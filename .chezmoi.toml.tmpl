{{- if lookPath "age" }}
encryption = "age"
{{- end }}

[git]
    autoAdd = true
    autoCommit = true
    autoPush = true
    commitMessageTemplateFile = ".commit_message.tmpl"

[data]
    github_user       = "jsoyer"
    xdgCacheDir       = "{{ .chezmoi.homeDir }}/.cache"
    xdgConfigDir      = "{{ .chezmoi.homeDir }}/.config"
    xdgDataDir        = "{{ .chezmoi.homeDir }}/.local/share"
    xdgStateDir       = "{{ .chezmoi.homeDir }}/.local/state"
    name = "Jerome Soyer"
    email = "jeromesoyer@gmail.com"
    work_email = "jsoyer@varonis.com"
    ubuntu_flavor     = "{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") (not (env "CI")) }}{{ if hasPrefix "ubuntu-server" .chezmoi.hostname }}server{{ else if hasPrefix "ubuntu-desktop" .chezmoi.hostname }}desktop{{ else }}{{ promptStringOnce . "ubuntu_flavor" "Ubuntu flavor [desktop/server]" "server" }}{{ end }}{{ else }}server{{ end }}"
    fedora_flavor     = "{{ if lookPath "rpm-ostree" }}atomic{{ else if hasPrefix "fedora-server" .chezmoi.hostname }}server{{ else if hasPrefix "fedora-desktop" .chezmoi.hostname }}desktop{{ else }}{{ promptStringOnce . "fedora_flavor" "Fedora flavor [desktop/server]" "desktop" }}{{ end }}"

{{- if lookPath "age" }}

[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
{{-   $opConfigFile := joinPath .chezmoi.homeDir ".config" "op" "config" }}
{{-   $opReady := false }}
{{-   if and (eq .chezmoi.os "darwin") (lookPath "op") (stat $opConfigFile) }}
{{-     if or (stat "/Applications/1Password.app") (stat "/Applications/1Password 7.app") }}
{{-       $opReady = true }}
{{-     end }}
{{-   end }}
{{-   if $opReady }}
    recipient = "{{ onepasswordRead "op://Private/Age Encryption Key - Chezmoi/public key" }}"
{{-   else }}
    recipient = "{{ promptStringOnce . "age_recipient" "age public key (age1...)" }}"
{{-   end }}
{{- end }}

[edit]
    command = "nvim"

{{- if lookPath "delta" }}
[diff]
    command = "delta"
    pager = "delta"
{{- end }}

[merge]
    command = "nvim"
    args = [
      "{{ `{{ .Destination }}` }}",
      "{{ `{{ .Source }}` }}",
      "{{ `{{ .Target }}` }}",
    ]
