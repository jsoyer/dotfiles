{{- /* Preserve the technical profile on re-init; package scope is independent. */ -}}
{{- $mp := index . "machine_profile" | default "" -}}
{{- $existingMachine := and $mp (stat .chezmoi.configFile) -}}
{{- if not $mp -}}
{{- if eq .chezmoi.os "windows" -}}{{- $mp = "windows" -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{- if eq .chezmoi.hostname "jsoyer-macOS" -}}{{- $mp = "mac-pro" -}}{{- else -}}{{- $mp = "mac-personal" -}}{{- end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- if or (eq .chezmoi.osRelease.id "raspbian") (eq .chezmoi.osRelease.id "raspios") -}}{{- $mp = "rpi" -}}
{{- else if stat "/proc/device-tree/model" -}}{{- $mp = promptStringOnce . "machine_profile" "Machine profile (choose rpi or debian)" "rpi" -}}
{{- else if env "CI" -}}{{- $mp = "ubuntu-server" -}}
{{- else if eq .chezmoi.osRelease.id "ubuntu" -}}
{{- if hasPrefix "ubuntu-desktop" .chezmoi.hostname -}}{{- $mp = "ubuntu-desktop" -}}
{{- else if hasPrefix "ubuntu-server" .chezmoi.hostname -}}{{- $mp = "ubuntu-server" -}}
{{- else -}}{{- $mp = promptStringOnce . "machine_profile" "Machine profile [ubuntu-server/ubuntu-desktop]" "ubuntu-server" -}}{{- end -}}
{{- else if and (lookPath "rpm-ostree") (not (stat "/.toolboxenv")) (not (env "TOOLBOX_PATH")) -}}{{- $mp = "fedora-atomic" -}}
{{- else if or (stat "/.toolboxenv") (env "TOOLBOX_PATH") -}}{{- $mp = "toolbox" -}}
{{- else if lookPath "dnf" -}}
{{- if hasPrefix "fedora-server" .chezmoi.hostname -}}{{- $mp = "fedora-server" -}}
{{- else if hasPrefix "fedora-desktop" .chezmoi.hostname -}}{{- $mp = "fedora-desktop" -}}
{{- else -}}{{- $mp = promptStringOnce . "machine_profile" "Machine profile [fedora-desktop/fedora-server]" "fedora-desktop" -}}{{- end -}}
{{- else if eq .chezmoi.osRelease.id "omarchy" -}}{{- $mp = "omarchy" -}}
{{- else if eq .chezmoi.osRelease.id "arch" -}}
{{- if hasPrefix "arch-server" .chezmoi.hostname -}}{{- $mp = "arch-server" -}}
{{- else if hasPrefix "arch-desktop" .chezmoi.hostname -}}{{- $mp = "arch-desktop" -}}
{{- else -}}{{- $mp = promptStringOnce . "machine_profile" "Machine profile [arch-desktop/arch-server]" "arch-desktop" -}}{{- end -}}
{{- else if eq .chezmoi.osRelease.id "debian" -}}{{- $mp = "debian" -}}
{{- else -}}{{- $mp = promptStringOnce . "machine_profile" "Machine profile" "debian" -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- $mp = includeTemplate "machine-profile" (dict "machine_profile" $mp) -}}
{{- $pp := index . "package_profile" | default "" -}}
{{- if env "DOTFILES_PACKAGE_PROFILE" -}}{{- $pp = env "DOTFILES_PACKAGE_PROFILE" -}}{{- end -}}
{{- if not $pp -}}
{{- if and (index . "machine_profile") (stat .chezmoi.configFile) -}}
{{- $pp = "legacy" -}}
{{- else if env "CI" -}}{{- $pp = "base" -}}
{{- else -}}{{- $pp = promptStringOnce . "package_profile" "Packages [base/personal/professional/server]" "base" -}}{{- end -}}
{{- end -}}
{{- if not (has $pp (list "base" "personal" "professional" "server" "legacy")) -}}{{- fail "Invalid package_profile: choose base, personal, professional or server" -}}{{- end -}}
{{- /* A new machine must not silently reuse another Mac's generic hostname. */ -}}
{{- if not $existingMachine -}}
{{- $catalog := include "dot_private/package-layers.json" | fromJson -}}
{{- $host := first (splitList "." .chezmoi.hostname) -}}
{{- $collision := false -}}
{{- if hasKey $catalog.profiles $mp -}}
{{- range $manager, $_ := (index $catalog.profiles $mp).managers -}}
{{- $suffix := "" -}}{{- if eq $manager "scoop" -}}{{- $suffix = ".json" -}}{{- end -}}
{{- if stat (printf "%s/dot_private/%s%s%s" $.chezmoi.sourceDir (index $catalog.host_prefixes $manager) $host $suffix) -}}{{- $collision = true -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- if $collision -}}
{{- $reuse := eq (env "DOTFILES_REUSE_HOST_PACKAGES") "1" -}}
{{- if not $reuse -}}{{- $reuse = promptBoolOnce . "reuse_host_packages" (printf "Package lists already exist for %s. Reuse them for the same machine" $host) false -}}{{- end -}}
{{- if not $reuse -}}{{- fail (printf "Hostname %s already owns package lists. Choose a unique hostname, or explicitly reuse this machine with DOTFILES_REUSE_HOST_PACKAGES=1" $host) -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- $_ := set . "machine_profile" $mp -}}
{{- $_ := set . "package_profile" $pp -}}
[git]
    autoAdd = {{ if eq (env "CHEZMOI_AUTO_GIT") "1" }}true{{ else }}false{{ end }}
    autoCommit = {{ if eq (env "CHEZMOI_AUTO_GIT") "1" }}true{{ else }}false{{ end }}
    autoPush = {{ if eq (env "CHEZMOI_AUTO_GIT") "1" }}true{{ else }}false{{ end }}
    commitMessageTemplateFile = ".commit_message.tmpl"

[data]
    github_user       = "jsoyer"
    xdgCacheDir       = {{ printf "%s/.cache" .chezmoi.homeDir | quote }}
    xdgConfigDir      = {{ printf "%s/.config" .chezmoi.homeDir | quote }}
    xdgDataDir        = {{ printf "%s/.local/share" .chezmoi.homeDir | quote }}
    xdgStateDir       = {{ printf "%s/.local/state" .chezmoi.homeDir | quote }}
    name = "Jerome Soyer"
    email = "jeromesoyer@gmail.com"
    work_email = "jsoyer@varonis.com"
    # Technical configuration and package scope are independent.
    machine_profile = {{ $mp | quote }}
    package_profile = {{ $pp | quote }}
{{- if eq $pp "base" }}
    install_ocx = false
    install_mas = false
    install_docker = false
{{- else }}
{{- $desktopProfiles := list "mac-personal" "fedora-desktop" "toolbox" "ubuntu-desktop" "arch-desktop" "omarchy" -}}
{{- if has $mp $desktopProfiles }}
    install_ocx = {{ promptBoolOnce . "install_ocx" "Install OpenCode extensions (ocx + npm plugins)" false }}
{{- end }}
{{- if or (eq $mp "mac-personal") (eq $mp "mac-pro") }}
    install_mas = {{ promptBoolOnce . "install_mas" "Install Mac App Store apps via mas" false }}
{{- end }}
{{- if and (ne $mp "toolbox") (not (env "CI")) }}
    install_docker = {{ promptBoolOnce . "install_docker" "Install a container engine (Docker; Podman on Fedora; Colima on macOS)" false }}
{{- end }}

{{- end }}

{{- if eq $mp "omarchy" }}

[data.omarchy]
    override_shell = {{ promptBoolOnce .omarchy "override_shell" "Override OmArchy shell config (zsh/bash/starship)" true }}
    override_nvim = {{ promptBoolOnce .omarchy "override_nvim" "Override OmArchy Neovim config" false }}
    override_tmux = {{ promptBoolOnce .omarchy "override_tmux" "Override OmArchy tmux config" true }}
    override_git = {{ promptBoolOnce .omarchy "override_git" "Override OmArchy git config" true }}
    override_wm = {{ promptBoolOnce .omarchy "override_wm" "Override OmArchy window manager (Hyprland/etc.)" false }}
{{- end }}

[edit]
    command = "nvim"

{{- if lookPath "delta" }}
[diff]
    command = "delta"
    pager = "delta"
{{- end }}

[merge]
    command = "nvim"
    args = [
      "{{ `{{ .Destination }}` }}",
      "{{ `{{ .Source }}` }}",
      "{{ `{{ .Target }}` }}",
    ]
