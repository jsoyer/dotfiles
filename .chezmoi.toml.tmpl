{{- if lookPath "age" }}
encryption = "age"
{{- end }}

[git]
    autoAdd = true
    autoCommit = true
    autoPush = true
    commitMessageTemplateFile = ".commit_message.tmpl"

[data]
    github_user       = "jsoyer"
    xdgCacheDir       = "{{ .chezmoi.homeDir }}/.cache"
    xdgConfigDir      = "{{ .chezmoi.homeDir }}/.config"
    xdgDataDir        = "{{ .chezmoi.homeDir }}/.local/share"
    xdgStateDir       = "{{ .chezmoi.homeDir }}/.local/state"
    name = "Jerome Soyer"
    email = "jeromesoyer@gmail.com"
    work_email = "jsoyer@varonis.com"
    # Profile detection — order matters: most specific first
    # Profiles: windows, mac-pro, mac-personal, rpi, ubuntu-server, ubuntu-desktop,
    #   fedora-atomic, toolbox, fedora-server, fedora-desktop, omarchy, arch-server, arch-desktop, debian
    machine_profile   = "{{- if eq .chezmoi.os "windows" -}}windows
{{- else if eq .chezmoi.os "darwin" -}}{{- if eq .chezmoi.hostname "jsoyer-macOS" -}}mac-pro{{- else -}}mac-personal{{- end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- if or (eq .chezmoi.osRelease.id "raspbian") (eq .chezmoi.osRelease.id "raspios") -}}rpi
{{- else if stat "/proc/device-tree/model" -}}{{ promptStringOnce . "machine_profile" "Machine profile [rpi/debian]" "rpi" }}
{{- else if env "CI" -}}ubuntu-server
{{- else if eq .chezmoi.osRelease.id "ubuntu" -}}
{{- if hasPrefix "ubuntu-server" .chezmoi.hostname -}}ubuntu-server
{{- else if hasPrefix "ubuntu-desktop" .chezmoi.hostname -}}ubuntu-desktop
{{- else -}}{{ promptStringOnce . "machine_profile" "Machine profile [ubuntu-server/ubuntu-desktop]" "ubuntu-server" }}
{{- end -}}
{{- else if and (lookPath "rpm-ostree") (not (stat "/.toolboxenv")) (not (env "TOOLBOX_PATH")) -}}fedora-atomic
{{- else if or (stat "/.toolboxenv") (env "TOOLBOX_PATH") -}}toolbox
{{- else if lookPath "dnf" -}}
{{- if hasPrefix "fedora-server" .chezmoi.hostname -}}fedora-server
{{- else if hasPrefix "fedora-desktop" .chezmoi.hostname -}}fedora-desktop
{{- else -}}{{ promptStringOnce . "machine_profile" "Machine profile [fedora-desktop/fedora-server]" "fedora-desktop" }}
{{- end -}}
{{- else if eq .chezmoi.osRelease.id "omarchy" -}}omarchy
{{- else if eq .chezmoi.osRelease.id "arch" -}}
{{- if hasPrefix "arch-server" .chezmoi.hostname -}}arch-server
{{- else if hasPrefix "arch-desktop" .chezmoi.hostname -}}arch-desktop
{{- else -}}{{ promptStringOnce . "machine_profile" "Machine profile [arch-desktop/arch-server]" "arch-desktop" }}
{{- end -}}
{{- else if eq .chezmoi.osRelease.id "debian" -}}debian
{{- else -}}{{ promptStringOnce . "machine_profile" "Machine profile" "debian" }}
{{- end -}}
{{- end -}}"
{{- $mp := index . "machine_profile" -}}
{{- $desktopProfiles := list "mac-personal" "fedora-desktop" "toolbox" "ubuntu-desktop" "arch-desktop" "omarchy" -}}
{{- if has $mp $desktopProfiles }}
    install_ocx = {{ promptBoolOnce . "install_ocx" "Install OpenCode extensions (ocx + npm plugins)" false }}
{{- end }}
{{- if or (eq $mp "mac-personal") (eq $mp "mac-pro") }}
    install_mas = {{ promptBoolOnce . "install_mas" "Install Mac App Store apps via mas" false }}
{{- end }}

{{- if eq $mp "omarchy" }}

[data.omarchy]
    override_shell = {{ promptBoolOnce .omarchy "override_shell" "Override OmArchy shell config (zsh/bash/starship)" true }}
    override_nvim = {{ promptBoolOnce .omarchy "override_nvim" "Override OmArchy Neovim config" false }}
    override_tmux = {{ promptBoolOnce .omarchy "override_tmux" "Override OmArchy tmux config" true }}
    override_git = {{ promptBoolOnce .omarchy "override_git" "Override OmArchy git config" true }}
    override_wm = {{ promptBoolOnce .omarchy "override_wm" "Override OmArchy window manager (Hyprland/etc.)" false }}
{{- end }}

{{- if lookPath "age" }}

[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
{{-   $opConfigFile := joinPath .chezmoi.homeDir ".config" "op" "config" }}
{{-   $opReady := false }}
{{-   if and (eq .chezmoi.os "darwin") (lookPath "op") (stat $opConfigFile) }}
{{-     if or (stat "/Applications/1Password.app") (stat "/Applications/1Password 7.app") }}
{{-       $opReady = true }}
{{-     end }}
{{-   end }}
{{-   if $opReady }}
    recipient = "{{ onepasswordRead "op://Private/Age Encryption Key - Chezmoi/public key" }}"
{{-   else }}
    recipient = "{{ promptStringOnce . "age_recipient" "age public key (age1...)" }}"
{{-   end }}
{{- end }}

[edit]
    command = "nvim"

{{- if lookPath "delta" }}
[diff]
    command = "delta"
    pager = "delta"
{{- end }}

[merge]
    command = "nvim"
    args = [
      "{{ `{{ .Destination }}` }}",
      "{{ `{{ .Source }}` }}",
      "{{ `{{ .Target }}` }}",
    ]
