# Main Brewfile
# Assembles package lists based on OS and hostname.

# 1. Common packages for all machines
{{ include "dot_private/Brewfile_common" | trim }}

# 2. Profile-specific packages
{{- if eq .chezmoi.os "darwin" }}
{{-   if eq .chezmoi.hostname "jsoyer-macOS" }}
{{ include "dot_private/Brewfile_pro" | trim }}
{{-   else }}
{{ include "dot_private/Brewfile_personal" | trim }}
{{-   end }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $isRPi           := or (eq .chezmoi.osRelease.id "raspbian") (stat "/proc/device-tree/model") -}}
{{-   $isUbuntu        := and (eq .chezmoi.osRelease.id "ubuntu") (not $isRPi) -}}
{{-   $ubuntuFlavor    := .ubuntu_flavor | default "server" -}}
{{-   $isUbuntuDesktop := and $isUbuntu (eq $ubuntuFlavor "desktop") -}}
{{-   $fedoraFlavor    := .fedora_flavor | default "desktop" -}}
{{-   $isFedoraDesktop := eq $fedoraFlavor "desktop" -}}
{{-   if $isRPi }}
{{-     if or (hasPrefix "bbh-network" .chezmoi.hostname) (hasPrefix "omv-" .chezmoi.hostname) }}
{{ include "dot_private/Brewfile_rpi" | trim }}
{{-     else }}
{{ include "dot_private/Brewfile_rpi" | trim }}
{{-     end }}
{{-   else if $isUbuntuDesktop }}
{{ include "dot_private/Brewfile_ubuntu_desktop" | trim }}
{{-   else if $isUbuntu }}
{{ include "dot_private/Brewfile_rpi" | trim }}
{{-   else if $isFedoraDesktop }}
{{ include "dot_private/Brewfile_fedora_desktop" | trim }}
{{-   else }}
{{ include "dot_private/Brewfile_linux" | trim }}
{{-   end }}
{{- end }}
