# Main Brewfile
# macOS: full Homebrew (formulae + casks + mas)
# Linux: brew-only packages (native packages handled by apt/dnf/pacman)

{{- $mp := index . "machine_profile" -}}
{{- if eq .chezmoi.os "darwin" }}
{{ include "dot_private/Brewfile_macos" | trim }}

{{-   if eq $mp "mac-pro" }}
{{ include "dot_private/Brewfile_pro" | trim }}
{{-   else }}
{{ include "dot_private/Brewfile_personal" | trim }}
{{-   end }}
{{- else if eq .chezmoi.os "linux" }}
{{-   if eq $mp "fedora-atomic" }}
{{ include "dot_private/Brewfile_fedora_atomic" | trim }}
{{-   else }}
{{ include "dot_private/Brewfile_brew_only" | trim }}
{{-     if eq $mp "rpi" }}
{{ include "dot_private/Brewfile_rpi" | trim }}
{{-     end }}
{{-   end }}
{{- end }}
