# Main Brewfile
# Assembles package lists based on OS and hostname.

# 1. Common packages for all machines
{{ include "dot_private/Brewfile_common" | trim }}

# 2. Profile-specific packages
{{- $mp := index . "machine_profile" -}}
{{- if eq .chezmoi.os "darwin" }}
{{-   if eq $mp "mac-pro" }}
{{ include "dot_private/Brewfile_pro" | trim }}
{{-   else }}
{{ include "dot_private/Brewfile_personal" | trim }}
{{-   end }}
{{- else if eq .chezmoi.os "linux" }}
{{-   if eq $mp "rpi" }}
{{ include "dot_private/Brewfile_rpi" | trim }}
{{-   else if eq $mp "ubuntu-desktop" }}
{{ include "dot_private/Brewfile_ubuntu_desktop" | trim }}
{{-   else if eq $mp "fedora-desktop" }}
{{ include "dot_private/Brewfile_fedora_desktop" | trim }}
{{-   else }}
{{ include "dot_private/Brewfile_linux" | trim }}
{{-   end }}
{{- end }}
