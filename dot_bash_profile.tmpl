{{- if stat "/.toolboxenv" -}}
# Minimal .bash_profile for toolbox - source .profile for env vars
[ -f ~/.profile ] && . ~/.profile
[ -f ~/.bashrc ] && . ~/.bashrc
{{- else if eq .chezmoi.os "darwin" -}}
# macOS bash_profile
[ -f ~/.profile ] && . ~/.profile

# Homebrew (must be before .bashrc so starship and other brew tools are in PATH)
eval "$(/opt/homebrew/bin/brew shellenv)"

[ -f ~/.bashrc ] && . ~/.bashrc
{{- else -}}
# Standard Linux .bash_profile
[ -f ~/.profile ] && . ~/.profile
[ -f ~/.bashrc ] && . ~/.bashrc
{{- end }}
