# Oh-My-Zsh configuration
export ZSH=$HOME/.oh-my-zsh
export UPDATE_ZSH_DAYS=7
ZSH_THEME=""  # Theme disabled, using Starship instead

# ============================================================================
# Oh-My-Zsh Plugins
# ============================================================================
# Organized by category for maintainability
# Only include plugins for installed tools to keep startup fast

plugins=(
  # === Core Productivity ===
  colored-man-pages    # Colorful man pages
  colorize             # Syntax highlighting for cat/less
  copybuffer           # Copy command line to clipboard (Ctrl+O)
  copyfile             # Copy file contents to clipboard
  extract              # Universal archive extraction (just type: extract file.zip)
  encode64             # Base64 encoding/decoding helpers
  jsontools            # JSON manipulation (pp_json, is_json, etc.)

  # === Package Managers ===
  brew                 # Homebrew aliases and completion

  # === Version Managers (only if you use them) ===
  pyenv                # Python version management
  jenv                 # Java version management
  rbenv                # Ruby version management

  # === Languages & Frameworks ===
  node                 # Node.js aliases
  npm                  # NPM completion
  yarn                 # Yarn completion
  poetry               # Python poetry support

  # === Git ===
  git                  # Core git aliases
  github               # GitHub integration
  git-extras           # Additional git commands
  gitignore            # Gitignore templates (gi python, gi node, etc.)

  # === Cloud & Infrastructure ===
  aws                  # AWS CLI completion
  docker               # Docker aliases and completion
  kubectl              # Kubernetes completion
  helm                 # Helm completion
  terraform            # Terraform completion

  # === System ===
  macos                # macOS-specific utilities
  ssh-agent            # SSH agent management
  sudo                 # ESC ESC to add sudo
  rsync                # Rsync completion

  # === Utilities ===
  web-search           # Search from terminal (google, ddg, github, etc.)
)

# ============================================================================
# Load Oh-My-Zsh
# ============================================================================
source $ZSH/oh-my-zsh.sh

# ============================================================================
# Load modular configuration files
# ============================================================================
for config_file ($HOME/.zsh/*.zsh(N)); do
  source $config_file
done

# ============================================================================
# Starship prompt (must be last to override oh-my-zsh theme)
# ============================================================================
eval "$(starship init zsh)"
export STARSHIP_CONFIG=~/.config/starship/starship.toml

