[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[user]
	name = Jerome Soyer
	email = jeromesoyer@gmail.com
{{- if stat "/Applications/1Password.app" }}
  signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519-github.pub
{{- end }}

[pull]
  # Use rebase instead of merge on git pull for a cleaner linear history
	rebase = true

[core]
  editor = nvim
  autocrlf = input
  excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
{{- if lookPath "delta" }}
  pager = delta
{{- end }}

[init]
  defaultBranch = main

[push]
  default = current
  autoSetupRemote = true

[fetch]
  prune = true
  prunetags = true

[rerere]
  enabled = true

[rebase]
  autosquash = true
  autostash = true

[merge]
  conflictstyle = zdiff3

[diff]
  algorithm = histogram
  colorMoved = default

{{- if stat "/Applications/1Password.app" }}

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
  gpgsign = true
{{- end }}

[alias]
  st = status -sb
  co = checkout
  br = branch
  cm = commit -m
  ca = commit --amend --no-edit
  cp = cherry-pick
  sw = switch
  swc = switch -c

  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  ll = log --oneline --graph --decorate --all
  last = log -1 HEAD --stat

  uncommit = reset --soft HEAD~1
  unstage = restore --staged
  discard = restore

  aliases = config --get-regexp ^alias\\.
  whoami = config user.email

  # Show stash list
  sl = stash list
  # Stash including untracked
  su = stash -u

  # List branches sorted by last commit
  recent = branch --sort=-committerdate --format='%(committerdate:short) %(refname:short)'

  # Delete merged branches
  sweep = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

{{- if lookPath "delta" }}

[delta]
  navigate = true
  light = false
  side-by-side = false
  line-numbers = true
  syntax-theme = Catppuccin Mocha
  file-style = bold yellow
  file-decoration-style = yellow ul
  hunk-header-style = file line-number syntax
  hunk-header-decoration-style = blue box
  plus-style = syntax "#1e3a2f"
  minus-style = syntax "#3b1e1e"
  plus-emph-style = syntax "#2d5a3d"
  minus-emph-style = syntax "#5a2d2d"
  blame-format = "{author:<15} {commit:<8} {timestamp:<15} "
  blame-timestamp-format = "%Y-%m-%d %H:%M"

[interactive]
  diffFilter = delta --color-only
{{- end }}


# `gh` non qualifié, et pas de garde `lookPath` : le helper s'exécute au moment
# du `git push`, pas au moment du `chezmoi apply`. Figer un chemin absolu rendu
# à l'apply liait la config au PATH de ce moment-là — sur une machine où gh
# n'était pas encore installé (ou absent du PATH du service d'autoupdate), le
# bloc n'était pas écrit du tout et git tombait sur « Password authentication
# is not supported », sans indice. Le dépôt étant public, seul le push casse :
# fetch et rebase passent en anonyme, ce qui masque la panne jusqu'au bout.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
