# .chezmoiignore — keep the ~/.claude dotfiles lean.
# Patterns are target paths relative to $HOME. Scoped to .claude/ so other
# dotfiles are unaffected. None of these match currently-managed files, so
# adding this file does not un-manage anything (verified: 263 managed files).

# ── ~/.claude runtime / ephemeral state (never belongs in dotfiles) ──
.claude/cache
.claude/paste-cache
.claude/file-history
.claude/shell-snapshots
.claude/debug
.claude/downloads
.claude/uploads
.claude/logs
.claude/hooks/logs
.claude/hooks/.approvals
.claude/hooks/.pending
.claude/state
.claude/sessions
.claude/session-data
.claude/session-env
.claude/projects
.claude/todos
.claude/todoStorage.json
.claude/telemetry
.claude/usage-data
.claude/worktrees
.claude/plans
.claude/tasks
.claude/plugins
.claude/remote
.claude/context-mode
.claude/token-optimizer/checkpoints
.claude/_backups
.claude/backups

# ── security/ here is a Python virtualenv (agent-sdk-venv), not dotfiles ──
.claude/security

# ── machine-local / secrets (must never be committed) ──
.claude/settings.local.json
.claude/.credentials.json
.claude/*.env
.claude/*.secret
.claude/*.pem
.claude/history.jsonl
.claude/mcp-needs-auth-cache.json
.claude/security_warnings_state_*
.claude/.settings.lock
.claude/.last-update-result.json
.claude/.last-cleanup
.claude/.caveman-active
.claude/*.log

# ── evolution: keep the tracked structure, drop machine-specific data ──
.claude/evolution/error-registry.json
.claude/evolution/model-performance.json
.claude/evolution/workflow-changelog.md
.claude/evolution/session-postmortems/*.md

# ── media_automation : NAS uniquement (omv-nice / omv-dijon) ──
# Ces scripts et leur config chiffree n'ont de sens que sur les deux NAS.
# bin/** couvre les futurs siblings. Les noms explicites restent pour
# que le test de regression voie chaque fichier.
# Ignore = do not re-apply. Actual deletion of leftovers is
# run_once_13-remove-nas-media-leftovers.sh (chezmoiremove would prompt
# on every `ca` until the leftover is gone).
{{ if not (or (eq .chezmoi.hostname "omv-nice") (eq .chezmoi.hostname "omv-dijon")) }}
bin/**
bin/media_automation.py
bin/audit_seasonless.sh
bin/test_media_automation.py
bin/anime_absolute_plan.py
bin/anime_folder_plan.py
bin/infuse_rename_plan.py
bin/media_absolute_shows.py
bin/media_absolute_refresh.py
bin/serie_renommer.py
bin/media_automation
{{ end }}

# ── Agent stacks (moshi / orca / cursor-worker) : Linux only ──
# herdr is the exception: the binary is installed on every Unix machine
# (run_once_after_14-install-herdr). Ignore = do not re-apply. Actual
# deletion of leftovers is run_once_12-disable-macos-agent-stacks.sh
# (ignore never removes), and only moshi/orca/cursor wrappers are wiped.
{{ if ne .chezmoi.os "linux" }}
.config/systemd
.local/bin/agentsvc
.local/bin/cursor-setup
.local/bin/moshi-hook-launch
.local/bin/moshi-setup
.local/bin/moshi-uninstall
.local/bin/orca-gui
.local/bin/orca-setup
.local/bin/orca-uninstall
.local/bin/orca-version
.local/bin/update-cursor-agent
.local/bin/update-moshi
.local/bin/update-orca
{{ end }}
{{ if eq .machine_profile "mac-pro" }}
Library/LaunchAgents/com.jsoyer.moshi-hook.plist
Library/LaunchAgents/com.jsoyer.moshi-update.plist
{{ end }}

# ── ~/.agents : plus gere par chezmoi, mais toujours utilise ──
# dot_agents/ a ete supprime de la source par d9794e50 (consolidation aictx).
# chezmoi se souvenait de l'avoir ecrit et voulait donc supprimer ~/.agents a
# chaque apply. Le dossier a depuis ete recree par l'outillage agent (il
# contient skills/terminal-browser), donc chezmoi demandait confirmation avant
# de l'effacer — et sans TTY, il ABANDONNAIT tout l'apply : plus aucun script
# ni fichier applique, y compris via chezmoi-autoupdate.
# On le sort explicitement du perimetre.
.agents
