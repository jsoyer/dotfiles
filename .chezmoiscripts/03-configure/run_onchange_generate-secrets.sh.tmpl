{{- if ne .chezmoi.os "windows" -}}
{{- if lookPath "op" -}}
#!/usr/bin/env bash
# =============================================================================
# Generate ~/.zsh/secrets.zsh from 1Password
# Falls back silently if 1Password is not authenticated or item not found.
# =============================================================================
# 1Password item: op://Private/Shell Secrets
# Re-runs when this script changes (no external trigger — run chezmoi apply to refresh)

set -uo pipefail

SECRETS_FILE="${HOME}/.zsh/secrets.zsh"
SECRETS_BASH="${HOME}/.bash/secrets.bash"
OP_ITEM="op://Private/Shell Secrets"

# Check if 1Password is authenticated — prompt to connect if interactive TTY
if ! op account list &>/dev/null 2>&1; then
    if [[ -t 0 ]]; then
        echo -n "🔑 1Password: not authenticated. Connect now? (y/N) "
        read -r _op_answer
        if [[ "${_op_answer}" =~ ^[Yy]$ ]]; then
            eval "$(op signin 2>/dev/null)" || true
        fi
        unset _op_answer
    fi
    # Re-check after potential signin
    if ! op account list &>/dev/null 2>&1; then
        echo "1Password: not authenticated, skipping secrets generation"
        exit 0
    fi
fi

# Check if the item exists
if ! op item get "Shell Secrets" --vault "Private" &>/dev/null 2>&1; then
    echo "1Password: 'Shell Secrets' item not found in Private vault"
    echo "Create it with: op item create --category=login --vault=Private --title='Shell Secrets'"
    echo "Then add fields: GITHUB_TOKEN, CHEZMOI_NTFY_TOPIC, CHEZMOI_NTFY_URL, CHEZMOI_NTFY_TOKEN, etc."
    exit 0
fi

echo "🔑 Generating secrets.zsh from 1Password..."

# Read each field — silently skip if not found
_op_read() {
    local field="$1"
    op read "${OP_ITEM}/${field}" 2>/dev/null || echo ""
}

GITHUB_TOKEN="$(_op_read "GITHUB_TOKEN")"
HOMEBREW_GITHUB_API_TOKEN="$(_op_read "GITHUB_TOKEN")"
CHEZMOI_NTFY_TOPIC="$(_op_read "CHEZMOI_NTFY_TOPIC")"
CHEZMOI_NTFY_URL="$(_op_read "CHEZMOI_NTFY_URL")"
CHEZMOI_NTFY_TOKEN="$(_op_read "CHEZMOI_NTFY_TOKEN")"
TELEGRAM_BOT_TOKEN="$(_op_read "TELEGRAM_BOT_TOKEN")"
TELEGRAM_CHAT_ID="$(_op_read "TELEGRAM_CHAT_ID")"
DISCORD_WEBHOOK_URL="$(_op_read "DISCORD_WEBHOOK_URL")"
SLACK_BOT_TOKEN="$(_op_read "SLACK_BOT_TOKEN")"
SLACK_TEAM_ID="$(_op_read "SLACK_TEAM_ID")"
BRAVE_API_KEY="$(_op_read "BRAVE_API_KEY")"
LINEAR_API_KEY="$(_op_read "LINEAR_API_KEY")"
NOTION_API_KEY="$(_op_read "NOTION_API_KEY")"
OBSIDIAN_API_KEY="$(_op_read "OBSIDIAN_API_KEY")"

# Write secrets.zsh (umask 077 to prevent race window with world-readable file)
mkdir -p "${HOME}/.zsh"
(
umask 077
cat > "${SECRETS_FILE}" << 'HEADER'
#!/usr/bin/env zsh
# =============================================================================
# Auto-generated from 1Password (op://Private/Shell Secrets)
# Do NOT edit manually — run `chezmoi apply` to regenerate
# =============================================================================
HEADER
)

# Only export non-empty values (single-quoted to prevent injection)
_export() {
    local name="$1" value="$2"
    if [[ -n "$value" ]]; then
        value="${value//\'/\'\\\'\'}"
        echo "export ${name}='${value}'" >> "${SECRETS_FILE}"
    fi
}

_export "GITHUB_TOKEN" "$GITHUB_TOKEN"
_export "HOMEBREW_GITHUB_API_TOKEN" "$HOMEBREW_GITHUB_API_TOKEN"
_export "CHEZMOI_NTFY_TOPIC" "$CHEZMOI_NTFY_TOPIC"
_export "CHEZMOI_NTFY_URL" "$CHEZMOI_NTFY_URL"
_export "CHEZMOI_NTFY_TOKEN" "$CHEZMOI_NTFY_TOKEN"
_export "TELEGRAM_BOT_TOKEN" "$TELEGRAM_BOT_TOKEN"
_export "TELEGRAM_CHAT_ID" "$TELEGRAM_CHAT_ID"
_export "DISCORD_WEBHOOK_URL" "$DISCORD_WEBHOOK_URL"
_export "SLACK_BOT_TOKEN" "$SLACK_BOT_TOKEN"
_export "SLACK_TEAM_ID" "$SLACK_TEAM_ID"
_export "BRAVE_API_KEY" "$BRAVE_API_KEY"
_export "LINEAR_API_KEY" "$LINEAR_API_KEY"
_export "NOTION_API_KEY" "$NOTION_API_KEY"
_export "OBSIDIAN_API_KEY" "$OBSIDIAN_API_KEY"

chmod 600 "${SECRETS_FILE}"

# Also generate bash version (same content, sourced by .bash/99-integrations)
if [[ -d "${HOME}/.bash" ]]; then
    cp "${SECRETS_FILE}" "${SECRETS_BASH}"
    chmod 600 "${SECRETS_BASH}"
fi

_count=$(grep -c '^export' "${SECRETS_FILE}" 2>/dev/null || echo 0)
echo "🔑 secrets.zsh generated (${_count} secrets from 1Password)"
{{- end }}
{{- end }}
