{{- if ne (index . "package_profile" | default "legacy") "base" -}}
{{- if ne .chezmoi.os "windows" -}}
{{- if lookPath "op" -}}
#!/usr/bin/env bash
# =============================================================================
# Generate ~/.zsh/secrets.zsh from 1Password
# Skips when unauthenticated; failed reads preserve the old files and retry later.
# =============================================================================
# 1Password item: op://Private/Shell Secrets
# generator: {{ include "dot_local/bin/executable_dotfiles-generated-config" | sha256sum }}
# For an explicit refresh: dotfiles-generated-config secrets

set -uo pipefail

# Check if 1Password has accounts configured (op account list prompts interactively if none)
if ! op account list --format=json 2>/dev/null | grep -q '"url"'; then
    if [[ -t 0 ]] && [[ "${CHEZMOI_AUTOUPDATE:-}" != "1" ]]; then
        echo -n "🔑 1Password: no accounts configured. Set up now? (y/N) "
        read -r _op_setup
        if [[ "${_op_setup}" =~ ^[Yy]$ ]]; then
            op account add
        fi
        unset _op_setup
        # Re-check after potential setup
        if ! op account list --format=json 2>/dev/null | grep -q '"url"'; then
            echo "1Password: skipping secrets generation"
            exit 0
        fi
    else
        echo "1Password: no accounts configured, skipping secrets generation"
        exit 0
    fi
fi

# Check if 1Password is authenticated
# Skip interactive prompt if CHEZMOI_AUTOUPDATE=1 (background daemon) or no TTY
if ! op whoami &>/dev/null 2>&1; then
    if [[ -t 0 ]] && [[ "${CHEZMOI_AUTOUPDATE:-}" != "1" ]]; then
        echo -n "🔑 1Password: not authenticated. Connect now? (y/N) "
        read -r _op_answer
        if [[ "${_op_answer}" =~ ^[Yy]$ ]]; then
            eval "$(op signin 2>/dev/null)" || true
        fi
        unset _op_answer
    fi
    # Re-check after potential signin
    if ! op whoami &>/dev/null 2>&1; then
        echo "1Password: not authenticated, skipping secrets generation"
        exit 0
    fi
fi

python3 "{{ .chezmoi.sourceDir }}/dot_local/bin/executable_dotfiles-generated-config" secrets
{{- end }}
{{- end }}

{{- end -}}
