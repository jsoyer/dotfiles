{{- /* Every machine except Windows (a bash script; Windows gets mise from Scoop). */ -}}
{{- $mp := index . "machine_profile" -}}
{{- $intelMac := and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") -}}
{{- $linux := eq .chezmoi.os "linux" -}}
{{- if eq .chezmoi.os "windows" -}}
{{- else -}}
#!/usr/bin/env bash
# =============================================================================
# Install the toolchains / CLI tools declared in ~/.config/mise/config.toml
# =============================================================================
# config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
#
# mise is normally installed by Homebrew (brew "mise" in the Brewfiles), and a
# leftover standalone copy is removed so there is a single mise.
# Intel macOS only: Homebrew is Tier 3 there (no bottles; the bundle filter
# drops unbottled formulae), so brew can neither install nor upgrade mise. Then
# the checksum-verified standalone binary in ~/.local/bin/mise wins (kept
# current by `mise self-update` in sysup), and a brew mise is uninstalled once
# the standalone copy works. The standalone copy is never removed in that case.
# Linux (all profiles, incl. RPi and servers): mise comes from Linuxbrew when
# brew exists and pours a bottle for it (x86_64 / arm64). Otherwise (no brew, e.g.
# 32-bit Pis, or no sudo) the same checksum-verified standalone binary is installed
# (linux-x64 / linux-arm64 / linux-armv7 asset from `uname -m`; an architecture
# without an asset is skipped cleanly). A brew mise always wins over the
# standalone copy, which is then removed (single mise on PATH). Never compiled.
# Global languages come from mise only on mac-pro and Intel Macs; elsewhere the
# script also prunes unreferenced mise toolchains after `mise install`.
# Failures are non-fatal: this script always exits 0.

set -uo pipefail

LOCAL_MISE="$HOME/.local/bin/mise"

find_brew_mise() {
    local brew_bin prefix
    brew_bin="$(command -v brew 2>/dev/null || true)"
    [[ -z "$brew_bin" ]] && return 1
    prefix="$("$brew_bin" --prefix 2>/dev/null)" || return 1
    if [[ -x "$prefix/bin/mise" ]]; then
        printf '%s\n' "$prefix/bin/mise"
        return 0
    fi
    return 1
}
{{ if or $intelMac $linux }}
# True when Homebrew publishes a bottle for mise on this host.
brew_has_bottle_for_mise() {
    command -v brew >/dev/null 2>&1 || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    brew info --json=v2 mise 2>/dev/null | python3 -c '
import json, platform, sys
try:
    f = json.load(sys.stdin)["formulae"][0]
except Exception:
    sys.exit(1)
files = f.get("bottle", {}).get("stable", {}).get("files") or {}
if platform.system() == "Linux":
    tag = "arm64_linux" if platform.machine() in ("aarch64", "arm64") else "x86_64_linux"
    sys.exit(0 if tag in files else 1)
sys.exit(0 if files else 1)'
}
{{ end }}
{{ if or $intelMac $linux }}
install_standalone_mise() {
    local tool tag asset base tmp expected actual
    for tool in curl tar; do
        command -v "$tool" >/dev/null 2>&1 || { echo "mise: $tool missing, skipping standalone install."; return 1; }
    done
    tag="$(curl -fsSL -o /dev/null -w '%{url_effective}' https://github.com/jdx/mise/releases/latest | sed 's|.*/||')" || return 1
    [[ -n "$tag" ]] || return 1
{{- if $intelMac }}
    asset="mise-${tag}-macos-x64.tar.gz"
{{- else }}
    case "$(uname -m)" in
        x86_64|amd64)  asset="mise-${tag}-linux-x64.tar.gz" ;;
        aarch64|arm64) asset="mise-${tag}-linux-arm64.tar.gz" ;;
        armv7l|armv8l) asset="mise-${tag}-linux-armv7.tar.gz" ;;
        *) echo "mise: no release binary for $(uname -m), skipping."; return 1 ;;
    esac
{{- end }}
    base="https://github.com/jdx/mise/releases/download/${tag}"
    tmp="$(mktemp -d)" || return 1
    # shellcheck disable=SC2064
    trap "rm -r -f '$tmp'" RETURN
    if ! { curl -fsSL -o "$tmp/$asset" "$base/$asset" && curl -fsSL -o "$tmp/SHASUMS256.txt" "$base/SHASUMS256.txt"; }; then
        echo "mise: download failed, skipping."
        return 1
    fi
    expected="$(awk -v a="$asset" '$2 == a || $2 == "./"a {print $1; exit}' "$tmp/SHASUMS256.txt")"
    if command -v sha256sum >/dev/null 2>&1; then
        actual="$(sha256sum "$tmp/$asset" | awk '{print $1}')"
    elif command -v shasum >/dev/null 2>&1; then
        actual="$(shasum -a 256 "$tmp/$asset" | awk '{print $1}')"
    else
        echo "mise: no sha256 tool, skipping standalone install."
        return 1
    fi
    if [[ -z "$expected" || "$expected" != "$actual" ]]; then
        echo "mise: sha256 verification FAILED for $asset, not installing."
        return 1
    fi
    tar -xzf "$tmp/$asset" -C "$tmp" || return 1
    mkdir -p "$HOME/.local/bin"
    install -m 0755 "$tmp/mise/bin/mise" "$LOCAL_MISE" || return 1
    echo "mise: installed $tag to $LOCAL_MISE (sha256 verified)."
}
{{ end }}
MISE="$(find_brew_mise || true)"
PREFER_STANDALONE=0
{{ if $intelMac }}
# Intel: brew cannot pour mise, so a brew mise would go stale. Prefer standalone.
if [[ -n "$MISE" ]] && ! brew_has_bottle_for_mise; then
    PREFER_STANDALONE=1
    echo "mise: Homebrew cannot pour mise here, switching to the verified standalone binary."
    if install_standalone_mise && "$LOCAL_MISE" --version >/dev/null 2>&1; then
        if brew uninstall mise; then
            echo "mise: removed Homebrew mise (standalone $LOCAL_MISE is now the only mise)."
        else
            echo "mise: warning: 'brew uninstall mise' failed (non-fatal); remove it by hand."
        fi
        MISE="$LOCAL_MISE"
    else
        echo "mise: standalone install failed (non-fatal), keeping Homebrew mise $MISE."
    fi
fi
{{ end }}
if [[ -n "$MISE" && "$PREFER_STANDALONE" == 1 ]]; then
    :  # decided above (standalone installed, or brew mise kept after a failure)
elif [[ -n "$MISE" ]]; then
    # Single mise: drop a leftover standalone copy when brew provides one.
    if [[ -e "$LOCAL_MISE" ]]; then
        echo "mise: Homebrew mise present ($MISE), removing standalone $LOCAL_MISE."
        rm -f "$LOCAL_MISE"
    fi
elif [[ -x "$LOCAL_MISE" ]]; then
    MISE="$LOCAL_MISE"
elif command -v mise >/dev/null 2>&1; then
    MISE="$(command -v mise)"
{{- if $intelMac }}
elif ! brew_has_bottle_for_mise; then
    echo "mise: Homebrew cannot pour it here, using verified release download."
    install_standalone_mise && MISE="$LOCAL_MISE"
{{- else if $linux }}
elif brew_has_bottle_for_mise; then
    :  # brew can pour mise here: the brew bundle installs it (may still be pending)
else
    echo "mise: no Homebrew bottle here, using the verified release download."
    install_standalone_mise && MISE="$LOCAL_MISE"
{{- end }}
fi

if [[ -z "${MISE:-}" ]]; then
    echo "mise: not available yet (brew bundle may still be pending); skipping tool install."
    exit 0
fi

# Rate limits for the aqua/github backends. Token is never printed.
if [[ -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
    GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
    [[ -n "$GITHUB_TOKEN" ]] && export GITHUB_TOKEN
fi

echo "mise: installing tools from ~/.config/mise/config.toml ($MISE)"
if "$MISE" install --yes; then
    echo "mise: tools up to date."
else
    echo "mise: some tools failed to install (non-fatal); rerun 'mise install'."
fi
{{- if not (or (eq $mp "mac-pro") $intelMac) }}

# No global languages here (Homebrew / the native package manager provide them,
# see dot_config/mise/config.toml.tmpl): drop toolchain versions installed by an
# earlier global config. prune keeps versions still referenced by a project
# mise.toml / .tool-versions that mise tracks.
if "$MISE" prune --yes; then
    echo "mise: pruned toolchain versions no longer referenced by any config."
else
    echo "mise: prune failed (non-fatal)."
fi
{{- end }}
{{- if and (eq .chezmoi.os "darwin") (ne $mp "mac-pro") }}

# Expose the JDKs to /usr/libexec/java_home and GUI apps (needs sudo; the helper
# prints the manual commands instead when it cannot elevate). Skipped on
# mac-pro: non-admin, employer-managed.
if command -v mise-java-macos-link >/dev/null 2>&1; then
    mise-java-macos-link || true
elif [[ -x "$HOME/.local/bin/mise-java-macos-link" ]]; then
    "$HOME/.local/bin/mise-java-macos-link" || true
fi
{{- end }}
exit 0
{{- end }}
