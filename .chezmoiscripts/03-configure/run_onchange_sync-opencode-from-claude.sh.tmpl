{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Keep OpenCode MCP servers aligned with Claude settings
# settings hash: {{ include "dot_claude/settings.json" | sha256sum }}

set -euo pipefail

# Skip if chezmoi persistent state lock is active (another apply in progress)
LOCKS=(
  "{{ .chezmoi.homeDir }}/.local/share/chezmoi/persistent-state.boltdb.lock"
  "{{ .chezmoi.homeDir }}/.config/chezmoi/chezmoistate.boltdb.lock"
)
for lock in "${LOCKS[@]}"; do
  if [[ -e "$lock" ]]; then
    echo "sync-mcp-servers: chezmoi lock present ($lock), skipping" >&2
    exit 0
  fi
done

if command -v sync-mcp-servers &>/dev/null; then
  sync-mcp-servers
else
  # Fallback: run via chezmoi-managed script
  if [[ -x "{{ .chezmoi.homeDir }}/.local/bin/sync-mcp-servers" ]]; then
    "{{ .chezmoi.homeDir }}/.local/bin/sync-mcp-servers"
  else
    echo "sync-mcp-servers not available; skipping MCP sync" >&2
  fi
fi
{{- end -}}
