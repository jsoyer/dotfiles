{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Sync skill symlinks from ~/.skills/ into consumer dirs
# Also sync agent symlinks from ~/.agents/ into ~/.claude/agents/
# Managed by chezmoi — reruns when skill-lock.json changes

# skill-lock hash: {{ include "dot_skills/dot_skill-lock.json" | sha256sum }}

set -euo pipefail

# ── Skills sync ─────────────────────────────────────────
SKILLS_SRC="{{ .chezmoi.homeDir }}/.skills"
SKILL_CONSUMERS=(.claude .qwen .vibe .codex .kimi)
SKILL_REL_PATH="../../.skills"

if [[ -d "$SKILLS_SRC" ]]; then
  for consumer in "${SKILL_CONSUMERS[@]}"; do
    target="{{ .chezmoi.homeDir }}/$consumer/skills"
    mkdir -p "$target"

    # Create symlinks for each skill
    for skill_dir in "$SKILLS_SRC"/*/; do
      [[ -d "$skill_dir" ]] || continue
      name="$(basename "$skill_dir")"
      link="$target/$name"
      if [[ ! -L "$link" ]]; then
        ln -sf "$SKILL_REL_PATH/$name" "$link"
      fi
    done

    # Clean up stale symlinks
    for link in "$target"/*/; do
      [[ -L "${link%/}" ]] || continue
      if [[ ! -e "${link%/}" ]]; then
        rm -f "${link%/}"
      fi
    done
  done

  skill_count="$(find "$SKILLS_SRC" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')"
  echo "skills: synced $skill_count skills to ${SKILL_CONSUMERS[*]}"
else
  echo "skills: $SKILLS_SRC not found, skipping"
fi

# ── Agents sync ─────────────────────────────────────────
AGENTS_SRC="{{ .chezmoi.homeDir }}/.agents"
AGENT_TARGET="{{ .chezmoi.homeDir }}/.claude/agents"

if [[ -d "$AGENTS_SRC" ]]; then
  mkdir -p "$AGENT_TARGET"

  for agent_file in "$AGENTS_SRC"/*.md; do
    [[ -f "$agent_file" ]] || continue
    name="$(basename "$agent_file")"
    link="$AGENT_TARGET/$name"
    if [[ ! -L "$link" ]]; then
      ln -sf "../../.agents/$name" "$link"
    fi
  done

  # Clean stale agent symlinks
  for link in "$AGENT_TARGET"/*.md; do
    [[ -L "$link" ]] || continue
    if [[ ! -e "$link" ]]; then
      rm -f "$link"
    fi
  done

  agent_count="$(find "$AGENTS_SRC" -maxdepth 1 -name '*.md' | wc -l | tr -d ' ')"
  echo "agents: synced $agent_count agents to .claude/agents/"
fi
{{- end -}}
