{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# =============================================================================
# Cleanup stale shell caches when binaries have moved (brew → native)
# Runs on every chezmoi apply — fast (only stat checks, no forks)
# =============================================================================

for cache_dir in "${HOME}/.cache/starship" "${HOME}/.cache/zoxide" "${HOME}/.cache/atuin" "${HOME}/.cache/direnv"; do
    meta="${cache_dir}/meta"
    if [[ -f "$meta" ]]; then
        cached_path="$(<"$meta")"
        if [[ -n "$cached_path" ]] && [[ ! -x "$cached_path" ]]; then
            rm -rf "$cache_dir"
        fi
    else
        # No meta file — check cache content for dead paths (e.g., /opt/homebrew on Linux)
        for init_file in "$cache_dir"/init.*; do
            [[ -f "$init_file" ]] || continue
            if grep -q '/opt/homebrew/' "$init_file" 2>/dev/null && [[ ! -d "/opt/homebrew" ]]; then
                rm -rf "$cache_dir"
                break
            fi
            if grep -q '/home/linuxbrew/' "$init_file" 2>/dev/null && [[ ! -d "/home/linuxbrew" ]]; then
                rm -rf "$cache_dir"
                break
            fi
        done
    fi
done

# Also check bash caches
for meta_file in "${HOME}/.cache/shell"/*.meta; do
    [[ -f "$meta_file" ]] || continue
    cached_path="$(<"$meta_file")"
    if [[ -n "$cached_path" ]] && [[ ! -x "$cached_path" ]]; then
        base="${meta_file%.meta}"
        rm -f "$meta_file" "${base}.bash" "${base}.zsh"
    fi
done
{{- end }}
