{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Installe /etc/sudoers.d/sysup pour que `sysup` tourne sans mot de passe.
#
# Pourquoi un script et pas un fichier gere directement : chezmoi gere $HOME,
# pas /etc. Le contenu est donc rendu ici puis pose avec sudo.
#
# Linux uniquement : sur macOS `sysup` passe par brew, qui ne demande pas sudo.
#
# run_always_ et pas run_onchange_ : si sudo demande un mot de passe, le script
# sort proprement sans installer. Un run_onchange_ enregistrerait alors son hash
# comme "execute" et ne retenterait JAMAIS. Ici il retente a chaque apply, et le
# cmp ci-dessous le rend no-op des que la regle est en place.

set -euo pipefail

TARGET="/etc/sudoers.d/sysup"
RULE_USER="{{ .chezmoi.username }}"

TMP="$(mktemp)"
cleanup() { [ -n "${TMP:-}" ] && [ -f "$TMP" ] && command rm -f -- "$TMP"; }
trap cleanup EXIT

cat > "$TMP" <<EOF
# Genere par chezmoi
# (.chezmoiscripts/03-configure/run_onchange_install-sudoers-sysup.sh.tmpl)
# NE PAS EDITER A LA MAIN : toute modification sera ecrasee au prochain apply.
#
# Permet a \`sysup\` de tourner sans surveillance. Portee volontairement etroite :
# uniquement les commandes de mise a jour lancees par sysup, arguments compris.
# \`dnf install <n_importe_quoi>\` continue de demander le mot de passe.
#
# Reste proche d'un acces root : les scriptlets des paquets s'executent en root,
# donc un depot ou un paquet compromis passe root sans mot de passe.
# L'enumeration exacte bloque l'installation arbitraire, pas une mise a jour
# malveillante.
Defaults:${RULE_USER} !requiretty

# Fedora
${RULE_USER} ALL=(root) NOPASSWD: /usr/bin/dnf upgrade --refresh -y

# Debian / Ubuntu / Raspberry Pi
${RULE_USER} ALL=(root) NOPASSWD: /usr/bin/apt-get update
${RULE_USER} ALL=(root) NOPASSWD: /usr/bin/apt-get dist-upgrade -y
${RULE_USER} ALL=(root) NOPASSWD: /usr/bin/apt-get autoremove -y

# Arch
${RULE_USER} ALL=(root) NOPASSWD: /usr/bin/pacman -Syu --noconfirm
EOF

# visudo vit dans /usr/sbin, absent du PATH de beaucoup d'environnements non
# interactifs (dont celui dans lequel chezmoi execute ce script). On le resout
# explicitement plutot que de dependre du PATH.
VISUDO=""
for _candidate in "$(command -v visudo 2>/dev/null || true)" /usr/sbin/visudo /usr/bin/visudo; do
    if [ -n "$_candidate" ] && [ -x "$_candidate" ]; then
        VISUDO="$_candidate"
        break
    fi
done

# Outil de validation absent : on ne pose RIEN (un sudoers invalide casse sudo
# entierement), mais on ne fait pas echouer l'apply pour autant — sinon
# chezmoi-autoupdate remonterait une erreur toutes les heures.
if [ -z "$VISUDO" ]; then
    echo "sudoers-sysup: visudo introuvable, impossible de valider la regle — installation ignoree." >&2
    exit 0
fi

# Un sudoers invalide peut casser sudo entierement : on valide AVANT de poser.
# Ici l'echec est un VRAI probleme (regle malformee), on le remonte bruyamment.
if ! "$VISUDO" -c -f "$TMP" >/dev/null 2>&1; then
    echo "sudoers-sysup: regle invalide, installation annulee" >&2
    "$VISUDO" -c -f "$TMP" >&2 || true
    exit 1
fi

# Ordre important : on teste d'ABORD si sudo est utilisable sans prompt.
# Toute commande sudo -n qui echoue laisse une entree "a password is required"
# dans le journal ; comme ce script tourne a chaque apply (donc toutes les
# heures via chezmoi-autoupdate), commencer par le `cmp` polluait le journal
# systeme d'un echec d'authentification par heure.
if ! sudo -n true 2>/dev/null; then
    echo "sudoers-sysup: sudo demande un mot de passe, installation reportee."
    echo "  Lancer une fois a la main :  sudo -v && chezmoi apply"
    exit 0
fi

# Deja identique ? on ne touche a rien.
if sudo -n cmp -s "$TMP" "$TARGET" 2>/dev/null; then
    echo "sudoers-sysup: deja a jour"
    exit 0
fi

sudo install -m 0440 -o root -g root "$TMP" "$TARGET"
echo "sudoers-sysup: installe dans ${TARGET} pour ${RULE_USER}"
{{- end }}
