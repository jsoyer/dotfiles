{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# aictx cache is deployed directly by chezmoi to ~/.aictx/
# Symlinks wired automatically via aictx apply

set -euo pipefail

CACHE_ROOT="{{ .chezmoi.homeDir }}/.aictx"

# Copy settings.json to cache if it exists
if [[ -f "{{ .chezmoi.homeDir }}/.claude/settings.json" ]]; then
  cp "{{ .chezmoi.homeDir }}/.claude/settings.json" "${CACHE_ROOT}/settings.json"
fi

# Wire symlinks from ~/.aictx/ into CLI directories
if command -v aictx >/dev/null 2>&1; then
  aictx apply --yes --scope global 2>/dev/null && echo "aictx: symlinks wired" || true
else
  echo "aictx: not installed — run 'cargo install --path tools/claude-context' then 'aictx apply'"
fi
{{- end -}}
