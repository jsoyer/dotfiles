{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# aictx cache is deployed directly by chezmoi to ~/.aictx/
# Symlinks are managed by `aictx enable/disable/apply`

set -euo pipefail

CACHE_ROOT="{{ .chezmoi.homeDir }}/.aictx"

# Copy settings.json to cache if it exists
if [[ -f "{{ .chezmoi.homeDir }}/.claude/settings.json" ]]; then
  cp "{{ .chezmoi.homeDir }}/.claude/settings.json" "${CACHE_ROOT}/settings.json"
fi

echo "aictx: cache ready (use 'aictx apply' or 'aictx enable' to wire symlinks)"
{{- end -}}
