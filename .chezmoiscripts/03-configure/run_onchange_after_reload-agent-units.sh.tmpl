{{- $mp := index . "machine_profile" -}}
{{- $skip := list "windows" "toolbox" -}}
{{- if and (eq .chezmoi.os "linux") (not (has $mp $skip)) -}}
#!/usr/bin/env bash
# =============================================================================
# Reload systemd --user when an agent unit changes
# =============================================================================
# THIS SCRIPT NEVER ENABLES OR STARTS ANYTHING.
#
# herdr's *binary* is installed automatically (run_once_after_14-install-herdr).
# Moshi / orca / cursor stay MANUAL (moshi-install / orca-install /
# cursor-install). This script only runs `daemon-reload` — without it, a unit
# modified by `chezmoi apply` stays silently inactive until the next reboot
# while the old version keeps running.
#
# The `after_` prefix is REQUIRED: a bare `run_onchange_` can fire BEFORE
# chezmoi has written the units, in which case the daemon-reload applies to the
# old content — a silent no-op. Observed for real on herdr-update.service, which
# still resolved to update-herdr.sh after a full apply.
#
# Reruns whenever one of the units changes:
# moshi-hook:    {{ include "dot_config/systemd/user/moshi-hook.service" | sha256sum }}
# moshi-update:  {{ include "dot_config/systemd/user/moshi-update.service" | sha256sum }}
# moshi-timer:   {{ include "dot_config/systemd/user/moshi-update.timer" | sha256sum }}
# cursor-worker: {{ include "dot_config/systemd/user/cursor-worker.service.tmpl" | sha256sum }}
# cursor-update: {{ include "dot_config/systemd/user/cursor-update.service" | sha256sum }}
# cursor-timer:  {{ include "dot_config/systemd/user/cursor-update.timer" | sha256sum }}
# herdr-update:  {{ include "dot_config/systemd/user/herdr-update.service" | sha256sum }}
# herdr-timer:   {{ include "dot_config/systemd/user/herdr-update.timer" | sha256sum }}

set -uo pipefail

command -v systemctl >/dev/null 2>&1 || exit 0
systemctl --user show-environment >/dev/null 2>&1 || exit 0

systemctl --user daemon-reload || exit 0
echo "systemd --user reloaded (agent units changed)."

# Targeted reminder, only for services the user has actually enabled.
for unit in moshi-hook.service cursor-worker.service; do
    if systemctl --user is-enabled --quiet "${unit}" 2>/dev/null; then
        echo "  ${unit} is enabled: apply the new unit with 'agentsvc restart ${unit%%-*}'"
    fi
done
{{- end }}
