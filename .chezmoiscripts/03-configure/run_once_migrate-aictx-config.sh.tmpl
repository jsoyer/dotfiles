{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Migrate legacy config dirs to ~/.config/aictx/
# run_once: only runs once per machine

set -euo pipefail

TARGET_DIR="{{ .chezmoi.homeDir }}/.config/aictx"

# Migration step 1: claude-context → ai-context (old migration, kept for machines that skipped it)
OLD_CLAUDE_CTX="{{ .chezmoi.homeDir }}/.config/claude-context"
OLD_AI_CTX="{{ .chezmoi.homeDir }}/.config/ai-context"

if [[ -d "$OLD_CLAUDE_CTX" && ! -d "$OLD_AI_CTX" && ! -d "$TARGET_DIR" ]]; then
  mv "$OLD_CLAUDE_CTX" "$TARGET_DIR"
  echo "aictx: migrated config dir from claude-context to aictx"
elif [[ -d "$OLD_CLAUDE_CTX" && ! -d "$TARGET_DIR" ]]; then
  mv "$OLD_CLAUDE_CTX" "$TARGET_DIR"
  echo "aictx: migrated config dir from claude-context to aictx"
fi

# Migration step 2: ai-context → aictx
if [[ -d "$OLD_AI_CTX" && ! -d "$TARGET_DIR" ]]; then
  mv "$OLD_AI_CTX" "$TARGET_DIR"
  echo "aictx: migrated config dir from ai-context to aictx"
fi

# Clean up old binary name
OLD_BIN="{{ .chezmoi.homeDir }}/.local/bin/claude-context"
if [[ -f "$OLD_BIN" ]]; then
  rm -f "$OLD_BIN"
  echo "aictx: removed old binary claude-context"
fi

# Clean up old completions
for f in \
  "{{ .chezmoi.homeDir }}/.zsh/completions/_cctx" \
  "{{ .chezmoi.homeDir }}/.local/share/bash-completion/completions/cctx" \
  "{{ .chezmoi.homeDir }}/.config/fish/completions/cctx.fish"; do
  if [[ -f "$f" ]]; then
    rm -f "$f"
    echo "aictx: removed old completion $f"
  fi
done
{{- end -}}
