{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
# Mail setup — create Maildir structure and initialize notmuch
# Managed by chezmoi — reruns automatically when mail configs change

# Config hashes (trigger rerun on changes):
# mbsync:   {{ include "dot_config/isync/private_mbsyncrc.tmpl" | sha256sum }}
# notmuch:  {{ include "dot_notmuch-config.tmpl" | sha256sum }}

set -euo pipefail

MAIL_DIR="{{ .xdgDataDir }}/mail"
MSMTP_STATE="{{ .xdgStateDir }}/msmtp"

echo "📬 Setting up mail directories..."
mkdir -p "$MAIL_DIR/gmail"
mkdir -p "$MSMTP_STATE"
echo "   ✓ $MAIL_DIR/gmail"
echo "   ✓ $MSMTP_STATE"

if command -v notmuch &>/dev/null; then
  echo "🔍 Initializing notmuch database..."
  notmuch new --quiet || true
  echo "   ✓ notmuch database ready"
else
  echo "   ⚠ notmuch not found, skipping (run brew bundle first)"
fi

echo "✅ Mail setup complete"
echo "   Next steps:"
echo "   1. Run: mbsync -a   (first IMAP sync)"
echo "   2. Run: notmuch new (index emails)"
echo "   3. Run: neomutt     (open mail client)"
{{- end -}}
