{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Build ai-context (aictx) from source if cargo is available
# Managed by chezmoi — reruns when source files change

# source hash: {{ glob "tools/claude-context/src/**/*.rs" | join "\n" | sha256sum }}

set -euo pipefail

TOOL_DIR="{{ .chezmoi.sourceDir }}/tools/claude-context"
BIN_DIR="{{ .chezmoi.homeDir }}/.local/bin"
BIN_NAME="ai-context"

# Skip if cargo not available
if ! command -v cargo &>/dev/null; then
  echo "aictx: cargo not found, skipping build (install Rust to enable)"
  exit 0
fi

# Skip if source directory doesn't exist
if [[ ! -d "$TOOL_DIR" ]]; then
  echo "aictx: source not found at $TOOL_DIR, skipping"
  exit 0
fi

echo "aictx: building ai-context..."

cd "$TOOL_DIR"
if cargo build --release --quiet 2>/dev/null; then
  mkdir -p "$BIN_DIR"
  cp "target/release/$BIN_NAME" "$BIN_DIR/$BIN_NAME"
  chmod +x "$BIN_DIR/$BIN_NAME"
  echo "aictx: installed to $BIN_DIR/$BIN_NAME ($(du -h "$BIN_DIR/$BIN_NAME" | cut -f1))"

  # Install shell completions
  if command -v zsh &>/dev/null; then
    "$BIN_DIR/$BIN_NAME" completions zsh --install 2>&1
  fi
  if command -v bash &>/dev/null; then
    "$BIN_DIR/$BIN_NAME" completions bash --install 2>&1
  fi
  if command -v fish &>/dev/null; then
    "$BIN_DIR/$BIN_NAME" completions fish --install 2>&1
  fi
else
  echo "aictx: build failed (non-fatal, skipping)"
fi
{{- end -}}
