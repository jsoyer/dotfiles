{{- $mp := index . "machine_profile" -}}
{{- $skip := list "mac-pro" "windows" "toolbox" -}}
{{- if not (has $mp $skip) -}}
#!/usr/bin/env bash
# =============================================================================
# Enable chezmoi-autoupdate timer/agent
# Reruns when timer/service/plist files change
# =============================================================================
# service hash: {{ include "dot_config/systemd/user/chezmoi-autoupdate.service" | sha256sum }}
# timer hash:   {{ include "dot_config/systemd/user/chezmoi-autoupdate.timer" | sha256sum }}

set -uo pipefail

{{- if eq .chezmoi.os "linux" }}
# Linux: enable systemd user timer
# Wait for chezmoi to finish deploying the files (run_onchange can fire mid-apply)
_timer_file="${HOME}/.config/systemd/user/chezmoi-autoupdate.timer"
_retries=0
while [[ ! -f "${_timer_file}" ]] && (( _retries < 10 )); do
    sleep 1
    _retries=$(( _retries + 1 ))
done

if command -v systemctl >/dev/null 2>&1 && [[ -f "${_timer_file}" ]]; then
    echo "Enabling chezmoi-autoupdate systemd timer..."
    systemctl --user daemon-reload
    systemctl --user enable --now chezmoi-autoupdate.timer
    echo "chezmoi-autoupdate timer enabled"
else
    echo "systemctl or timer file not available, skipping timer setup"
fi
{{- else if eq .chezmoi.os "darwin" }}
# macOS mac-personal: load launchd agent
_plist="${HOME}/Library/LaunchAgents/com.jsoyer.chezmoi-autoupdate.plist"
if [[ -f "${_plist}" ]]; then
    echo "Loading chezmoi-autoupdate launchd agent..."
    launchctl unload "${_plist}" 2>/dev/null || true
    launchctl load "${_plist}"
    echo "chezmoi-autoupdate launchd agent loaded"
else
    echo "LaunchAgent plist not found at ${_plist}, skipping"
fi
{{- end }}
{{- end }}
