{{- if and (ne .chezmoi.os "windows") (lookPath "gpg") (lookPath "op") -}}
#!/bin/bash
# =============================================================================
# GPG Key Import from 1Password
# =============================================================================

set -eo pipefail

GPG_KEY_ID="027B16CE3562EF9E"
OP_PRIVATE_DOC="7rd7xxbwdyghdigju4odgvgxou"
OP_PUBLIC_DOC="mjm4qfoafklqc65zqwfhkppzqq"

# Check if key is already imported
if gpg --list-secret-keys "$GPG_KEY_ID" &>/dev/null; then
  echo "🔑 GPG key $GPG_KEY_ID already imported, skipping"
  exit 0
fi

echo "🔑 Importing GPG key from 1Password..."

# Import public key
if op document get "$OP_PUBLIC_DOC" 2>/dev/null | gpg --import 2>/dev/null; then
  echo "🔑 Public key imported"
else
  echo "⚠️  Failed to import public key (doc: $OP_PUBLIC_DOC) — check UUID in 1Password"
fi

# Import private key (optional — not all machines need signing capability)
if op_output=$(op document get "$OP_PRIVATE_DOC" 2>&1); then
  echo "$op_output" | gpg --import && echo "🔑 Private key imported" \
    || echo "⚠️  Failed to import private key into GPG"
else
  echo "⚠️  Private key document not found in 1Password (doc: $OP_PRIVATE_DOC)"
  echo "    To fix: update OP_PRIVATE_DOC in run_once_configure-gpg.sh.tmpl"
  echo "    Run: op document list | grep -i gpg"
fi

# Set trust to ultimate only if public key was imported
if gpg --list-keys "$GPG_KEY_ID" &>/dev/null; then
  FINGERPRINT=$(gpg --fingerprint --with-colons "$GPG_KEY_ID" 2>/dev/null | awk -F: '/^fpr/{print $10; exit}')
  if [[ -n "$FINGERPRINT" ]]; then
    echo "${FINGERPRINT}:6:" | gpg --import-ownertrust
    echo "✅ GPG key $GPG_KEY_ID imported and trusted"
  else
    echo "⚠️  Could not retrieve fingerprint for GPG key $GPG_KEY_ID"
  fi
else
  echo "⚠️  GPG key $GPG_KEY_ID not found after import attempts"
fi
{{- end }}
