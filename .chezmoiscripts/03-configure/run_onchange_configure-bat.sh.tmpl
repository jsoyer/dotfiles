{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# =============================================================================
# Rebuild bat theme cache when themes change
# =============================================================================
# themes hash: {{ include "dot_config/bat/themes/Catppuccin Mocha.tmTheme" | sha256sum }}

set -euo pipefail

if command -v bat &>/dev/null; then
    echo "🦇 Rebuilding bat theme cache..."
    bat cache --build 2>/dev/null || true
fi
{{- end }}
