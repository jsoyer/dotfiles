{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Update Homebrew packages
# filter: {{ include "dot_local/bin/executable_brewfile-filter-bottled" | sha256sum }}
# wrapper: {{ include "dot_local/bin/executable_breww" | sha256sum }}
# untap:   {{ include "dot_local/bin/executable_brew-untap-blacklisted" | sha256sum }}
# blacklist: {{ include "dot_private/Brewfile_blacklist" | sha256sum }}

set -euo pipefail

if [[ "${CHEZMOI_AUTOUPDATE:-0}" == "1" && "${CHEZMOI_AUTOUPDATE_UPGRADES:-0}" != "1" ]]; then
    echo "Skipping Homebrew upgrades during unattended chezmoi autoupdate. Set CHEZMOI_AUTOUPDATE_UPGRADES=1 to opt in."
    exit 0
fi

eval "$(brew shellenv)"
export MACHINE_PROFILE="{{ index . "machine_profile" }}"
upgrade_rc=0

# Drop blacklisted taps before brew update. Homebrew 6 aborts the whole
# update when a leftover tap still has disabled cask DSL (sidneys/homebrew).
UNTAP_PY="{{ .chezmoi.sourceDir }}/dot_local/bin/executable_brew-untap-blacklisted"
BLACKLIST="{{ .chezmoi.sourceDir }}/dot_private/Brewfile_blacklist"
if [[ -f "$UNTAP_PY" ]] && command -v python3 >/dev/null; then
    python3 "$UNTAP_PY" --blacklist "$BLACKLIST" || upgrade_rc=1
fi

echo "Upgrading packages..."
# Share bup's policy: bottles first, then source builds for every remaining
# formula, and a final outdated check (pins/failed upgrades cannot look current).
BREWW="{{ .chezmoi.sourceDir }}/dot_local/bin/executable_breww"
python3 "$BREWW" upgrade --formula || upgrade_rc=1
{{- if eq (index . "machine_profile") "mac-pro" }}
python3 "$BREWW" upgrade --cask || upgrade_rc=1
{{- else }}
python3 "$BREWW" upgrade --greedy --cask || upgrade_rc=1
{{- end }}

echo "Cleaning up old versions..."
brew cleanup || upgrade_rc=1

if command -v npm &>/dev/null; then
    echo "📦 Updating global npm packages..."
    # `npm update -g` is a no-op for 0.x packages (caret pins the minor), so
    # reinstall each global at @latest instead — that is how codex fell behind.
    if _npm_list="$(npm ls -g --depth=0)"; then
        while read -r _pkg; do
            [[ -n "$_pkg" ]] || continue
            echo "  ⬆️  $_pkg"
            if ! npm install -g "${_pkg}@latest"; then
                echo "  ⚠️  failed: $_pkg" >&2
                upgrade_rc=1
            fi
        done < <(printf '%s\n' "$_npm_list" | tail -n +2 | sed -E 's/^[^a-zA-Z@]*//; s/@[0-9][^@]*$//')
    else
        echo "⚠️  Cannot list global npm packages; update incomplete." >&2
        upgrade_rc=1
    fi
fi

if [[ "$upgrade_rc" != 0 ]]; then
    echo "⚠️  Updates incomplete. See the failed or deferred packages above." >&2
    exit "$upgrade_rc"
fi
echo "Upgrade complete!"
{{- end -}}
