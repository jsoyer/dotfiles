{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Update Homebrew packages

set -euo pipefail
eval "$(brew shellenv)"

echo "🍺 Updating Homebrew packages..."
if [[ "$MACHINE_PROFILE" == "mac-pro" ]]; then
    brew upgrade
else
    brew upgrade --greedy
fi

echo "🧹 Cleaning up old versions..."
brew cleanup

echo "🔄 Updating Homebrew itself..."
brew update

echo "✅ Upgrade complete!"
{{- end -}}
