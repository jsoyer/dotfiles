{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Update Homebrew packages

set -euo pipefail
eval "$(brew shellenv)"

echo "Updating Homebrew packages..."
{{- if eq .chezmoi.hostname "jsoyer-macOS" }}
brew upgrade
{{- else }}
brew upgrade --greedy
{{- end }}

echo "Cleaning up old versions..."
brew cleanup

echo "Updating Homebrew itself..."
brew update

echo "Upgrade complete!"
{{- end -}}
