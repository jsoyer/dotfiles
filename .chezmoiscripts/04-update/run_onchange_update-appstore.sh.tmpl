{{- if and (eq .chezmoi.os "darwin") (ne (index . "machine_profile") "mac-pro") -}}
#!/usr/bin/env bash
# Update macOS App Store apps via mas-cli

set -euo pipefail

if [[ "${CHEZMOI_AUTOUPDATE:-0}" == "1" && "${CHEZMOI_AUTOUPDATE_UPGRADES:-0}" != "1" ]]; then
    echo "Skipping App Store upgrades during unattended chezmoi autoupdate. Set CHEZMOI_AUTOUPDATE_UPGRADES=1 to opt in."
    exit 0
fi

echo "📱 Updating macOS App Store apps..."

if command -v mas &> /dev/null; then
    mas outdated
    mas upgrade
else
    echo "⚠️  mas-cli not installed (run: brew install mas)"
fi

echo "✅ App Store update complete!"
{{- end -}}
