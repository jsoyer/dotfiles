{{- if and (eq .chezmoi.os "darwin") (ne .chezmoi.hostname "jsoyer-macOS") -}}
#!/usr/bin/env bash
# Update macOS App Store apps via mas-cli

set -euo pipefail

echo "📱 Updating macOS App Store apps..."

if command -v mas &> /dev/null; then
    mas outdated
    mas upgrade
else
    echo "⚠️  mas-cli not installed (run: brew install mas)"
fi

echo "✅ App Store update complete!"
{{- end -}}
