{{- if eq .chezmoi.os "linux" -}}
{{- $mp             := index . "machine_profile" -}}
{{- $isRPi          := eq $mp "rpi" -}}
{{- $isUbuntu       := or (eq $mp "ubuntu-server") (eq $mp "ubuntu-desktop") -}}
{{- $isFedoraAtomic := eq $mp "fedora-atomic" -}}
{{- $isFedora       := or (eq $mp "fedora-desktop") (eq $mp "fedora-server") -}}
{{- $isArch         := or (eq $mp "arch-desktop") (eq $mp "arch-server") -}}
{{- $isArchDesktop  := eq $mp "arch-desktop" -}}
#!/usr/bin/env bash
# Update Linux packages

set -euo pipefail

{{- if $isRPi }}
echo "Updating Raspberry Pi packages..."
sudo apt update
sudo apt dist-upgrade -y
sudo apt autoremove -y

if command -v uv &>/dev/null; then
    echo "Updating uv..."
    uv self update
fi
{{- end }}

{{- if $isUbuntu }}
echo "Updating Ubuntu packages..."
sudo apt update
sudo apt dist-upgrade -y
sudo apt autoremove -y

if command -v uv &>/dev/null; then
    echo "Updating uv..."
    uv self update
fi
{{- end }}

{{- if $isFedora }}
echo "Updating Fedora packages..."
sudo dnf upgrade -y
{{- end }}

{{- if $isArch }}
echo "Updating Arch Linux packages..."
sudo pacman -Syu --noconfirm

if [[ "${MACHINE_PROFILE:-}" == "arch-desktop" ]] && command -v yay &>/dev/null; then
    echo "Updating AUR packages..."
    yay -Sua --noconfirm
fi

if command -v uv &>/dev/null; then
    echo "Updating uv..."
    uv self update
fi
{{- end }}
{{- if $isFedoraAtomic }}
echo "Updating Fedora Atomic (rpm-ostree)..."
sudo rpm-ostree upgrade
{{- end }}

# =============================================================================
# CLI AI Tools updates (all profiles except toolbox and fedora-atomic)
# =============================================================================
{{- if not (or (eq $mp "toolbox") $isFedoraAtomic) }}

if command -v claude &>/dev/null; then
    echo "🤖 Updating Claude Code..."
    claude update 2>/dev/null || true
fi

if command -v copilot-cli &>/dev/null; then
    echo "🤖 Updating Copilot CLI..."
    curl -fsSL https://gh.io/copilot-install | bash 2>/dev/null || true
fi

if command -v codex &>/dev/null && command -v npm &>/dev/null; then
    echo "🤖 Updating Codex CLI..."
    npm update -g @openai/codex 2>/dev/null || true
fi
{{- end }}

echo "Upgrade complete!"
{{- end -}}
