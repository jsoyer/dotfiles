{{- if eq .chezmoi.os "linux" -}}
{{- $mp             := index . "machine_profile" -}}
{{- $isRPi          := eq $mp "rpi" -}}
{{- $isUbuntu       := or (eq $mp "ubuntu-server") (eq $mp "ubuntu-desktop") -}}
{{- $isFedoraAtomic := eq $mp "fedora-atomic" -}}
{{- $isFedora       := or (eq $mp "fedora-desktop") (eq $mp "fedora-server") -}}
{{- $isArch         := or (eq $mp "arch-desktop") (eq $mp "arch-server") -}}
{{- $isArchDesktop  := eq $mp "arch-desktop" -}}
#!/usr/bin/env bash
# Update Linux packages

set -euo pipefail

if [[ "${CHEZMOI_AUTOUPDATE:-0}" == "1" && "${CHEZMOI_AUTOUPDATE_UPGRADES:-0}" != "1" ]]; then
    echo "Skipping Linux package upgrades during unattended chezmoi autoupdate. Set CHEZMOI_AUTOUPDATE_UPGRADES=1 to opt in."
    exit 0
fi

{{- if $isRPi }}
echo "Updating Raspberry Pi packages..."
sudo apt update
sudo apt dist-upgrade -y
sudo apt autoremove -y

if command -v uv &>/dev/null; then
    echo "Updating uv..."
    uv self update
fi
{{- end }}

{{- if $isUbuntu }}
echo "Updating Ubuntu packages..."
sudo apt update
sudo apt dist-upgrade -y
sudo apt autoremove -y

if command -v uv &>/dev/null; then
    echo "Updating uv..."
    uv self update
fi
{{- end }}

{{- if $isFedora }}
echo "Updating Fedora packages..."
sudo dnf upgrade -y
{{- end }}

{{- if $isArch }}
echo "Updating Arch Linux packages..."
sudo pacman -Syu --noconfirm

if [[ "${MACHINE_PROFILE:-}" == "arch-desktop" ]] && command -v yay &>/dev/null; then
    echo "Updating AUR packages..."
    yay -Sua --noconfirm
fi

if command -v uv &>/dev/null; then
    echo "Updating uv..."
    uv self update
fi
{{- end }}
{{- if $isFedoraAtomic }}
echo "Updating Fedora Atomic (rpm-ostree)..."
sudo rpm-ostree upgrade
{{- end }}

# =============================================================================
# CLI AI Tools updates (all profiles except toolbox and fedora-atomic)
# =============================================================================
{{- if not (or (eq $mp "toolbox") $isFedoraAtomic) }}

if command -v claude &>/dev/null; then
    echo "🤖 Updating Claude Code..."
    claude update 2>/dev/null || true
fi

if command -v copilot-cli &>/dev/null; then
    echo "🤖 Updating Copilot CLI..."
    curl -fsSL https://gh.io/copilot-install | bash 2>/dev/null || true
fi

# Antigravity CLI (agy): official installer on Linux, updated by `agy update`.
# The installer exits early when agy exists, so it only runs when missing.
# A Linuxbrew cask copy (antigravity-cli) is migrated to the official
# install: it shadows ~/.local/bin/agy and `agy update` would rewrite a binary
# brew owns. Inline (not install-ai): this script runs before chezmoi deploys
# ~/.local/bin, so install-ai may not exist yet on a fresh machine.
_agy_migrate_linuxbrew() {
    local bp tgt
    command -v agy &>/dev/null && command -v brew &>/dev/null || return 0
    bp="$(brew --prefix 2>/dev/null)" || return 0
    tgt="$(readlink -f "$(command -v agy)" 2>/dev/null)" || return 0
    [[ -n "$bp" && "$tgt" == "$bp"/* ]] || return 0
    echo "🤖 Antigravity CLI: Linuxbrew copy found — migrating to the official installer..."
    brew uninstall --cask --force antigravity-cli >/dev/null 2>&1 || true
    rm -f "$bp/bin/agy"
    hash -r
}
_agy_migrate_linuxbrew
if command -v agy &>/dev/null; then
    echo "🤖 Updating Antigravity CLI..."
    agy update 2>/dev/null || true
else
    echo "🤖 Installing Antigravity CLI..."
    curl -fsSL https://antigravity.google/cli/install.sh | bash 2>/dev/null || echo "  ⚠️  failed: antigravity-cli"
fi

if command -v npm &>/dev/null; then
    echo "📦 Updating global npm packages..."
    # `npm update -g` is a no-op for 0.x packages (caret pins the minor), so
    # reinstall each global at @latest instead — that is how codex fell behind.
    while read -r _pkg; do
        [[ -n "$_pkg" ]] || continue
        echo "  ⬆️  $_pkg"
        npm install -g "${_pkg}@latest" >/dev/null 2>&1 || echo "  ⚠️  failed: $_pkg"
    done < <(npm ls -g --depth=0 2>/dev/null | tail -n +2 | sed -E 's/^[^a-zA-Z@]*//; s/@[0-9][^@]*$//')
fi
{{- end }}

echo "Upgrade complete!"
{{- end -}}
