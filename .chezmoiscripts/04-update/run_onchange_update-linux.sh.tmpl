{{- if eq .chezmoi.os "linux" -}}
{{- $isRPi    := or (eq .chezmoi.osRelease.id "raspbian") (stat "/proc/device-tree/model") -}}
{{- $isUbuntu := and (eq .chezmoi.osRelease.id "ubuntu") (not $isRPi) -}}
{{- $isFedoraAtomic  := and (eq .chezmoi.os "linux") (lookPath "rpm-ostree") (not (stat "/.toolboxenv")) (not (env "TOOLBOX_PATH")) -}}
{{- $fedoraFlavor    := (index . "fedora_flavor") | default "desktop" -}}
{{- $isFedora        := and (eq .chezmoi.os "linux") (lookPath "dnf") (not (lookPath "rpm-ostree")) (not (stat "/.toolboxenv")) (not (env "TOOLBOX_PATH")) -}}
{{- $isFedoraDesktop := and $isFedora (eq $fedoraFlavor "desktop") -}}
{{- $isFedoraServer  := and $isFedora (eq $fedoraFlavor "server") -}}
#!/usr/bin/env bash
# Update Linux packages

set -euo pipefail

{{- if $isRPi }}
echo "Updating Raspberry Pi packages..."
sudo apt update
sudo apt dist-upgrade -y
sudo apt autoremove -y

if command -v uv &>/dev/null; then
    echo "Updating uv..."
    uv self update
fi
{{- end }}

{{- if $isUbuntu }}
echo "Updating Ubuntu packages..."
sudo apt update
sudo apt dist-upgrade -y
sudo apt autoremove -y

if command -v uv &>/dev/null; then
    echo "Updating uv..."
    uv self update
fi
{{- end }}

{{- if and (lookPath "dnf") (not (lookPath "rpm-ostree")) (not (stat "/.toolboxenv")) }}
echo "Updating Fedora packages..."
sudo dnf upgrade -y
{{- end }}

{{- if lookPath "rpm-ostree" }}
echo "Updating Fedora Atomic (rpm-ostree)..."
sudo rpm-ostree upgrade
{{- end }}

echo "Upgrade complete!"
{{- end -}}
