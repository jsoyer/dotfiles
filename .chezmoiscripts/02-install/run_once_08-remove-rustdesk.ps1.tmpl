{{- if eq .chezmoi.os "windows" -}}
# One-time cleanup: remove RustDesk from Windows machines.
# No-ops when RustDesk is not installed.

#Requires -Version 5.1
$ErrorActionPreference = 'Continue'

function Test-RustDeskInstalled {
    if (Get-Process -Name rustdesk -ErrorAction SilentlyContinue) { return $true }
    if (Get-Service -Name RustDesk -ErrorAction SilentlyContinue) { return $true }
    if (Get-Command rustdesk -ErrorAction SilentlyContinue) { return $true }
    $paths = @(
        "${env:ProgramFiles}\RustDesk\rustdesk.exe",
        "${env:ProgramFiles(x86)}\RustDesk\rustdesk.exe",
        "${env:LOCALAPPDATA}\RustDesk\rustdesk.exe"
    )
    foreach ($p in $paths) {
        if (Test-Path -LiteralPath $p) { return $true }
    }
    if (Get-Command scoop -ErrorAction SilentlyContinue) {
        $scoopList = scoop list rustdesk 2>$null
        if ($scoopList) { return $true }
    }
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        $winget = winget list --id RustDesk.RustDesk --disable-interactivity 2>$null
        if ($winget -match 'RustDesk') { return $true }
    }
    return $false
}

if (-not (Test-RustDeskInstalled)) {
    Write-Host "ℹ️  RustDesk not installed, skipping."
    exit 0
}

Write-Host "🧹 Removing RustDesk..." -ForegroundColor Cyan

Stop-Process -Name rustdesk -Force -ErrorAction SilentlyContinue

if (Get-Command scoop -ErrorAction SilentlyContinue) {
    scoop uninstall rustdesk 2>$null
}
if (Get-Command winget -ErrorAction SilentlyContinue) {
    winget uninstall --id RustDesk.RustDesk --silent --disable-interactivity 2>$null
}
if (Get-Command choco -ErrorAction SilentlyContinue) {
    choco uninstall rustdesk -y 2>$null
}

if (Get-Service -Name RustDesk -ErrorAction SilentlyContinue) {
    Stop-Service -Name RustDesk -Force -ErrorAction SilentlyContinue
    sc.exe delete RustDesk | Out-Null
}

Write-Host "✅ RustDesk cleanup done." -ForegroundColor Green
{{ end -}}
