{{- $mp := index . "machine_profile" -}}
{{- $ocxProfiles := list "mac-personal" "fedora-desktop" "toolbox" "ubuntu-desktop" "arch-desktop" -}}
{{- if has $mp $ocxProfiles -}}
#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# OpenCode Tools Installation
# Profiles: {{ join ", " $ocxProfiles }}
# =============================================================================

# ocx — OpenCode extension manager
if ! command -v ocx &>/dev/null; then
    echo "Installing ocx..."
    curl -fsSL https://ocx.kdco.dev/install.sh | sh
    # Ensure ~/.local/bin is in PATH for the rest of this script
    export PATH="${HOME}/.local/bin:${PATH}"
else
    echo "ocx already installed"
fi

# npm-based tools — require npm
if command -v npm &>/dev/null; then
    # Ensure npm global installs go to user directory (avoids EACCES on Fedora/Linux)
    if [[ -z "$(npm config get prefix 2>/dev/null | grep -v '/usr')" ]]; then
        mkdir -p "${HOME}/.npm-global"
        npm config set prefix "${HOME}/.npm-global"
        export PATH="${HOME}/.npm-global/bin:${PATH}"
    fi
    # oh-my-openagent — Agent harness plugin for OpenCode
    if ! npm list -g oh-my-openagent &>/dev/null; then
        echo "Installing oh-my-openagent..."
        npm install -g oh-my-openagent
    else
        echo "oh-my-openagent already installed"
    fi

    # OpenSpec — Spec-driven development CLI
    if ! npm list -g @fission-ai/openspec &>/dev/null; then
        echo "Installing OpenSpec..."
        npm install -g @fission-ai/openspec@latest
    else
        echo "OpenSpec already installed"
    fi

    # swarm-tools — Multi-agent orchestration
    if ! npm list -g opencode-swarm-plugin &>/dev/null; then
        echo "Installing swarm-tools..."
        npm install -g opencode-swarm-plugin
    else
        echo "swarm-tools already installed"
    fi
else
    echo "npm not found, skipping npm-based tools"
fi

# ocx global init — creates profiles and global config
if [[ ! -f "${HOME}/.config/opencode/ocx.jsonc" ]] && [[ ! -f "${HOME}/.config/opencode/.opencode/ocx.jsonc" ]]; then
    echo "Initializing ocx globally..."
    ocx init --global
else
    echo "ocx global config already initialized"
fi

# Fix: remove root-level ocx.jsonc if .opencode/ocx.jsonc also exists (ocx requires single location)
if [[ -f "${HOME}/.config/opencode/ocx.jsonc" ]] && [[ -f "${HOME}/.config/opencode/.opencode/ocx.jsonc" ]]; then
    echo "Consolidating duplicate ocx.jsonc..."
    rm -f "${HOME}/.config/opencode/ocx.jsonc"
fi

# ocx plugins — non-fatal (registry hash mismatches are transient)
OCX_DIR="${HOME}/.config/opencode"

# opencode-notify — Desktop notifications plugin
if ! (cd "${OCX_DIR}" && ocx list 2>/dev/null | grep -q "kdco/notify"); then
    echo "Installing opencode-notify..."
    (cd "${OCX_DIR}" && ocx add kdco/notify --from https://registry.kdco.dev) || echo "  Warning: opencode-notify install failed (non-fatal)"
else
    echo "opencode-notify already installed"
fi

# opencode-worktree — Git worktree integration
if ! (cd "${OCX_DIR}" && ocx list 2>/dev/null | grep -q "kdco/worktree"); then
    echo "Installing opencode-worktree..."
    (cd "${OCX_DIR}" && ocx add kdco/worktree --from https://registry.kdco.dev) || echo "  Warning: opencode-worktree install failed (non-fatal)"
else
    echo "opencode-worktree already installed"
fi

echo "OpenCode tools installation complete!"
{{- end }}
