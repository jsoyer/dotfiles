{{- if eq .chezmoi.os "linux" -}}
{{- $mp              := index . "machine_profile" -}}
{{- $isUbuntuDesktop := eq $mp "ubuntu-desktop" -}}
{{- $isFedoraAtomic  := eq $mp "fedora-atomic" -}}
{{- $isFedoraDesktop := eq $mp "fedora-desktop" -}}
{{- $isRpi           := eq $mp "rpi" -}}
{{- if or $isFedoraAtomic $isFedoraDesktop $isUbuntuDesktop $isRpi -}}
{{- $hostOverlayPath := printf "%s/dot_private/Flatpakfile_%s" .chezmoi.sourceDir .chezmoi.hostname -}}
#!/usr/bin/env bash
# run_onchange hash sources (reruns when any relevant file changes):
{{- if $isFedoraAtomic }}
{{- $atomicBase := printf "%s/dot_private/Flatpakfile_fedora_atomic" .chezmoi.sourceDir -}}
{{- if stat $atomicBase }}
#   fedora-atomic base: {{ include $atomicBase | sha256sum }}
{{- else }}
#   fedora-atomic base: (absent)
{{- end -}}
{{- end -}}
{{- if $isUbuntuDesktop }}
{{- $ubuntuBase := printf "%s/dot_private/Flatpakfile_ubuntu_desktop" .chezmoi.sourceDir -}}
{{- if stat $ubuntuBase }}
#   ubuntu-desktop base: {{ include $ubuntuBase | sha256sum }}
{{- else }}
#   ubuntu-desktop base: (absent)
{{- end -}}
{{- end -}}
{{- if $isFedoraDesktop }}
{{- $fedoraBase := printf "%s/dot_private/Flatpakfile_fedora_desktop" .chezmoi.sourceDir -}}
{{- if stat $fedoraBase }}
#   fedora-desktop base: {{ include $fedoraBase | sha256sum }}
{{- else }}
#   fedora-desktop base: (absent)
{{- end -}}
{{- end -}}
{{- if $isRpi }}
{{- $rpiBase := printf "%s/dot_private/Flatpakfile_rpi" .chezmoi.sourceDir -}}
{{- if stat $rpiBase }}
#   rpi base: {{ include $rpiBase | sha256sum }}
{{- else }}
#   rpi base: (absent)
{{- end -}}
{{- end -}}
{{- if stat $hostOverlayPath }}
#   host overlay: {{ include $hostOverlayPath | sha256sum }}
{{- end }}
# =============================================================================
# Flatpak Packages Installation (reruns when this package list changes)
# =============================================================================

set -uo pipefail

# A single failed package must never abort `chezmoi apply` and block the rest of
# the config (mirrors run_onchange_03-brew-bundle.sh). Failures are collected and
# reported at the end instead of aborting.
_PKG_FAILURES=()
_pkgfail() {
    _PKG_FAILURES+=("$1")
    echo "  ⚠️  ${1} failed — continuing so the rest of the config still applies" >&2
}

echo "Setting up Flatpak..."

{{- if $isFedoraAtomic }}
# Check if flatpak is installed, install if not
if ! command -v flatpak &>/dev/null; then
    echo "Flatpak not found, installing..."
    sudo rpm-ostree install flatpak
    echo "Flatpak installed. Reboot required, then run this script again."
    exit 0
fi

# Add flathub remote if not exists (system-wide)
if ! sudo flatpak remote-list --system 2>/dev/null | grep -q flathub; then
    sudo flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fi

# Refresh metadata so installs don't fail with "No remote refs found"
echo "Refreshing Flathub metadata..."
sudo flatpak update --appstream flathub --system 2>/dev/null || true

echo "Installing Flatpak packages (Fedora Atomic)..."

_install_flatpak_atomic() {
    local pkg="$1"
    if flatpak info "$pkg" &>/dev/null; then
        echo "  $pkg already installed"
    else
        echo "  Installing $pkg..."
        sudo flatpak install --system --noninteractive flathub "$pkg" \
            || _pkgfail "flatpak (fedora-atomic): ${pkg}"
    fi
}

# --- base manifest (fedora-atomic) ---
_base="{{ printf "%s/dot_private/Flatpakfile_fedora_atomic" .chezmoi.sourceDir }}"
if [[ -f "$_base" && -s "$_base" ]]; then
    mapfile -t _apps < <(grep -v '^\s*#' "$_base" | grep -v '^\s*$')
    for pkg in "${_apps[@]}"; do _install_flatpak_atomic "$pkg"; done
fi

# --- per-hostname overlay ---
_host_file="{{ $hostOverlayPath }}"
if [[ -f "$_host_file" && -s "$_host_file" ]]; then
    mapfile -t _host_apps < <(grep -v '^\s*#' "$_host_file" | grep -v '^\s*$')
    if (( ${#_host_apps[@]} > 0 )); then
        echo "Installing host-overlay Flatpak packages ({{ .chezmoi.hostname }}, Fedora Atomic)..."
        for pkg in "${_host_apps[@]}"; do _install_flatpak_atomic "$pkg"; done
    fi
fi
{{- end }}

{{- if $isUbuntuDesktop }}
# Ensure flatpak is installed (apt)
if ! command -v flatpak &>/dev/null; then
    echo "Flatpak not found, installing via apt..."
    sudo apt update
    sudo apt install -y flatpak gnome-software-plugin-flatpak
fi

# Add Flathub remote (user-level, no reboot needed)
if ! flatpak remote-list --user 2>/dev/null | grep -q flathub; then
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fi

# Refresh metadata
echo "Refreshing Flathub metadata..."
flatpak update --appstream flathub --user 2>/dev/null || true

echo "Installing Flatpak packages (Ubuntu Desktop)..."

_install_flatpak_ubuntu() {
    local pkg="$1"
    # No --scope flag on purpose: `flatpak info --user` does NOT see a
    # system-wide install, so it would happily install a duplicate --user copy
    # of an app already present system-wide (~1 GB each on an RPi).
    if flatpak info "$pkg" &>/dev/null; then
        echo "  $pkg already installed"
    else
        echo "  Installing $pkg..."
        flatpak install --user --noninteractive flathub "$pkg" \
            || _pkgfail "flatpak (ubuntu-desktop): ${pkg}"
    fi
}

# --- base manifest (ubuntu-desktop) ---
_base="{{ printf "%s/dot_private/Flatpakfile_ubuntu_desktop" .chezmoi.sourceDir }}"
if [[ -f "$_base" && -s "$_base" ]]; then
    mapfile -t _apps < <(grep -v '^\s*#' "$_base" | grep -v '^\s*$')
    for pkg in "${_apps[@]}"; do _install_flatpak_ubuntu "$pkg"; done
fi

# --- per-hostname overlay ---
_host_file="{{ $hostOverlayPath }}"
if [[ -f "$_host_file" && -s "$_host_file" ]]; then
    mapfile -t _host_apps < <(grep -v '^\s*#' "$_host_file" | grep -v '^\s*$')
    if (( ${#_host_apps[@]} > 0 )); then
        echo "Installing host-overlay Flatpak packages ({{ .chezmoi.hostname }}, Ubuntu Desktop)..."
        for pkg in "${_host_apps[@]}"; do _install_flatpak_ubuntu "$pkg"; done
    fi
fi
{{- end }}

{{- if $isFedoraDesktop }}
# Flatpak for Fedora Desktop (apps not available or outdated in DNF repos)
if ! command -v flatpak &>/dev/null; then
    echo "Flatpak not found, installing via dnf..."
    sudo dnf install -y flatpak || _pkgfail "dnf: flatpak (fedora-desktop)"
fi

# Add Flathub remote (user-level)
if ! flatpak remote-list --user 2>/dev/null | grep -q flathub; then
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fi

echo "Refreshing Flathub metadata..."
flatpak update --appstream flathub --user 2>/dev/null || true

echo "Installing Flatpak packages (Fedora Desktop)..."

_install_flatpak_fedora() {
    local pkg="$1"
    # No --scope flag on purpose: `flatpak info --user` does NOT see a
    # system-wide install, so it would happily install a duplicate --user copy
    # of an app already present system-wide (~1 GB each on an RPi).
    if flatpak info "$pkg" &>/dev/null; then
        echo "  $pkg already installed"
    else
        echo "  Installing $pkg..."
        flatpak install --user --noninteractive flathub "$pkg" \
            || _pkgfail "flatpak (fedora-desktop): ${pkg}"
    fi
}

# --- base manifest (fedora-desktop) ---
_base="{{ printf "%s/dot_private/Flatpakfile_fedora_desktop" .chezmoi.sourceDir }}"
if [[ -f "$_base" && -s "$_base" ]]; then
    mapfile -t _apps < <(grep -v '^\s*#' "$_base" | grep -v '^\s*$')
    for pkg in "${_apps[@]}"; do _install_flatpak_fedora "$pkg"; done
fi

# --- per-hostname overlay ---
_host_file="{{ $hostOverlayPath }}"
if [[ -f "$_host_file" && -s "$_host_file" ]]; then
    mapfile -t _host_apps < <(grep -v '^\s*#' "$_host_file" | grep -v '^\s*$')
    if (( ${#_host_apps[@]} > 0 )); then
        echo "Installing host-overlay Flatpak packages ({{ .chezmoi.hostname }}, Fedora Desktop)..."
        for pkg in "${_host_apps[@]}"; do _install_flatpak_fedora "$pkg"; done
    fi
fi
{{- end }}

{{- if $isRpi }}
# Raspberry Pi OS is Debian-based: same apt/user-scope flow as ubuntu-desktop.
# Only aarch64-capable apps are listed -- Discord and Signal ship x86_64 only on
# Flathub, which is what used to make `brew bundle` fail here.
if ! command -v flatpak &>/dev/null; then
    echo "Flatpak not found, installing via apt..."
    sudo apt update
    sudo apt install -y flatpak
fi

if ! flatpak remote-list --user 2>/dev/null | grep -q flathub; then
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fi

echo "Refreshing Flathub metadata..."
flatpak update --appstream flathub --user 2>/dev/null || true

echo "Installing Flatpak packages (Raspberry Pi)..."

_install_flatpak_rpi() {
    local pkg="$1"
    # No --scope flag on purpose: `flatpak info --user` does NOT see a
    # system-wide install, so it would happily install a duplicate --user copy
    # of an app already present system-wide (~1 GB each on an RPi).
    if flatpak info "$pkg" &>/dev/null; then
        echo "  $pkg already installed"
    else
        echo "  Installing $pkg..."
        flatpak install --user --noninteractive flathub "$pkg" \
            || _pkgfail "flatpak (rpi): ${pkg}"
    fi
}

# --- base manifest (rpi) ---
_base="{{ printf "%s/dot_private/Flatpakfile_rpi" .chezmoi.sourceDir }}"
if [[ -f "$_base" && -s "$_base" ]]; then
    mapfile -t _apps < <(grep -v '^\s*#' "$_base" | grep -v '^\s*$')
    for pkg in "${_apps[@]}"; do _install_flatpak_rpi "$pkg"; done
fi

# --- per-hostname overlay ---
_host_file="{{ $hostOverlayPath }}"
if [[ -f "$_host_file" && -s "$_host_file" ]]; then
    mapfile -t _host_apps < <(grep -v '^\s*#' "$_host_file" | grep -v '^\s*$')
    if (( ${#_host_apps[@]} > 0 )); then
        echo "Installing host-overlay Flatpak packages ({{ .chezmoi.hostname }}, Raspberry Pi)..."
        for pkg in "${_host_apps[@]}"; do _install_flatpak_rpi "$pkg"; done
    fi
fi
{{- end }}

if ((${#_PKG_FAILURES[@]})); then
    echo ""
    echo "⚠️  Some packages failed to install (your dotfiles config was still applied):"
    printf '   - %s\n' "${_PKG_FAILURES[@]}"
    echo "   Fix the cause and re-run: chezmoi apply"
fi

echo "Flatpak packages installation complete."
{{ end -}}
{{- end }}
