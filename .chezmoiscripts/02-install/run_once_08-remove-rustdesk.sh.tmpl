{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# =============================================================================
# One-time cleanup: remove RustDesk from all machines (macOS + Linux)
# No-ops (no sudo, no "Removing..." line) when RustDesk is not installed.
# =============================================================================

set -euo pipefail

rustdesk_installed() {
{{ if eq .chezmoi.os "darwin" -}}
    if command -v brew &>/dev/null && brew list --cask rustdesk &>/dev/null; then
        return 0
    fi
    [[ -d /Applications/RustDesk.app || -d "${HOME}/Applications/RustDesk.app" ]] && return 0
    pgrep -x RustDesk >/dev/null 2>&1 && return 0
    shopt -s nullglob
    local agents=( "${HOME}/Library/LaunchAgents/com.carriez."*.plist )
    shopt -u nullglob
    (( ${#agents[@]} > 0 )) && return 0
    return 1
{{ else -}}
    command -v rustdesk >/dev/null 2>&1 && return 0
    pgrep -x rustdesk >/dev/null 2>&1 && return 0
    if command -v flatpak >/dev/null 2>&1 && flatpak list --app --columns=application 2>/dev/null | grep -qx 'com.rustdesk.RustDesk'; then
        return 0
    fi
    if command -v dpkg >/dev/null 2>&1 && dpkg -s rustdesk &>/dev/null; then
        return 0
    fi
    if command -v rpm >/dev/null 2>&1 && rpm -q rustdesk &>/dev/null; then
        return 0
    fi
    if command -v pacman >/dev/null 2>&1 && pacman -Qi rustdesk &>/dev/null; then
        return 0
    fi
    return 1
{{ end -}}
}

if ! rustdesk_installed; then
    echo "ℹ️  RustDesk not installed, skipping."
    exit 0
fi

echo "🧹 Removing RustDesk..."

{{ if eq .chezmoi.os "darwin" -}}
pkill -x RustDesk 2>/dev/null || true

if command -v brew &>/dev/null && brew list --cask rustdesk &>/dev/null; then
    brew uninstall --cask --zap rustdesk || true
fi

# App bundles: never prompt sudo unless the system copy actually exists.
for app in /Applications/RustDesk.app "${HOME}/Applications/RustDesk.app"; do
    [[ -d "$app" ]] || continue
    if rm -rf "$app" 2>/dev/null; then
        continue
    fi
    echo "⚠️  $app needs admin rights to remove — skipped on this account."
done

shopt -s nullglob
for plist in "${HOME}/Library/LaunchAgents/com.carriez."*.plist; do
    launchctl unload "$plist" 2>/dev/null || true
    rm -f "$plist"
done
shopt -u nullglob
rm -rf "${HOME}/Library/Preferences/com.carriez."* "${HOME}/.config/rustdesk" 2>/dev/null || true
{{ else -}}
pkill -x rustdesk 2>/dev/null || true

if command -v flatpak >/dev/null 2>&1 && flatpak list --app --columns=application 2>/dev/null | grep -qx 'com.rustdesk.RustDesk'; then
    flatpak uninstall -y com.rustdesk.RustDesk 2>/dev/null || true
fi
if command -v apt-get >/dev/null 2>&1 && dpkg -s rustdesk &>/dev/null; then
    sudo apt-get remove -y rustdesk || true
elif command -v dnf >/dev/null 2>&1 && rpm -q rustdesk &>/dev/null; then
    sudo dnf remove -y rustdesk || true
elif command -v pacman >/dev/null 2>&1 && pacman -Qi rustdesk &>/dev/null; then
    sudo pacman -Rns --noconfirm rustdesk || true
fi
rm -rf ~/.config/rustdesk 2>/dev/null || true
{{ end -}}

echo "✅ RustDesk cleanup done."
{{ end -}}
