{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# =============================================================================
# Linux Packages Installation - apt, dnf, rpm-ostree
# =============================================================================

set -eufo pipefail

# =============================================================================
# Raspberry Pi / Debian - apt packages
# =============================================================================
{{- if contains "rpi" .chezmoi.kernel.osrelease }}
echo "[chezmoi] Installing Raspberry Pi packages via apt..."

sudo apt update && sudo apt install -y \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    eza \
    vivid \
    locales || true

if ! command -v chezmoi &> /dev/null; then
    echo "[chezmoi] Installing chezmoi via official script..."
    sh -c "$(curl -fsSL https://get.chezmoi.io)"
fi
{{- end }}

# =============================================================================
# Fedora Standard - dnf packages
# =============================================================================
{{- if and (lookPath "dnf") (not (lookPath "rpm-ostree")) (not (stat "/.toolboxenv")) }}
echo "[chezmoi] Installing Fedora Standard packages via dnf..."

sudo dnf install -y --skip-unavailable \
    chezmoi \
    eza \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    vivid \
    jetbrains-mono-fonts-all \
    fish \
    kitty \
    nushell \
    util-linux-user
{{- end }}

# =============================================================================
# Fedora Atomic - rpm-ostree packages
# =============================================================================
{{- if and (lookPath "rpm-ostree") (not (stat "/.toolboxenv")) }}
echo "[chezmoi] Installing Fedora Atomic packages via rpm-ostree..."

sudo rpm-ostree install --apply-live --idempotent git chezmoi
{{- end }}

echo "[chezmoi] Linux packages installation complete!"
{{- end }}
