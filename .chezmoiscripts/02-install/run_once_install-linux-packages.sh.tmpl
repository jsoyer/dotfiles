{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# =============================================================================
# Linux Packages Installation - apt, dnf, rpm-ostree
# =============================================================================

set -eufo pipefail

# =============================================================================
# Raspberry Pi / Debian - apt packages
# =============================================================================
{{- if contains "rpi" .chezmoi.kernel.osrelease }}
echo "🐍 Installing Raspberry Pi packages via apt..."

sudo apt update && sudo apt install -y \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    eza \
    vivid \
    locales
{{- end }}

# =============================================================================
# Fedora Standard - dnf packages
# =============================================================================
{{- if and (lookPath "dnf") (not (lookPath "rpm-ostree")) (not (stat "/.toolboxenv")) (not (env "TOOLBOX_PATH")) }}
echo "🐧 Installing Fedora Standard packages via dnf..."

sudo dnf install -y --skip-unavailable \
    chezmoi \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    vivid \
    jetbrains-mono-fonts-all \
    fish \
    kitty \
    nushell \
    util-linux-user \
    cargo \
    rust

# Install eza via cargo (not in Fedora repos)
if ! command -v eza &>/dev/null; then
    echo "📦 Installing eza via cargo..."
    cargo install eza
fi
{{- end }}

# =============================================================================
# Fedora Toolbox - dnf packages (same as Fedora Standard)
# =============================================================================
{{- if and (lookPath "dnf") (or (stat "/.toolboxenv") (env "TOOLBOX_PATH")) }}
echo "📦 Installing Fedora Toolbox packages via dnf..."

sudo dnf install -y --skip-unavailable \
    chezmoi \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    vivid \
    fish \
    kitty \
    nushell \
    util-linux-user \
    cargo \
    rust

# Install eza via cargo (not in Fedora repos)
if ! command -v eza &>/dev/null; then
    echo "📦 Installing eza via cargo..."
    cargo install eza
fi
{{- end }}

# =============================================================================
# Fedora Atomic - rpm-ostree packages
# =============================================================================
{{- if and (lookPath "rpm-ostree") (not (stat "/.toolboxenv")) }}
echo "🐧 Fedora Atomic - no additional packages (git/chezmoi handled by bootstrap)"
{{- end }}

echo "✅ Linux packages installation complete!"
{{- end }}
