{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# =============================================================================
# One-time: delete leftover moshi/orca/cursor-worker files on macOS.
# .chezmoiignore stops chezmoi from re-applying them, but does NOT remove
# targets already written. This script is the removal side.
#
# herdr is NOT in this wipe: it is installed on every Unix machine
# (Homebrew on macOS, herdr.dev one-liner on Linux via herdr-setup /
# run_once_after_14-install-herdr). Editing this script re-runs it; the
# wrapper wipe is mac-pro only so mac-personal LaunchAgents keep their
# moshi shims.
# =============================================================================
set -euo pipefail

removed=0

rm_if_present() {
    local f="$1"
    if [[ -e "$f" || -L "$f" ]]; then
        rm -f "$f"
        echo "  removed ${f}"
        removed=$((removed + 1))
    fi
}

{{ if eq .machine_profile "mac-pro" -}}
# mac-personal LaunchAgents still call moshi-hook-launch / update-moshi
# (installed by moshi-setup, not chezmoi). Only wipe those leftovers on mac-pro.
uid="$(id -u)"
for label in com.jsoyer.moshi-hook com.jsoyer.moshi-update; do
    target="gui/${uid}/${label}"
    if launchctl print "${target}" &>/dev/null; then
        launchctl bootout "${target}" 2>/dev/null || true
        echo "  unloaded ${target}"
        removed=$((removed + 1))
    fi
    rm_if_present "${HOME}/Library/LaunchAgents/${label}.plist"
done
for f in \
    "${HOME}/.local/bin/agentsvc" \
    "${HOME}/.local/bin/cursor-setup" \
    "${HOME}/.local/bin/moshi-hook-launch" \
    "${HOME}/.local/bin/moshi-setup" \
    "${HOME}/.local/bin/moshi-uninstall" \
    "${HOME}/.local/bin/orca-gui" \
    "${HOME}/.local/bin/orca-setup" \
    "${HOME}/.local/bin/orca-uninstall" \
    "${HOME}/.local/bin/orca-version" \
    "${HOME}/.local/bin/update-cursor-agent" \
    "${HOME}/.local/bin/update-moshi" \
    "${HOME}/.local/bin/update-orca"
do
    rm_if_present "$f"
done
{{ end -}}

# systemd units are Linux-only leftovers on any Mac.
for f in \
    "${HOME}/.config/systemd/user/moshi-hook.service" \
    "${HOME}/.config/systemd/user/moshi-update.service" \
    "${HOME}/.config/systemd/user/moshi-update.timer" \
    "${HOME}/.config/systemd/user/herdr-update.service" \
    "${HOME}/.config/systemd/user/herdr-update.timer" \
    "${HOME}/.config/systemd/user/cursor-update.service" \
    "${HOME}/.config/systemd/user/cursor-update.timer" \
    "${HOME}/.config/systemd/user/cursor-worker.service"
do
    rm_if_present "$f"
done

if (( removed > 0 )); then
    echo "ℹ️  Removed ${removed} leftover moshi/orca/cursor file(s) (Linux-only stacks)."
else
    echo "ℹ️  No leftover moshi/orca/cursor files, skipping."
fi
{{- end -}}
