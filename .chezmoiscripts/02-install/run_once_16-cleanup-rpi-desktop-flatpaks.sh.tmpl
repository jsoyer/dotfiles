{{- if and (eq .chezmoi.os "linux") (eq (includeTemplate "machine-profile" .) "rpi") -}}
#!/usr/bin/env bash
# Remove desktop apps that used to be installed on every Raspberry Pi, even
# headless servers. Keep app data intact; this removes apps and unused runtimes.

set -euo pipefail

if ! command -v flatpak >/dev/null 2>&1; then
    echo "Flatpak is not installed; nothing to clean."
    exit 0
fi

installed="$(flatpak list --user --app --columns=application 2>/dev/null | awk 'NR > 1 && NF { print $1 }')"
apps=(
    io.github.shiftey.Desktop
    md.obsidian.Obsidian
    org.localsend.localsend_app
    tech.feliciano.pocket-casts
)

removed=0
failed=0
for app in "${apps[@]}"; do
    if grep -Fxq "$app" <<<"$installed"; then
        echo "Removing Raspberry Pi desktop Flatpak: $app"
        if flatpak uninstall --user --noninteractive -y "$app"; then
            ((removed++)) || true
        else
            echo "⚠️  Could not remove $app" >&2
            failed=1
        fi
    fi
done

if (( removed > 0 )); then
    flatpak uninstall --user --unused --noninteractive -y || true
    echo "Removed $removed app(s); Flatpak app data was preserved."
else
    echo "No legacy Raspberry Pi desktop Flatpaks found."
fi

exit "$failed"
{{- end -}}
