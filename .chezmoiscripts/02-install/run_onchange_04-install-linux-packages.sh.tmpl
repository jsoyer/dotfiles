fi

# Per-hostname overlay: machine-specific apt packages layered on top of the base.
_hostaptfile="{{ .chezmoi.sourceDir }}/dot_private/Aptfile_{{ .chezmoi.hostname }}"
if [[ -f "$_hostaptfile" ]]; then
    mapfile -t _hostpkgs < <(grep -v '^\s*#' "$_hostaptfile" | grep -v '^\s*$')
    if (( ${#_hostpkgs[@]} )); then
        echo "📦 apt install (hostname overlay: {{ .chezmoi.hostname }})"
        sudo apt-get install -y "${_hostpkgs[@]}" || _pkgfail "apt: hostname overlay"
    fi
fi

# Install starship via official installer (not in Ubuntu apt)
_install_starship || true

# Install eza (prefers apt, falls back to cargo)
_install_eza || true

# Install WezTerm via official apt repo
if ! command -v wezterm &>/dev/null; then
    echo "Installing WezTerm..."
    curl -fsSL https://apt.fury.io/wez/gpg.key | sudo gpg --yes --dearmor -o /etc/apt/keyrings/wezterm-fury.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *" \
        | sudo tee /etc/apt/sources.list.d/wezterm.list > /dev/null
    sudo apt update
    sudo apt install -y wezterm || _pkgfail "apt: wezterm (ubuntu-desktop)"
fi

# Install 1Password CLI via official apt repo
if ! command -v op &>/dev/null; then
    echo "Installing 1Password CLI..."
    tmp_key="$(mktemp)"
    curl -sS https://downloads.1password.com/linux/keys/1password.asc -o "$tmp_key"
    sudo gpg --dearmor < "$tmp_key" | sudo tee /usr/share/keyrings/1password-archive-keyring.gpg > /dev/null
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" \
        | sudo tee /etc/apt/sources.list.d/1password.list > /dev/null
    sudo apt update
    sudo apt install -y 1password-cli || _pkgfail "apt: 1password-cli (ubuntu-desktop)"
fi

# Install gh CLI via official apt keyring
if ! command -v gh &>/dev/null; then
    echo "Installing gh (GitHub CLI)..."
    tmp_key="$(mktemp)"
    wget -nv -O "$tmp_key" https://cli.github.com/packages/githubcli-archive-keyring.gpg
    sudo mkdir -p -m 755 /etc/apt/keyrings
    sudo install -m 644 "$tmp_key" /etc/apt/keyrings/githubcli-archive-keyring.gpg
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt update
    sudo apt install -y gh || _pkgfail "apt: gh (ubuntu-desktop)"
fi

# Install uv (provides uvx for MCP servers using Python)
if ! command -v uv &>/dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi

# Add Flathub remote for desktop apps
if command -v flatpak &>/dev/null; then
    if ! flatpak remote-list --user 2>/dev/null | grep -q flathub; then
        flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    fi
fi

# Snap packages (Ubuntu — pre-installed, priority: apt > brew > snap > script)
if command -v snap &>/dev/null; then
    _snapfile="{{ .chezmoi.sourceDir }}/dot_private/Snapfile_ubuntu_desktop"
    if [[ -f "$_snapfile" ]]; then
        mapfile -t _snappkgs < <(grep -v '^\s*#' "$_snapfile" | grep -v '^\s*$')
        for _pkg in "${_snappkgs[@]}"; do
            if ! snap list "$_pkg" &>/dev/null 2>&1; then
                echo "📦 Installing snap: $_pkg..."
                sudo snap install "$_pkg" 2>/dev/null || _pkgfail "snap: ${_pkg}"
            fi
        done
    fi

    # Per-hostname snap overlay.
    _hostsnapfile="{{ .chezmoi.sourceDir }}/dot_private/Snapfile_{{ .chezmoi.hostname }}"
    if [[ -f "$_hostsnapfile" ]]; then
        mapfile -t _hostsnapkgs < <(grep -v '^\s*#' "$_hostsnapfile" | grep -v '^\s*$')
        if (( ${#_hostsnapkgs[@]} )); then
            echo "📦 snap install (hostname overlay: {{ .chezmoi.hostname }})"
            for _pkg in "${_hostsnapkgs[@]}"; do
                if ! snap list "$_pkg" &>/dev/null 2>&1; then
                    sudo snap install "$_pkg" 2>/dev/null || _pkgfail "snap: hostname overlay: ${_pkg}"
                fi
            done
        fi
    fi
fi
