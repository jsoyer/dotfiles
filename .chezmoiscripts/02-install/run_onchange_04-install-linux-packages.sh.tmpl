# =============================================================================
# Arch Linux Desktop - pacman + yay (AUR)
# =============================================================================
{{- if or $isArchDesktop $isOmArchy }}
echo "Installing Arch Linux Desktop packages via pacman..."

# Install packages from Pacfile manifest
_pacfile="{{ .chezmoi.sourceDir }}/dot_private/Pacfile_arch_desktop"
if [[ -f "$_pacfile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_pacfile" | grep -v '^\s*$')
    sudo pacman -S --noconfirm --needed "${_pkgs[@]}" || _pkgfail "pacman: arch-desktop packages"
fi

# Install yay (AUR helper) if not present
if ! command -v yay &>/dev/null; then
    echo "Installing yay (AUR helper)..."
    _yay_tmp="$(mktemp -d)"
    trap 'rm -rf "$_yay_tmp"' EXIT
    git clone https://aur.archlinux.org/yay.git "$_yay_tmp/yay"
    (cd "$_yay_tmp/yay" && makepkg -si --noconfirm) || _pkgfail "aur: yay (AUR helper build)"
fi

# Install AUR packages from Pacfile_aur_desktop
_aurfile="{{ .chezmoi.sourceDir }}/dot_private/Pacfile_aur_desktop"
if [[ -f "$_aurfile" ]] && command -v yay &>/dev/null; then
    mapfile -t _aurpkgs < <(grep -v '^\s*#' "$_aurfile" | grep -v '^\s*$')
    if (( ${#_aurpkgs[@]} )); then
        yay -S --noconfirm --needed --answerdiff=None --answerclean=None "${_aurpkgs[@]}" || _pkgfail "aur: arch-desktop AUR packages"
    fi
fi

# Per-hostname overlay: machine-specific pacman packages layered on top of the base.
_hostpacfile="{{ .chezmoi.sourceDir }}/dot_private/Pacfile_{{ .chezmoi.hostname }}"
if [[ -f "$_hostpacfile" ]]; then
    mapfile -t _hostpkgs < <(grep -v '^\s*#' "$_hostpacfile" | grep -v '^\s*$')
    if (( ${#_hostpkgs[@]} )); then
        echo "📦 pacman install (hostname overlay: {{ .chezmoi.hostname }})"
        sudo pacman -S --noconfirm --needed "${_hostpkgs[@]}" || _pkgfail "pacman: hostname overlay"
    fi
fi

# Per-hostname AUR overlay.
_hostaur="{{ .chezmoi.sourceDir }}/dot_private/Pacfile_aur_{{ .chezmoi.hostname }}"
if [[ -f "$_hostaur" ]] && command -v yay &>/dev/null; then
    mapfile -t _hostaurpkgs < <(grep -v '^\s*#' "$_hostaur" | grep -v '^\s*$')
    if (( ${#_hostaurpkgs[@]} )); then
        echo "📦 yay install (hostname AUR overlay: {{ .chezmoi.hostname }})"
        yay -S --noconfirm --needed --answerdiff=None --answerclean=None "${_hostaurpkgs[@]}" || _pkgfail "aur: hostname overlay"
    fi
fi

# Install uv
if ! command -v uv &>/dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
{{- end }}

