{{- if eq .chezmoi.os "linux" -}}
{{- $mp              := index . "machine_profile" -}}
{{- $isRPi           := eq $mp "rpi" -}}
{{- $isDebian        := eq $mp "debian" -}}
{{- $isUbuntuServer  := eq $mp "ubuntu-server" -}}
{{- $isUbuntuDesktop := eq $mp "ubuntu-desktop" -}}
{{- $isUbuntu        := or $isUbuntuServer $isUbuntuDesktop -}}
{{- $isFedoraAtomic  := eq $mp "fedora-atomic" -}}
{{- $isToolbox       := eq $mp "toolbox" -}}
{{- $isFedoraDesktop := eq $mp "fedora-desktop" -}}
{{- $isFedoraServer  := eq $mp "fedora-server" -}}
{{- $isFedora        := or $isFedoraDesktop $isFedoraServer -}}
{{- $isOmArchy       := eq $mp "omarchy" -}}
{{- $isArchDesktop   := eq $mp "arch-desktop" -}}
{{- $isArchServer    := eq $mp "arch-server" -}}
{{- $isArch          := or $isArchDesktop $isArchServer $isOmArchy -}}
#!/usr/bin/env bash
# =============================================================================
# Linux Packages Installation - apt, dnf, rpm-ostree
# =============================================================================

# Manifest checksums — chezmoi reruns this script when any of these change:
{{- if $isRPi }}
# Aptfile_rpi:            {{ include "dot_private/Aptfile_rpi" | sha256sum }}
{{- end }}
{{- if $isUbuntuServer }}
# Aptfile_ubuntu_server:  {{ include "dot_private/Aptfile_ubuntu_server" | sha256sum }}
{{- end }}
{{- if $isUbuntuDesktop }}
# Aptfile_ubuntu_desktop: {{ include "dot_private/Aptfile_ubuntu_desktop" | sha256sum }}
{{- end }}
{{- if $isFedoraServer }}
# Dnffile_fedora_server:  {{ include "dot_private/Dnffile_fedora_server" | sha256sum }}
{{- end }}
{{- if $isDebian }}
# Aptfile_debian:         {{ include "dot_private/Aptfile_debian" | sha256sum }}
{{- end }}
{{- if $isFedoraDesktop }}
# Dnffile_fedora_desktop: {{ include "dot_private/Dnffile_fedora_desktop" | sha256sum }}
{{- end }}
{{- if or $isArchDesktop $isOmArchy }}
# Pacfile_arch_desktop:   {{ include "dot_private/Pacfile_arch_desktop" | sha256sum }}
# Pacfile_aur_desktop:    {{ include "dot_private/Pacfile_aur_desktop" | sha256sum }}
# Pacfile_arch_gui:       {{ include "dot_private/Pacfile_arch_gui" | sha256sum }}
# Pacfile_aur_gui:        {{ include "dot_private/Pacfile_aur_gui" | sha256sum }}
{{- end }}
{{- if $isUbuntuDesktop }}
# Aptfile_ubuntu_gui:     {{ include "dot_private/Aptfile_ubuntu_gui" | sha256sum }}
# Snapfile_ubuntu_desktop: {{ include "dot_private/Snapfile_ubuntu_desktop" | sha256sum }}
{{- end }}
{{- if $isFedoraDesktop }}
# Dnffile_fedora_gui:     {{ include "dot_private/Dnffile_fedora_gui" | sha256sum }}
{{- end }}
{{- if $isRPi }}
# Aptfile_rpi_gui:        {{ include "dot_private/Aptfile_rpi_gui" | sha256sum }}
{{- end }}
{{- if $isArchServer }}
# Pacfile_arch_server:    {{ include "dot_private/Pacfile_arch_server" | sha256sum }}
{{- end }}
{{- if $isFedoraAtomic }}
# Rpmfile_fedora_atomic:  {{ include "dot_private/Rpmfile_fedora_atomic" | sha256sum }}
{{- end }}

set -euo pipefail

# Ensure brew is in PATH if installed (chezmoi scripts run in isolated subshells)
# Check binary directly — directory may exist before brew is fully installed
if [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x "${HOME}/.linuxbrew/bin/brew" ]]; then
    eval "$("${HOME}/.linuxbrew/bin/brew" shellenv)"
fi

# Initialize git-lfs if available (required for .wallpapers repo)
if command -v git-lfs &>/dev/null; then
    git lfs install --skip-smudge 2>/dev/null || true
fi

# Detect if a display server / desktop environment is installed
_has_gui() {
    command -v Xorg &>/dev/null || \
    command -v Xwayland &>/dev/null || \
    command -v gnome-shell &>/dev/null || \
    command -v plasmashell &>/dev/null || \
    command -v hyprctl &>/dev/null || \
    command -v sway &>/dev/null || \
    command -v startx &>/dev/null
}

# =============================================================================
# Raspberry Pi / Debian - apt packages
# =============================================================================
{{- if $isRPi }}
echo "Installing Raspberry Pi packages via apt..."

# Install packages from Aptfile manifest
_aptfile="{{ .chezmoi.sourceDir }}/dot_private/Aptfile_rpi"
if [[ -f "$_aptfile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_aptfile" | grep -v '^\s*$')
    sudo apt update && sudo apt-get install -y "${_pkgs[@]}"
fi

# 1Password CLI — handled by run_once_install-1password.sh

# Install gh CLI via official apt keyring
if ! command -v gh &>/dev/null; then
    echo "Installing gh (GitHub CLI)..."
    tmp_key="$(mktemp)"
    if ! command -v wget &>/dev/null; then
        sudo apt install -y wget
    fi
    wget -nv -O "$tmp_key" https://cli.github.com/packages/githubcli-archive-keyring.gpg
    sudo mkdir -p -m 755 /etc/apt/keyrings
    sudo install -m 644 "$tmp_key" /etc/apt/keyrings/githubcli-archive-keyring.gpg
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt update
    sudo apt install -y gh
fi

# Install uv (provides uvx for MCP servers using Python)
if ! command -v uv &>/dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
{{- end }}

# =============================================================================
# Debian (generic, non-RPi) - apt packages
# =============================================================================
{{- if $isDebian }}
echo "Installing Debian packages via apt..."

# Install packages from Aptfile manifest
_aptfile="{{ .chezmoi.sourceDir }}/dot_private/Aptfile_debian"
if [[ -f "$_aptfile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_aptfile" | grep -v '^\s*$')
    sudo apt update && sudo apt-get install -y "${_pkgs[@]}"
fi

# Install starship via official installer (not in Debian apt)
if ! command -v starship &>/dev/null; then
    echo "Installing starship..."
    curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

# Install 1Password CLI via official apt repo
if ! command -v op &>/dev/null; then
    echo "Installing 1Password CLI..."
    tmp_key="$(mktemp)"
    curl -sS https://downloads.1password.com/linux/keys/1password.asc -o "$tmp_key"
    sudo gpg --dearmor < "$tmp_key" | sudo tee /usr/share/keyrings/1password-archive-keyring.gpg > /dev/null
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" \
        | sudo tee /etc/apt/sources.list.d/1password.list > /dev/null
    sudo apt update
    sudo apt install -y 1password-cli
fi

# Install gh CLI via official apt keyring
if ! command -v gh &>/dev/null; then
    echo "Installing gh (GitHub CLI)..."
    tmp_key="$(mktemp)"
    if ! command -v wget &>/dev/null; then
        sudo apt install -y wget
    fi
    wget -nv -O "$tmp_key" https://cli.github.com/packages/githubcli-archive-keyring.gpg
    sudo mkdir -p -m 755 /etc/apt/keyrings
    sudo install -m 644 "$tmp_key" /etc/apt/keyrings/githubcli-archive-keyring.gpg
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt update
    sudo apt install -y gh
fi

# Install uv (provides uvx for MCP servers using Python)
if ! command -v uv &>/dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
{{- end }}

# =============================================================================
# Ubuntu Server - apt packages (minimal, server-focused)
# =============================================================================
{{- if $isUbuntuServer }}
echo "Installing Ubuntu Server packages via apt..."

# Install packages from Aptfile manifest
_aptfile="{{ .chezmoi.sourceDir }}/dot_private/Aptfile_ubuntu_server"
if [[ -f "$_aptfile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_aptfile" | grep -v '^\s*$')
    sudo apt update && sudo apt-get install -y "${_pkgs[@]}"
fi

# Install starship via official installer (not in Ubuntu apt)
if ! command -v starship &>/dev/null; then
    echo "Installing starship..."
    curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

# Install eza via cargo (not in standard Ubuntu repos)
if ! command -v eza &>/dev/null; then
    if command -v cargo &>/dev/null; then
        echo "Installing eza via cargo..."
        cargo install eza
    else
        echo "cargo not found — skipping eza (install Rust first)"
    fi
fi

# Install 1Password CLI via official apt repo
if ! command -v op &>/dev/null; then
    echo "Installing 1Password CLI..."
    tmp_key="$(mktemp)"
    curl -sS https://downloads.1password.com/linux/keys/1password.asc -o "$tmp_key"
    sudo gpg --dearmor < "$tmp_key" | sudo tee /usr/share/keyrings/1password-archive-keyring.gpg > /dev/null
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" \
        | sudo tee /etc/apt/sources.list.d/1password.list > /dev/null
    sudo apt update
    sudo apt install -y 1password-cli
fi

# Install gh CLI via official apt keyring
if ! command -v gh &>/dev/null; then
    echo "Installing gh (GitHub CLI)..."
    tmp_key="$(mktemp)"
    if ! command -v wget &>/dev/null; then
        sudo apt install -y wget
    fi
    wget -nv -O "$tmp_key" https://cli.github.com/packages/githubcli-archive-keyring.gpg
    sudo mkdir -p -m 755 /etc/apt/keyrings
    sudo install -m 644 "$tmp_key" /etc/apt/keyrings/githubcli-archive-keyring.gpg
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt update
    sudo apt install -y gh
fi

# Install uv (provides uvx for MCP servers using Python)
if ! command -v uv &>/dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
{{- end }}

# =============================================================================
# Ubuntu Desktop - additional packages on top of server
# =============================================================================
{{- if $isUbuntuDesktop }}
echo "Installing Ubuntu Desktop packages via apt..."

# Install packages from Aptfile manifest
_aptfile="{{ .chezmoi.sourceDir }}/dot_private/Aptfile_ubuntu_desktop"
if [[ -f "$_aptfile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_aptfile" | grep -v '^\s*$')
    sudo apt update && sudo apt-get install -y "${_pkgs[@]}"
fi

# Install starship via official installer (not in Ubuntu apt)
if ! command -v starship &>/dev/null; then
    echo "Installing starship..."
    curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

# Install eza via cargo (not in standard Ubuntu repos)
if ! command -v eza &>/dev/null; then
    if command -v cargo &>/dev/null; then
        echo "Installing eza via cargo..."
        cargo install eza
    else
        echo "cargo not found — skipping eza (install Rust first)"
    fi
fi

# Install WezTerm via official apt repo
if ! command -v wezterm &>/dev/null; then
    echo "Installing WezTerm..."
    curl -fsSL https://apt.fury.io/wez/gpg.key | sudo gpg --yes --dearmor -o /etc/apt/keyrings/wezterm-fury.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *" \
        | sudo tee /etc/apt/sources.list.d/wezterm.list > /dev/null
    sudo apt update
    sudo apt install -y wezterm
fi

# Install 1Password CLI via official apt repo
if ! command -v op &>/dev/null; then
    echo "Installing 1Password CLI..."
    tmp_key="$(mktemp)"
    curl -sS https://downloads.1password.com/linux/keys/1password.asc -o "$tmp_key"
    sudo gpg --dearmor < "$tmp_key" | sudo tee /usr/share/keyrings/1password-archive-keyring.gpg > /dev/null
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" \
        | sudo tee /etc/apt/sources.list.d/1password.list > /dev/null
    sudo apt update
    sudo apt install -y 1password-cli
fi

# Install gh CLI via official apt keyring
if ! command -v gh &>/dev/null; then
    echo "Installing gh (GitHub CLI)..."
    tmp_key="$(mktemp)"
    wget -nv -O "$tmp_key" https://cli.github.com/packages/githubcli-archive-keyring.gpg
    sudo mkdir -p -m 755 /etc/apt/keyrings
    sudo install -m 644 "$tmp_key" /etc/apt/keyrings/githubcli-archive-keyring.gpg
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt update
    sudo apt install -y gh
fi

# Install uv (provides uvx for MCP servers using Python)
if ! command -v uv &>/dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi

# Add Flathub remote for desktop apps
if command -v flatpak &>/dev/null; then
    if ! flatpak remote-list --user 2>/dev/null | grep -q flathub; then
        flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    fi
fi

# Snap packages (Ubuntu — pre-installed, priority: apt > brew > snap > script)
if command -v snap &>/dev/null; then
    _snapfile="{{ .chezmoi.sourceDir }}/dot_private/Snapfile_ubuntu_desktop"
    if [[ -f "$_snapfile" ]]; then
        mapfile -t _snappkgs < <(grep -v '^\s*#' "$_snapfile" | grep -v '^\s*$')
        for _pkg in "${_snappkgs[@]}"; do
            if ! snap list "$_pkg" &>/dev/null 2>&1; then
                echo "📦 Installing snap: $_pkg..."
                sudo snap install "$_pkg" 2>/dev/null || true
            fi
        done
    fi
fi
{{- end }}

# =============================================================================
# Fedora Server - dnf packages (minimal, headless)
# =============================================================================
{{- if $isFedoraServer }}
echo "Installing Fedora Server packages via dnf..."

# Install packages from Dnffile manifest
_dnffile="{{ .chezmoi.sourceDir }}/dot_private/Dnffile_fedora_server"
if [[ -f "$_dnffile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_dnffile" | grep -v '^\s*$')
    sudo dnf install -y --skip-unavailable "${_pkgs[@]}"
fi

# Install eza via cargo (not in Fedora repos)
if ! command -v eza &>/dev/null; then
    echo "Installing eza via cargo..."
    cargo install eza
fi
{{- end }}

# =============================================================================
# Fedora Desktop - dnf packages (server + GUI apps via DNF first)
# =============================================================================
{{- if $isFedoraDesktop }}
echo "Installing Fedora Desktop packages via dnf..."

# Install packages from Dnffile manifest
_dnffile="{{ .chezmoi.sourceDir }}/dot_private/Dnffile_fedora_desktop"
if [[ -f "$_dnffile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_dnffile" | grep -v '^\s*$')
    sudo dnf install -y --skip-unavailable "${_pkgs[@]}"
fi

# Install eza via cargo (not in Fedora repos)
if ! command -v eza &>/dev/null; then
    echo "Installing eza via cargo..."
    cargo install eza
fi

{{- end }}

# =============================================================================
# Fedora Toolbox - dnf packages (same as Fedora Standard)
# =============================================================================
{{- if and (lookPath "dnf") (or (stat "/.toolboxenv") (env "TOOLBOX_PATH")) }}
echo "Installing Fedora Toolbox packages via dnf..."

sudo dnf install -y --skip-unavailable \
    chezmoi \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    vivid \
    fish \
    kitty \
    nushell \
    util-linux-user \
    cargo \
    rust

# Install eza via cargo (not in Fedora repos)
if ! command -v eza &>/dev/null; then
    echo "Installing eza via cargo..."
    cargo install eza
fi
{{- end }}

# =============================================================================
# Arch Linux Desktop - pacman + yay (AUR)
# =============================================================================
{{- if or $isArchDesktop $isOmArchy }}
echo "Installing Arch Linux Desktop packages via pacman..."

# Install packages from Pacfile manifest
_pacfile="{{ .chezmoi.sourceDir }}/dot_private/Pacfile_arch_desktop"
if [[ -f "$_pacfile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_pacfile" | grep -v '^\s*$')
    sudo pacman -S --noconfirm --needed "${_pkgs[@]}"
fi

# Install yay (AUR helper) if not present
if ! command -v yay &>/dev/null; then
    echo "Installing yay (AUR helper)..."
    _yay_tmp="$(mktemp -d)"
    trap 'rm -rf "$_yay_tmp"' EXIT
    git clone https://aur.archlinux.org/yay.git "$_yay_tmp/yay"
    (cd "$_yay_tmp/yay" && makepkg -si --noconfirm)
fi

# Install AUR packages from Pacfile_aur_desktop
_aurfile="{{ .chezmoi.sourceDir }}/dot_private/Pacfile_aur_desktop"
if [[ -f "$_aurfile" ]] && command -v yay &>/dev/null; then
    mapfile -t _aurpkgs < <(grep -v '^\s*#' "$_aurfile" | grep -v '^\s*$')
    [[ ${#_aurpkgs[@]} -gt 0 ]] && yay -S --noconfirm --needed --answerdiff=None --answerclean=None "${_aurpkgs[@]}"
fi

# Install uv
if ! command -v uv &>/dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
{{- end }}

# =============================================================================
# Arch Linux Server - pacman only
# =============================================================================
{{- if $isArchServer }}
echo "Installing Arch Linux Server packages via pacman..."

# Install packages from Pacfile manifest
_pacfile="{{ .chezmoi.sourceDir }}/dot_private/Pacfile_arch_server"
if [[ -f "$_pacfile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_pacfile" | grep -v '^\s*$')
    sudo pacman -S --noconfirm --needed "${_pkgs[@]}"
fi

# Install uv
if ! command -v uv &>/dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
{{- end }}

# =============================================================================
# Fedora Atomic - rpm-ostree base layer packages
# =============================================================================
{{- if $isFedoraAtomic }}
echo "Installing Fedora Atomic base layer packages via rpm-ostree..."

_pacfile="{{ .chezmoi.sourceDir }}/dot_private/Rpmfile_fedora_atomic"
if [[ -f "$_pacfile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_pacfile" | grep -v '^\s*$')
    for _pkg in "${_pkgs[@]}"; do
        if ! rpm -q "$_pkg" &>/dev/null; then
            echo "  Installing $_pkg..."
            sudo rpm-ostree install --apply-live "$_pkg" 2>/dev/null || \
                echo "  Warning: could not install $_pkg (may need reboot)"
        fi
    done
fi
{{- end }}

# =============================================================================
# GUI Apps — only install if a display server is present
# =============================================================================
if _has_gui; then
    echo "🖥️ Display server detected, installing GUI apps..."

{{- if $isUbuntuDesktop }}
    _guifile="{{ .chezmoi.sourceDir }}/dot_private/Aptfile_ubuntu_gui"
    if [[ -f "$_guifile" ]]; then
        mapfile -t _guipkgs < <(grep -v '^\s*#' "$_guifile" | grep -v '^\s*$')
        [[ ${#_guipkgs[@]} -gt 0 ]] && sudo apt-get install -y "${_guipkgs[@]}"
    fi

    # Zed Editor — no official apt repo, use native installer
    if ! command -v zed &>/dev/null; then
        echo "🖊️ Installing Zed Editor..."
        curl -f https://zed.dev/install.sh | sh 2>/dev/null || true
    fi
{{- end }}

{{- if $isFedoraDesktop }}
    _guifile="{{ .chezmoi.sourceDir }}/dot_private/Dnffile_fedora_gui"
    if [[ -f "$_guifile" ]]; then
        mapfile -t _guipkgs < <(grep -v '^\s*#' "$_guifile" | grep -v '^\s*$')
        [[ ${#_guipkgs[@]} -gt 0 ]] && sudo dnf install -y --skip-unavailable "${_guipkgs[@]}"
    fi

    # Zed Editor — no official dnf repo, use native installer
    if ! command -v zed &>/dev/null; then
        echo "🖊️ Installing Zed Editor..."
        curl -f https://zed.dev/install.sh | sh
    fi
{{- end }}

{{- if $isRPi }}
    _guifile="{{ .chezmoi.sourceDir }}/dot_private/Aptfile_rpi_gui"
    if [[ -f "$_guifile" ]]; then
        mapfile -t _guipkgs < <(grep -v '^\s*#' "$_guifile" | grep -v '^\s*$')
        [[ ${#_guipkgs[@]} -gt 0 ]] && sudo apt-get install -y "${_guipkgs[@]}"
    fi
    # Pi-Apps GUI apps handled by run_once_install-pi-apps.sh
{{- end }}

{{- if or $isArchDesktop $isOmArchy }}
    _guifile="{{ .chezmoi.sourceDir }}/dot_private/Pacfile_arch_gui"
    if [[ -f "$_guifile" ]]; then
        mapfile -t _guipkgs < <(grep -v '^\s*#' "$_guifile" | grep -v '^\s*$')
        [[ ${#_guipkgs[@]} -gt 0 ]] && sudo pacman -S --noconfirm --needed "${_guipkgs[@]}"
    fi

    _aurguifile="{{ .chezmoi.sourceDir }}/dot_private/Pacfile_aur_gui"
    if [[ -f "$_aurguifile" ]] && command -v yay &>/dev/null; then
        mapfile -t _aurguipkgs < <(grep -v '^\s*#' "$_aurguifile" | grep -v '^\s*$')
        [[ ${#_aurguipkgs[@]} -gt 0 ]] && yay -S --noconfirm --needed --answerdiff=None --answerclean=None "${_aurguipkgs[@]}"
    fi
{{- end }}

else
    echo "🖥️ No display server detected, skipping GUI apps"
fi

# =============================================================================
# CLI AI Tools (all profiles except toolbox and fedora-atomic)
# =============================================================================
{{- if not (or $isToolbox $isFedoraAtomic) }}

{{- if or $isArchDesktop $isOmArchy $isArchServer }}
# Arch/OmArchy — install via AUR (native > script)
if command -v yay &>/dev/null; then
    yay -S --noconfirm --needed --answerdiff=None --answerclean=None claude-code github-copilot-cli-bin openai-codex-bin rtk-bin 2>/dev/null || true
fi
{{- else }}
# Priority: native repos > brew formula > install script (last resort)
# claude-code and copilot-cli are macOS casks only (no Linux brew formula).
# codex has a brew formula that may work on Linux.

# Claude Code (cask only on macOS — script on Linux)
if ! command -v claude &>/dev/null; then
    echo "🤖 Installing Claude Code..."
    curl -fsSL https://claude.ai/install.sh | bash
fi

# GitHub Copilot CLI (cask only on macOS — script on Linux)
if ! command -v copilot-cli &>/dev/null; then
    echo "🤖 Installing GitHub Copilot CLI..."
    curl -fsSL https://gh.io/copilot-install | bash 2>/dev/null || true
fi

# Codex CLI (cask on macOS only — npm on Linux)
if ! command -v codex &>/dev/null; then
    if command -v npm &>/dev/null; then
        echo "🤖 Installing Codex CLI via npm..."
        # Ensure npm global installs go to user directory (avoids EACCES)
        if [[ -z "$(npm config get prefix 2>/dev/null | grep -v '/usr')" ]]; then
            mkdir -p "${HOME}/.npm-global"
            npm config set prefix "${HOME}/.npm-global"
            export PATH="${HOME}/.npm-global/bin:${PATH}"
        fi
        npm i -g @openai/codex
    else
        echo "⚠️ npm not found, skipping Codex CLI"
    fi
fi
{{- end }}

# RTK (Rust Token Killer) — brew formula available, curl fallback
if ! command -v rtk &>/dev/null; then
    if command -v brew &>/dev/null; then
        echo "🤖 Installing RTK via brew..."
        brew install rtk 2>/dev/null || {
            echo "🤖 Brew failed, falling back to installer..."
            curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/master/install.sh | sh 2>/dev/null || true
        }
    else
        echo "🤖 Installing RTK via installer..."
        curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/master/install.sh | sh 2>/dev/null || {
            echo "⚠️ RTK install failed (GitHub API rate limit?), will retry next chezmoi apply"
        }
    fi
fi

# OpenCode CLI — handled by brew bundle (Brewfile_brew_only)
{{- end }}

echo "Linux packages installation complete!"
{{- end }}
