{{- if eq .chezmoi.os "linux" -}}
{{- $mp              := index . "machine_profile" -}}
{{- $isRPi           := eq $mp "rpi" -}}
{{- $isDebian        := eq $mp "debian" -}}
{{- $isUbuntuServer  := eq $mp "ubuntu-server" -}}
{{- $isUbuntuDesktop := eq $mp "ubuntu-desktop" -}}
{{- $isUbuntu        := or $isUbuntuServer $isUbuntuDesktop -}}
{{- $isFedoraAtomic  := eq $mp "fedora-atomic" -}}
{{- $isToolbox       := eq $mp "toolbox" -}}
{{- $isFedoraDesktop := eq $mp "fedora-desktop" -}}
{{- $isFedoraServer  := eq $mp "fedora-server" -}}
{{- $isFedora        := or $isFedoraDesktop $isFedoraServer -}}
{{- $isOmArchy       := eq $mp "omarchy" -}}
{{- $isArchDesktop   := eq $mp "arch-desktop" -}}
{{- $isArchServer    := eq $mp "arch-server" -}}
{{- $isArch          := or $isArchDesktop $isArchServer $isOmArchy -}}
#!/usr/bin/env bash
# =============================================================================
# Linux Packages Installation - apt, dnf, rpm-ostree
# =============================================================================

# Manifest checksums — chezmoi reruns this script when any of these change:
{{- if $isRPi }}
# Aptfile_rpi:            {{ include "dot_private/Aptfile_rpi" | sha256sum }}
{{- end }}
{{- if $isUbuntuServer }}
# Aptfile_ubuntu_server:  {{ include "dot_private/Aptfile_ubuntu_server" | sha256sum }}
{{- end }}
{{- if $isUbuntuDesktop }}
# Aptfile_ubuntu_desktop: {{ include "dot_private/Aptfile_ubuntu_desktop" | sha256sum }}
{{- end }}
{{- if $isFedoraServer }}
# Dnffile_fedora_server:  {{ include "dot_private/Dnffile_fedora_server" | sha256sum }}
{{- end }}
{{- if $isDebian }}
# Aptfile_debian:         {{ include "dot_private/Aptfile_debian" | sha256sum }}
{{- end }}
{{- if $isFedoraDesktop }}
# Dnffile_fedora_desktop: {{ include "dot_private/Dnffile_fedora_desktop" | sha256sum }}
{{- end }}
{{- if or $isArchDesktop $isOmArchy }}
# Pacfile_arch_desktop:   {{ include "dot_private/Pacfile_arch_desktop" | sha256sum }}
# Pacfile_aur_desktop:    {{ include "dot_private/Pacfile_aur_desktop" | sha256sum }}
# Pacfile_arch_gui:       {{ include "dot_private/Pacfile_arch_gui" | sha256sum }}
# Pacfile_aur_gui:        {{ include "dot_private/Pacfile_aur_gui" | sha256sum }}
{{- end }}
{{- if $isUbuntuDesktop }}
# Snapfile_ubuntu_desktop: {{ include "dot_private/Snapfile_ubuntu_desktop" | sha256sum }}
{{- end }}
{{- if $isArchServer }}
# Pacfile_arch_server:    {{ include "dot_private/Pacfile_arch_server" | sha256sum }}
{{- end }}
{{- if $isFedoraAtomic }}
# Rpmfile_fedora_atomic:  {{ include "dot_private/Rpmfile_fedora_atomic" | sha256sum }}
{{- end }}

set -uo pipefail

# A single failed package must never abort `chezmoi apply` and block the rest of
# the config (mirrors run_onchange_03-brew-bundle.sh). Failures are collected and
# reported at the end instead of aborting.
_PKG_FAILURES=()
_pkgfail() {
    _PKG_FAILURES+=("$1")
    echo "  ⚠️  ${1} failed — continuing so the rest of the config still applies" >&2
}

# Cache directory for large installer scripts
CHEZMOI_DL_CACHE="${XDG_CACHE_HOME:-${HOME}/.cache}/chezmoi-downloads"
mkdir -p "${CHEZMOI_DL_CACHE}"

# Ensure brew is in PATH if installed (chezmoi scripts run in isolated subshells)
# Check binary directly — directory may exist before brew is fully installed
if [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x "${HOME}/.linuxbrew/bin/brew" ]]; then
    eval "$("${HOME}/.linuxbrew/bin/brew" shellenv)"
fi

# Initialize git-lfs if available (required for .wallpapers repo)
if command -v git-lfs &>/dev/null; then
    git lfs install --skip-smudge 2>/dev/null || true
fi

# Detect if a display server / desktop environment is installed
_has_gui() {
    command -v Xorg &>/dev/null || \
    command -v Xwayland &>/dev/null || \
    command -v gnome-shell &>/dev/null || \
    command -v plasmashell &>/dev/null || \
    command -v hyprctl &>/dev/null || \
    command -v sway &>/dev/null || \
    command -v startx &>/dev/null
}

_cached_fetch() {
    local url="$1"
    local dest="${CHEZMOI_DL_CACHE}/$(basename "$url")"

    if [[ ! -f "$dest" ]]; then
        curl -fsSL "$url" -o "$dest"
    fi

    echo "$dest"
}

_install_starship() {
    if command -v starship &>/dev/null; then
        return 0
    fi

    echo "Installing starship..."
    local arch
    arch="$(uname -m 2>/dev/null || echo unknown)"
    local platform_arg=()
    case "$arch" in
        x86_64)
            platform_arg=(--platform x86_64-unknown-linux-musl)
            ;;
        aarch64|arm64)
            platform_arg=(--platform aarch64-unknown-linux-musl)
            ;;
    esac

    local installer
    installer="$(_cached_fetch "https://starship.rs/install.sh")"

    if ! sh "$installer" -s -- -y "${platform_arg[@]}"; then
        echo "Starship install script failed, falling back to cargo..." >&2
        if command -v cargo &>/dev/null; then
            cargo install --locked starship && return 0
            echo "Warning: cargo install starship failed. Install manually from https://starship.rs" >&2
        else
            echo "Warning: cargo not available for starship fallback. Install manually from https://starship.rs" >&2
        fi
        return 1
    fi
}

_install_eza() {
    if command -v eza &>/dev/null; then
        return 0
    fi

    if command -v apt-get &>/dev/null; then
        echo "Installing eza via apt..."
        if sudo DEBIAN_FRONTEND=noninteractive apt-get install -y eza; then
            return 0
        fi
        echo "apt install eza failed, falling back..." >&2
    elif command -v dnf &>/dev/null; then
        echo "Installing eza via dnf..."
        if sudo dnf install -y eza; then
            return 0
        fi
        echo "dnf install eza failed, falling back..." >&2
    elif command -v pacman &>/dev/null; then
        echo "Installing eza via pacman..."
        if sudo pacman -S --needed --noconfirm eza; then
            return 0
        fi
        echo "pacman install eza failed, falling back..." >&2
    elif command -v brew &>/dev/null; then
        echo "Installing eza via Homebrew..."
        if brew install eza; then
            return 0
        fi
        echo "brew install eza failed, falling back..." >&2
    fi

    if command -v cargo &>/dev/null; then
        echo "Installing eza via cargo..."
        cargo install eza && return 0
        echo "Warning: cargo install eza failed." >&2
    else
        echo "cargo not found — skipping eza (install Rust first)" >&2
    fi

    return 1
}

# =============================================================================
# Raspberry Pi / Debian - apt packages
# =============================================================================
{{- if $isRPi }}
echo "Installing Raspberry Pi packages via apt..."

# Install packages from Aptfile manifest
_aptfile="{{ .chezmoi.sourceDir }}/dot_private/Aptfile_rpi"
if [[ -f "$_aptfile" ]]; then
    mapfile -t _pkgs < <(grep -v '^\s*#' "$_aptfile" | grep -v '^\s*$')
    sudo apt update && sudo apt-get install -y "${_pkgs[@]}" || _pkgfail "apt: rpi base packages"
fi

# Per-hostname overlay: machine-specific apt packages layered on top of the base.
_hostaptfile="{{ .chezmoi.sourceDir }}/dot_private/Aptfile_{{ .chezmoi.hostname }}"
if [[ -f "$_hostaptfile" ]]; then
    mapfile -t _hostpkgs < <(grep -v '^\s*#' "$_hostaptfile" | grep -v '^\s*$')
    if (( ${#_hostpkgs[@]} )); then
        echo "📦 apt install (hostname overlay: {{ .chezmoi.hostname }})"
        sudo apt-get install -y "${_hostpkgs[@]}" || _pkgfail "apt: hostname overlay"
    fi
fi

# 1Password CLI — handled by run_once_install-1password.sh

# Install gh CLI via official apt keyring
if ! command -v gh &>/dev/null; then
    echo "Installing gh (GitHub CLI)..."
    tmp_key="$(mktemp)"
    if ! command -v wget &>/dev/null; then
        sudo apt install -y wget || _pkgfail "apt: wget (rpi)"
    fi
    wget -nv -O "$tmp_key" https://cli.github.com/packages/githubcli-archive-keyring.gpg
    sudo mkdir -p -m 755 /etc/apt/keyrings
    sudo install -m 644 "$tmp_key" /etc/apt/keyrings/githubcli-archive-keyring.gpg
    rm -f "$tmp_key"
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt update
    sudo apt install -y gh || _pkgfail "apt: gh (rpi)"
fi

# Install uv (provides uvx for MCP servers using Python)
if ! command -v uv &>/dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
{{- end }}

# =============================================================================
