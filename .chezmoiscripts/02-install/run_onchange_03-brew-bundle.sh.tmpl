{{- if lookPath "brew" -}}
#!/usr/bin/env bash

# Active layers only; changing another profile does not rerun this installer.
# filter: {{ include "dot_local/bin/executable_brewfile-filter-bottled" | sha256sum }}
{{- $selection := includeTemplate "package-files" (dict "data" . "manager" "brew") | fromJson }}
# selection: {{ $selection | toJson | sha256sum }}
{{- range $selection.files }}
# {{ . }}: {{ include (printf "dot_private/%s" .) | sha256sum }}
{{- end }}

set -uo pipefail  # no -e: brew bundle returns non-zero if some deps fail (non-fatal)
eval "$(brew shellenv)"

BREWFILE_DIR="{{ .chezmoi.sourceDir }}/dot_private"
FILTER_PY="{{ .chezmoi.sourceDir }}/dot_local/bin/executable_brewfile-filter-bottled"

# Refresh PATH to include brew-installed runtimes (node, go, cargo)
_refresh_brew_path() {
  eval "$(brew shellenv)"
  # Add brew bin dirs explicitly — needed for `env node` in npm shebangs
  local prefix
  prefix="$(brew --prefix)"
  export PATH="$prefix/bin:$prefix/sbin:$PATH"
  hash -r 2>/dev/null || true
}

# Drop formulae Homebrew cannot pour (Tier 3 / no bottle). See brewfile-filter-bottled.
_filter_unbottled() {
  local input filtered
  input="$(cat)"
  if [[ -f "$FILTER_PY" ]] && command -v python3 >/dev/null; then
    if filtered="$(printf '%s\n' "$input" | python3 "$FILTER_PY")"; then
      printf '%s\n' "$filtered"
      return 0
    fi
  fi
  printf '%s\n' "$input"
}

echo "🍺 brew bundle install ({{ $selection.package_profile }}, {{ $selection.hostname }})"
# Inline the effective manifest: no deployed Python or package-plan needed on first apply.
combined="$(_filter_unbottled <<'CHEZMOI_SELECTED_BREWFILE'
{{ includeTemplate "package-manifest" (dict "data" . "manager" "brew") }}
CHEZMOI_SELECTED_BREWFILE
)" || exit 1
[[ -n "$combined" ]] || exit 0
printf '%s\n' "$combined" | grep -E '^(brew |tap |cask |mas )' | brew bundle install --file=- || true
_refresh_brew_path
# The final pass must fail visibly so chezmoi retries instead of recording success.
printf '%s\n' "$combined" | brew bundle install --file=-
{{ end -}}
