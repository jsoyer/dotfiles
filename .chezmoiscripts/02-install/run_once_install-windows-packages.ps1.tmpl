{{- if eq .chezmoi.os "windows" -}}
# Installs packages via Scoop on Windows machines.

#Requires -Version 5.1

# =============================================================================
# Install Scoop if not present
# =============================================================================
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Host "Installing Scoop..." -ForegroundColor Cyan
    Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
    Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
}

# =============================================================================
# Add buckets
# =============================================================================
Write-Host "Adding Scoop buckets..." -ForegroundColor Cyan
if (-not (scoop bucket list | Select-String -Quiet 'extras'))        { scoop bucket add extras }
if (-not (scoop bucket list | Select-String -Quiet 'versions'))      { scoop bucket add versions }
if (-not (scoop bucket list | Select-String -Quiet 'nirsoft'))       { scoop bucket add nirsoft }
if (-not (scoop bucket list | Select-String -Quiet 'sysinternals'))  { scoop bucket add sysinternals https://github.com/niheaven/scoop-sysinternals }
if (-not (scoop bucket list | Select-String -Quiet 'nerd-fonts'))    { scoop bucket add nerd-fonts https://github.com/matthewjberger/scoop-nerd-fonts }
if (-not (scoop bucket list | Select-String -Quiet 'nonportable'))   { scoop bucket add nonportable }
if (-not (scoop bucket list | Select-String -Quiet 'java'))          { scoop bucket add java }

# =============================================================================
# Install packages
# =============================================================================
function Install-ScoopPackages {
    param([string[]]$Packages)
    $installed = scoop list 2>$null | Select-Object -ExpandProperty Name
    $missing = $Packages | Where-Object { $_ -notin $installed }
    if ($missing) {
        scoop install $missing
    }
}

Write-Host "Installing Scoop packages (main)..." -ForegroundColor Cyan
Install-ScoopPackages @(
    '1password-cli', '7zip', 'chezmoi', 'claude-code', 'codex',
    'dark', 'docker', 'git', 'innounp', 'neovim', 'opencode', 'uv'
)

Write-Host "Installing Scoop packages (extras)..." -ForegroundColor Cyan
Install-ScoopPackages @(
    'brave', 'chatgpt', 'discord', 'googlechrome', 'komorebi',
    'powertoys', 'sysinternals', 'tor-browser', 'vscode', 'whkd', 'zed'
)

Write-Host "Installing Scoop packages (versions)..." -ForegroundColor Cyan
Install-ScoopPackages @('jdownloader')

Write-Host "Installing Scoop packages (java)..." -ForegroundColor Cyan
Install-ScoopPackages @('temurin25-jre')

Write-Host "Scoop setup complete." -ForegroundColor Green
{{ end -}}
