{{- if eq .chezmoi.os "windows" -}}
{{ printf "\ufeff" }}# Installs packages via Scoop on Windows machines.

#Requires -Version 5.1
# Do NOT set ErrorActionPreference = 'Stop' — a single failed package must never
# abort chezmoi apply and block the rest of the config. Failures are collected and
# reported at the end instead.
$ErrorActionPreference = 'Continue'
Set-StrictMode -Version Latest

$pkgFailures = [System.Collections.Generic.List[string]]::new()

$scoopManifest = @'
{{ includeTemplate "package-manifest" (dict "data" . "manager" "scoop") }}
'@ | ConvertFrom-Json

# =============================================================================
# Install Scoop if not present
# =============================================================================
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Host "Installing Scoop..." -ForegroundColor Cyan
    Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
    Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
}

# Bypass the interactive scoop alias while provisioning the declared selection.
$nativeScoop = Get-Command scoop -CommandType Function, ExternalScript, Application -ErrorAction Stop | Select-Object -First 1

# =============================================================================
# Add buckets
# =============================================================================
Write-Host "Adding Scoop buckets..." -ForegroundColor Cyan
foreach ($bucket in $scoopManifest.buckets) {
    if (-not (& $nativeScoop bucket list | Select-String -Quiet $bucket.name)) {
        if ($bucket.source) {
            & $nativeScoop bucket add $bucket.name $bucket.source
        } else {
            & $nativeScoop bucket add $bucket.name
        }
        if ($LASTEXITCODE -ne 0) { $pkgFailures.Add("scoop bucket: $($bucket.name)") }
    }
}

# =============================================================================
# Install packages
# =============================================================================
$scoopPath = if ($env:SCOOP) { $env:SCOOP } else { Join-Path $env:USERPROFILE 'scoop' }

function Install-ScoopPackages {
    param($App)
    $package = $App.name
    if ($App.PSObject.Properties['bucket'] -and $App.bucket) { $package = "$($App.bucket)/$package" }
    $hasVersion = $App.PSObject.Properties['version'] -and $App.version
    if ($hasVersion) { $package += "@$($App.version)" }
    $installArgs = @('install', $package)
    if ($App.PSObject.Properties['architecture'] -and $App.architecture) { $installArgs += @('--arch', $App.architecture) }
    $root = $scoopPath
    if ($App.PSObject.Properties['global'] -and $App.global) {
        $installArgs += '--global'
        $root = if ($env:SCOOP_GLOBAL) { $env:SCOOP_GLOBAL } else { Join-Path $env:ProgramData 'scoop' }
    }
    if ($hasVersion -or -not (Test-Path (Join-Path $root "apps/$($App.name)/current"))) {
        & $nativeScoop @installArgs
        if ($LASTEXITCODE -ne 0) { return $false }
    }
    return $true
}

Write-Host "Installing Scoop packages (main)..." -ForegroundColor Cyan
foreach ($app in $scoopManifest.apps) {
    try {
        $ok = Install-ScoopPackages $app
        if (-not $ok) {
            $msg = "scoop: $($app.name)"
            Write-Warning "  ⚠️  $msg failed — continuing so the rest of the config still applies"
            $pkgFailures.Add($msg)
        }
    } catch {
        $msg = "scoop: $($app.name)"
        Write-Warning "  ⚠️  $msg failed ($($_)) — continuing so the rest of the config still applies"
        $pkgFailures.Add($msg)
    }
}

if ($pkgFailures.Count -gt 0) {
    Write-Host ""
    Write-Host "⚠️  Some packages failed to install (your dotfiles config was still applied):" -ForegroundColor Yellow
    foreach ($f in $pkgFailures) { Write-Host "   - $f" -ForegroundColor Yellow }
    Write-Host "   Fix the cause and re-run: chezmoi apply" -ForegroundColor Yellow
    exit 1
}

Write-Host "Scoop setup complete." -ForegroundColor Green
{{ end -}}
