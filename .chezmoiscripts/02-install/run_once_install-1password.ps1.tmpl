{{- if eq .chezmoi.os "windows" -}}
#Requires -Version 5.1
# =============================================================================
# 1Password Installation - Windows
# =============================================================================
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

# Install 1Password app via MSIX
$op1PExe = Join-Path $env:ProgramFiles '1Password\1Password.exe'
if (Test-Path $op1PExe) {
    Write-Host "1Password already installed" -ForegroundColor Green
} else {
    Write-Host "Installing 1Password..." -ForegroundColor Cyan

    $tempDir = Join-Path $env:TEMP ([System.IO.Path]::GetRandomFileName())
    New-Item -ItemType Directory -Path $tempDir -Force | Out-Null

    try {
        $msixUrl = "https://c.1password.com/dist/1P/win8/1PasswordSetup-latest.msixbundle"
        $msixPath = "$tempDir\1PasswordSetup-latest.msixbundle"

        Write-Host "Downloading 1Password..." -ForegroundColor Cyan
        Invoke-WebRequest -Uri $msixUrl -OutFile $msixPath -UseBasicParsing

        Write-Host "Running installer..." -ForegroundColor Cyan
        Add-AppxPackage -Path $msixPath

        Write-Host "1Password installed" -ForegroundColor Green
    } catch {
        Write-Host "Failed to install 1Password: $_" -ForegroundColor Red
        throw
    } finally {
        Remove-Item $tempDir -Recurse -Force -ErrorAction SilentlyContinue
    }
}

# Install 1Password CLI via Scoop
if (Get-Command op -ErrorAction SilentlyContinue) {
    Write-Host "1Password CLI already installed" -ForegroundColor Green
} else {
    Write-Host "Installing 1Password CLI via Scoop..." -ForegroundColor Cyan
    scoop install 1password-cli
}
{{- end -}}
