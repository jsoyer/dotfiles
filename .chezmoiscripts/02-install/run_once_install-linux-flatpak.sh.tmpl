{{- if eq .chezmoi.os "linux" -}}
{{- if lookPath "rpm-ostree" -}}
#!/bin/bash
# =============================================================================
# Flatpak Packages Installation (Fedora Atomic)
# =============================================================================

set -eufo pipefail

echo "📦 Setting up Flatpak..."

# Check if flatpak is installed, install if not
if ! command -v flatpak &>/dev/null; then
    echo "📦 Flatpak not found, installing..."
    sudo rpm-ostree install flatpak
    echo "⚠️  Flatpak installed. Reboot required, then run this script again."
    exit 0
fi

# Add flathub remote if not exists
if ! flatpak remote-list 2>/dev/null | grep -q flathub; then
    sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flathubrepo
fi

echo "📦 Installing Flatpak packages..."
# Install each package individually with sudo
for pkg in \
    best.ellie.StartupConfiguration \
    com.brave.Browser \
    com.discordapp.Discord \
    com.google.Chrome \
    com.obsproject.Studio \
    dev.edfloreshz.CosmicTweaks \
    dev.zed.Zed \
    io.dbeaver.DBeaverCommunity \
    io.github.BuddySirJava.SSH-Studio \
    io.github.cosmic_utils.camera \
    io.github.shiftey.Desktop \
    io.podman_desktop.PodmanDesktop \
    md.obsidian.Obsidian \
    org.fedoraproject.MediaWriter \
    org.filezillaproject.Filezilla \
    org.gnome.Firmware \
    org.gnome.Loupe \
    org.gnome.Photos \
    org.localsend.localsend_app \
    org.remmina.Remmina \
    org.signal.Signal \
    org.telegram.desktop \
    org.torproject.torbrowser-launcher \
    org.videolan.VLC \
    tech.feliciano.pocket-casts
do
    echo "  → Installing $pkg..."
    sudo flatpak install --system --noninteractive flathub "$pkg" || echo "  ⚠️  Failed to install $pkg"
done

echo "✅ Flatpak packages installation complete."
{{ end -}}
{{- end }}
