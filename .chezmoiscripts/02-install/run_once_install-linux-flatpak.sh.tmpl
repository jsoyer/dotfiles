{{- if eq .chezmoi.os "linux" -}}
{{- if lookPath "rpm-ostree" -}}
#!/bin/bash
# =============================================================================
# Flatpak Packages Installation (Fedora Atomic)
# =============================================================================

set -eufo pipefail

echo "📦 Setting up Flatpak..."

# Add flathub remote if not exists (ignore errors - may already be configured)
if ! flatpak remote-list 2>/dev/null | grep -q flathub; then
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
fi

echo "📦 Installing Flatpak packages..."
flatpak install -y flathub \
    com.brave.Browser \
    com.obsproject.Studio \
    dev.zed.Zed \
    io.dbeaver.DBeaverCommunity \
    io.podman_desktop.PodmanDesktop \
    md.obsidian.Obsidian \
    org.filezillaproject.Filezilla \
    org.kde.kitty \
    org.wezfurlong.wezterm \
    org.videolan.VLC 2>/dev/null || true

echo "✅ Flatpak packages installation complete."
{{ end -}}
{{- end }}
