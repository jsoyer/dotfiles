{{- $mp := index . "machine_profile" -}}
{{- $skipProfiles := list "fedora-server" "ubuntu-server" "arch-server" "debian" "windows" -}}
{{- $isOMV := or (hasPrefix "omv-" .chezmoi.hostname) (hasPrefix "bbh-network" .chezmoi.hostname) -}}
{{- if and (eq .chezmoi.os "linux") (not (has $mp $skipProfiles)) (not $isOMV) -}}
#!/usr/bin/env bash
# =============================================================================
# Linuxbrew (Homebrew for Linux) Installation
# =============================================================================

set -euo pipefail

if command -v brew &>/dev/null; then
    echo "Homebrew already installed, skipping."
    exit 0
fi

echo "Installing Homebrew (Linuxbrew)..."

# Prerequisites
{{- if eq $mp "fedora-atomic" }}
# Fedora Atomic: layer minimal build deps for brew (image stays mostly clean)
sudo rpm-ostree install --apply-live --idempotent gcc gcc-c++ make procps-ng file 2>/dev/null || true
{{- else if or (eq $mp "fedora-desktop") (eq $mp "toolbox") }}
sudo dnf install -y gcc gcc-c++ make procps-ng curl file git
{{- else if eq $mp "arch-desktop" }}
sudo pacman -S --needed --noconfirm base-devel procps-ng curl file gcc
{{- else }}
# rpi / debian / ubuntu-*
sudo apt-get update -q
sudo apt-get install -y build-essential procps curl file gcc
{{- end }}

/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Add brew to PATH for the rest of this session
if [[ -d "/home/linuxbrew/.linuxbrew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -d "${HOME}/.linuxbrew" ]]; then
    eval "$("${HOME}/.linuxbrew/bin/brew" shellenv)"
fi

echo "Homebrew installed: $(brew --version)"
{{ end -}}
