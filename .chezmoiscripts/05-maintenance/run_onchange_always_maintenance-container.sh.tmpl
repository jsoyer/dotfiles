{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/bash
# =============================================================================
# Container Maintenance - Docker/Podman, Containers, Images, and compose updates
# =============================================================================

set -e

# Detect container runtime (docker or podman)
if command -v docker &>/dev/null && docker info &>/dev/null 2>&1; then
    CONTAINER_RUNTIME="docker"
    EMOJI="🐳"
elif command -v podman &>/dev/null && podman info &>/dev/null 2>&1; then
    CONTAINER_RUNTIME="podman"
    EMOJI="🦭"
else
    echo "❌ No container runtime (Docker/Podman) is running. Skipping maintenance."
    exit 0
fi

echo "$EMOJI Starting container maintenance ($CONTAINER_RUNTIME)..."

# List running containers
echo "📋 Running containers:"
$CONTAINER_RUNTIME ps

echo ""
echo "📦 Updating compose projects..."

# Find all docker-compose.yml files in home directory and update them
find "$HOME" -name "docker-compose.yml" -not -path "*/.*" 2>/dev/null | while read -r compose_file; do
    project_dir=$(dirname "$compose_file")
    project_name=$(basename "$project_dir")
    
    echo "  → Updating $project_name in $project_dir"
    
    # Check if any container from this project is running
    if $CONTAINER_RUNTIME compose -f "$compose_file" ps --services --filter "status=running" 2>/dev/null | grep -q .; then
        echo "    ⏳ Pulling new images..."
        pull_output=$($CONTAINER_RUNTIME compose -f "$compose_file" pull 2>&1)
        
        # Check if new images were pulled
        if echo "$pull_output" | grep -qE "(Pulling|Downloading|Extracting|Status: Downloaded)"; then
            echo "    🔄 New images found, restarting containers..."
            $CONTAINER_RUNTIME compose -f "$compose_file" up -d
        else
            echo "    ✅ No new images, containers up to date"
        fi
    else
        echo "    ⏭️  Skipping (no running containers)"
    fi
done

echo ""
echo "🗑️ Cleaning up unused images..."

# Remove all unused images
$CONTAINER_RUNTIME image prune -a -f

echo ""
echo "✨ Container maintenance complete!"
{{- end -}}
