{{- if and (eq .chezmoi.os "linux") (contains "rpi" .chezmoi.kernel.osrelease) -}}
#!/bin/bash
# =============================================================================
# Raspberry Pi - Dependencies Installation Script
# =============================================================================
# This script runs automatically via chezmoi on first apply.
# OMZ, zsh plugins, and TPM are managed by .chezmoiexternal.toml.tmpl
# =============================================================================

set -e

echo "[chezmoi] Configuring locale..."

# Ensure en_US.UTF-8 is available on Debian-based systems
if ! locale -a 2>/dev/null | grep -qi "en_US.utf8"; then
    echo "en_US.UTF-8 not found. Generating..."
    sudo sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    sudo dpkg-reconfigure --frontend=noninteractive locales
    sudo update-locale LANG=en_US.UTF-8
fi

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

echo "[chezmoi] Installing dependencies via apt..."

sudo apt update && sudo apt install -y \
    chezmoi \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    eza \
    vivid \
    locales

# Create symlinks for renamed packages on Debian/Ubuntu
sudo ln -sf /usr/bin/batcat /usr/local/bin/bat 2>/dev/null || true
sudo ln -sf /usr/bin/fdfind /usr/local/bin/fd 2>/dev/null || true

echo "[chezmoi] Packages installed"

# =============================================================================
# Nerd Font Installation
# =============================================================================
if [[ ! -d "$HOME/.local/share/fonts/JetBrainsMonoNerdFont" ]]; then
    echo "[chezmoi] Installing JetBrains Mono Nerd Font..."
    mkdir -p "$HOME/.local/share/fonts/JetBrainsMonoNerdFont"
    cd "$HOME/.local/share/fonts/JetBrainsMonoNerdFont"
    curl -fLO "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz"
    tar -xf JetBrainsMono.tar.xz
    rm JetBrainsMono.tar.xz
    fc-cache -fv
    echo "[chezmoi] Nerd Font installed"
fi

# =============================================================================
# Set Zsh as default shell
# =============================================================================
if [[ "$SHELL" != *"zsh"* ]]; then
    echo "[chezmoi] Setting Zsh as default shell..."
    chsh -s "$(which zsh)"
    echo "[chezmoi] Default shell changed to Zsh (log out and back in to apply)"
fi

echo "[chezmoi] Raspberry Pi setup complete!"
{{- end -}}
