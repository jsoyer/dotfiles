{{- if eq .chezmoi.os "linux" -}}
{{- $mp              := index . "machine_profile" -}}
{{- $isRPi           := eq $mp "rpi" -}}
{{- $isDebian        := eq $mp "debian" -}}
{{- $isUbuntuServer  := eq $mp "ubuntu-server" -}}
{{- $isUbuntuDesktop := eq $mp "ubuntu-desktop" -}}
{{- $isUbuntu        := or $isUbuntuServer $isUbuntuDesktop -}}
{{- $isFedoraAtomic  := eq $mp "fedora-atomic" -}}
{{- $isToolbox       := eq $mp "toolbox" -}}
{{- $isFedoraDesktop := eq $mp "fedora-desktop" -}}
{{- $isFedoraServer  := eq $mp "fedora-server" -}}
{{- $isFedora        := or $isFedoraDesktop $isFedoraServer -}}
{{- $isOmArchy       := eq $mp "omarchy" -}}
{{- $isArchDesktop   := eq $mp "arch-desktop" -}}
{{- $isArchServer    := eq $mp "arch-server" -}}
{{- $isArch          := or $isArchDesktop $isArchServer $isOmArchy -}}
#!/usr/bin/env bash
# =============================================================================
# Linux Setup - Locale, Repositories, Tailscale
# =============================================================================

set -euo pipefail

# =============================================================================
# Raspberry Pi / Debian / Ubuntu - Locale configuration
# =============================================================================
{{- if or $isRPi $isDebian $isUbuntu }}
echo "Configuring locale..."

if ! locale -a 2>/dev/null | grep -qi "en_US.utf8"; then
    echo "en_US.UTF-8 not found. Generating..."
    sudo sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    sudo dpkg-reconfigure --frontend=noninteractive locales
    sudo update-locale LANG=en_US.UTF-8
fi

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Create symlinks for renamed packages on Debian/Ubuntu
sudo ln -sf /usr/bin/batcat /usr/local/bin/bat 2>/dev/null || true
sudo ln -sf /usr/bin/fdfind /usr/local/bin/fd 2>/dev/null || true
{{- end }}

# =============================================================================
# Arch Linux - Locale configuration
# =============================================================================
{{- if $isArch }}
echo "Configuring Arch Linux locale..."
if ! grep -q "^en_US.UTF-8 UTF-8" /etc/locale.gen 2>/dev/null; then
    echo "en_US.UTF-8 UTF-8" | sudo tee -a /etc/locale.gen > /dev/null
    sudo locale-gen
fi
if [[ ! -f /etc/locale.conf ]]; then
    echo "LANG=en_US.UTF-8" | sudo tee /etc/locale.conf > /dev/null
fi
{{- end }}

# =============================================================================
# Ubuntu Desktop - Third-party APT repositories
# =============================================================================
{{- if $isUbuntuDesktop }}
echo "📦 Adding third-party APT repositories..."

sudo mkdir -p -m 755 /etc/apt/keyrings

# Brave Browser
if [[ ! -f /etc/apt/sources.list.d/brave-browser-release.list ]]; then
    echo "  Adding Brave Browser repo..."
    curl -fsSL https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg \
        | sudo gpg --yes --dearmor -o /etc/apt/keyrings/brave-browser-archive-keyring.gpg
    echo "deb [signed-by=/etc/apt/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" \
        | sudo tee /etc/apt/sources.list.d/brave-browser-release.list > /dev/null
fi

# Google Chrome
if [[ ! -f /etc/apt/sources.list.d/google-chrome.list ]]; then
    echo "  Adding Google Chrome repo..."
    curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
        | sudo gpg --yes --dearmor -o /etc/apt/keyrings/google-chrome.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
        | sudo tee /etc/apt/sources.list.d/google-chrome.list > /dev/null
fi

# Signal Desktop
if [[ ! -f /etc/apt/sources.list.d/signal-xenial.list ]]; then
    echo "  Adding Signal Desktop repo..."
    curl -fsSL https://updates.signal.org/desktop/apt/keys.asc \
        | sudo gpg --yes --dearmor -o /etc/apt/keyrings/signal-desktop-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/signal-desktop-keyring.gpg] https://updates.signal.org/desktop/apt xenial main" \
        | sudo tee /etc/apt/sources.list.d/signal-xenial.list > /dev/null
fi

# Zed Editor — no official apt repo, installed via curl script in install-linux-packages

sudo apt update
{{- end }}

# =============================================================================
# Fedora Standard - COPR repositories
# =============================================================================
{{- if and (lookPath "dnf") (not (lookPath "rpm-ostree")) (not (stat "/.toolboxenv")) (not (env "TOOLBOX_PATH")) }}
echo "📦 Enabling COPR repositories..."

sudo dnf copr enable -y alternateved/eza
sudo dnf copr enable -y atim/starship
sudo dnf copr enable -y skoved/vivid
sudo dnf copr enable -y atim/nushell
{{- end }}

# =============================================================================
# Fedora Desktop - Third-party DNF repositories
# =============================================================================
{{- if $isFedoraDesktop }}
echo "📦 Adding third-party DNF repositories..."

# Brave Browser
if [[ ! -f /etc/yum.repos.d/brave-browser.repo ]]; then
    echo "  Adding Brave Browser repo..."
    sudo dnf config-manager addrepo --from-repofile=https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo
fi

# Google Chrome
if [[ ! -f /etc/yum.repos.d/google-chrome.repo ]]; then
    echo "  Adding Google Chrome repo..."
    sudo rpm --import https://dl.google.com/linux/linux_signing_key.pub
    cat << 'REPO' | sudo tee /etc/yum.repos.d/google-chrome.repo > /dev/null
[google-chrome]
name=Google Chrome
baseurl=https://dl.google.com/linux/chrome/rpm/stable/x86_64
enabled=1
gpgcheck=1
gpgkey=https://dl.google.com/linux/linux_signing_key.pub
REPO
fi

# Note: Zed on Fedora — no official dnf repo, installed via script in install-linux-packages
{{- end }}

# =============================================================================
# Tailscale Installation (all Linux profiles except toolbox)
# =============================================================================
{{- if not $isToolbox }}

{{- if or $isRPi $isDebian $isUbuntu }}
# Debian/Ubuntu/RPi - Tailscale via official apt repo
if ! command -v tailscale &>/dev/null; then
    echo "🔒 Installing Tailscale..."
    curl -fsSL https://tailscale.com/install.sh | sh
    sudo systemctl enable --now tailscaled || true
    echo "🔒 Tailscale installed. Run 'sudo tailscale up' to authenticate."
else
    sudo systemctl enable --now tailscaled 2>/dev/null || true
    echo "🔒 Tailscale already installed"
fi
{{- end }}

{{- if $isArch }}
# Arch Linux - Tailscale via pacman
if ! command -v tailscale &>/dev/null; then
    echo "🔒 Installing Tailscale..."
    sudo pacman -S --needed --noconfirm tailscale
    sudo systemctl enable --now tailscaled || true
    echo "🔒 Tailscale installed. Run 'sudo tailscale up' to authenticate."
else
    sudo systemctl enable --now tailscaled 2>/dev/null || true
    echo "🔒 Tailscale already installed"
fi
{{- end }}

{{- if $isFedora }}
# Fedora - Tailscale via official dnf repo
if ! rpm -q tailscale &>/dev/null; then
    echo "🔒 Installing Tailscale..."
    sudo dnf config-manager addrepo --from-repofile=https://pkgs.tailscale.com/stable/fedora/tailscale.repo
    sudo dnf install -y tailscale
    sudo systemctl enable --now tailscaled || true
    echo "🔒 Tailscale installed. Run 'sudo tailscale up' to authenticate."
else
    sudo systemctl enable --now tailscaled 2>/dev/null || true
    echo "🔒 Tailscale already installed"
fi
{{- end }}

{{- if $isFedoraAtomic }}
# Fedora Atomic - Tailscale via rpm-ostree
if ! rpm -q tailscale &>/dev/null; then
    echo "🔒 Installing Tailscale..."
    sudo curl -fsSL https://pkgs.tailscale.com/stable/fedora/tailscale.repo \
        -o /etc/yum.repos.d/tailscale.repo 2>/dev/null || true
    sudo rpm-ostree install --idempotent --apply-live tailscale 2>/dev/null || true
    sudo systemctl enable --now tailscaled 2>/dev/null || true
    echo "🔒 Tailscale installation attempted. Run 'sudo tailscale up' to authenticate."
else
    sudo systemctl enable --now tailscaled 2>/dev/null || true
    echo "🔒 Tailscale already installed"
fi
{{- end }}

{{- end }}

echo "✅ Linux setup complete!"
{{- end }}
