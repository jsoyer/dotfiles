#!/bin/bash
# =============================================================================
# Fedora Standard - Dependencies Installation Script
# =============================================================================
# This script runs automatically via chezmoi on first apply for this profile.
# =============================================================================
{{- $isToolbox := stat "/.toolboxenv" }}
{{- $isStandardFedora := and (lookPath "dnf") (not (lookPath "rpm-ostree")) }}
{{- if not (or $isToolbox $isStandardFedora) }}
# Not a Fedora Standard or Toolbox system, skipping
exit 0
{{- end }}

set -eufo pipefail

echo "[chezmoi] Installing Fedora Standard dependencies via dnf..."

echo "Enabling COPR repositories..."
sudo dnf copr enable -y alternateved/eza
sudo dnf copr enable -y atim/starship
sudo dnf copr enable -y skoved/vivid

# Install packages (skip already installed or unavailable)
sudo dnf install -y --skip-unavailable \
    eza \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    vivid \
    jetbrains-mono-fonts-all \
    util-linux-user # For chsh

echo "[chezmoi] Packages installed"

# Note: oh-my-zsh, zsh plugins, powerlevel10k, and tpm are managed by chezmoiexternal.toml

echo "[chezmoi] Fedora Standard setup complete!"
