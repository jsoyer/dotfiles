{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# =============================================================================
# Fedora Standard - Dependencies Installation Script
# =============================================================================
# This script runs automatically via chezmoi on first apply for this profile.
# =============================================================================
{{- $isToolbox := stat "/.toolboxenv" }}
{{- $isStandardFedora := and (lookPath "dnf") (not (lookPath "rpm-ostree")) }}
{{- if not (or $isToolbox $isStandardFedora) }}
# Not a Fedora Standard or Toolbox system, skipping
exit 0
{{- end }}

set -eufo pipefail

echo "[chezmoi] Installing Fedora Standard dependencies via dnf..."

echo "Enabling COPR repositories..."
sudo dnf copr enable -y alternateved/eza
sudo dnf copr enable -y atim/starship
sudo dnf copr enable -y skoved/vivid
sudo dnf copr enable -y atim/nushell

# Install packages (skip already installed or unavailable)
sudo dnf install -y --skip-unavailable \
    chezmoi \
    eza \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    vivid \
    jetbrains-mono-fonts-all \
    kitty \
    nushell \
    util-linux-user # For chsh

echo "[chezmoi] Packages installed"

# Install Nerd Fonts for terminal icons
if [[ ! -d "$HOME/.local/share/fonts/JetBrainsMonoNerdFont" ]]; then
    echo "[chezmoi] Installing JetBrains Mono Nerd Font..."
    mkdir -p "$HOME/.local/share/fonts/JetBrainsMonoNerdFont"
    cd "$HOME/.local/share/fonts/JetBrainsMonoNerdFont"
    curl -fLO "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz"
    tar -xf JetBrainsMono.tar.xz
    rm JetBrainsMono.tar.xz
    fc-cache -fv
    echo "[chezmoi] Nerd Font installed"
fi

# Note: oh-my-zsh, zsh plugins, powerlevel10k, and tpm are managed by chezmoiexternal.toml

# =============================================================================
# Tailscale Installation
# =============================================================================
if ! rpm -q tailscale &>/dev/null; then
    echo "[chezmoi] Installing Tailscale..."
    sudo dnf config-manager addrepo --from-repofile=https://pkgs.tailscale.com/stable/fedora/tailscale.repo
    sudo dnf install -y tailscale
    sudo systemctl enable --now tailscaled
    echo "[chezmoi] Tailscale installed. Run 'sudo tailscale up' to authenticate."
else
    echo "[chezmoi] Tailscale already installed"
fi

echo "[chezmoi] Fedora Standard setup complete!"
{{- end }}
