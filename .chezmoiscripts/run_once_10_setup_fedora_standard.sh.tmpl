{{- $isToolbox := stat "/.toolboxenv" -}}
{{- $isStandardFedora := and (lookPath "dnf") (not (lookPath "rpm-ostree")) -}}
{{- if or $isToolbox $isStandardFedora -}}
#!/bin/bash
# =============================================================================
# Fedora Standard - Dependencies Installation Script
# =============================================================================
# This script runs automatically via chezmoi on first apply for this profile.
# =============================================================================

set -eufo pipefail

echo "[chezmoi] Installing Fedora Standard dependencies via dnf..."

echo "Enabling COPR repository for eza..."
sudo dnf copr enable -y alternateved/eza

# Translating package list from apt to dnf
sudo dnf install -y \
    eza \
    zsh \
    git \
    curl \
    wget \
    tmux \
    fzf \
    neovim \
    fd-find \
    ripgrep \
    jq \
    unzip \
    bat \
    fontconfig \
    starship \
    zoxide \
    vivid \
    util-linux-user # For chsh

echo "[chezmoi] Packages installed"

# Install Oh-My-Zsh if not present
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
    echo "[chezmoi] Installing Oh-My-Zsh..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

# Install Zsh plugins
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

if [[ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]]; then
    git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
fi

if [[ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]]; then
    git clone https://github.com/zsh-users/zsh-syntax-highlighting "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"
fi

# Install TPM (Tmux Plugin Manager)
if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
fi

echo "[chezmoi] Fedora Standard setup complete!"
{{- end -}}
