{{- if and (eq .chezmoi.os "darwin") (eq .machine_profile "mac-personal") -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jsoyer.moshi-hook</string>

    <!-- macOS counterpart of moshi-hook.service. The binary may come from
         Homebrew (tap rjyo/moshi) or from ~/.local/bin: moshi-hook-launch
         resolves whichever is present. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/bin/moshi-hook-launch</string>
    </array>

    <!-- Equivalent of Restart=always: launchd relaunches on every exit,
         including exit 0 (the daemon can exit cleanly after an update). -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <!-- Anti crash-loop: launchd already enforces 10s between relaunches; set
         it explicitly so the intent is readable in the logs. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>WorkingDirectory</key>
    <string>{{ .chezmoi.homeDir }}</string>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/moshi-hook.log</string>

    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/moshi-hook.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>{{ .chezmoi.homeDir }}</string>
    </dict>
</dict>
</plist>
{{- end }}
