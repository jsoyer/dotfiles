#!/usr/bin/env bash
#
# orca-setup — Installe et configure Orca en serveur headless (systemd SYSTEM).
#
# Successeur de install-orca-systemd.sh. Fait tout ce que faisait ce dernier, et
# en plus : télécharge l'AppImage si elle est absente, choisit l'asset selon
# l'ARCHITECTURE (un RPi arm64 recevait silencieusement le binaire x86_64), et
# détecte l'adresse d'appairage au lieu de la coder en dur.
#
# Scope SYSTEM et non --user : l'AppImage vit dans /opt/orca et le service doit
# tourner au boot sans session ouverte. C'est pourquoi les units ne sont PAS
# déployées par chezmoi (qui n'écrit que dans $HOME) mais générées ici.
#
# Linux uniquement — Orca ne publie pas d'AppImage macOS utilisable en headless.
#
# ⚠️ S'invoque SANS sudo : le script s'élève lui-même. `sudo orca-setup` échoue
# en "command not found" car le secure_path de sudo n'inclut pas ~/.local/bin.
#
# Usage :
#   orca-setup                              install complet (demande le mdp sudo)
#   orca-setup --pairing-address 100.x.y.z  force l'adresse d'appairage
#   orca-setup --port 6768                  force le port du runtime
#   orca-setup --status                     état (pas de root requis)
#   orca-setup --uninstall
#   orca-setup --dry-run
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
REPO="stablyai/orca"
DEST_DIR="/opt/orca"
APP_NAME="orca-linux.AppImage"          # nom local, indépendant de l'asset
DEST="${DEST_DIR}/${APP_NAME}"
SERVICE="orca-serve.service"
DROPIN_DIR="/etc/systemd/system/${SERVICE}.d"
UPDATE_SCRIPT="/usr/local/bin/update-orca"
DEFAULT_PORT=6768

PAIRING_ADDR=""
PORT="$DEFAULT_PORT"
SVC_USER=""
DO_SERVICE=1
DRY_RUN=0
ASSUME_YES=0
ACTION="install"

# --- Helpers ------------------------------------------------------------------
c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[orca-setup]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[orca-setup]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[orca-setup]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[orca-setup]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then printf '  %s+%s %s\n' "$c_y" "$c_0" "$*"; return 0; fi
  "$@"
}

# Écrit un fichier, ou affiche son chemin + contenu en --dry-run.
write_file() {
  local path="$1"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s écrire %s\n' "$c_y" "$c_0" "$path"
    cat >/dev/null
    return 0
  fi
  cat > "$path"
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

# --- Parsing des options ------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pairing-address) PAIRING_ADDR="${2:?adresse manquante}"; shift ;;
    --port)            PORT="${2:?port manquant}"; shift ;;
    --user)            SVC_USER="${2:?utilisateur manquant}"; shift ;;
    --no-service)      DO_SERVICE=0 ;;
    --status)          ACTION="status" ;;
    --uninstall)       ACTION="uninstall" ;;
    --dry-run)         DRY_RUN=1 ;;
    -y|--yes)          ASSUME_YES=1 ;;
    -h|--help)         usage; exit 0 ;;
    *)                 die "Option inconnue : $1 (voir --help)" ;;
  esac
  shift
done

[[ "$(uname -s)" == "Linux" ]] || die "Orca headless est supporté sur Linux uniquement (plateforme : $(uname -s))."

# --- Sélection de l'asset selon l'architecture --------------------------------
# ⚠️ La release publie deux AppImages. Sans ce test, un RPi arm64 téléchargeait
# orca-linux.AppImage (x86_64) et le service échouait avec "Exec format error".
case "$(uname -m)" in
  x86_64|amd64)   ASSET="orca-linux.AppImage" ;;
  aarch64|arm64)  ASSET="orca-linux-arm64.AppImage" ;;
  *)              die "Architecture non supportée par les releases Orca : $(uname -m)" ;;
esac
URL="https://github.com/${REPO}/releases/latest/download/${ASSET}"

# --- Statut (ne demande pas root) ---------------------------------------------
appimage_version() {
  local img="$1" tmpd ver
  [[ -f "$img" ]] || { echo "absente"; return 0; }
  tmpd="$(mktemp -d)" || { echo "inconnue"; return 0; }
  ( cd "$tmpd" && "$img" --appimage-extract '*.desktop' >/dev/null 2>&1 ) || true
  ver="$(grep -hm1 '^X-AppImage-Version=' "$tmpd"/squashfs-root/*.desktop 2>/dev/null | cut -d= -f2)"
  rm -rf "$tmpd"
  echo "${ver:-inconnue}"
}

# systemctl is-active/is-enabled IMPRIMENT déjà un état ("inactive", "not-found")
# puis sortent en code != 0 : un `|| echo inconnu` ajouterait une SECONDE ligne.
sstate() { local out; out="$("$@" 2>/dev/null)" || true; echo "${out:-inconnu}"; }

do_status() {
  printf '%sOrca%s\n' "$c_b" "$c_0"
  printf '  AppImage : %s (%s, asset %s)\n' "$DEST" "$(appimage_version "$DEST")" "$ASSET"
  printf '  Service  : %s / %s\n' \
    "$(sstate systemctl is-active "$SERVICE")" \
    "$(sstate systemctl is-enabled "$SERVICE")"
  printf '  Timer MAJ: %s\n' "$(sstate systemctl is-active orca-update.timer)"
  if ss -ltn 2>/dev/null | grep -qE ":${PORT}\b"; then
    printf '  Port %s : en écoute\n' "$PORT"
  else
    printf '  Port %s : %saucune écoute%s\n' "$PORT" "$c_y" "$c_0"
  fi
}

if [[ "$ACTION" == "status" ]]; then do_status; exit 0; fi

# --- Élévation ----------------------------------------------------------------
# ⚠️ NE PAS appeler `sudo orca-setup` : le secure_path de sudo ne contient pas
# ~/.local/bin, la commande serait introuvable. On s'élève soi-même avec le
# chemin ABSOLU du script (résolu, car $0 peut être relatif si on l'invoque par
# `./orca-setup` ou `bash orca-setup`).
if [[ "$(id -u)" -ne 0 ]]; then
  self="$(readlink -f -- "$0" 2>/dev/null || true)"
  [[ -n "$self" && -r "$self" ]] || die "Impossible de résoudre le chemin du script ($0) pour l'élévation."
  log "Droits root requis (écriture /opt + systemd) — élévation via sudo…"
  exec sudo -- "$self" "$@"
fi

# Utilisateur propriétaire de la session Orca (le profil userData est chez lui).
if [[ -z "$SVC_USER" ]]; then
  SVC_USER="${SUDO_USER:-}"
  [[ -n "$SVC_USER" && "$SVC_USER" != "root" ]] || SVC_USER="$(logname 2>/dev/null || true)"
  [[ -n "$SVC_USER" ]] || die "Impossible de déterminer l'utilisateur cible — précise --user <nom>."
fi
id "$SVC_USER" >/dev/null 2>&1 || die "Utilisateur inconnu : ${SVC_USER}"

# --- Désinstallation ----------------------------------------------------------
do_uninstall() {
  if [[ "$ASSUME_YES" -eq 0 ]]; then
    printf 'Retirer le service Orca et ses units ? (l'\''AppImage est conservée) [y/N] '
    read -r reply
    [[ "$reply" =~ ^[yYoO]$ ]] || { log "Annulé."; exit 0; }
  fi
  run systemctl disable --now "$SERVICE" 2>/dev/null || true
  run systemctl disable --now orca-update.timer 2>/dev/null || true
  run rm -rf "$DROPIN_DIR"
  run rm -f /etc/systemd/system/orca-update.service /etc/systemd/system/orca-update.timer
  run rm -f "$UPDATE_SCRIPT"
  run systemctl daemon-reload
  ok "Units retirées. AppImage conservée dans ${DEST_DIR} (rm -rf ${DEST_DIR} pour tout effacer)."
}

if [[ "$ACTION" == "uninstall" ]]; then do_uninstall; exit 0; fi

# --- Adresse d'appairage ------------------------------------------------------
# Le mobile joint le runtime via cette IP. Tailscale d'abord (adresse stable
# quel que soit le réseau), sinon l'IP source de la route par défaut.
detect_pairing_addr() {
  local ip
  if command -v tailscale >/dev/null 2>&1; then
    ip="$(tailscale ip -4 2>/dev/null | head -1)"
    [[ -n "$ip" ]] && { echo "$ip"; return 0; }
  fi
  ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}')"
  echo "$ip"
}

if [[ -z "$PAIRING_ADDR" ]]; then
  PAIRING_ADDR="$(detect_pairing_addr)"
  [[ -n "$PAIRING_ADDR" ]] || die "Adresse d'appairage indéterminable — précise --pairing-address <ip>."
  log "Adresse d'appairage détectée : ${PAIRING_ADDR}"
fi

# --- Téléchargement de l'AppImage si absente ----------------------------------
if [[ ! -f "$DEST" ]]; then
  log "AppImage absente — téléchargement de ${ASSET}…"
  command -v curl >/dev/null 2>&1 || die "curl est requis."
  run mkdir -p "$DEST_DIR"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    TMP="$(mktemp "${DEST_DIR}/.${APP_NAME}.XXXXXX")"
    trap 'rm -f "$TMP"' EXIT
    curl -fL --retry 3 --retry-delay 2 --progress-bar -o "$TMP" "$URL" \
      || die "Échec du téléchargement depuis ${URL}"
    # Une AppImage valide démarre par un en-tête ELF (0x7F 'E' 'L' 'F').
    [[ "$(head -c 4 "$TMP" | od -An -tx1 | tr -d ' ')" == "7f454c46" ]] \
      || die "Le fichier téléchargé n'est pas un exécutable ELF valide."
    chmod 755 "$TMP"
    mv -f "$TMP" "$DEST"
    trap - EXIT
  fi
  ok "AppImage installée : ${DEST} ($(appimage_version "$DEST"))"
else
  ok "AppImage déjà présente : ${DEST} ($(appimage_version "$DEST"))"
fi

# --- Script de mise à jour ----------------------------------------------------
# Emplacement système : contexte SELinux `bin_t`, exécutable par systemd.
# (Un script sous /home/... porte `home_t` que systemd refuse d'exécuter.)
SRC_UPDATE=""
for c in "$(dirname "$0")/update-orca" "/home/${SVC_USER}/.local/bin/update-orca"; do
  [[ -r "$c" ]] && { SRC_UPDATE="$c"; break; }
done
if [[ -n "$SRC_UPDATE" ]]; then
  run install -m 0755 "$SRC_UPDATE" "$UPDATE_SCRIPT"
  command -v restorecon >/dev/null 2>&1 && run restorecon -v "$UPDATE_SCRIPT" >/dev/null || true
  ok "Script de MAJ installé : ${UPDATE_SCRIPT}"
else
  warn "update-orca introuvable — le timer de MAJ ne sera pas fonctionnel."
  warn "Lance 'chezmoi apply' pour déployer ~/.local/bin/update-orca, puis relance orca-setup."
fi

if [[ "$DO_SERVICE" -eq 0 ]]; then
  ok "Terminé (--no-service : aucune unit écrite)."
  exit 0
fi

# --- Unit principale ----------------------------------------------------------
# On la génère intégralement pour qu'une machine neuve fonctionne sans passer par
# l'enregistrement CLI depuis l'UI Orca.
if [[ -f "/etc/systemd/system/${SERVICE}" && "$DRY_RUN" -eq 0 ]]; then
  cp -f "/etc/systemd/system/${SERVICE}" "/etc/systemd/system/${SERVICE}.bak"
fi
write_file "/etc/systemd/system/${SERVICE}" <<EOF
[Unit]
Description=Orca runtime server
Documentation=https://github.com/${REPO}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${SVC_USER}
WorkingDirectory=${DEST_DIR}
ExecStart=${DEST} serve --port ${PORT} --pairing-address ${PAIRING_ADDR}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
ok "Unit écrite : /etc/systemd/system/${SERVICE} (user=${SVC_USER}, port=${PORT}, pairing=${PAIRING_ADDR})"

# --- Drop-in : arrêt propre + logs propres ------------------------------------
# Le service échouait à l'arrêt : Electron ignore SIGINT, systemd temporisait
# puis tuait le process (SIGABRT + coredump). On bascule sur SIGTERM (mieux géré
# par Electron), on tue tout l'arbre de process et on laisse plus de marge.
run mkdir -p "$DROPIN_DIR"
write_file "${DROPIN_DIR}/override.conf" <<'EOF'
# Géré par orca-setup — arrêt propre + logs propres du serveur Orca.
[Service]
# --- Arrêt propre (Electron) ---
# Electron réagit mieux à SIGTERM qu'à SIGINT pour un shutdown gracieux.
KillSignal=SIGTERM
# Termine le process principal puis SIGKILL le reste de l'arbre au timeout.
KillMode=mixed
# Marge d'arrêt plus large avant le kill forcé.
TimeoutStopSec=45
# En cas de timeout, tuer proprement (SIGKILL) au lieu d'un abort/coredump.
TimeoutStopFailureMode=kill

# --- Logs propres en headless ---
# NB: valeur entre guillemets — sinon systemd découpe sur les espaces.
# GPU : pas d'accélération matérielle sur GPU virtio.
Environment="ELECTRON_EXTRA_LAUNCH_ARGS=--disable-gpu"
# D-Bus : pas de session bus en headless. Socket INEXISTANT volontaire : Chromium
# échoue la connexion sans tenter d'opération privilégiée (pointer vers le bus
# système déclenchait un refus polkit sur StartTransientUnit).
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/orca-no-session-bus"
#
# Ces warnings Chromium/Electron en headless sont inévitables à la source (pas de
# vrai X, pas de session bus, pas de GPU) et totalement bénins. On les masque du
# journal via LogFilterPatterns (~ = deny). Les vraies erreurs passent toujours.
LogFilterPatterns=~vaInitialize failed
LogFilterPatterns=~Failed to connect to the bus
LogFilterPatterns=~Failed to call method: org.freedesktop.DBus
LogFilterPatterns=~libva error
EOF
ok "Drop-in écrit : ${DROPIN_DIR}/override.conf"

# --- Timer de mise à jour -----------------------------------------------------
write_file /etc/systemd/system/orca-update.service <<EOF
[Unit]
Description=Met à jour l'AppImage Orca vers la dernière release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Le script tourne déjà en root ici : pas de sudo, il gère stop/update/start.
ExecStart=${UPDATE_SCRIPT}
# Ne pas marquer le boot en échec si GitHub est injoignable ponctuellement.
SuccessExitStatus=0
TimeoutStartSec=30min
EOF

write_file /etc/systemd/system/orca-update.timer <<'EOF'
[Unit]
Description=Vérification quotidienne des mises à jour Orca

[Timer]
Unit=orca-update.service
OnCalendar=daily
# Rattrape l'exécution si la machine était éteinte à l'heure prévue.
Persistent=true
# Étale la charge (évite les updates simultanées à minuit pile).
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
EOF
ok "Units de MAJ écrites."

# --- Application --------------------------------------------------------------
run systemctl daemon-reload
run systemctl enable --now "$SERVICE"
[[ -n "$SRC_UPDATE" ]] && run systemctl enable --now orca-update.timer

if [[ "$DRY_RUN" -eq 1 ]]; then exit 0; fi

sleep 3
if systemctl is-active --quiet "$SERVICE"; then
  ok "${SERVICE} actif ✔"
else
  warn "${SERVICE} n'est pas actif — voir : journalctl -u ${SERVICE} -e"
fi
echo
do_status
echo
log "Tester la MAJ tout de suite :  sudo systemctl start orca-update.service"
