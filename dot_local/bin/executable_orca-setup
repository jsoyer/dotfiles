#!/usr/bin/env bash
#
# orca-setup — Install and configure Orca as a headless server (SYSTEM systemd).
#
# Successor to install-orca-systemd.sh. Does everything that script did, plus:
# downloads the AppImage when missing, picks the asset by ARCHITECTURE (an arm64
# RPi silently received the x86_64 AppImage), and detects the pairing address
# instead of hardcoding it.
#
# SYSTEM scope, not --user: the AppImage lives in /opt/orca and the service must
# start at boot with no session open. That is why the units are NOT deployed by
# chezmoi (which only writes inside $HOME) but generated here.
#
# Linux only — Orca publishes no macOS AppImage usable headless.
#
# WARNING: invoke it WITHOUT sudo, the script elevates itself. `sudo orca-setup`
# fails with "command not found" because sudo's secure_path excludes
# ~/.local/bin.
#
# Beyond the runtime itself it provisions the MONITORING that was missing on
# 2026-09-14, when orca-serve crash-looped for 16h (826 restarts) with nothing
# ever surfacing it: orca-health + its timer, orca-alert@ wired through
# OnFailure=, and the zz- drop-ins that make /tmp private and give the crash-loop
# ceiling a window wide enough to catch a SLOW loop.
#
# Usage:
#   orca-setup                              full install (prompts for sudo)
#   orca-setup --pairing-address 100.x.y.z  force the pairing address
#   orca-setup --port 6768                  force the runtime port
#   orca-setup --status                     state (no root needed)
#   orca-setup --uninstall
#   orca-setup --dry-run
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
REPO="stablyai/orca"
DEST_DIR="/opt/orca"
APP_NAME="orca-linux.AppImage"          # local name, independent of the asset
DEST="${DEST_DIR}/${APP_NAME}"
SERVICE="orca-serve.service"
DROPIN_DIR="/etc/systemd/system/${SERVICE}.d"
UPDATE_SCRIPT="/usr/local/bin/update-orca"
UPDATE_SERVICE="orca-update.service"
UPDATE_DROPIN_DIR="/etc/systemd/system/${UPDATE_SERVICE}.d"
HEALTH_SCRIPT="/usr/local/bin/orca-health"
HEALTH_SERVICE="orca-health.service"
HEALTH_TIMER="orca-health.timer"
ALERT_SERVICE="orca-alert@.service"
ALERT_CONF="/etc/orca-alert.conf"
HEALTH_STATE_DIR="/var/lib/orca-health"
DEFAULT_PORT=6768

PAIRING_ADDR=""
PORT="$DEFAULT_PORT"
SVC_USER=""
DO_SERVICE=1
DRY_RUN=0
ASSUME_YES=0
ACTION="install"

# --- Helpers ------------------------------------------------------------------
c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[orca-setup]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[orca-setup]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[orca-setup]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[orca-setup]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then printf '  %s+%s %s\n' "$c_y" "$c_0" "$*"; return 0; fi
  "$@"
}

# Write a file, or print its path plus content under --dry-run.
write_file() {
  local path="$1"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s write %s\n' "$c_y" "$c_0" "$path"
    cat >/dev/null
    return 0
  fi
  cat > "$path"
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

# --- Option parsing -----------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pairing-address) PAIRING_ADDR="${2:?address missing}"; shift ;;
    --port)            PORT="${2:?port missing}"; shift ;;
    --user)            SVC_USER="${2:?user missing}"; shift ;;
    --no-service)      DO_SERVICE=0 ;;
    --status)          ACTION="status" ;;
    --uninstall)       ACTION="uninstall" ;;
    --dry-run)         DRY_RUN=1 ;;
    -y|--yes)          ASSUME_YES=1 ;;
    -h|--help)         usage; exit 0 ;;
    *)                 die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

[[ "$(uname -s)" == "Linux" ]] || die "Headless Orca is Linux-only (platform: $(uname -s))."

# --- Asset selection by architecture ------------------------------------------
# WARNING: the release publishes two AppImages. Without this check an arm64 RPi
# downloaded orca-linux.AppImage (x86_64) and the service failed with
# "Exec format error".
case "$(uname -m)" in
  x86_64|amd64)   ASSET="orca-linux.AppImage" ;;
  aarch64|arm64)  ASSET="orca-linux-arm64.AppImage" ;;
  *)              die "Architecture not supported by the Orca releases: $(uname -m)" ;;
esac
URL="https://github.com/${REPO}/releases/latest/download/${ASSET}"

# --- Status (does not require root) -------------------------------------------
appimage_version() {
  local img="$1" tmpd ver
  [[ -f "$img" ]] || { echo "missing"; return 0; }
  tmpd="$(mktemp -d)" || { echo "unknown"; return 0; }
  ( cd "$tmpd" && "$img" --appimage-extract '*.desktop' >/dev/null 2>&1 ) || true
  ver="$(grep -hm1 '^X-AppImage-Version=' "$tmpd"/squashfs-root/*.desktop 2>/dev/null | cut -d= -f2)"
  rm -rf "$tmpd"
  echo "${ver:-unknown}"
}

# systemctl is-active/is-enabled ALREADY print a state ("inactive", "not-found")
# and then exit non-zero: an `|| echo unknown` would add a SECOND line.
sstate() { local out; out="$("$@" 2>/dev/null)" || true; echo "${out:-unknown}"; }

do_status() {
  printf '%sOrca%s\n' "$c_b" "$c_0"
  printf '  AppImage : %s (%s, asset %s)\n' "$DEST" "$(appimage_version "$DEST")" "$ASSET"
  printf '  Service  : %s / %s\n' \
    "$(sstate systemctl is-active "$SERVICE")" \
    "$(sstate systemctl is-enabled "$SERVICE")"
  printf '  Timer    : %s\n' "$(sstate systemctl is-active orca-update.timer)"
  printf '  Health   : %s / %s\n' \
    "$(sstate systemctl is-active "$HEALTH_TIMER")" \
    "$(sstate systemctl is-enabled "$HEALTH_TIMER")"
  # `sport = :N` is an ss FILTER, not a text match. The old `grep -qE ":${PORT}\b"`
  # produced false positives: with PORT=1, `:1\b` matches `[::1]:631`, because `]`
  # counts as a word boundary. A probe that lies is worse than no probe at all.
  if ss -ltn "sport = :${PORT}" 2>/dev/null | grep -q LISTEN; then
    printf '  Port %s : listening\n' "$PORT"
  else
    printf '  Port %s : %snot listening%s\n' "$PORT" "$c_y" "$c_0"
  fi
}

if [[ "$ACTION" == "status" ]]; then do_status; exit 0; fi

# --- Elevation ----------------------------------------------------------------
# Do NOT call `sudo orca-setup`: sudo's secure_path does not include
# ~/.local/bin, so the command would not be found. We elevate ourselves with the
# ABSOLUTE path of the script (resolved, because $0 can be relative when invoked
# as `./orca-setup` or `bash orca-setup`).
if [[ "$(id -u)" -ne 0 ]]; then
  self="$(readlink -f -- "$0" 2>/dev/null || true)"
  [[ -n "$self" && -r "$self" ]] || die "Cannot resolve the script path ($0) for elevation."
  log "Root required (writing /opt + systemd) — elevating through sudo…"
  exec sudo -- "$self" "$@"
fi

# User owning the Orca session (the userData profile is theirs).
if [[ -z "$SVC_USER" ]]; then
  SVC_USER="${SUDO_USER:-}"
  [[ -n "$SVC_USER" && "$SVC_USER" != "root" ]] || SVC_USER="$(logname 2>/dev/null || true)"
  [[ -n "$SVC_USER" ]] || die "Cannot determine the target user — pass --user <name>."
fi
id "$SVC_USER" >/dev/null 2>&1 || die "Unknown user: ${SVC_USER}"

# --- Uninstall ----------------------------------------------------------------
do_uninstall() {
  if [[ "$ASSUME_YES" -eq 0 ]]; then
    printf 'Remove the Orca service and its units? (the AppImage is kept) [y/N] '
    read -r reply
    [[ "$reply" =~ ^[yY]$ ]] || { log "Cancelled."; exit 0; }
  fi
  run systemctl disable --now "$SERVICE" 2>/dev/null || true
  run systemctl disable --now orca-update.timer 2>/dev/null || true
  # Stop the monitoring too: a timer left behind would keep alerting every ten
  # minutes about a service that no longer exists.
  run systemctl disable --now "$HEALTH_TIMER" 2>/dev/null || true
  run rm -rf "$DROPIN_DIR" "$UPDATE_DROPIN_DIR" "$HEALTH_STATE_DIR"
  run rm -f /etc/systemd/system/orca-update.service /etc/systemd/system/orca-update.timer
  run rm -f "/etc/systemd/system/${HEALTH_SERVICE}" \
            "/etc/systemd/system/${HEALTH_TIMER}" \
            "/etc/systemd/system/${ALERT_SERVICE}"
  run rm -f "$UPDATE_SCRIPT" "$HEALTH_SCRIPT"
  run systemctl daemon-reload
  # ${ALERT_CONF} is user configuration (it may hold an ntfy URL) and is kept,
  # like the AppImage.
  ok "Units removed. AppImage kept in ${DEST_DIR}, alert config kept in ${ALERT_CONF}."
}

if [[ "$ACTION" == "uninstall" ]]; then do_uninstall; exit 0; fi

# --- Pairing address ----------------------------------------------------------
# The phone reaches the runtime through this IP. Tailscale first (stable address
# whatever the network), otherwise the source IP of the default route.
detect_pairing_addr() {
  local ip
  if command -v tailscale >/dev/null 2>&1; then
    ip="$(tailscale ip -4 2>/dev/null | head -1)"
    [[ -n "$ip" ]] && { echo "$ip"; return 0; }
  fi
  ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}')"
  echo "$ip"
}

if [[ -z "$PAIRING_ADDR" ]]; then
  PAIRING_ADDR="$(detect_pairing_addr)"
  [[ -n "$PAIRING_ADDR" ]] || die "Cannot determine the pairing address — pass --pairing-address <ip>."
  log "Detected pairing address: ${PAIRING_ADDR}"
fi

# --- Download the AppImage when missing ---------------------------------------
if [[ ! -f "$DEST" ]]; then
  log "AppImage missing — downloading ${ASSET}…"
  command -v curl >/dev/null 2>&1 || die "curl is required."
  run mkdir -p "$DEST_DIR"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    TMP="$(mktemp "${DEST_DIR}/.${APP_NAME}.XXXXXX")"
    trap 'rm -f "$TMP"' EXIT
    curl -fL --retry 3 --retry-delay 2 --progress-bar -o "$TMP" "$URL" \
      || die "Download failed from ${URL}"
    # A valid AppImage starts with an ELF header (0x7F 'E' 'L' 'F').
    [[ "$(head -c 4 "$TMP" | od -An -tx1 | tr -d ' ')" == "7f454c46" ]] \
      || die "The downloaded file is not a valid ELF executable."
    chmod 755 "$TMP"
    mv -f "$TMP" "$DEST"
    trap - EXIT
  fi
  ok "AppImage installed: ${DEST} ($(appimage_version "$DEST"))"
else
  ok "AppImage already present: ${DEST} ($(appimage_version "$DEST"))"
fi

# --- Helper scripts (update-orca, orca-health) --------------------------------
# System location: SELinux `bin_t` context, executable by systemd.
# (A script under /home carries `home_t`, which systemd refuses to execute.)
#
# TRAP, learned the hard way: `install` DEREFERENCES symlinks. Make
# ~/.local/bin/update-orca a symlink to /usr/local/bin/update-orca and source and
# destination become the same inode — install then TRUNCATES the script it is
# meant to copy, destroying both. Chezmoi deploys real files, so this cannot
# happen through a normal apply; the `-ef` guard below makes it impossible to
# reintroduce by hand.
locate_helper() {
  local name="$1" c
  for c in "$(dirname "$0")/${name}" "/home/${SVC_USER}/.local/bin/${name}"; do
    [[ -r "$c" ]] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

install_helper() {
  local src="$1" dest="$2"
  if [[ "$src" -ef "$dest" ]]; then
    ok "$(basename "$dest") is already the installed copy — left untouched."
    return 0
  fi
  run install -m 0755 "$src" "$dest"
  command -v restorecon >/dev/null 2>&1 && run restorecon -v "$dest" >/dev/null || true
  ok "Installed: ${dest}"
}

SRC_UPDATE="$(locate_helper update-orca || true)"
if [[ -n "$SRC_UPDATE" ]]; then
  install_helper "$SRC_UPDATE" "$UPDATE_SCRIPT"
else
  warn "update-orca not found — the update timer will not work."
  warn "Run 'chezmoi apply' to deploy ~/.local/bin/update-orca, then re-run orca-setup."
fi

SRC_HEALTH="$(locate_helper orca-health || true)"
if [[ -n "$SRC_HEALTH" ]]; then
  install_helper "$SRC_HEALTH" "$HEALTH_SCRIPT"
else
  warn "orca-health not found — NO monitoring will be installed."
  warn "Run 'chezmoi apply' to deploy ~/.local/bin/orca-health, then re-run orca-setup."
fi

if [[ "$DO_SERVICE" -eq 0 ]]; then
  ok "Done (--no-service: no unit written)."
  exit 0
fi

# AppImage type-2 runtime dlopens libfuse.so.2. Raspberry Pi OS / Debian ship
# fuse3 (libfuse.so.3) by default, so the unit crash-loops with:
#   dlopen(): error loading libfuse.so.2
# APPIMAGE_EXTRACT_AND_RUN=1 skips FUSE entirely (extract to $TMPDIR and exec).
# Also install libfuse2 when a package manager is there, so orca-gui / manual
# runs without the env var still work.
has_libfuse2() {
  ldconfig -p 2>/dev/null | grep -q 'libfuse\.so\.2' && return 0
  compgen -G '/usr/lib/*/libfuse.so.2' >/dev/null && return 0
  compgen -G '/lib/*/libfuse.so.2' >/dev/null && return 0
  [[ -e /usr/lib/libfuse.so.2 || -e /lib/libfuse.so.2 ]]
}

ensure_libfuse2() {
  if has_libfuse2; then
    ok "libfuse.so.2 already present."
    return 0
  fi
  log "libfuse.so.2 missing — AppImages cannot mount without it (or extract-and-run)."
  if command -v apt-get >/dev/null 2>&1; then
    run apt-get install -y libfuse2 || run apt-get install -y libfuse2t64 || \
      warn "Could not install libfuse2; systemd will use APPIMAGE_EXTRACT_AND_RUN=1."
  elif command -v dnf >/dev/null 2>&1; then
    run dnf install -y fuse-libs || warn "Could not install fuse-libs."
  elif command -v pacman >/dev/null 2>&1; then
    run pacman -S --needed --noconfirm fuse2 || warn "Could not install fuse2."
  else
    warn "No known package manager — relying on APPIMAGE_EXTRACT_AND_RUN=1."
  fi
}

ensure_libfuse2

# Electron/Chromium inside the AppImage links GTK/ATK/NSS/CUPS/GBM. A Pi Lite
# image has none of those. Install the whole set every time (apt -y is
# idempotent) — skipping on "atk is present" left looping crashing on cups.
# Chromium/Electron Depends (google-chrome-stable) + AppImage extras.
ELECTRON_APT_PKGS=(
  libfuse2
  libgtk-3-0 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0
  libnss3 libnspr4 libgbm1 libasound2 libdrm2 libcups2
  libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0
  libglib2.0-0 libdbus-1-3 libexpat1 libudev1 libsecret-1-0
  libxss1 libxtst6 libnotify4 libx11-6 libx11-xcb1 libxcb1
  libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0
  libxrandr2 libvulkan1 fonts-liberation xvfb zlib1g zlib1g-dev
)
ELECTRON_APT_PKGS_T64=(
  libfuse2t64
  libgtk-3-0t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64
  libnss3 libnspr4 libgbm1 libasound2t64 libdrm2 libcups2t64
  libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0
  libglib2.0-0t64 libdbus-1-3 libexpat1 libudev1 libsecret-1-0
  libxss1 libxtst6 libnotify4 libx11-6 libx11-xcb1 libxcb1
  libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0
  libxrandr2 libvulkan1 fonts-liberation xvfb zlib1g zlib1g-dev
)

ensure_electron_runtime() {
  log "Ensuring Electron/GTK runtime libraries…"
  if command -v apt-get >/dev/null 2>&1; then
    run apt-get install -y "${ELECTRON_APT_PKGS[@]}" \
      || run apt-get install -y "${ELECTRON_APT_PKGS_T64[@]}" \
      || warn "Could not install GTK/Electron libs — orca-ide will fail to start."
  elif command -v dnf >/dev/null 2>&1; then
    run dnf install -y gtk3 nss nspr mesa-libgbm alsa-lib at-spi2-atk \
      libXScrnSaver cups-libs libdrm libXcomposite libXdamage libXrandr \
      libxkbcommon at-spi2-core libX11-xcb libsecret xorg-x11-server-Xvfb || \
      warn "Could not install GTK/Electron libs."
  elif command -v pacman >/dev/null 2>&1; then
    run pacman -S --needed --noconfirm gtk3 nss nspr libxss alsa-lib \
      at-spi2-core libcups libdrm libxcomposite libxdamage libxrandr \
      libxkbcommon libx11 libsecret xorg-server-xvfb || \
      warn "Could not install GTK/Electron libs."
  fi
}

ensure_electron_runtime

# --- Main unit ----------------------------------------------------------------
# Generated in full so a fresh machine works without going through the CLI
# registration from the Orca UI.
if [[ -f "/etc/systemd/system/${SERVICE}" && "$DRY_RUN" -eq 0 ]]; then
  cp -f "/etc/systemd/system/${SERVICE}" "/etc/systemd/system/${SERVICE}.bak"
fi
write_file "/etc/systemd/system/${SERVICE}" <<EOF
[Unit]
Description=Orca runtime server
Documentation=https://github.com/${REPO}
After=network-online.target
Wants=network-online.target
# Cap crash-loops. The window is DELIBERATELY wide. 8 starts per 120s only
# catches a FAST loop: the 2026-09-14 outage cycled every ~69s, i.e. ~1.7 starts
# per window, so the counter reset before ever reaching 8 and the unit stayed
# "active" for 16h. 5 starts per 30 minutes cuts that slow loop in ~5 minutes
# while still tolerating an isolated incident. zz-crashloop-guard.conf restates
# this, so the ceiling survives a hand-edited unit.
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
User=${SVC_USER}
WorkingDirectory=${DEST_DIR}
# Private /tmp, destroyed when the unit stops. Even when extract-and-run is the
# only option (no FUSE), the 546 MB extraction can then neither saturate the host
# tmpfs nor be shared with a second instance — and that shared path is precisely
# what truncated AppRun into "Exec format error" on 2026-09-14.
PrivateTmp=yes
# Type-2 AppImage needs libfuse.so.2; extract-and-run works without FUSE.
Environment=APPIMAGE_EXTRACT_AND_RUN=1
# Electron/Orca still requires an X server. Without xvfb: Missing X server
# or DISPLAY then SIGSEGV. --auto-servernum picks a free display.
ExecStart=/usr/bin/xvfb-run --auto-servernum ${DEST} serve --port ${PORT} --pairing-address ${PAIRING_ADDR}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
ok "Unit written: /etc/systemd/system/${SERVICE} (user=${SVC_USER}, port=${PORT}, pairing=${PAIRING_ADDR})"

# --- Drop-in: clean shutdown + clean logs -------------------------------------
# The service used to fail on stop: Electron ignores SIGINT, systemd waited out
# its timeout then killed the process (SIGABRT + coredump). We switch to SIGTERM
# (which Electron handles), kill the whole process tree, and allow more time.
run mkdir -p "$DROPIN_DIR"
write_file "${DROPIN_DIR}/override.conf" <<'EOF'
# Managed by orca-setup — clean shutdown and clean logs for the Orca server.
[Service]
# --- Clean shutdown (Electron) ---
# Electron handles SIGTERM far better than SIGINT for a graceful shutdown.
KillSignal=SIGTERM
# Terminate the main process, then SIGKILL the rest of the tree at the timeout.
KillMode=mixed
# Wider shutdown window before the forced kill.
TimeoutStopSec=45
# On timeout, kill cleanly (SIGKILL) instead of abort/coredump.
TimeoutStopFailureMode=kill

# --- Clean logs in headless mode ---
# NB: quoted values — otherwise systemd splits on spaces.
# GPU: no hardware acceleration on a virtio GPU.
Environment="APPIMAGE_EXTRACT_AND_RUN=1"
Environment="ELECTRON_EXTRA_LAUNCH_ARGS=--disable-gpu"
# D-Bus: no session bus in headless mode. The socket is DELIBERATELY
# nonexistent: Chromium then fails to connect without attempting a privileged
# operation (pointing at the system bus triggered a polkit denial on
# StartTransientUnit).
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/orca-no-session-bus"
#
# These Chromium/Electron warnings are unavoidable at the source in headless
# mode (no real X, no session bus, no GPU) and entirely benign. We hide them
# from the journal with LogFilterPatterns (~ = deny). Real errors still pass.
LogFilterPatterns=~vaInitialize failed
LogFilterPatterns=~Failed to connect to the bus
LogFilterPatterns=~Failed to call method: org.freedesktop.DBus
LogFilterPatterns=~libva error
EOF
ok "Drop-in written: ${DROPIN_DIR}/override.conf"

# --- Update timer -------------------------------------------------------------
write_file /etc/systemd/system/orca-update.service <<EOF
[Unit]
Description=Update the Orca AppImage to the latest release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The script already runs as root here: no sudo, it handles stop/update/start.
ExecStart=${UPDATE_SCRIPT}
# Do not mark the boot as failed when GitHub is momentarily unreachable.
SuccessExitStatus=0
TimeoutStartSec=30min
EOF

write_file /etc/systemd/system/orca-update.timer <<'EOF'
[Unit]
Description=Daily check for Orca updates

[Timer]
Unit=orca-update.service
OnCalendar=daily
# Catch up if the machine was off at the scheduled time.
Persistent=true
# Spread the load (avoid simultaneous updates at midnight sharp).
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
EOF
ok "Update units written."

# --- Monitoring, alerting, /tmp containment -----------------------------------
# Why all of this exists: on 2026-09-14 orca-serve crash-looped for 16h (826
# restarts), saturating the tmpfs /tmp, and NOTHING surfaced it. Three failures
# had to line up, and each is answered below:
#
#   1. APPIMAGE_EXTRACT_AND_RUN=1 unsquashed the whole 546 MB AppImage into the
#      tmpfs /tmp on every launch, into a directory named after a hash of the
#      CONTENT — therefore the SAME path every time. With KillMode=mixed and
#      TimeoutStopSec=45, the outgoing instance's cleanup ran while the incoming
#      one had just extracted there: truncated AppRun -> "Exec format error" ->
#      crash -> restart -> re-extract 546 MB. A self-sustaining loop.
#                                              -> zz-tmp-fix.conf
#   2. The systemd ceiling was mathematically unreachable (see the base unit).
#                                              -> zz-crashloop-guard.conf
#   3. update-orca exited 0 after observing that nothing listened.
#                                              -> fixed inside update-orca
#
# orca-health is the backstop for what none of those anticipate: it probes the
# REAL symptom — does the port actually answer — rather than trusting the state
# systemd reports, which said "active" throughout the outage.
#
# The zz- prefix is not cosmetic. override.conf is REGENERATED by this script on
# every run; the zz- files are written separately and drop-ins load in
# alphabetical order, so these always come last and always win.
run mkdir -p "$DROPIN_DIR" "$UPDATE_DROPIN_DIR"

if has_libfuse2; then
  # FUSE is available: the AppImage mounts itself read-only instead of
  # extracting. Zero bytes written to /tmp, and no shared extraction path between
  # instances, so the race simply cannot occur.
  #
  # `Environment=` with an EMPTY value resets the whole list — that is how
  # APPIMAGE_EXTRACT_AND_RUN, inherited from the unit and from override.conf, is
  # removed. The variables worth keeping are redeclared right after.
  write_file "${DROPIN_DIR}/zz-tmp-fix.conf" <<'EOF'
# Managed by orca-setup. Loaded AFTER override.conf — deliberately.
#
# Kills APPIMAGE_EXTRACT_AND_RUN: libfuse.so.2 is present, so the AppImage mounts
# itself read-only. Nothing is written to /tmp, and two instances no longer share
# an extraction directory — which is what produced the truncated AppRun and the
# 826-restart crash loop of 2026-09-14.
#
# PrivateTmp is the second layer: whatever still lands in /tmp (a fallback
# extraction if FUSE disappears, a leaked mount) is reclaimed on every stop.
[Service]
Environment=
Environment="ELECTRON_EXTRA_LAUNCH_ARGS=--disable-gpu"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/orca-no-session-bus"
PrivateTmp=yes
EOF
  ok "Drop-in written: ${DROPIN_DIR}/zz-tmp-fix.conf (FUSE mode, nothing in /tmp)"
else
  # No libfuse.so.2: extraction is the only way to launch, so it stays — but
  # contained. PrivateTmp gives the unit a /tmp of its own, destroyed on stop:
  # the extraction can no longer saturate the host tmpfs, and no second instance
  # can ever see (or delete) these files.
  write_file "${DROPIN_DIR}/zz-tmp-fix.conf" <<'EOF'
# Managed by orca-setup. Loaded AFTER override.conf — deliberately.
#
# libfuse.so.2 is MISSING on this host, so APPIMAGE_EXTRACT_AND_RUN must stay:
# without it the AppImage cannot start at all. What changes is the blast radius —
# PrivateTmp gives the unit its own /tmp, destroyed on stop, so the 546 MB
# extraction can neither fill the host tmpfs nor be shared between two instances.
#
# Install libfuse2 / libfuse2t64 and re-run orca-setup to switch to FUSE mode,
# which writes nothing to /tmp at all.
[Service]
PrivateTmp=yes
EOF
  warn "libfuse.so.2 missing — keeping extract-and-run, contained by PrivateTmp."
fi

write_file "${DROPIN_DIR}/zz-crashloop-guard.conf" <<'EOF'
# Managed by orca-setup. Anti crash-loop ceiling, restated outside override.conf
# so a hand-edited unit cannot quietly lose it.
#
# 2026-09-14: 1215 failed starts for 1 success, one cycle every ~65s, three days
# running, and systemd never intervened. StartLimitBurst=8 over
# StartLimitIntervalSec=120 demands 8 failures in 2 minutes — one every 15s. At
# 65s per cycle that is ~1.8 per window: the counter resets before reaching 8,
# forever. A rate ceiling only protects against FAST loops, and it was the SLOW
# loop that burned CPU and RAM for three days.
#
# 5 failures within 30 minutes: a 65s loop is cut in ~5 min, while an isolated
# incident (the SIGBUS of 14/09 17:02, recovered in 7s) is still tolerated.
#
# On reaching the ceiling the unit stays 'failed' instead of looping — visible in
# `systemctl --failed`. To restart it after a fix:
#   sudo systemctl reset-failed orca-serve.service && sudo systemctl start orca-serve.service
[Unit]
StartLimitIntervalSec=1800
StartLimitBurst=5
EOF

if [[ -n "$SRC_HEALTH" ]]; then
  # OnFailure fires an immediate check — and therefore an alert — instead of
  # waiting up to 10 minutes for the next timer tick.
  for d in "$DROPIN_DIR" "$UPDATE_DROPIN_DIR"; do
    write_file "${d}/zz-alert.conf" <<'EOF'
# Managed by orca-setup. Fires a health check, and therefore an alert, the moment
# the unit fails.
[Unit]
OnFailure=orca-alert@%n.service
EOF
  done

  # orca-update.service makes two `mktemp -d` calls in /tmp with no trap on them:
  # if the script dies in between, the directory leaks. Small (12 KB measured),
  # so this is preventive rather than urgent.
  write_file "${UPDATE_DROPIN_DIR}/zz-tmp-fix.conf" <<'EOF'
# Managed by orca-setup. Private /tmp, destroyed at the end of the run: the
# update script's mktemp directories cannot leak.
[Service]
PrivateTmp=yes
EOF

  write_file "/etc/systemd/system/${HEALTH_SERVICE}" <<EOF
[Unit]
Description=Orca health check (service + port + crash-loop)
Documentation=file://${HEALTH_SCRIPT}

[Service]
Type=oneshot
ExecStart=${HEALTH_SCRIPT}
# The script prefixes its messages with <3>/<4>, so journald derives the
# priority: \`journalctl -u ${HEALTH_SERVICE} -p err\` shows only real outages.
StandardOutput=journal
StandardError=journal
PrivateTmp=yes
EOF

  write_file "/etc/systemd/system/${HEALTH_TIMER}" <<'EOF'
[Unit]
Description=Check Orca every 10 minutes

[Timer]
# One pass shortly after boot, then every 10 minutes.
OnBootSec=3min
OnUnitActiveSec=10min
# Catch up if the machine was off.
Persistent=true
Unit=orca-health.service

[Install]
WantedBy=timers.target
EOF

  write_file "/etc/systemd/system/${ALERT_SERVICE}" <<EOF
[Unit]
Description=Immediate alert after %i failed

[Service]
Type=oneshot
# Reuses the very same logic (and the same anti-spam state) as the periodic check.
ExecStart=${HEALTH_SCRIPT}
StandardOutput=journal
StandardError=journal
PrivateTmp=yes
# Do not fail the alert itself: orca-health exits 1 when it finds a problem,
# which is its job, not a malfunction of the alert.
SuccessExitStatus=0 1
EOF

  # Never overwritten: it may already hold the user's ntfy URL. 0600 because that
  # URL is the only thing protecting the alert feed from being read by anyone.
  if [[ -f "$ALERT_CONF" ]]; then
    ok "Alert config already present: ${ALERT_CONF} (left untouched)"
  elif [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s write %s (mode 600)\n' "$c_y" "$c_0" "$ALERT_CONF"
  else
    ( umask 077; cat > "$ALERT_CONF" <<'EOF'
# Notification channel for orca-health.
#
# Default: journal only (journalctl -u orca-health -p err).
# For a push notification, uncomment and set an ntfy URL. Pick a long,
# unguessable topic name: anyone who knows it can read your alerts.
#
#ORCA_ALERT_URL="https://ntfy.sh/orca-<hostname>-<random-string>"
EOF
    )
    ok "Alert config created: ${ALERT_CONF} (journal only — edit to add a push URL)"
  fi

  ok "Monitoring units written (${HEALTH_TIMER} every 10 min, OnFailure alerts)."
else
  warn "No orca-health — skipping the health timer and the OnFailure alerts."
fi

# Recent Orca builds IGNORE `serve --port`. The runtime reads
# ~/.config/orca/mobile-ws-fallback-port.json and may pick an ephemeral port
# on first boot. Write 6768 before the first start (mkdir: the profile does
# not exist until Orca has run once).
enforce_port_file() {
  local home dir file
  home="$(getent passwd "$SVC_USER" | cut -d: -f6)"
  dir="${home}/.config/orca"
  file="${dir}/mobile-ws-fallback-port.json"
  run mkdir -p "$dir"
  run chown "$SVC_USER":"$SVC_USER" "$dir" 2>/dev/null || true
  if [[ "$DRY_RUN" -eq 0 ]]; then
    printf '{"port":%s}\n' "$PORT" > "$file"
    chown "$SVC_USER":"$SVC_USER" "$file"
    chmod 644 "$file"
  fi
  ok "Port ${PORT} written to ${file}"
}

# See the note in do_status: an ss filter, never a text match on the whole table.
port_listening() { ss -ltn "sport = :${PORT}" 2>/dev/null | grep -q LISTEN; }

# --- Apply --------------------------------------------------------------------
enforce_port_file
run systemctl daemon-reload
# Re-read the port file: stop a running instance first.
if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
  run systemctl stop "$SERVICE" || true
fi
run systemctl enable --now "$SERVICE"
# `[[ ... ]] && cmd` as a statement returns 1 when the test is false, which under
# `set -e` would abort the script right here. Spelled as an if-block instead.
if [[ -n "$SRC_UPDATE" ]]; then
  run systemctl enable --now orca-update.timer
fi
if [[ -n "$SRC_HEALTH" ]]; then
  run systemctl enable --now "$HEALTH_TIMER"
fi

if [[ "$DRY_RUN" -eq 1 ]]; then exit 0; fi

if systemctl is-active --quiet "$SERVICE"; then
  ok "${SERVICE} active ✔"
else
  warn "${SERVICE} is not active — see: journalctl -u ${SERVICE} -e"
fi

log "Waiting for port ${PORT} (Electron is slow on a Pi)…"
ok_port=0
for _ in $(seq 1 20); do
  port_listening && { ok_port=1; break; }
  sleep 2
done
if [[ "$ok_port" -eq 0 ]]; then
  warn "Port ${PORT} not listening — rewriting the port file and restarting…"
  enforce_port_file
  run systemctl restart "$SERVICE" || true
  for _ in $(seq 1 15); do
    port_listening && { ok_port=1; break; }
    sleep 2
  done
fi
if [[ "$ok_port" -eq 1 ]]; then
  ok "Headless server listening on ${PORT} ✔"
else
  warn "Still not on ${PORT}. Actual listeners: $(ss -ltnp 2>/dev/null | grep -iE 'orca|xvfb' | grep -oE ':[0-9]+' | sort -u | tr '\n' ' ')"
  warn "journalctl -u ${SERVICE} -e"
fi
echo
do_status
echo
log "Test the update right away:  sudo systemctl start orca-update.service"
