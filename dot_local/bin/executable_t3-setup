#!/usr/bin/env bash
#
# t3-setup — Install T3 Code (the `t3` CLI) and run it as a headless user service.
#
# Thin wrapper: the service itself is upstream's (`t3 service install` creates the
# systemd USER unit t3code.service). This script only adds what upstream lacks:
#   - the CLI install when missing (https://t3.codes/install.sh -> ~/.local/bin/t3)
#   - ~/.t3/service.env (KEY=VALUE, 0600) for --lan / --port / --host
#   - linger, so the user manager survives logout (the only sudo needed)
#   - monitoring: t3-health.timer (10 min) + OnFailure=t3-alert@ on t3code.service
#   - zz-user-path.conf on t3code.service: PATH with the mise shims, ~/.local/bin
#     and ~/.grok/bin, plus pinned MISE_*_DIR — the upstream unit sets no PATH,
#     so the agents T3 launches were not found (same lesson as orca-setup)
#   - the OpenCode instance pointed at `opencode2` when installed: with mise,
#     `opencode` is v1 and the OpenCode Go/Zen login lives in v2 (only when the
#     instance exists and has no binaryPath yet; the service is stopped first)
#   - t3-update.timer (daily, random 1 h, or fixed with --update-at)
#
# USER scope on purpose: no system unit, no root, nothing under /etc.
# Linux only — on macOS T3 Code is the `t3-code` cask (desktop app, Brewfile).
# There is no t3-gui wrapper: the desktop app is a cask / AppImage, not a service.
# Optional headless browser support is upstream's: `sudo t3 browser setup`.
#
# Alerts go through agent-alert (ntfy or Telegram): `agent-alert --configure`, then
# `agent-alert --test`; journal only until configured. See t3-health.
#
# Usage:
#   t3-setup                         install CLI + service + monitoring
#   t3-setup --lan                   T3CODE_LAN=true (also listens on Tailscale; never public)
#   t3-setup --port 3773             T3CODE_PORT
#   t3-setup --host 100.x.y.z        T3CODE_HOST
#   t3-setup --update-at 04:30       fixed daily update time (default: daily, random 1h)
#   t3-setup --status                state (no changes)
#   t3-setup --uninstall             disable monitoring + `t3 service uninstall`
#   t3-setup --dry-run               print what would run
#
# Pair clients with `t3-pair`. Remove everything with `t3-uninstall`.
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
INSTALL_URL="https://t3.codes/install.sh"
SERVICE="t3code.service"
ENV_FILE="${T3_SERVICE_ENV:-$HOME/.t3/service.env}"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

ENV_UPDATES=()
UPDATE_AT=""
DRY_RUN=0
ASSUME_YES=0
ACTION="install"

# --- Helpers ------------------------------------------------------------------
c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[t3-setup]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[t3-setup]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[t3-setup]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[t3-setup]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then printf '  %s+%s %s\n' "$c_y" "$c_0" "$*"; return 0; fi
  "$@"
}

# Write a file, or print its path under --dry-run (content discarded).
write_file() {
  local path="$1"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s write %s\n' "$c_y" "$c_0" "$path"
    cat >/dev/null
    return 0
  fi
  mkdir -p "$(dirname "$path")"
  cat > "$path"
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

# --- Option parsing -----------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --lan)       ENV_UPDATES+=("T3CODE_LAN=true") ;;
    --port)
      _v="${2:?port missing}"; shift
      [[ "$_v" =~ ^[0-9]+$ ]] && (( _v >= 1 && _v <= 65535 )) || die "Invalid --port: ${_v}"
      ENV_UPDATES+=("T3CODE_PORT=${_v}") ;;
    --host)
      _v="${2:?address missing}"; shift
      # Strict charset: the value lands in a KEY=VALUE file read by systemd.
      [[ "$_v" =~ ^[A-Za-z0-9._:-]+$ ]] || die "Invalid --host: ${_v}"
      ENV_UPDATES+=("T3CODE_HOST=${_v}") ;;
    --update-at) UPDATE_AT="${2:?time missing (HH:MM)}"; shift ;;
    --status)    ACTION="status" ;;
    --uninstall) ACTION="uninstall" ;;
    --dry-run)   DRY_RUN=1 ;;
    -y|--yes)    ASSUME_YES=1 ;;
    -h|--help)   usage; exit 0 ;;
    *)           die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

[[ "$(uname -s)" == "Linux" ]] || die "t3-setup targets Linux (platform: $(uname -s)); on macOS use the t3-code cask."
[[ -z "$UPDATE_AT" || "$UPDATE_AT" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] \
  || die "--update-at expects HH:MM (got: ${UPDATE_AT})"

have_systemd_user() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

# is-active/is-enabled print a state AND exit non-zero: keep stdout only.
sstate() { local out; out="$("$@" 2>/dev/null)" || true; echo "${out:-unknown}"; }

t3_path() { [[ -x "$HOME/.local/bin/t3" ]] && echo "$HOME/.local/bin/t3" || command -v t3 2>/dev/null || true; }

linger_on() { loginctl show-user "$(id -un)" -p Linger 2>/dev/null | grep -q 'Linger=yes'; }

# --- Status -------------------------------------------------------------------
do_status() {
  local p; p="$(t3_path)"
  printf '%sT3 Code%s\n' "$c_b" "$c_0"
  if [[ -n "$p" ]]; then
    printf '  Binary   : %s (%s)\n' "$p" "$("$p" --version 2>/dev/null | head -1 || echo unknown)"
  else
    printf '  Binary   : %smissing%s (run t3-setup)\n' "$c_r" "$c_0"
  fi
  if have_systemd_user; then
    printf '  Service  : %s / %s\n' "$(sstate systemctl --user is-active "$SERVICE")" \
      "$(sstate systemctl --user is-enabled "$SERVICE")"
    printf '  Restarts : %s\n' "$(sstate systemctl --user show -p NRestarts --value "$SERVICE")"
    printf '  Health   : %s\n' "$(sstate systemctl --user is-active t3-health.timer)"
    printf '  Updater  : %s\n' "$(sstate systemctl --user is-active t3-update.timer)"
  fi
  printf '  Linger   : %s\n' "$(linger_on && echo yes || echo no)"
  if [[ -f "$ENV_FILE" ]]; then
    printf '  Env file : %s (mode %s)\n' "$ENV_FILE" "$(stat -c %a "$ENV_FILE" 2>/dev/null || echo ?)"
  else
    printf '  Env file : none (upstream defaults)\n'
  fi
  [[ -n "$p" ]] && { "$p" status 2>/dev/null | sed 's/^/  t3 status: /' || true; }
}

[[ "$ACTION" == "status" ]] && { do_status; exit 0; }

# --- Uninstall ----------------------------------------------------------------
if [[ "$ACTION" == "uninstall" ]]; then
  if [[ "$ASSUME_YES" -eq 0 && "$DRY_RUN" -eq 0 ]]; then
    printf 'Stop the T3 Code service and its monitoring? (CLI and ~/.t3 are kept) [y/N] '
    read -r reply
    [[ "$reply" =~ ^[yY]$ ]] || { log "Cancelled."; exit 0; }
  fi
  if have_systemd_user; then
    for u in t3-health.timer t3-update.timer; do
      run systemctl --user disable --now "$u" 2>/dev/null || true
    done
    run rm -rf "${UNIT_DIR}/${SERVICE}.d"
    run rm -f "${UNIT_DIR}"/t3-{health,update}.{service,timer} "${UNIT_DIR}/t3-alert@.service"
    run systemctl --user daemon-reload
  fi
  t3_path | grep -q . && run "$(t3_path)" service uninstall || true
  ok "Service and monitoring removed. Full removal: t3-uninstall"
  exit 0
fi

# --- Step 1: CLI --------------------------------------------------------------
P="$(t3_path)"
if [[ -n "$P" ]]; then
  ok "t3 already installed: ${P}"
else
  log "Installing the t3 CLI..."
  command -v curl >/dev/null 2>&1 || die "curl is required."
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s curl -fsSL %s | sh\n' "$c_y" "$c_0" "$INSTALL_URL"
  else
    # The upstream installer refuses to overwrite a foreign `t3` binary.
    curl -fsSL "$INSTALL_URL" | sh || die "The t3 installer failed."
    hash -r
    P="$(t3_path)"
    [[ -n "$P" ]] || die "t3 installed but not found (is ~/.local/bin in PATH?)"
  fi
fi
T3="${P:-t3}"

# --- Step 2: service.env (only when options were given) -----------------------
ENV_CHANGED=0
write_service_env() {
  [[ ${#ENV_UPDATES[@]} -gt 0 ]] || return 0
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s write %s (mode 600): %s\n' "$c_y" "$c_0" "$ENV_FILE" "${ENV_UPDATES[*]}"
    return 0
  fi
  mkdir -p "$(dirname "$ENV_FILE")"
  local tmp kv key
  tmp="$(umask 077; mktemp "${ENV_FILE}.XXXXXX")"
  [[ -f "$ENV_FILE" ]] && cat "$ENV_FILE" > "$tmp"
  for kv in "${ENV_UPDATES[@]}"; do
    key="${kv%%=*}"
    # Replace, never duplicate: drop any previous line for the same key.
    { grep -v "^${key}=" "$tmp" || true; } > "${tmp}.2"
    mv "${tmp}.2" "$tmp"
    printf '%s\n' "$kv" >> "$tmp"
  done
  chmod 600 "$tmp"
  if [[ -f "$ENV_FILE" ]] && cmp -s "$tmp" "$ENV_FILE"; then
    rm -f "$tmp"; log "service.env already up to date."
  else
    mv "$tmp" "$ENV_FILE"; ENV_CHANGED=1
    ok "Wrote ${ENV_FILE} (0600): ${ENV_UPDATES[*]}"
  fi
}

# --- Step 3: upstream service -------------------------------------------------
have_systemd_user || [[ "$DRY_RUN" -eq 1 ]] \
  || die "systemd --user unavailable — run the server by hand: t3 up"

write_service_env
log "Installing the service (t3 service install)..."
run "$T3" service install

if ! linger_on; then
  log "Enabling linger (keeps the user service alive after logout)..."
  run sudo loginctl enable-linger "$(id -un)" || warn "Could not enable linger."
fi


# OpenCode: mise keeps `opencode` = v1 (listed first) and installs v2 as
# `opencode2`, which holds the OpenCode Go/Zen login. Point T3's existing
# OpenCode instance at it, once (a binaryPath set by hand is kept).
T3_SETTINGS="${T3CODE_HOME:-$HOME/.t3}/userdata/settings.json"
OC2="$(command -v opencode2 2>/dev/null || true)"
oc_needs_path() {
  python3 - "$T3_SETTINGS" <<'PY'
import json, sys
try:
    inst = json.load(open(sys.argv[1]))["providerInstances"]["opencode"]
except (OSError, ValueError, KeyError, TypeError):
    sys.exit(1)
sys.exit(0 if not (inst.get("config") or {}).get("binaryPath") else 1)
PY
}
if [[ -n "$OC2" && -f "$T3_SETTINGS" ]] && oc_needs_path; then
  log "OpenCode instance -> ${OC2} (OpenCode 2 holds the Go/Zen login)..."
  if [[ "$DRY_RUN" -eq 0 ]]; then
    # The server rewrites settings.json: edit it while stopped.
    systemctl --user stop "$SERVICE" 2>/dev/null || true
    cp -p "$T3_SETTINGS" "${T3_SETTINGS}.bak-t3-setup"
    python3 - "$T3_SETTINGS" "$OC2" <<'PY'
import json, os, sys
p, oc2 = sys.argv[1], sys.argv[2]
s = json.load(open(p))
s["providerInstances"]["opencode"].setdefault("config", {})["binaryPath"] = oc2
tmp = p + ".tmp"
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
    json.dump(s, f, indent=2)
os.replace(tmp, p)
PY
  else
    printf '  %s+%s set providerInstances.opencode.config.binaryPath=%s\n' "$c_y" "$c_0" "$OC2"
  fi
  ENV_CHANGED=1
fi

# --- Step 4: monitoring + updater units (generated, user scope) ---------------
write_file "${UNIT_DIR}/t3-alert@.service" <<'EOF'
[Unit]
Description=Immediate alert after %i failed

[Service]
Type=oneshot
ExecStart=%h/.local/bin/t3-health --alert %i
EOF

write_file "${UNIT_DIR}/${SERVICE}.d/zz-alert.conf" <<'EOF'
# Managed by t3-setup: immediate alert when the upstream unit fails.
[Unit]
OnFailure=t3-alert@%n.service
EOF

# The upstream unit sets no PATH and a unit never reads shell rc files: the
# agent CLIs (mise shims, vendor installers) must be listed explicitly.
PATH_DROPIN="${UNIT_DIR}/${SERVICE}.d/zz-user-path.conf"
path_dropin() {
  cat <<'EOF'
# Managed by t3-setup: a unit never reads shell rc files, so the agent CLIs
# (mise shims, vendor installs) must be on PATH explicitly.
[Service]
Environment="PATH=%h/.local/share/mise/shims:%h/.local/bin:%h/.grok/bin:/usr/local/bin:/usr/bin:/bin"
# Agent tools may isolate XDG_*: pin mise to its real dirs so the shims still work.
Environment="MISE_DATA_DIR=%h/.local/share/mise" "MISE_CONFIG_DIR=%h/.config/mise" "MISE_STATE_DIR=%h/.local/state/mise" "MISE_CACHE_DIR=%h/.cache/mise"
EOF
}
if ! cmp -s <(path_dropin) "$PATH_DROPIN" 2>/dev/null; then
  path_dropin | write_file "$PATH_DROPIN"
  ENV_CHANGED=1
fi

write_file "${UNIT_DIR}/t3-health.service" <<'EOF'
[Unit]
Description=T3 Code health check
OnFailure=t3-alert@%n.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/t3-health
# t3-health exits 1 when it FOUND a problem (its job), not when it malfunctioned.
SuccessExitStatus=0 1
EOF

write_file "${UNIT_DIR}/t3-health.timer" <<'EOF'
[Unit]
Description=T3 Code health check every 10 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min

[Install]
WantedBy=timers.target
EOF

write_file "${UNIT_DIR}/t3-update.service" <<'EOF'
[Unit]
Description=Update T3 Code
OnFailure=t3-alert@%n.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/update-t3
EOF

if [[ -n "$UPDATE_AT" ]]; then
  # An update restarts the server and cuts running sessions: pin a quiet hour.
  CAL="OnCalendar=*-*-* ${UPDATE_AT}:00"; DELAY="RandomizedDelaySec=0"
else
  CAL="OnCalendar=daily"; DELAY="RandomizedDelaySec=1h"
fi
write_file "${UNIT_DIR}/t3-update.timer" <<EOF
[Unit]
Description=Daily check for T3 Code updates

[Timer]
${CAL}
Persistent=true
${DELAY}

[Install]
WantedBy=timers.target
EOF

run systemctl --user daemon-reload
run systemctl --user enable --now t3-health.timer t3-update.timer

if [[ "$ENV_CHANGED" -eq 1 ]]; then
  log "Environment changed — restarting (t3 service restart)..."
  run "$T3" service restart
fi

[[ "$DRY_RUN" -eq 1 ]] && exit 0

if [[ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/agent-alert.conf" ]]; then
  log "Alerts go to the journal only. For a push: agent-alert --configure, then agent-alert --test"
fi
echo
do_status
