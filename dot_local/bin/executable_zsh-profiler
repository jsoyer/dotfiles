#!/usr/bin/env zsh
# zsh-profiler — measure per-file startup time for zsh config
# Usage: zsh-profiler

# Intentionally no set -e: we want to continue even if individual sources fail
set -uo pipefail

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

echo "${BOLD}zsh startup profiler${NC}"
echo ""

# Use zsh's EPOCHREALTIME for accurate timing (works on macOS + Linux)
zmodload zsh/datetime 2>/dev/null

_prof_results=()

_prof_source() {
    local file="$1"
    local start_s end_s elapsed_ms
    start_s=$EPOCHREALTIME
    source "$file" 2>/dev/null
    end_s=$EPOCHREALTIME
    elapsed_ms=$(( (end_s - start_s) * 1000 ))
    elapsed_ms=${elapsed_ms%.*}  # truncate to integer
    _prof_results+=("${elapsed_ms} ${file}")
}

# Profile oh-my-zsh
_omz_start=$EPOCHREALTIME
[[ -f "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh" ]] && source "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh" 2>/dev/null
_omz_end=$EPOCHREALTIME
_omz_ms=$(( (_omz_end - _omz_start) * 1000 ))
_omz_ms=${_omz_ms%.*}
_prof_results+=("${_omz_ms} oh-my-zsh")

# Profile each modular config
for config_file ($HOME/.zsh/*.zsh(N)); do
    _prof_source "$config_file"
done

# Sort and display
echo "  %-6s  %s\n" "Time" "File"
echo "  ----------------------------------------"

total=0
for entry in "${(On)_prof_results[@]}"; do
    ms="${entry%% *}"
    file="${entry#* }"
    basename="${file##*/}"
    total=$(( total + ms ))

    color="${GREEN}"
    if (( ms >= 50 && ms < 100 )); then
        color="${YELLOW}"
    elif (( ms >= 100 )); then
        color="${RED}"
    fi
    printf "  ${color}%4dms${NC}  %s\n" "$ms" "$basename"
done

echo ""
echo "${BOLD}Total: ${total}ms${NC}"
echo ""
echo "Thresholds: ${GREEN}< 50ms${NC} fast  ${YELLOW}50-100ms${NC} ok  ${RED}> 100ms${NC} slow"
