#!/usr/bin/env zsh
# zsh-profiler — measure per-file startup time for zsh config
# Usage: zsh-profiler [--top N]

set -uo pipefail

TOP="${1:-0}"
[[ "$1" == "--top" ]] && TOP="${2:-10}"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

echo "${BOLD}zsh startup profiler${NC}"
echo ""

# Create a temporary zshrc that profiles each source
TMPRC="$(mktemp)"
TMPLOG="$(mktemp)"

cat > "${TMPRC}" << 'PROFILER'
# Minimal env needed for oh-my-zsh
export ZSH="${HOME}/.oh-my-zsh"
export SHELL="$(which zsh)"

_prof_log=""

_prof_source() {
    local file="$1"
    local start_ns end_ns elapsed_ms
    start_ns=$(($(date +%s%N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1e9))')))
    source "$file" 2>/dev/null
    end_ns=$(($(date +%s%N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1e9))')))
    elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))
    _prof_log="${_prof_log}${elapsed_ms} ${file}\n"
}

# Profile oh-my-zsh
_omz_start=$(($(date +%s%N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1e9))')))
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh" 2>/dev/null
_omz_end=$(($(date +%s%N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1e9))')))
_omz_ms=$(( (_omz_end - _omz_start) / 1000000 ))
_prof_log="${_prof_log}${_omz_ms} oh-my-zsh\n"

# Profile each modular config
for config_file ($HOME/.zsh/*.zsh(N)); do
    _prof_source "$config_file"
done

# Output results
echo -e "$_prof_log" | sort -rn > /tmp/zsh-profiler.log
PROFILER

# Run the profiling zsh
zsh -c "source ${TMPRC}" 2>/dev/null

# Display results
if [[ -f /tmp/zsh-profiler.log ]]; then
    local total=0
    printf "  %-6s  %s\n" "Time" "File"
    printf "  %s\n" "----------------------------------------"
    while IFS=' ' read -r ms file; do
        [[ -z "$ms" ]] && continue
        total=$(( total + ms ))
        local color="${GREEN}"
        if (( ms >= 50 && ms < 100 )); then
            color="${YELLOW}"
        elif (( ms >= 100 )); then
            color="${RED}"
        fi
        local basename="${file##*/}"
        printf "  ${color}%4dms${NC}  %s\n" "$ms" "$basename"
    done < /tmp/zsh-profiler.log

    echo ""
    echo "${BOLD}Total: ${total}ms${NC}"
    echo ""
    echo "Thresholds: ${GREEN}< 50ms${NC} fast  ${YELLOW}50-100ms${NC} ok  ${RED}> 100ms${NC} slow"
fi

rm -f "${TMPRC}" "${TMPLOG}"
