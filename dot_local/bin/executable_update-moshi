#!/usr/bin/env bash
#
# update-moshi — Update the moshi-hook binary and restart the daemon if the
# version changed.
#
# Flow: back up the binary → self-update (`moshi-hook update`) or `brew upgrade`
# depending on how it was installed → check the new binary answers → restart the
# service if the version moved → roll back automatically if it does not come up.
#
# Counterpart of update-orca, but in USER scope: moshi-hook lives in
# ~/.local/bin and depends on ~/.config/moshi + ~/.local/state/moshi. No root,
# no copy into /usr/local/bin (the SELinux home_t trap only affects SYSTEM
# units; a --user unit runs a binary under /home just fine).
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
BIN="${MOSHI_BIN:-$HOME/.local/bin/moshi-hook}"
SERVICE="moshi-hook.service"
PLIST="com.jsoyer.moshi-hook"

# --- Helpers ------------------------------------------------------------------
log()  { printf '\033[1;34m[moshi-update]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[moshi-update]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[moshi-update]\033[0m %s\n' "$*" >&2; exit 1; }

# `moshi-hook version` prints "moshi-hook X.Y.Z"; returns "unknown" if silent.
bin_version() {
  local v
  v="$("$1" version 2>/dev/null | awk 'NF{print $NF; exit}')" || true
  echo "${v:-unknown}"
}

# systemctl --user needs XDG_RUNTIME_DIR (present when launched by systemd, must
# be rebuilt if the script is called from cron/ssh without a session).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# --- Guards -------------------------------------------------------------------
[[ "$(id -u)" -ne 0 ]] || die "Run as your user, not root (binary and state live in \$HOME)."

# The binary may also come from Homebrew (macOS): prefer whatever is on PATH.
if ! [[ -x "$BIN" ]]; then
  BIN="$(command -v moshi-hook 2>/dev/null || true)"
fi
[[ -n "$BIN" && -x "$BIN" ]] || die "moshi-hook binary not found or not executable."
BACKUP="${BIN}.bak"

# Installed by Homebrew? Then brew owns the update: a self-update would overwrite
# the binary in the Cellar and brew would rewrite it at the next upgrade.
BREW_MANAGED=0
if command -v brew >/dev/null 2>&1; then
  case "$BIN" in
    "$(brew --prefix 2>/dev/null)"/*) BREW_MANAGED=1 ;;
  esac
fi

# --- Supervisor detection -----------------------------------------------------
have_systemd=0
have_launchd=0
if command -v systemctl >/dev/null 2>&1 && systemctl --user cat "$SERVICE" >/dev/null 2>&1; then
  have_systemd=1
elif [[ "$(uname -s)" == "Darwin" ]] && [[ -f "${HOME}/Library/LaunchAgents/${PLIST}.plist" ]]; then
  have_launchd=1
fi

restart_service() {
  if [[ "$have_systemd" -eq 1 ]]; then
    systemctl --user restart "$SERVICE"
  elif [[ "$have_launchd" -eq 1 ]]; then
    launchctl kickstart -k "gui/$(id -u)/${PLIST}"
  fi
}

service_active() {
  if [[ "$have_systemd" -eq 1 ]]; then
    systemctl --user is-active --quiet "$SERVICE"
  elif [[ "$have_launchd" -eq 1 ]]; then
    launchctl list 2>/dev/null | grep -q "$PLIST"
  else
    return 1
  fi
}

# --- Current version + backup -------------------------------------------------
CUR_VER="$(bin_version "$BIN")"
log "Installed version: ${CUR_VER}"

# --- Update -------------------------------------------------------------------
if [[ "$BREW_MANAGED" -eq 1 ]]; then
  log "Binary managed by Homebrew — updating through brew."
  set +e
  OUT="$(brew upgrade moshi-hook 2>&1)"; RC=$?
  set -e
  printf '%s\n' "$OUT" | sed 's/^/    /'
  if [[ "$RC" -ne 0 ]]; then
    warn "brew upgrade failed (code ${RC}) — binary unchanged (${CUR_VER})."
    exit 0
  fi
else
  # `moshi-hook update` downloads the release and replaces the binary with an
  # atomic rename: the running daemon keeps its inode, no need to stop it first.
  cp -f "$BIN" "$BACKUP"   # rollback stays possible even on a half-failed update
  set +e
  OUT="$("$BIN" update 2>&1)"; RC=$?
  set -e
  printf '%s\n' "$OUT" | sed 's/^/    /'
  if [[ "$RC" -ne 0 ]]; then
    # Network/API unreachable: not fatal, the binary did not move. Do not fail
    # the timer over a transient outage — the next run catches up.
    warn "moshi-hook update failed (code ${RC}) — binary unchanged (${CUR_VER}), will retry on the next run."
    exit 0
  fi
fi

# --- Validate the new binary --------------------------------------------------
NEW_VER="$(bin_version "$BIN")"
if [[ "$NEW_VER" == "unknown" ]]; then
  warn "The updated binary no longer answers 'version' — rolling back."
  if [[ -f "$BACKUP" ]]; then
    mv -f "$BACKUP" "$BIN"
    chmod 755 "$BIN"
    restart_service || true
    die "Rolled back to ${CUR_VER}. Broken release?"
  fi
  die "No backup available (brew install) — try: brew reinstall moshi-hook"
fi

log "Installed version: ${CUR_VER}  →  version after update: ${NEW_VER}"

if [[ "$NEW_VER" == "$CUR_VER" ]]; then
  log "Already up to date (${CUR_VER}) — daemon left alone, no restart."
  exit 0
fi

# --- Restart the daemon -------------------------------------------------------
# The running process still holds the old inode: without a restart, the new
# version only takes effect at the next (re)start.
if [[ "$have_systemd" -eq 1 || "$have_launchd" -eq 1 ]]; then
  if service_active || { [[ "$have_systemd" -eq 1 ]] && systemctl --user is-enabled --quiet "$SERVICE"; }; then
    log "Restarting the service…"
    restart_service || warn "unclean restart (continuing with the check)."
    sleep 3
    if service_active; then
      log "Service active ✔"
    else
      warn "Service down after the update — rolling back to ${CUR_VER}…"
      if [[ -f "$BACKUP" ]]; then
        mv -f "$BACKUP" "$BIN"
        chmod 755 "$BIN"
        restart_service || true
        die "Rolled back. See: journalctl --user -u ${SERVICE} -e"
      fi
      die "Service down and no backup (brew install). Check the logs."
    fi
  else
    log "Service neither active nor enabled — no restart."
  fi
fi

log "moshi-hook updated successfully (${CUR_VER} → ${NEW_VER})."
