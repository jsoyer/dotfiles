#!/usr/bin/env bash
#
# update-moshi — Met à jour le binaire moshi-hook et redémarre le daemon si la
# version a changé.
#
# Flux : sauvegarde du binaire → self-update (`moshi-hook update`) ou
# `brew upgrade` selon le mode d'installation → vérification que le nouveau
# binaire répond → restart du service si la version a bougé → rollback
# automatique si le service ne remonte pas.
#
# Pendant de update-orca, mais en scope UTILISATEUR : moshi-hook vit dans
# ~/.local/bin et dépend de ~/.config/moshi + ~/.local/state/moshi. Pas de root,
# pas de copie vers /usr/local/bin (le piège SELinux home_t ne concerne que les
# units SYSTEM ; une unit --user exécute très bien un binaire sous /home).
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
BIN="${MOSHI_BIN:-$HOME/.local/bin/moshi-hook}"
SERVICE="moshi-hook.service"
PLIST="com.jsoyer.moshi-hook"

# --- Helpers ------------------------------------------------------------------
log()  { printf '\033[1;34m[moshi-update]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[moshi-update]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[moshi-update]\033[0m %s\n' "$*" >&2; exit 1; }

# `moshi-hook version` imprime "moshi-hook X.Y.Z" ; renvoie "inconnue" si muet.
bin_version() {
  local v
  v="$("$1" version 2>/dev/null | awk 'NF{print $NF; exit}')" || true
  echo "${v:-inconnue}"
}

# systemctl --user a besoin de XDG_RUNTIME_DIR (présent quand lancé par systemd,
# à reconstruire si le script est appelé depuis cron/ssh sans session).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# --- Garde-fous ---------------------------------------------------------------
[[ "$(id -u)" -ne 0 ]] || die "À lancer en tant qu'utilisateur, pas en root (binaire et état vivent dans \$HOME)."

# Le binaire peut aussi venir de Homebrew (macOS) : on suit le PATH en priorité.
if ! [[ -x "$BIN" ]]; then
  BIN="$(command -v moshi-hook 2>/dev/null || true)"
fi
[[ -n "$BIN" && -x "$BIN" ]] || die "Binaire moshi-hook introuvable ou non exécutable."
BACKUP="${BIN}.bak"

# Installé par Homebrew ? Alors c'est brew qui met à jour : un self-update
# écraserait le binaire dans le Cellar et brew le réécrirait au prochain upgrade.
BREW_MANAGED=0
if command -v brew >/dev/null 2>&1; then
  case "$BIN" in
    "$(brew --prefix 2>/dev/null)"/*) BREW_MANAGED=1 ;;
  esac
fi

# --- Détection du superviseur -------------------------------------------------
have_systemd=0
have_launchd=0
if command -v systemctl >/dev/null 2>&1 && systemctl --user cat "$SERVICE" >/dev/null 2>&1; then
  have_systemd=1
elif [[ "$(uname -s)" == "Darwin" ]] && [[ -f "${HOME}/Library/LaunchAgents/${PLIST}.plist" ]]; then
  have_launchd=1
fi

restart_service() {
  if [[ "$have_systemd" -eq 1 ]]; then
    systemctl --user restart "$SERVICE"
  elif [[ "$have_launchd" -eq 1 ]]; then
    launchctl kickstart -k "gui/$(id -u)/${PLIST}"
  fi
}

service_active() {
  if [[ "$have_systemd" -eq 1 ]]; then
    systemctl --user is-active --quiet "$SERVICE"
  elif [[ "$have_launchd" -eq 1 ]]; then
    launchctl list 2>/dev/null | grep -q "$PLIST"
  else
    return 1
  fi
}

# --- Version actuelle + sauvegarde --------------------------------------------
CUR_VER="$(bin_version "$BIN")"
log "Version installée : ${CUR_VER}"

# --- Mise à jour --------------------------------------------------------------
if [[ "$BREW_MANAGED" -eq 1 ]]; then
  log "Binaire géré par Homebrew — mise à jour via brew."
  set +e
  OUT="$(brew upgrade moshi-hook 2>&1)"; RC=$?
  set -e
  printf '%s\n' "$OUT" | sed 's/^/    /'
  if [[ "$RC" -ne 0 ]]; then
    warn "brew upgrade a échoué (code ${RC}) — binaire inchangé (${CUR_VER})."
    exit 0
  fi
else
  # `moshi-hook update` télécharge la release et remplace le binaire par rename
  # atomique : le daemon en cours garde son inode, inutile de l'arrêter avant.
  cp -f "$BIN" "$BACKUP"   # rollback possible même si le self-update foire à moitié
  set +e
  OUT="$("$BIN" update 2>&1)"; RC=$?
  set -e
  printf '%s\n' "$OUT" | sed 's/^/    /'
  if [[ "$RC" -ne 0 ]]; then
    # Réseau/API injoignable : non fatal, le binaire n'a pas bougé. On n'échoue
    # pas le timer pour une coupure passagère — la prochaine exécution rattrapera.
    warn "moshi-hook update a échoué (code ${RC}) — binaire inchangé (${CUR_VER}), nouvelle tentative au prochain run."
    exit 0
  fi
fi

# --- Validation du nouveau binaire --------------------------------------------
NEW_VER="$(bin_version "$BIN")"
if [[ "$NEW_VER" == "inconnue" ]]; then
  warn "Le binaire mis à jour ne répond plus à 'version' — rollback."
  if [[ -f "$BACKUP" ]]; then
    mv -f "$BACKUP" "$BIN"
    chmod 755 "$BIN"
    restart_service || true
    die "Rollback effectué vers ${CUR_VER}. Release cassée ?"
  fi
  die "Aucune sauvegarde disponible (installation brew) — tente : brew reinstall moshi-hook"
fi

log "Version installée : ${CUR_VER}  →  version après update : ${NEW_VER}"

if [[ "$NEW_VER" == "$CUR_VER" ]]; then
  log "Déjà à jour (${CUR_VER}) — daemon laissé intact, aucun restart."
  exit 0
fi

# --- Restart du daemon --------------------------------------------------------
# Le process en cours tourne toujours sur l'ancien inode : sans restart, la
# nouvelle version n'est active qu'au prochain (re)démarrage.
if [[ "$have_systemd" -eq 1 || "$have_launchd" -eq 1 ]]; then
  if service_active || { [[ "$have_systemd" -eq 1 ]] && systemctl --user is-enabled --quiet "$SERVICE"; }; then
    log "Redémarrage du service…"
    restart_service || warn "restart non-propre (poursuite de la vérification)."
    sleep 3
    if service_active; then
      log "Service actif ✔"
    else
      warn "Service KO après update — rollback vers ${CUR_VER}…"
      if [[ -f "$BACKUP" ]]; then
        mv -f "$BACKUP" "$BIN"
        chmod 755 "$BIN"
        restart_service || true
        die "Rollback effectué. Voir : journalctl --user -u ${SERVICE} -e"
      fi
      die "Service KO et pas de sauvegarde (installation brew). Voir les logs."
    fi
  else
    log "Service ni actif ni activé — pas de restart."
  fi
fi

log "moshi-hook mis à jour avec succès (${CUR_VER} → ${NEW_VER})."
