#!/usr/bin/env bash
#
# update-t3 — Update T3 Code, restart the service when the version moved, then
# smoke-test it with t3-health.
#
# Thin wrapper over `t3 update --yes` (upstream owns download, verification and
# the version switch). Upstream reports status `restart-pending` while the
# service still runs the previous build, hence the restart here.
#
# Run by t3-update.timer (user scope, see t3-setup --update-at), or by hand.
#
# Usage:
#   update-t3                    update, restart if the version changed, smoke test
#   update-t3 --channel nightly  forwarded to `t3 update` (also: --allow-downgrade,
#                                or a version number as positional argument)
#   update-t3 --no-restart       leave the running service alone
#   update-t3 --no-smoke         skip the t3-health check
#
set -euo pipefail

RESTART=1
SMOKE=1
PASSTHRU=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-restart) RESTART=0 ;;
    --no-smoke)   SMOKE=0 ;;
    -h|--help)    sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; exit 0 ;;
    *)            PASSTHRU+=("$1") ;;
  esac
  shift
done

SERVICE="t3code.service"
log()  { printf '\033[1;34m[update-t3]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[update-t3]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[update-t3]\033[0m %s\n' "$*" >&2; exit 1; }

# systemctl --user needs XDG_RUNTIME_DIR (absent outside a login session).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

[[ "$(id -u)" -ne 0 ]] || die "Run as your user, not root."
command -v t3 >/dev/null 2>&1 || die "t3 not found — run: t3-setup"

version() { t3 --version 2>/dev/null | head -1 | tr -d '\r' || echo unknown; }

before="$(version)"
log "Installed version: ${before:-unknown}"

# A failed update (network outage) leaves the binary untouched: do not fail the
# timer over it, the next run catches up. Anything else surfaces in the journal.
if ! t3 update --yes ${PASSTHRU[@]+"${PASSTHRU[@]}"}; then
  warn "t3 update failed — version unchanged (${before:-unknown})."
  exit 0
fi

hash -r
after="$(version)"
[[ -n "$after" && "$after" != "unknown" ]] || die "The updated t3 no longer answers --version."
log "Version: ${before} -> ${after}"

have_service=0
systemctl --user cat "$SERVICE" >/dev/null 2>&1 && have_service=1

if [[ "$RESTART" -eq 1 && "$have_service" -eq 1 ]]; then
  # Restart on a version change, OR when upstream still reports restart-pending
  # (an earlier update whose restart never happened).
  if [[ "$after" != "$before" ]] || t3 status --json 2>/dev/null | grep -q 'restart-pending'; then
    log "Restarting ${SERVICE}..."
    t3 service restart || warn "Unclean restart (the smoke test decides)."
  else
    log "Already up to date — service left alone."
  fi
fi

if [[ "$SMOKE" -eq 1 && "$have_service" -eq 1 ]]; then
  sleep 5
  if command -v t3-health >/dev/null 2>&1 && t3-health; then
    log "Smoke test OK."
  else
    die "Smoke test FAILED after update (${before} -> ${after}). See: journalctl --user -u ${SERVICE} -e. Roll back: t3 update --yes ${before} --allow-downgrade"
  fi
fi
log "T3 Code is up to date (${after})."
