#!/usr/bin/env bash
#
# moshi-setup — Installe et configure la stack Moshi (moshi-hook + mosh + tmux).
#
# Multi-plateforme : Debian/Ubuntu/RPi (apt), Fedora/RHEL (dnf), Fedora Atomic
# (rpm-ostree), Arch/OmArchy (pacman), openSUSE (zypper), Alpine (apk), Void
# (xbps), macOS (Homebrew + tap rjyo/moshi). Fallback Homebrew/Linuxbrew.
#
# Rien n'est activé automatiquement par chezmoi : ce script est le SEUL point
# d'entrée (alias `moshi-install`). Idempotent — relançable sans risque.
#
# Usage :
#   moshi-setup                  install complet + activation du service
#   moshi-setup --no-service     binaires seulement (conteneur, toolbox, CI)
#   moshi-setup --no-packages    saute mosh/tmux (déjà gérés par les manifests)
#   moshi-setup --status         état du binaire + du service
#   moshi-setup --update         délègue à update-moshi
#   moshi-setup --uninstall      retire service + binaire (garde mosh/tmux)
#   moshi-setup --dry-run        affiche sans exécuter
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
INSTALL_DIR="${MOSHI_INSTALL_DIR:-$HOME/.local/bin}"
BIN="${INSTALL_DIR}/moshi-hook"
INSTALLER_URL="https://getmoshi.app/install.sh"
BREW_TAP="rjyo/moshi"
SERVICE="moshi-hook.service"
UPDATE_TIMER="moshi-update.timer"
PLIST_HOOK="com.jsoyer.moshi-hook"
PLIST_UPDATE="com.jsoyer.moshi-update"

DO_PACKAGES=1
DO_HOOK=1
DO_SERVICE=1
ASSUME_YES=0
DRY_RUN=0
ACTION="install"

# --- Helpers ------------------------------------------------------------------
c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[moshi-setup]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[moshi-setup]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[moshi-setup]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[moshi-setup]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

# Exécute une commande, ou l'affiche seulement en --dry-run.
run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s %s\n' "$c_y" "$c_0" "$*"
    return 0
  fi
  "$@"
}

# sudo seulement si on n'est pas déjà root et que sudo existe.
SUDO=""
need_sudo() {
  [[ "$(id -u)" -eq 0 ]] && { SUDO=""; return 0; }
  command -v sudo >/dev/null 2>&1 || die "Droits root requis mais sudo est introuvable."
  SUDO="sudo"
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

# --- Parsing des options ------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-packages) DO_PACKAGES=0 ;;
    --no-hook)     DO_HOOK=0 ;;
    --no-service)  DO_SERVICE=0 ;;
    --status)      ACTION="status" ;;
    --update)      ACTION="update" ;;
    --uninstall)   ACTION="uninstall" ;;
    --dry-run)     DRY_RUN=1 ;;
    -y|--yes)      ASSUME_YES=1 ;;
    -h|--help)     usage; exit 0 ;;
    *)             die "Option inconnue : $1 (voir --help)" ;;
  esac
  shift
done

# --- Détection de la plateforme -----------------------------------------------
OS="$(uname -s)"
case "$OS" in
  Linux)  PLATFORM="linux" ;;
  Darwin) PLATFORM="darwin" ;;
  *)      die "Plateforme non supportée : ${OS} (Linux et macOS uniquement)." ;;
esac

# Un toolbox/conteneur partage le réseau de l'hôte : y faire tourner un second
# daemon moshi-hook entrerait en conflit avec celui de l'hôte.
IN_CONTAINER=0
if [[ -f /.toolboxenv || -n "${TOOLBOX_PATH:-}" || -f /run/.containerenv || -f /.dockerenv ]]; then
  IN_CONTAINER=1
fi

# Identifiant de distribution : ID puis ID_LIKE (ex. "ubuntu" → "debian").
distro_ids() {
  [[ -r /etc/os-release ]] || return 0
  # shellcheck disable=SC1091
  . /etc/os-release
  printf '%s %s\n' "${ID:-}" "${ID_LIKE:-}"
}

# Gestionnaire de paquets à utiliser pour mosh/tmux.
detect_pm() {
  if [[ "$PLATFORM" == "darwin" ]]; then
    command -v brew >/dev/null 2>&1 && { echo brew; return; }
    echo none; return
  fi

  # Fedora Atomic : dnf existe mais est en lecture seule côté image.
  if command -v rpm-ostree >/dev/null 2>&1 && [[ "$IN_CONTAINER" -eq 0 ]]; then
    echo rpm-ostree; return
  fi

  local ids; ids=" $(distro_ids) "
  case "$ids" in
    *" debian "*|*" ubuntu "*|*" raspbian "*|*" raspios "*) command -v apt-get >/dev/null 2>&1 && { echo apt; return; } ;;
    *" fedora "*|*" rhel "*|*" centos "*)                   command -v dnf     >/dev/null 2>&1 && { echo dnf; return; } ;;
    *" arch "*|*" archarm "*|*" omarchy "*)                 command -v pacman  >/dev/null 2>&1 && { echo pacman; return; } ;;
    *" suse "*|*" opensuse "*)                              command -v zypper  >/dev/null 2>&1 && { echo zypper; return; } ;;
    *" alpine "*)                                           command -v apk     >/dev/null 2>&1 && { echo apk; return; } ;;
    *" void "*)                                             command -v xbps-install >/dev/null 2>&1 && { echo xbps; return; } ;;
  esac

  # Fallback : on sonde les binaires si /etc/os-release n'a rien donné.
  for pm in apt-get dnf pacman zypper apk xbps-install brew; do
    command -v "$pm" >/dev/null 2>&1 || continue
    case "$pm" in
      apt-get)      echo apt ;;
      xbps-install) echo xbps ;;
      *)            echo "$pm" ;;
    esac
    return
  done
  echo none
}

# --- Étape 1 : mosh + tmux ----------------------------------------------------
install_packages() {
  local pm; pm="$(detect_pm)"
  local missing=()
  command -v mosh >/dev/null 2>&1 || missing+=(mosh)
  command -v tmux >/dev/null 2>&1 || missing+=(tmux)

  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "mosh et tmux déjà présents — rien à installer."
    return 0
  fi
  log "Paquets manquants : ${missing[*]} (gestionnaire détecté : ${pm})"

  # Les wrappers du dépôt (aptw/dnfw/pacmanw/breww) installent ET mettent à jour
  # le manifest correspondant (dot_private/Aptfile_*, Dnffile_*…). On les préfère
  # au gestionnaire brut pour que la machine suivante hérite du paquet.
  local wrapper=""
  case "$pm" in
    apt)    command -v aptw    >/dev/null 2>&1 && wrapper="aptw" ;;
    dnf)    command -v dnfw    >/dev/null 2>&1 && wrapper="dnfw" ;;
    pacman) command -v pacmanw >/dev/null 2>&1 && wrapper="pacmanw" ;;
    brew)   command -v breww   >/dev/null 2>&1 && wrapper="breww" ;;
  esac
  if [[ -n "$wrapper" ]]; then
    log "Utilisation du wrapper ${wrapper} (le manifest sera mis à jour)."
    run "$wrapper" install "${missing[@]}"
    ok "Paquets installés : ${missing[*]}"
    return 0
  fi

  case "$pm" in
    apt)
      need_sudo
      run $SUDO apt-get update -qq
      run $SUDO apt-get install -y "${missing[@]}"
      ;;
    dnf)
      need_sudo
      run $SUDO dnf install -y "${missing[@]}"
      ;;
    rpm-ostree)
      # Superposition sur l'image : nécessite un redémarrage pour être active.
      warn "Fedora Atomic détecté — installation par superposition (redémarrage requis)."
      need_sudo
      run $SUDO rpm-ostree install --idempotent "${missing[@]}"
      warn "Redémarre pour que ${missing[*]} soient disponibles, puis relance moshi-setup."
      ;;
    pacman)
      need_sudo
      run $SUDO pacman -S --needed --noconfirm "${missing[@]}"
      ;;
    zypper)
      need_sudo
      run $SUDO zypper --non-interactive install "${missing[@]}"
      ;;
    apk)
      need_sudo
      run $SUDO apk add --no-cache "${missing[@]}"
      ;;
    xbps)
      need_sudo
      run $SUDO xbps-install -Sy "${missing[@]}"
      ;;
    brew)
      run brew install "${missing[@]}"
      ;;
    none)
      warn "Aucun gestionnaire de paquets reconnu — installe ${missing[*]} manuellement."
      return 0
      ;;
  esac
  ok "Paquets installés : ${missing[*]}"
}

# --- Étape 2 : moshi-hook -----------------------------------------------------
install_hook_brew() {
  log "Installation de moshi-hook via Homebrew (tap ${BREW_TAP})…"
  run brew tap "$BREW_TAP"
  # `brew trust` n'existe pas dans Homebrew mainline ; la commande est donnée par
  # la doc du tap. On la tente sans jamais échouer dessus.
  run brew trust "$BREW_TAP" 2>/dev/null || true
  run brew install moshi-hook
}

install_hook_curl() {
  log "Installation de moshi-hook via ${INSTALLER_URL}…"
  command -v curl >/dev/null 2>&1 || die "curl est requis pour installer moshi-hook."
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s curl -fsSL %s | INSTALL_DIR=%s MOSHI_HOOK_SKIP_FIRST_RUN=1 sh\n' \
      "$c_y" "$c_0" "$INSTALLER_URL" "$INSTALL_DIR"
    return 0
  fi
  # MOSHI_HOOK_SKIP_FIRST_RUN : l'installeur propose un `set --first-run`
  # interactif. C'est nous qui pilotons la suite (service + pairing).
  curl -fsSL "$INSTALLER_URL" \
    | INSTALL_DIR="$INSTALL_DIR" MOSHI_HOOK_SKIP_FIRST_RUN=1 sh \
    || die "L'installeur moshi-hook a échoué."
}

install_hook() {
  local existing=""
  existing="$(command -v moshi-hook 2>/dev/null || true)"
  if [[ -n "$existing" ]]; then
    ok "moshi-hook déjà installé : ${existing} ($(hook_version "$existing"))"
    log "Pour mettre à jour : moshi-setup --update"
    return 0
  fi

  if [[ "$PLATFORM" == "darwin" ]] && command -v brew >/dev/null 2>&1; then
    install_hook_brew
  else
    install_hook_curl
  fi

  # L'installeur pose le binaire dans INSTALL_DIR : il doit être dans le PATH.
  if ! command -v moshi-hook >/dev/null 2>&1 && [[ ! -x "$BIN" ]]; then
    die "moshi-hook introuvable après installation (attendu : ${BIN})."
  fi
  case ":${PATH}:" in
    *":${INSTALL_DIR}:"*) : ;;
    *) warn "${INSTALL_DIR} n'est pas dans le PATH — ajoute-le (voir dot_zsh/01-path.zsh)." ;;
  esac
  ok "moshi-hook installé."
}

# Chemin réel du binaire, brew ou ~/.local/bin.
hook_path() { command -v moshi-hook 2>/dev/null || { [[ -x "$BIN" ]] && echo "$BIN"; } || true; }
hook_version() { "$1" version 2>/dev/null | awk 'NF{print $NF; exit}' || echo inconnue; }

# --- Étape 3 : service --------------------------------------------------------
have_systemd_user() {
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl --user show-environment >/dev/null 2>&1
}

enable_linger() {
  # Sans linger, le gestionnaire systemd --user est tué à la déconnexion : le
  # daemon moshi-hook mourrait dès la fin de la session SSH — exactement ce
  # qu'on ne veut pas sur une machine qu'on rejoint en mosh.
  local u; u="$(id -un)"
  if loginctl show-user "$u" -p Linger 2>/dev/null | grep -q 'Linger=yes'; then
    ok "Linger déjà actif pour ${u}."
    return 0
  fi
  need_sudo
  log "Activation du linger (le service survit à la déconnexion)…"
  run $SUDO loginctl enable-linger "$u" || warn "Échec de l'activation du linger."
}

setup_service_linux() {
  local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  local missing=()
  for u in "$SERVICE" moshi-update.service "$UPDATE_TIMER"; do
    [[ -f "${unit_dir}/${u}" ]] || missing+=("$u")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    die "Units absentes de ${unit_dir} : ${missing[*]} — lance d'abord 'chezmoi apply'."
  fi

  if ! have_systemd_user; then
    warn "systemd --user indisponible (conteneur, WSL sans systemd…)."
    warn "Lance le daemon à la main : ${BIN} serve &"
    return 0
  fi

  enable_linger
  log "Activation des units systemd --user…"
  run systemctl --user daemon-reload
  run systemctl --user enable --now "$SERVICE"
  run systemctl --user enable --now "$UPDATE_TIMER"
  [[ "$DRY_RUN" -eq 1 ]] && return 0

  sleep 2
  if systemctl --user is-active --quiet "$SERVICE"; then
    ok "${SERVICE} actif ✔"
  else
    warn "${SERVICE} n'est pas actif — voir : journalctl --user -u ${SERVICE} -e"
  fi
}

setup_service_darwin() {
  local agents="${HOME}/Library/LaunchAgents"
  local missing=()
  for p in "$PLIST_HOOK" "$PLIST_UPDATE"; do
    [[ -f "${agents}/${p}.plist" ]] || missing+=("${p}.plist")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    die "LaunchAgents absents de ${agents} : ${missing[*]} — lance d'abord 'chezmoi apply'."
  fi
  for p in "$PLIST_HOOK" "$PLIST_UPDATE"; do
    log "Chargement de ${p}…"
    run launchctl unload "${agents}/${p}.plist" 2>/dev/null || true
    run launchctl load "${agents}/${p}.plist" || warn "Échec du chargement de ${p}."
  done
  ok "LaunchAgents chargés."
}

setup_service() {
  if [[ "$IN_CONTAINER" -eq 1 ]]; then
    warn "Conteneur/toolbox détecté — le daemon moshi-hook doit tourner sur l'HÔTE."
    warn "Service non configuré ici (utilise --no-service pour masquer cet avertissement)."
    return 0
  fi
  if [[ -z "$(hook_path)" ]]; then
    warn "moshi-hook absent — service non configuré."
    return 0
  fi
  case "$PLATFORM" in
    linux)  setup_service_linux ;;
    darwin) setup_service_darwin ;;
  esac
}

# --- Actions ------------------------------------------------------------------
# systemctl is-active/is-enabled IMPRIMENT déjà un état ("inactive", "not-found")
# puis sortent en code != 0 : un `|| echo inconnu` ajouterait une SECONDE ligne.
sstate() { local out; out="$("$@" 2>/dev/null)" || true; echo "${out:-inconnu}"; }

do_status() {
  local p; p="$(hook_path)"
  printf '%sMoshi%s\n' "$c_b" "$c_0"
  if [[ -n "$p" ]]; then
    printf '  Binaire  : %s (%s)\n' "$p" "$(hook_version "$p")"
  else
    printf '  Binaire  : %sabsent%s\n' "$c_r" "$c_0"
  fi
  printf '  mosh     : %s\n' "$(command -v mosh 2>/dev/null || echo absent)"
  printf '  tmux     : %s\n' "$(command -v tmux 2>/dev/null || echo absent)"
  if [[ "$PLATFORM" == "linux" ]] && have_systemd_user; then
    printf '  Service  : %s / %s\n' \
      "$(sstate systemctl --user is-active "$SERVICE")" \
      "$(sstate systemctl --user is-enabled "$SERVICE")"
    printf '  Timer MAJ: %s\n' "$(sstate systemctl --user is-active "$UPDATE_TIMER")"
  elif [[ "$PLATFORM" == "darwin" ]]; then
    printf '  Service  : %s\n' "$(launchctl list 2>/dev/null | grep -c "$PLIST_HOOK" | sed 's/^0$/non chargé/;s/^[1-9].*/chargé/')"
  fi
}

do_uninstall() {
  if [[ "$ASSUME_YES" -eq 0 ]]; then
    printf 'Retirer le service et le binaire moshi-hook ? [y/N] '
    read -r reply
    [[ "$reply" =~ ^[yYoO]$ ]] || { log "Annulé."; exit 0; }
  fi
  if [[ "$PLATFORM" == "linux" ]] && have_systemd_user; then
    run systemctl --user disable --now "$SERVICE" 2>/dev/null || true
    run systemctl --user disable --now "$UPDATE_TIMER" 2>/dev/null || true
    run systemctl --user daemon-reload
  elif [[ "$PLATFORM" == "darwin" ]]; then
    for p in "$PLIST_HOOK" "$PLIST_UPDATE"; do
      run launchctl unload "${HOME}/Library/LaunchAgents/${p}.plist" 2>/dev/null || true
    done
  fi
  # mosh et tmux sont laissés en place : ce sont des outils généraux, souvent
  # déclarés dans les manifests de paquets.
  run rm -f "$BIN" "${BIN}.bak" "${INSTALL_DIR}/moshi"
  ok "Désinstallé (mosh et tmux conservés)."
}

do_install() {
  log "Plateforme : ${PLATFORM} / $(uname -m)$([[ "$IN_CONTAINER" -eq 1 ]] && echo ' (conteneur)')"
  [[ "$DO_PACKAGES" -eq 1 ]] && install_packages
  [[ "$DO_HOOK"     -eq 1 ]] && install_hook
  [[ "$DO_SERVICE"  -eq 1 ]] && setup_service
  echo
  ok "Terminé."
  local p; p="$(hook_path)"
  if [[ -n "$p" ]]; then
    log "Étape suivante — appairer l'appli mobile :  moshi pair"
    log "État :                                      moshi-setup --status"
  fi
}

case "$ACTION" in
  install)   do_install ;;
  status)    do_status ;;
  update)    exec "${INSTALL_DIR}/update-moshi" ;;
  uninstall) do_uninstall ;;
esac
