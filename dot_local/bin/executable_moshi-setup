#!/usr/bin/env bash
#
# moshi-setup — Install and configure the Moshi stack (moshi-hook + mosh + tmux).
#
# Cross-platform: Debian/Ubuntu/RPi (apt), Fedora/RHEL (dnf), Fedora Atomic
# (rpm-ostree), Arch/OmArchy (pacman), openSUSE (zypper), Alpine (apk), Void
# (xbps), macOS (Homebrew + tap rjyo/moshi). Falls back to Homebrew/Linuxbrew.
#
# Nothing is enabled automatically by chezmoi: this script is the ONLY entry
# point (alias `moshi-install`). Idempotent — safe to re-run.
#
# Usage:
#   moshi-setup                  full install + enable the service
#   moshi-setup --no-service     binaries only (container, toolbox, CI)
#   moshi-setup --no-hooks       skip writing agent hooks into the AI CLIs
#   moshi-setup --no-packages    skip mosh/tmux (already in the manifests)
#   moshi-setup --status         binary and service state
#   moshi-setup --update         delegate to update-moshi
#   moshi-setup --uninstall      remove service + binary (keeps mosh/tmux)
#   moshi-setup --dry-run        print without executing
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
INSTALL_DIR="${MOSHI_INSTALL_DIR:-$HOME/.local/bin}"
BIN="${INSTALL_DIR}/moshi-hook"
INSTALLER_URL="https://getmoshi.app/install.sh"
BREW_TAP="rjyo/moshi"
SERVICE="moshi-hook.service"
UPDATE_TIMER="moshi-update.timer"
PLIST_HOOK="com.jsoyer.moshi-hook"
PLIST_UPDATE="com.jsoyer.moshi-update"

DO_PACKAGES=1
DO_HOOK=1
DO_SERVICE=1
DO_AGENT_HOOKS=1
ASSUME_YES=0
DRY_RUN=0
ACTION="install"

# --- Helpers ------------------------------------------------------------------
c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[moshi-setup]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[moshi-setup]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[moshi-setup]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[moshi-setup]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

# Run a command, or just print it under --dry-run.
run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s %s\n' "$c_y" "$c_0" "$*"
    return 0
  fi
  "$@"
}

# sudo only when not already root and sudo exists.
SUDO=""
need_sudo() {
  [[ "$(id -u)" -eq 0 ]] && { SUDO=""; return 0; }
  command -v sudo >/dev/null 2>&1 || die "Root required but sudo is not available."
  SUDO="sudo"
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

# --- Option parsing -----------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-packages) DO_PACKAGES=0 ;;
    --no-hook)     DO_HOOK=0 ;;
    --no-service)  DO_SERVICE=0 ;;
    --no-hooks)    DO_AGENT_HOOKS=0 ;;
    --status)      ACTION="status" ;;
    --update)      ACTION="update" ;;
    --uninstall)   ACTION="uninstall" ;;
    --dry-run)     DRY_RUN=1 ;;
    -y|--yes)      ASSUME_YES=1 ;;
    -h|--help)     usage; exit 0 ;;
    *)             die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

# --- Platform detection -------------------------------------------------------
OS="$(uname -s)"
case "$OS" in
  Linux)  PLATFORM="linux" ;;
  Darwin) PLATFORM="darwin" ;;
  *)      die "Unsupported platform: ${OS} (Linux and macOS only)." ;;
esac

# A toolbox/container shares the host network: running a second moshi-hook
# daemon inside it would fight with the one on the host.
IN_CONTAINER=0
if [[ -f /.toolboxenv || -n "${TOOLBOX_PATH:-}" || -f /run/.containerenv || -f /.dockerenv ]]; then
  IN_CONTAINER=1
fi

# Distribution identifiers: ID then ID_LIKE (e.g. "ubuntu" → "debian").
distro_ids() {
  [[ -r /etc/os-release ]] || return 0
  # shellcheck disable=SC1091
  . /etc/os-release
  printf '%s %s\n' "${ID:-}" "${ID_LIKE:-}"
}

# Which package manager to use for mosh/tmux.
detect_pm() {
  if [[ "$PLATFORM" == "darwin" ]]; then
    command -v brew >/dev/null 2>&1 && { echo brew; return; }
    echo none; return
  fi

  # Fedora Atomic: dnf exists but the image is read-only.
  if command -v rpm-ostree >/dev/null 2>&1 && [[ "$IN_CONTAINER" -eq 0 ]]; then
    echo rpm-ostree; return
  fi

  local ids; ids=" $(distro_ids) "
  case "$ids" in
    *" debian "*|*" ubuntu "*|*" raspbian "*|*" raspios "*) command -v apt-get >/dev/null 2>&1 && { echo apt; return; } ;;
    *" fedora "*|*" rhel "*|*" centos "*)                   command -v dnf     >/dev/null 2>&1 && { echo dnf; return; } ;;
    *" arch "*|*" archarm "*|*" omarchy "*)                 command -v pacman  >/dev/null 2>&1 && { echo pacman; return; } ;;
    *" suse "*|*" opensuse "*)                              command -v zypper  >/dev/null 2>&1 && { echo zypper; return; } ;;
    *" alpine "*)                                           command -v apk     >/dev/null 2>&1 && { echo apk; return; } ;;
    *" void "*)                                             command -v xbps-install >/dev/null 2>&1 && { echo xbps; return; } ;;
  esac

  # Fallback: probe the binaries if /etc/os-release told us nothing.
  for pm in apt-get dnf pacman zypper apk xbps-install brew; do
    command -v "$pm" >/dev/null 2>&1 || continue
    case "$pm" in
      apt-get)      echo apt ;;
      xbps-install) echo xbps ;;
      *)            echo "$pm" ;;
    esac
    return
  done
  echo none
}

# --- Step 1: mosh + tmux ------------------------------------------------------
install_packages() {
  local pm; pm="$(detect_pm)"
  local missing=()
  command -v mosh >/dev/null 2>&1 || missing+=(mosh)
  command -v tmux >/dev/null 2>&1 || missing+=(tmux)

  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "mosh and tmux already present — nothing to install."
    return 0
  fi
  log "Missing packages: ${missing[*]} (detected manager: ${pm})"

  # The repo wrappers (aptw/dnfw/pacmanw/breww) install AND update the matching
  # manifest (dot_private/Aptfile_*, Dnffile_*…). Prefer them over the raw
  # package manager so the next machine inherits the package.
  local wrapper=""
  case "$pm" in
    apt)    command -v aptw    >/dev/null 2>&1 && wrapper="aptw" ;;
    dnf)    command -v dnfw    >/dev/null 2>&1 && wrapper="dnfw" ;;
    pacman) command -v pacmanw >/dev/null 2>&1 && wrapper="pacmanw" ;;
    brew)   command -v breww   >/dev/null 2>&1 && wrapper="breww" ;;
  esac
  if [[ -n "$wrapper" ]]; then
    log "Using the ${wrapper} wrapper (the manifest will be updated)."
    run "$wrapper" install "${missing[@]}"
    ok "Packages installed: ${missing[*]}"
    return 0
  fi

  case "$pm" in
    apt)
      need_sudo
      run $SUDO apt-get update -qq
      run $SUDO apt-get install -y "${missing[@]}"
      ;;
    dnf)
      need_sudo
      run $SUDO dnf install -y "${missing[@]}"
      ;;
    rpm-ostree)
      # Layered onto the image: needs a reboot before it is usable.
      warn "Fedora Atomic detected — installing as a layered package (reboot required)."
      need_sudo
      run $SUDO rpm-ostree install --idempotent "${missing[@]}"
      warn "Reboot to make ${missing[*]} available, then re-run moshi-setup."
      ;;
    pacman)
      need_sudo
      run $SUDO pacman -S --needed --noconfirm "${missing[@]}"
      ;;
    zypper)
      need_sudo
      run $SUDO zypper --non-interactive install "${missing[@]}"
      ;;
    apk)
      need_sudo
      run $SUDO apk add --no-cache "${missing[@]}"
      ;;
    xbps)
      need_sudo
      run $SUDO xbps-install -Sy "${missing[@]}"
      ;;
    brew)
      run brew install "${missing[@]}"
      ;;
    none)
      warn "No recognised package manager — install ${missing[*]} manually."
      return 0
      ;;
  esac
  ok "Packages installed: ${missing[*]}"
}

# --- Step 2: moshi-hook -------------------------------------------------------
install_hook_brew() {
  log "Installing moshi-hook through Homebrew (tap ${BREW_TAP})…"
  run brew tap "$BREW_TAP"
  # `brew trust` does not exist in mainline Homebrew; the command comes from the
  # tap's own documentation. Attempt it, but never fail on it.
  run brew trust "$BREW_TAP" 2>/dev/null || true
  run brew install moshi-hook
}

install_hook_curl() {
  log "Installing moshi-hook through ${INSTALLER_URL}…"
  command -v curl >/dev/null 2>&1 || die "curl is required to install moshi-hook."
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s curl -fsSL %s | INSTALL_DIR=%s MOSHI_HOOK_SKIP_FIRST_RUN=1 sh\n' \
      "$c_y" "$c_0" "$INSTALLER_URL" "$INSTALL_DIR"
    return 0
  fi
  # MOSHI_HOOK_SKIP_FIRST_RUN: the installer offers an interactive
  # `set --first-run`. We drive what comes next ourselves (service + pairing).
  curl -fsSL "$INSTALLER_URL" \
    | INSTALL_DIR="$INSTALL_DIR" MOSHI_HOOK_SKIP_FIRST_RUN=1 sh \
    || die "The moshi-hook installer failed."
}

install_hook() {
  local existing=""
  existing="$(command -v moshi-hook 2>/dev/null || true)"
  if [[ -n "$existing" ]]; then
    ok "moshi-hook already installed: ${existing} ($(hook_version "$existing"))"
    log "To update: moshi-setup --update"
    return 0
  fi

  if [[ "$PLATFORM" == "darwin" ]] && command -v brew >/dev/null 2>&1; then
    install_hook_brew
  else
    install_hook_curl
  fi

  # The installer drops the binary in INSTALL_DIR: it must be on PATH.
  if ! command -v moshi-hook >/dev/null 2>&1 && [[ ! -x "$BIN" ]]; then
    die "moshi-hook not found after installation (expected: ${BIN})."
  fi
  case ":${PATH}:" in
    *":${INSTALL_DIR}:"*) : ;;
    *) warn "${INSTALL_DIR} is not on PATH — add it (see dot_zsh/01-path.zsh)." ;;
  esac
  ok "moshi-hook installed."
}

# Actual binary path, brew or ~/.local/bin.
hook_path() { command -v moshi-hook 2>/dev/null || { [[ -x "$BIN" ]] && echo "$BIN"; } || true; }
hook_version() { "$1" version 2>/dev/null | awk 'NF{print $NF; exit}' || echo unknown; }

# --- Step 3: service ----------------------------------------------------------
have_systemd_user() {
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl --user show-environment >/dev/null 2>&1
}

enable_linger() {
  # Without linger the systemd --user manager is killed at logout, so the
  # moshi-hook daemon would die at the end of the SSH session — exactly what we
  # do not want on a machine we reach over mosh.
  local u; u="$(id -un)"
  if loginctl show-user "$u" -p Linger 2>/dev/null | grep -q 'Linger=yes'; then
    ok "Linger already enabled for ${u}."
    return 0
  fi
  need_sudo
  log "Enabling linger (the service survives logout)…"
  run $SUDO loginctl enable-linger "$u" || warn "Could not enable linger."
}

setup_service_linux() {
  local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  local missing=()
  for u in "$SERVICE" moshi-update.service "$UPDATE_TIMER"; do
    [[ -f "${unit_dir}/${u}" ]] || missing+=("$u")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    die "Units missing from ${unit_dir}: ${missing[*]} — run 'chezmoi apply' first."
  fi

  if ! have_systemd_user; then
    warn "systemd --user unavailable (container, WSL without systemd…)."
    warn "Start the daemon by hand: ${BIN} serve &"
    return 0
  fi

  enable_linger
  log "Enabling the systemd --user units…"
  run systemctl --user daemon-reload
  run systemctl --user enable --now "$SERVICE"
  run systemctl --user enable --now "$UPDATE_TIMER"
  [[ "$DRY_RUN" -eq 1 ]] && return 0

  sleep 2
  if systemctl --user is-active --quiet "$SERVICE"; then
    ok "${SERVICE} active ✔"
  else
    warn "${SERVICE} is not active — see: journalctl --user -u ${SERVICE} -e"
  fi
}

setup_service_darwin() {
  local agents="${HOME}/Library/LaunchAgents"
  local missing=()
  for p in "$PLIST_HOOK" "$PLIST_UPDATE"; do
    [[ -f "${agents}/${p}.plist" ]] || missing+=("${p}.plist")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    die "LaunchAgents missing from ${agents}: ${missing[*]} — run 'chezmoi apply' first."
  fi
  for p in "$PLIST_HOOK" "$PLIST_UPDATE"; do
    log "Loading ${p}…"
    run launchctl unload "${agents}/${p}.plist" 2>/dev/null || true
    run launchctl load "${agents}/${p}.plist" || warn "Could not load ${p}."
  done
  ok "LaunchAgents loaded."
}

setup_service() {
  if [[ "$IN_CONTAINER" -eq 1 ]]; then
    warn "Container/toolbox detected — the moshi-hook daemon belongs on the HOST."
    warn "Service not configured here (use --no-service to silence this warning)."
    return 0
  fi
  if [[ -z "$(hook_path)" ]]; then
    warn "moshi-hook missing — service not configured."
    return 0
  fi
  case "$PLATFORM" in
    linux)  setup_service_linux ;;
    darwin) setup_service_darwin ;;
  esac
}

# --- Step 4: agent hooks ------------------------------------------------------
# `moshi-hook install` writes the Moshi hook configs into every supported AI
# CLI (claude, codex, cursor, grok, pi, omp, qwen, …). Idempotent and fast; it also
# reports "hook gap" warnings when a CLI carries retired hooks.
install_agent_hooks() {
  local p; p="$(hook_path)"
  [[ -n "$p" ]] || return 0
  log "Writing agent hooks into the AI CLIs (moshi-hook install)…"
  run "$p" install || warn "moshi-hook install failed — hooks may be stale."
}

# --- Actions ------------------------------------------------------------------
# systemctl is-active/is-enabled ALREADY print a state ("inactive", "not-found")
# and then exit non-zero: an `|| echo unknown` would add a SECOND line.
sstate() { local out; out="$("$@" 2>/dev/null)" || true; echo "${out:-unknown}"; }

do_status() {
  local p; p="$(hook_path)"
  printf '%sMoshi%s\n' "$c_b" "$c_0"
  if [[ -n "$p" ]]; then
    printf '  Binary   : %s (%s)\n' "$p" "$(hook_version "$p")"
  else
    printf '  Binary   : %smissing%s\n' "$c_r" "$c_0"
  fi
  printf '  mosh     : %s\n' "$(command -v mosh 2>/dev/null || echo missing)"
  printf '  tmux     : %s\n' "$(command -v tmux 2>/dev/null || echo missing)"
  if [[ "$PLATFORM" == "linux" ]] && have_systemd_user; then
    printf '  Service  : %s / %s\n' \
      "$(sstate systemctl --user is-active "$SERVICE")" \
      "$(sstate systemctl --user is-enabled "$SERVICE")"
    printf '  Timer    : %s\n' "$(sstate systemctl --user is-active "$UPDATE_TIMER")"
  elif [[ "$PLATFORM" == "darwin" ]]; then
    printf '  Service  : %s\n' "$(launchctl list 2>/dev/null | grep -c "$PLIST_HOOK" | sed 's/^0$/not loaded/;s/^[1-9].*/loaded/')"
  fi
}

do_uninstall() {
  if [[ "$ASSUME_YES" -eq 0 ]]; then
    printf 'Remove the moshi-hook service and binary? [y/N] '
    read -r reply
    [[ "$reply" =~ ^[yY]$ ]] || { log "Cancelled."; exit 0; }
  fi
  if [[ "$PLATFORM" == "linux" ]] && have_systemd_user; then
    run systemctl --user disable --now "$SERVICE" 2>/dev/null || true
    run systemctl --user disable --now "$UPDATE_TIMER" 2>/dev/null || true
    run systemctl --user daemon-reload
  elif [[ "$PLATFORM" == "darwin" ]]; then
    for p in "$PLIST_HOOK" "$PLIST_UPDATE"; do
      run launchctl unload "${HOME}/Library/LaunchAgents/${p}.plist" 2>/dev/null || true
    done
  fi
  # mosh and tmux are left alone: they are general-purpose tools, usually
  # declared in the package manifests.
  run rm -f "$BIN" "${BIN}.bak" "${INSTALL_DIR}/moshi"
  ok "Uninstalled (mosh and tmux kept)."
}

do_install() {
  log "Platform: ${PLATFORM} / $(uname -m)$([[ "$IN_CONTAINER" -eq 1 ]] && echo ' (container)')"
  [[ "$DO_PACKAGES" -eq 1 ]] && install_packages
  [[ "$DO_HOOK"     -eq 1 ]] && install_hook
  [[ "$DO_SERVICE"  -eq 1 ]] && setup_service
  [[ "$DO_AGENT_HOOKS" -eq 1 ]] && install_agent_hooks
  echo
  ok "Done."
  local p; p="$(hook_path)"
  if [[ -n "$p" ]]; then
    log "Next step — pair the mobile app:  moshi pair"
    log "State:                            moshi-setup --status"
  fi
}

case "$ACTION" in
  install)   do_install ;;
  status)    do_status ;;
  update)    exec "${INSTALL_DIR}/update-moshi" ;;
  uninstall) do_uninstall ;;
esac
