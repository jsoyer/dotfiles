#!/usr/bin/env bash
#
# install-docker — Install the container engine each platform expects.
#
#   macOS                   Colima + docker CLI, buildx, compose (Homebrew)
#   Debian, Ubuntu, RPi     Docker Engine from download.docker.com (APT)
#   Arch, OmArchy           docker, docker-compose, docker-buildx (pacman)
#   Fedora, RHEL-likes      Podman (their default engine) + podman-docker
#                           (docker CLI shim) + podman-compose; Atomic layers
#                           the two extras with rpm-ostree
#   Toolbox                 skipped: no daemon inside a container
#   Windows                 Docker Desktop via winget (chezmoi script, not this)
#
# Docker Engine on Linux: the user is added to the `docker` group so docker runs
# without sudo. That group is root-equivalent on the machine. Podman is rootless.
# Idempotent: an engine already present is kept as is (never mixed with another
# source); only its missing pieces (service, group, compose) are reported.
#
# Usage:
#   install-docker            install whatever is missing
#   install-docker --status   engine, versions, service, group
#   install-docker --dry-run  print without executing
#
set -uo pipefail

DRY_RUN=0
ACTION="install"

c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[install-docker]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[install-docker]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[install-docker]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[install-docker]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

usage() { sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status)  ACTION="status" ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *)         die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

SUDO="sudo"; [[ "$(id -u)" -eq 0 ]] && SUDO=""
failures=0

# run CMD... — execute, or print it verbatim in --dry-run.
run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s %s\n' "$c_y" "$c_0" "$*"
    return 0
  fi
  "$@"
}

# write_root_file PATH < content — write a root-owned file (0644).
write_root_file() {
  local content; content="$(cat)"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s write %s:\n%s\n' "$c_y" "$c_0" "$1" "$(sed 's/^/      /' <<<"$content")"
    return 0
  fi
  printf '%s\n' "$content" | $SUDO tee "$1" >/dev/null && $SUDO chmod 0644 "$1"
}

fail() { warn "$*"; failures=$((failures+1)); }

# --- Platform ------------------------------------------------------------------
os_release() { ( . /etc/os-release 2>/dev/null; printf '%s' "${!1:-}" ); }

platform() {
  if [[ "$(uname -s)" == "Darwin" ]]; then echo macos; return; fi
  if [[ -f /run/.toolboxenv || -f /.toolboxenv ]]; then echo toolbox; return; fi
  local id like; id="$(os_release ID)"; like="$(os_release ID_LIKE)"
  if command -v rpm-ostree &>/dev/null; then echo fedora-atomic; return; fi
  case " $id $like " in
    *" fedora "*|*" rhel "*|*" centos "*) echo fedora ;;
    *" arch "*)                           echo arch ;;
    *" debian "*|*" ubuntu "*|*" raspbian "*) echo debian ;;
    *)                                    echo unknown ;;
  esac
}

has_systemd() { [[ -d /run/systemd/system ]]; }
in_group() { id -nG "$(id -un)" | tr ' ' '\n' | grep -qx "$1"; }
ver() { "$@" 2>/dev/null | head -1 | tr -d '\r'; }

need_sudo() {
  [[ -z "$SUDO" || "$DRY_RUN" -eq 1 ]] && return 0
  command -v sudo &>/dev/null || die "sudo is required (not installed)."
  sudo -v || die "sudo is required to install the engine."
}

# --- Docker Engine (Linux) -----------------------------------------------------
# download.docker.com layout: linux/debian, linux/ubuntu, linux/raspbian (armhf
# only; 64-bit Raspberry Pi OS is plain Debian).
docker_apt_repo() {
  local id like arch
  id="$(os_release ID)"; like="$(os_release ID_LIKE)"; arch="$(dpkg --print-architecture)"
  if [[ "$id" == ubuntu || " $like " == *" ubuntu "* ]]; then
    printf 'ubuntu %s\n' "$(os_release UBUNTU_CODENAME || true)"
  elif [[ "$id" == raspbian && "$arch" == armhf ]]; then
    printf 'raspbian %s\n' "$(os_release VERSION_CODENAME)"
  else
    printf 'debian %s\n' "$(os_release VERSION_CODENAME)"
  fi
}

install_docker_apt() {
  local repo_os codename conflicts=() p
  read -r repo_os codename < <(docker_apt_repo)
  [[ -n "$codename" ]] || { [[ "$repo_os" == ubuntu ]] && codename="$(os_release VERSION_CODENAME)"; }
  [[ -n "$codename" ]] || { fail "cannot detect the release codename (/etc/os-release)"; return 1; }
  log "Docker Engine from download.docker.com/linux/${repo_os} (${codename})"

  # Distro packages that conflict with docker-ce (per Docker's install guide).
  for p in docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' && conflicts+=("$p")
  done
  if ((${#conflicts[@]})); then
    warn "removing conflicting packages: ${conflicts[*]}"
    run $SUDO apt-get remove -y "${conflicts[@]}" || { fail "could not remove ${conflicts[*]}"; return 1; }
  fi

  # .asc key read by apt directly: no gpg needed (absent on minimal images).
  run $SUDO install -m 0755 -d /etc/apt/keyrings || return 1
  run $SUDO curl -fsSL "https://download.docker.com/linux/${repo_os}/gpg" -o /etc/apt/keyrings/docker.asc \
    || { fail "could not download the Docker APT key"; return 1; }
  run $SUDO chmod a+r /etc/apt/keyrings/docker.asc
  write_root_file /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/${repo_os}
Suites: ${codename}
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  run $SUDO apt-get update -q || { fail "apt-get update failed"; return 1; }
  run $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin \
    || { fail "apt-get install docker-ce failed"; return 1; }
}

install_docker_pacman() {
  log "Docker from the Arch repositories"
  run $SUDO pacman -S --needed --noconfirm docker docker-compose docker-buildx \
    || { fail "pacman -S docker failed"; return 1; }
}

# Service + passwordless access, for any Docker Engine (fresh or pre-existing).
setup_docker_engine() {
  if has_systemd; then
    if [[ "$DRY_RUN" -eq 0 ]] && systemctl is-active --quiet docker; then
      :
    else
      run $SUDO systemctl enable --now docker.service containerd.service || fail "could not start the docker service"
    fi
  else
    warn "no systemd: start dockerd yourself (containers/WSL without systemd)"
  fi

  [[ -z "$SUDO" ]] && return 0   # root needs no group
  if in_group docker; then
    return 0
  fi
  getent group docker >/dev/null || run $SUDO groupadd docker
  run $SUDO usermod -aG docker "$(id -un)" || { fail "could not add $(id -un) to the docker group"; return 1; }
  [[ "$DRY_RUN" -eq 1 ]] || warn "$(id -un) added to the 'docker' group (root-equivalent). Log out and back in, or run: newgrp docker"
}

# --- Podman (Fedora family) ----------------------------------------------------
setup_podman_common() {
  # podman-docker prints a "Emulate Docker CLI using podman" notice on every call.
  [[ -e /etc/containers/nodocker ]] || run $SUDO touch /etc/containers/nodocker
  # Docker-compatible API socket (DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock).
  if has_systemd && systemctl --user show-environment &>/dev/null; then
    run systemctl --user enable --now podman.socket || warn "could not enable the user podman.socket"
  fi
}

install_podman_dnf() {
  log "Podman (Fedora's default engine) + docker CLI shim + compose"
  run $SUDO dnf install -y podman podman-docker podman-compose \
    || { fail "dnf install podman failed"; return 1; }
  setup_podman_common
}

install_podman_atomic() {
  log "Podman (preinstalled) + docker CLI shim + compose, layered with rpm-ostree"
  local missing=() p
  for p in podman-docker podman-compose; do rpm -q "$p" &>/dev/null || missing+=("$p"); done
  if ((${#missing[@]})); then
    run $SUDO rpm-ostree install --idempotent --apply-live "${missing[@]}" \
      || { fail "rpm-ostree install ${missing[*]} failed (reboot and retry if a deployment is pending)"; return 1; }
  fi
  setup_podman_common
}

# --- macOS ---------------------------------------------------------------------
install_colima() {
  command -v brew &>/dev/null || { fail "Homebrew is required on macOS"; return 1; }
  local f missing=()
  for f in colima docker docker-buildx docker-compose; do
    brew list --formula "$f" &>/dev/null || missing+=("$f")
  done
  if ((${#missing[@]})); then
    log "Homebrew: ${missing[*]}"
    run brew install "${missing[@]}" || { fail "brew install ${missing[*]} failed"; return 1; }
  fi

  # Homebrew's buildx/compose are CLI plugins: docker only finds them here.
  local plugins="${DOCKER_CONFIG:-$HOME/.docker}/cli-plugins" prefix
  prefix="$(brew --prefix)"
  run mkdir -p "$plugins"
  for f in buildx compose; do
    [[ -e "$plugins/docker-$f" ]] || run ln -sfn "$prefix/opt/docker-$f/bin/docker-$f" "$plugins/docker-$f"
  done

  if [[ "$DRY_RUN" -eq 0 ]] && colima status &>/dev/null; then
    ok "Colima already running"
  else
    log "Starting Colima at login (first start downloads its VM image)"
    run brew services start colima || fail "could not start Colima (try: colima start)"
  fi
}

# --- Status --------------------------------------------------------------------
do_status() {
  local p; p="$(platform)"
  printf '%sContainer engine%s (platform: %s)\n' "$c_b" "$c_0" "$p"
  printf '  %-9s %s\n' "docker"  "$(command -v docker &>/dev/null && ver docker --version || echo missing)"
  printf '  %-9s %s\n' "podman"  "$(command -v podman &>/dev/null && ver podman --version || echo missing)"
  printf '  %-9s %s\n' "compose" "$(ver docker compose version || ver podman-compose --version || echo missing)"
  printf '  %-9s %s\n' "buildx"  "$(ver docker buildx version || echo missing)"
  case "$p" in
    macos)
      printf '  %-9s %s\n' "colima" "$(colima status &>/dev/null && echo running || echo stopped)" ;;
    debian|arch)
      has_systemd && printf '  %-9s %s\n' "service" "$(systemctl is-active docker 2>/dev/null || true)"
      printf '  %-9s %s\n' "group" "$(in_group docker && echo "$(id -un) in docker" || echo "$(id -un) NOT in docker")" ;;
    fedora|fedora-atomic)
      printf '  %-9s %s\n' "socket" "$(systemctl --user is-active podman.socket 2>/dev/null || echo inactive)" ;;
  esac
}

[[ "$ACTION" == "status" ]] && { do_status; exit 0; }

# --- Main ----------------------------------------------------------------------
PLATFORM="$(platform)"
case "$PLATFORM" in
  toolbox) ok "Toolbox container: nothing to install (use the host's engine)"; exit 0 ;;
  unknown) die "Unsupported platform ($(os_release PRETTY_NAME)). See --help." ;;
esac

case "$PLATFORM" in
  macos)
    install_colima ;;
  debian|arch)
    if command -v docker &>/dev/null; then
      ok "Docker already installed: $(ver docker --version)"
      docker compose version &>/dev/null || warn "docker compose plugin missing (kept the existing install untouched)"
    else
      need_sudo
      if [[ "$PLATFORM" == debian ]]; then install_docker_apt; else install_docker_pacman; fi
    fi
    command -v docker &>/dev/null || [[ "$DRY_RUN" -eq 1 ]] && { need_sudo; setup_docker_engine; } ;;
  fedora)
    if command -v docker &>/dev/null && ! rpm -q podman-docker &>/dev/null; then
      ok "Docker Engine already installed ($(ver docker --version)): not replacing it with Podman"
    elif rpm -q podman podman-docker podman-compose &>/dev/null; then
      ok "Podman already installed: $(ver podman --version)"
    else
      need_sudo; install_podman_dnf
    fi ;;
  fedora-atomic)
    need_sudo; install_podman_atomic ;;
esac

echo
if [[ "$failures" -gt 0 ]]; then
  warn "Done with $failures failure(s) — see above."
  exit 1
fi
ok "Done."
[[ "$DRY_RUN" -eq 1 ]] || do_status
