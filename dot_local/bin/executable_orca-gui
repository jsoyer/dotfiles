#!/usr/bin/env bash
# All-in-one Orca GUI launcher: stops the headless service, opens the graphical
# interface, then restores the headless service when the window closes.
# The service is only restarted if it was running BEFORE (we restore the initial
# state, we do not impose one).
set -uo pipefail

SERVICE="orca-serve.service"
APPIMAGE="${ORCA_APPIMAGE:-/opt/orca/orca-linux.AppImage}"

note() { notify-send -a "Orca" "Orca" "$1" 2>/dev/null || true; }

[[ -x "$APPIMAGE" ]] || { echo "Orca AppImage not found: $APPIMAGE" >&2; exit 1; }

# Run "systemctl <action> <service>" as root.
#  1) try sudo -n (passwordless, if the sudoers rule is installed)
#  2) otherwise fall back to pkexec (graphical password prompt)
svc() {
    local action="$1"
    if sudo -n systemctl "$action" "$SERVICE" 2>/dev/null; then
        return 0
    fi
    pkexec systemctl "$action" "$SERVICE"
}

# 1) Remember the service state and stop it if it is running
was_active=0
if systemctl is-active --quiet "$SERVICE"; then
    was_active=1
    note "Stopping the headless service…"
    if ! svc stop; then
        note "Could not stop $SERVICE — the GUI cannot start (port in use)."
        exit 1
    fi
fi

# 2) Guarantee restoration even if the GUI crashes or is interrupted
restore() {
    if [ "$was_active" -eq 1 ]; then
        note "Restarting the headless service…"
        svc start || note "RESTART FAILED — run: sudo systemctl start $SERVICE"
    fi
}
trap restore EXIT INT TERM

# 3) Run the GUI in the foreground; the script waits for the window to close
note "Opening the graphical interface…"
# Type-2 AppImage needs libfuse.so.2; extract-and-run works without FUSE.
APPIMAGE_EXTRACT_AND_RUN=1 "$APPIMAGE" --no-sandbox "$@"
