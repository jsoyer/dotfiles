#!/usr/bin/env bash
# paseo-uninstall — take the Paseo server off this machine.
#
# Linux: `sudo paseo-setup --uninstall` (paseo, paseo-firewall and paseo-health
# units, the nftables guard, /usr/local/sbin/paseo-health), then optionally drops
# ~/.paseo. The CLI itself is a mise package: remove `npm:@getpaseo/cli` from
# your mise config (and `mise prune`) to uninstall it; agent-alert is shared with
# the Orca server and is left installed.
# macOS: Paseo is just the cask.

set -euo pipefail

ASSUME_YES=0
PURGE=0

usage() {
    cat <<'EOF'
Usage: paseo-uninstall [-y] [--purge]

  -y, --yes    do not ask for confirmation
  --purge      also drop ~/.paseo ($PASEO_HOME): config.json, password hash, logs

Linux: runs `sudo paseo-setup --uninstall` (units + firewall). The mise package
and ~/.paseo are kept unless --purge (data only; the package stays in mise).
macOS: uninstalls the paseo cask.
EOF
}

for arg in "$@"; do
    case "$arg" in
        -y|--yes) ASSUME_YES=1 ;;
        --purge) PURGE=1 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "paseo-uninstall: unknown option: $arg" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ "$ASSUME_YES" -eq 0 ]]; then
    printf 'Remove Paseo from this machine? [y/N] '
    read -r reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
fi

PASEO_DATA="${PASEO_HOME:-$HOME/.paseo}"

if [[ "$(uname -s)" == "Darwin" ]]; then
    if command -v brew &>/dev/null; then
        eval "$(brew shellenv)"
        brew list --cask paseo &>/dev/null && brew uninstall --cask --zap paseo || true
    fi
    [[ "$PURGE" -eq 1 ]] && rm -rf "$PASEO_DATA"
    echo "Paseo removed (cask)."
    exit 0
fi

# sudo's secure_path excludes ~/.local/bin: pass the resolved path.
SETUP="$(command -v paseo-setup || true)"
if [[ -n "$SETUP" ]]; then
    echo "Removing units and firewall (paseo-setup --uninstall)..."
    sudo "$SETUP" --uninstall
else
    echo "paseo-setup not found: removing units by hand..."
    sudo systemctl disable --now paseo-health.timer paseo.service paseo-firewall.service 2>/dev/null || true
    sudo rm -f /etc/systemd/system/paseo.service /etc/systemd/system/paseo-firewall.service \
        /etc/systemd/system/paseo-health.service /etc/systemd/system/paseo-health.timer \
        /usr/local/sbin/paseo-health /etc/paseo/paseo-guard.nft
    sudo systemctl daemon-reload
fi

[[ "$PURGE" -eq 1 ]] && rm -rf "$PASEO_DATA"

echo "Paseo server removed."
