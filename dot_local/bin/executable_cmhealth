#!/usr/bin/env bash
# cmhealth — comprehensive chezmoi environment health check
# Usage: cmhealth [--quiet]

set -euo pipefail

# --- Colors ---
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

# --- State ---
PASS=0
WARN=0
FAIL=0
QUIET=false

[[ "${1:-}" == "--quiet" ]] && QUIET=true

# --- Helpers ---
ok() {
    printf '%b\n' "  ${GREEN}✓${NC} $1"
    ((PASS++)) || true
}

warn() {
    printf '%b\n' "  ${YELLOW}!${NC} $1"
    ((WARN++)) || true
}

fail() {
    printf '%b\n' "  ${RED}✗${NC} $1"
    ((FAIL++)) || true
}

section() {
    [[ "${QUIET}" == false ]] && printf '\n%b\n' "${BOLD}$1${NC}"
}

CHEZMOI_SOURCE="${HOME}/.local/share/chezmoi"
CACHE_DIR="${HOME}/.cache/chezmoi-autoupdate"
STATUS_JSON="${CACHE_DIR}/status.json"

# ============================================================================
# 1. Source directory
# ============================================================================
section "Source directory"
if [[ -d "${CHEZMOI_SOURCE}" ]]; then
    ok "Chezmoi source dir exists: ${CHEZMOI_SOURCE}"
else
    fail "Chezmoi source dir missing: ${CHEZMOI_SOURCE}"
fi

if [[ -d "${CHEZMOI_SOURCE}/.git" ]]; then
    git_status="$(git -C "${CHEZMOI_SOURCE}" status --porcelain 2>/dev/null)"
    if [[ -z "${git_status}" ]]; then
        ok "Git working tree is clean"
    else
        warn "Git working tree has uncommitted changes ($(echo "${git_status}" | wc -l | tr -d ' ') files)"
    fi
else
    fail "Chezmoi source dir is not a git repository"
fi

# ============================================================================
# 2. Auto-update timer
# ============================================================================
section "Auto-update timer"
if [[ "$(uname -s)" == "Darwin" ]]; then
    if launchctl list 2>/dev/null | grep -q "com.jsoyer.chezmoi-autoupdate"; then
        ok "LaunchAgent com.jsoyer.chezmoi-autoupdate is loaded"
    else
        warn "LaunchAgent com.jsoyer.chezmoi-autoupdate is NOT loaded (run run_once_enable-chezmoi-autoupdate.sh)"
    fi
else
    if systemctl --user is-active --quiet chezmoi-autoupdate.timer 2>/dev/null; then
        ok "systemd chezmoi-autoupdate.timer is active"
    else
        warn "systemd chezmoi-autoupdate.timer is NOT active (run: systemctl --user enable --now chezmoi-autoupdate.timer)"
    fi
fi

# ============================================================================
# 3. Last update timestamp
# ============================================================================
section "Last update"
if [[ -f "${STATUS_JSON}" ]] && command -v jq &>/dev/null; then
    last_update="$(jq -r '.last_success // empty' "${STATUS_JSON}" 2>/dev/null)"
    if [[ -n "${last_update}" ]]; then
        # Parse epoch from ISO8601 or epoch integer stored in status.json
        if [[ "${last_update}" =~ ^[0-9]+$ ]]; then
            last_epoch="${last_update}"
        else
            last_epoch="$(date -d "${last_update}" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%S" "${last_update%.*}" +%s 2>/dev/null || echo 0)"
        fi
        now_epoch="$(date +%s)"
        age_hours=$(( (now_epoch - last_epoch) / 3600 ))
        if (( age_hours < 2 )); then
            ok "Last update was ${age_hours}h ago (< 2h)"
        elif (( age_hours < 24 )); then
            warn "Last update was ${age_hours}h ago (> 2h)"
        else
            fail "Last update was ${age_hours}h ago (> 24h) — check timer"
        fi
    else
        warn "No last_success timestamp in status.json"
    fi
elif [[ -f "${STATUS_JSON}" ]]; then
    warn "status.json found but jq not available to parse it"
else
    warn "No status.json found at ${STATUS_JSON} — auto-update may not have run yet"
fi

# ============================================================================
# 4. Deprecated Homebrew packages
# ============================================================================
section "Homebrew"
if command -v brew &>/dev/null; then
    deprecated="$(brew info --json=v2 --installed 2>/dev/null \
        | command -p jq -r '.formulae[] | select(.deprecated == true or .disabled == true) | .name' 2>/dev/null \
        || true)"
    if [[ -z "${deprecated}" ]]; then
        ok "No deprecated/disabled Homebrew formulae installed"
    else
        count="$(echo "${deprecated}" | wc -l | tr -d ' ')"
        warn "${count} deprecated/disabled formulae: $(echo "${deprecated}" | tr '\n' ' ')"
    fi
else
    ok "Homebrew not installed (skipping)"
fi

# ============================================================================
# 5. Stale shell caches
# ============================================================================
section "Shell caches"
stale_found=false
for meta in "${HOME}/.cache/fish/"*.fish "${HOME}/.zcompdump" "${HOME}/.zcompcache"; do
    # Expand glob safely
    [[ -e "${meta}" ]] || continue
    age_days=$(( ( $(date +%s) - $(stat -c %Y "${meta}" 2>/dev/null || stat -f %m "${meta}" 2>/dev/null || echo 0) ) / 86400 ))
    if (( age_days > 30 )); then
        warn "Stale cache (${age_days}d): ${meta}"
        stale_found=true
    fi
done
[[ "${stale_found}" == false ]] && ok "No stale shell caches (> 30 days)"

# ============================================================================
# 6. SSH permissions
# ============================================================================
section "SSH permissions"
if [[ -d "${HOME}/.ssh" ]]; then
    ssh_dir_perm="$(stat -c "%a" "${HOME}/.ssh" 2>/dev/null || stat -f "%OLp" "${HOME}/.ssh" 2>/dev/null || echo 000)"
    if [[ "${ssh_dir_perm}" == "700" ]]; then
        ok "~/.ssh directory permissions: 700"
    else
        fail "~/.ssh directory permissions: ${ssh_dir_perm} (expected 700)"
    fi

    bad_files=()
    while IFS= read -r -d '' f; do
        perm="$(stat -c "%a" "${f}" 2>/dev/null || stat -f "%OLp" "${f}" 2>/dev/null || echo 000)"
        # Private keys and config should be 600; .pub can be 644
        if [[ "${f}" == *.pub ]]; then
            continue
        fi
        if [[ "${perm}" != "600" && "${perm}" != "400" ]]; then
            bad_files+=("${f} (${perm})")
        fi
    done < <(find "${HOME}/.ssh" -maxdepth 1 -type f -print0 2>/dev/null)

    if (( ${#bad_files[@]} == 0 )); then
        ok "SSH file permissions look correct"
    else
        for bf in "${bad_files[@]}"; do
            fail "Bad SSH permission: ${bf}"
        done
    fi
else
    ok "~/.ssh directory does not exist (skipping)"
fi

# ============================================================================
# 7. Required environment variables
# ============================================================================
section "Environment variables"
required_vars=("GITHUB_TOKEN")
for var in "${required_vars[@]}"; do
    if [[ -n "${!var:-}" ]]; then
        ok "${var} is set"
    else
        warn "${var} is not set — some features may not work"
    fi
done

# ============================================================================
# 8. Nerd Fonts
# ============================================================================
section "Nerd Fonts"
if [[ "$(uname -s)" == "Darwin" ]]; then
    if system_profiler SPFontsDataType 2>/dev/null | grep -qi "nerd"; then
        ok "Nerd Font detected (system_profiler)"
    else
        warn "No Nerd Font found — icons may display incorrectly"
    fi
else
    if command -v fc-list &>/dev/null; then
        if fc-list 2>/dev/null | grep -qi "nerd"; then
            ok "Nerd Font detected (fc-list)"
        else
            warn "No Nerd Font found — icons may display incorrectly"
        fi
    else
        warn "fc-list not available — cannot check Nerd Fonts"
    fi
fi

# ============================================================================
# 9. Config drift detection
# ============================================================================
section "Config drift"
if command -v chezmoi &>/dev/null; then
    drift="$(chezmoi verify --exclude=scripts 2>&1 | head -20 || true)"
    if [[ -z "${drift}" ]]; then
        ok "No config drift (chezmoi verify clean)"
    else
        line_count="$(echo "${drift}" | wc -l | tr -d ' ')"
        warn "${line_count} drift(s) detected — run 'chezmoi diff' to review:"
        echo "${drift}" | head -5 | sed 's/^/    /'
    fi
else
    fail "chezmoi not found in PATH"
fi

# ============================================================================
# 10. Network connectivity
# ============================================================================
section "Network"
if ping -c1 -W2 github.com &>/dev/null 2>&1; then
    ok "Network reachable (github.com)"
else
    warn "Cannot reach github.com — auto-update will fail"
fi

# ============================================================================
# Summary
# ============================================================================
printf '\n'
total=$((PASS + WARN + FAIL))
printf '%b' "${BOLD}Summary:${NC} "
printf '%b' "${GREEN}${PASS} passed${NC}  "
(( WARN > 0 )) && printf '%b' "${YELLOW}${WARN} warnings${NC}  "
(( FAIL > 0 )) && printf '%b' "${RED}${FAIL} failed${NC}"
printf '\n'

if (( FAIL > 0 )); then
    exit 1
elif (( WARN > 0 )); then
    exit 2
else
    exit 0
fi
