#!/usr/bin/env bash
# flatpakw — flatpak wrapper that keeps Flatpakfile manifests in sync with chezmoi
# Usage: flatpakw <subcommand> [args...]
#        flatpakw install <app-id>   → installs + adds to host overlay Flatpakfile
#        flatpakw remove <app-id>    → removes + removes from host overlay Flatpakfile
#        flatpakw dump               → recompute host overlay from installed − base
#        flatpakw list               → passthrough to flatpak list
#        flatpakw <subcommand>       → passthrough to flatpak
#
# Model:
#   Base file    (Flatpakfile_<profile>)  = curated shared base — NEVER modified by flatpakw
#   Host overlay (Flatpakfile_<hostname>) = machine-specific extras (delta)

set -euo pipefail

# --- Colors ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# --- Config ---
CHEZMOI_SOURCE_PATH="${CHEZMOI_SOURCE_PATH:-${HOME}/.local/share/chezmoi}"
MANIFEST_DIR="${CHEZMOI_SOURCE_PATH}/dot_private"

# --- Hostname (short, no domain) ---
HOSTNAME_SHORT="$(uname -n | cut -d. -f1)"

# --- App-id validation (Flatpak reverse-DNS format) ---
validate_app() {
    local app="$1"
    if ! [[ "$app" =~ ^[a-zA-Z][a-zA-Z0-9_-]*(\.[a-zA-Z][a-zA-Z0-9_-]*){2,}$ ]]; then
        printf '%b\n' "${RED}Error: invalid Flatpak app id: '${app}'${NC}" >&2
        exit 1
    fi
}

# --- Determine base Flatpakfile (read-only reference) ---
get_base_flatpakfile() {
    case "${MACHINE_PROFILE:-}" in
        fedora-atomic)   printf '%s' "${MANIFEST_DIR}/Flatpakfile_fedora_atomic" ;;
        ubuntu-desktop)  printf '%s' "${MANIFEST_DIR}/Flatpakfile_ubuntu_desktop" ;;
        fedora-desktop)  printf '%s' "${MANIFEST_DIR}/Flatpakfile_fedora_desktop" ;;
        *)               printf '' ;;
    esac
}

# --- Host overlay file ---
get_host_flatpakfile() {
    printf '%s' "${MANIFEST_DIR}/Flatpakfile_${HOSTNAME_SHORT}"
}

# --- Load base app-ids into sorted output (for comm) ---
load_base_apps() {
    local base="$1"
    if [[ -f "$base" ]]; then
        grep -v '^\s*#' "$base" | grep -v '^\s*$' | sort
    fi
}

# --- Detect install scope (Atomic = system, others = user) ---
get_install_scope() {
    case "${MACHINE_PROFILE:-}" in
        fedora-atomic) printf 'system' ;;
        *)             printf 'user' ;;
    esac
}

# --- Build flatpak install/uninstall flags for the right scope ---
install_flags() {
    local scope; scope="$(get_install_scope)"
    if [[ "$scope" == "system" ]]; then
        printf -- '--system'
    else
        printf -- '--user'
    fi
}

# --- Add app-id to manifest (idempotent) ---
add_to_manifest() {
    local manifest="$1"
    local app="$2"
    if grep -qxF "$app" "$manifest" 2>/dev/null; then
        printf '%b\n' "${YELLOW}${app} already in $(basename "$manifest")${NC}"
        return
    fi
    printf '%s\n' "$app" >> "$manifest"
    printf '%b\n' "${GREEN}Added '${app}' to $(basename "$manifest")${NC}"
}

# --- Remove app-id from manifest ---
remove_from_manifest() {
    local manifest="$1"
    local app="$2"
    if [[ ! -f "$manifest" ]]; then
        printf '%b\n' "${YELLOW}$(basename "$manifest") does not exist — nothing to remove${NC}"
        return
    fi
    local tmp
    tmp="$(mktemp)"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == "$app" ]] && continue
        printf '%s\n' "$line"
    done < "$manifest" > "$tmp"
    mv "$tmp" "$manifest"
    printf '%b\n' "${GREEN}Removed '${app}' from $(basename "$manifest")${NC}"
}

# --- Dump host overlay: installed − base ---
dump_host_overlay() {
    local base_file host_file scope
    base_file="$(get_base_flatpakfile)"
    host_file="$(get_host_flatpakfile)"
    scope="$(get_install_scope)"

    printf '\n%b\n' "${YELLOW}Dumping host overlay: $(basename "$host_file")${NC}"

    local installed_tmp base_tmp
    installed_tmp="$(mktemp)"
    base_tmp="$(mktemp)"

    # List installed application ids
    if [[ "$scope" == "system" ]]; then
        flatpak list --system --app --columns=application 2>/dev/null | sort > "$installed_tmp"
    else
        flatpak list --user --app --columns=application 2>/dev/null | sort > "$installed_tmp"
    fi

    if [[ -n "$base_file" && -f "$base_file" ]]; then
        load_base_apps "$base_file" > "$base_tmp"
    else
        : > "$base_tmp"
    fi

    # Delta: installed − base (comm -23 requires sorted inputs)
    local delta_apps
    delta_apps="$(comm -23 "$installed_tmp" "$base_tmp")"

    rm -f "$installed_tmp" "$base_tmp"

    {
        printf '# Host overlay for %s — extras beyond the shared base.\n' "$HOSTNAME_SHORT"
        printf '# Managed by flatpakw. Do not edit manually.\n'
        printf '%s\n' "$delta_apps"
    } > "$host_file"

    local count
    count="$(printf '%s\n' "$delta_apps" | grep -c '\S' || true)"
    printf '%b\n' "${GREEN}Host overlay written: ${count} entries${NC}"
}

# --- Git sync ---
sync_to_git() {
    local manifest="$1"
    local action="$2"
    local app="$3"
    printf '\n%b\n' "${BLUE}Syncing with Git...${NC}"
    if ! git -C "$CHEZMOI_SOURCE_PATH" diff --quiet "$manifest" 2>/dev/null; then
        git -C "$CHEZMOI_SOURCE_PATH" add "$manifest"
        git -C "$CHEZMOI_SOURCE_PATH" commit -m "feat(flatpakw): ${action} ${app}"
        git -C "$CHEZMOI_SOURCE_PATH" pull --rebase origin main 2>/dev/null || true
        git -C "$CHEZMOI_SOURCE_PATH" push
        printf '%b\n' "${GREEN}Pushed to remote.${NC}"
    else
        printf '%b\n' "${YELLOW}No changes to sync.${NC}"
    fi
}

# --- Help ---
show_help() {
    local base_file host_file scope
    base_file="$(get_base_flatpakfile)"
    host_file="$(get_host_flatpakfile)"
    scope="$(get_install_scope)"
    cat <<EOF
flatpakw — flatpak wrapper with per-host overlay Flatpakfile sync

Usage:
  flatpakw install <app-id>   Install app and add to host overlay
  flatpakw remove <app-id>    Remove app and remove from host overlay
  flatpakw dump               Recompute host overlay from: installed − base
  flatpakw list               List installed apps (passthrough)
  flatpakw <subcommand>       Passthrough to flatpak

Base file (read-only): ${base_file:-unknown (check MACHINE_PROFILE)}
Host overlay:          ${host_file}
Install scope:         ${scope}
Hostname:              ${HOSTNAME_SHORT}
MACHINE_PROFILE:       ${MACHINE_PROFILE:-unset}
EOF
}

# --- Main ---
if [[ $# -eq 0 ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

SUBCOMMAND="$1"
shift

HOST_FLATPAKFILE="$(get_host_flatpakfile)"
SCOPE_FLAG="$(install_flags)"

case "$SUBCOMMAND" in
    install)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify a Flatpak app id${NC}" >&2
            exit 1
        fi
        for app in "$@"; do
            validate_app "$app"
        done
        printf '%b\n' "${BLUE}Running: flatpak install -y ${SCOPE_FLAG} flathub $*${NC}"
        flatpak install -y "$SCOPE_FLAG" flathub "$@"
        # Add to host overlay (base is read-only)
        for app in "$@"; do
            add_to_manifest "$HOST_FLATPAKFILE" "$app"
        done
        sync_to_git "$HOST_FLATPAKFILE" "install" "$*"
        ;;
    remove|uninstall)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify a Flatpak app id${NC}" >&2
            exit 1
        fi
        for app in "$@"; do
            validate_app "$app"
        done
        printf '%b\n' "${BLUE}Running: flatpak uninstall -y $*${NC}"
        flatpak uninstall -y "$@"
        # Remove from host overlay
        for app in "$@"; do
            remove_from_manifest "$HOST_FLATPAKFILE" "$app"
        done
        sync_to_git "$HOST_FLATPAKFILE" "remove" "$*"
        ;;
    dump)
        dump_host_overlay
        sync_to_git "$HOST_FLATPAKFILE" "dump" "host-overlay"
        ;;
    list|search|info|update|upgrade|run|override|repair|remotes|remote-add|remote-delete|remote-modify|remote-list)
        # Passthrough — no manifest change needed
        printf '%b\n' "${BLUE}Running: flatpak ${SUBCOMMAND} $*${NC}"
        flatpak "$SUBCOMMAND" "$@"
        ;;
    *)
        # Unknown subcommand — full passthrough
        printf '%b\n' "${BLUE}Running: flatpak ${SUBCOMMAND} $*${NC}"
        flatpak "$SUBCOMMAND" "$@"
        ;;
esac
