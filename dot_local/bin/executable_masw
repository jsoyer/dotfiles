#!/usr/bin/env bash
# masw — mas wrapper that keeps Brewfile mas entries in sync with chezmoi
# Usage: masw install <app_id>     → installs + adds to Brewfile
#        masw uninstall <app_id>   → uninstalls + removes from Brewfile
#        masw list/search/upgrade  → passthrough

set -euo pipefail

# --- Colors ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# --- Config ---
CHEZMOI_SOURCE_PATH="${CHEZMOI_SOURCE_PATH:-${HOME}/.local/share/chezmoi}"
MANIFEST_DIR="${CHEZMOI_SOURCE_PATH}/dot_private"

# --- Determine target Brewfile ---
get_brewfile() {
    case "${MACHINE_PROFILE:-}" in
        mac-personal) printf '%s' "${MANIFEST_DIR}/Brewfile_personal" ;;
        mac-pro)      printf '%s' "${MANIFEST_DIR}/Brewfile_pro" ;;
        *)            printf '' ;;
    esac
}

# --- Git sync ---
sync_to_git() {
    local brewfile="$1"
    local action="$2"
    local app="$3"
    printf '\n%b\n' "${BLUE}Syncing with Git...${NC}"
    if ! git -C "$CHEZMOI_SOURCE_PATH" diff --quiet "$brewfile" 2>/dev/null; then
        git -C "$CHEZMOI_SOURCE_PATH" add "$brewfile"
        git -C "$CHEZMOI_SOURCE_PATH" commit -m "feat(masw): ${action} ${app}"
        git -C "$CHEZMOI_SOURCE_PATH" pull --rebase origin main 2>/dev/null || true
        git -C "$CHEZMOI_SOURCE_PATH" push || printf '%b\n' "${YELLOW}Warning: Git push failed (will sync later)${NC}"
        printf '%b\n' "${GREEN}Pushed to remote.${NC}"
    else
        printf '%b\n' "${YELLOW}No changes to sync.${NC}"
    fi
}

# --- Help ---
show_help() {
    local brewfile
    brewfile="$(get_brewfile)"
    cat <<EOF
masw — Mac App Store wrapper with Brewfile manifest sync

Usage:
  masw install <app_id>      Install app and add to Brewfile
  masw uninstall <app_id>    Uninstall app and remove from Brewfile
  masw upgrade               Upgrade all App Store apps
  masw list                  List installed apps
  masw search <query>        Search App Store
  masw <subcommand>          Passthrough to mas

Brewfile location: ${brewfile:-unknown (check MACHINE_PROFILE)}
MACHINE_PROFILE: ${MACHINE_PROFILE:-unset}
EOF
}

# --- Main ---
if [[ $# -eq 0 ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

SUBCOMMAND="$1"
shift

BREWFILE="$(get_brewfile)"

case "$SUBCOMMAND" in
    install|purchase)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify an app ID${NC}" >&2
            exit 1
        fi
        app_id="$1"
        printf '%b\n' "${BLUE}Running: mas install ${app_id}${NC}"
        mas install "$app_id"

        if [[ -n "$BREWFILE" ]]; then
            # Get app name from mas
            app_name="$(mas info "$app_id" 2>/dev/null | head -1 | sed 's/ [0-9].*$//' || echo "Unknown")"
            mas_line="mas \"${app_name}\", id: ${app_id}"

            if grep -qF "id: ${app_id}" "$BREWFILE" 2>/dev/null; then
                printf '%b\n' "${YELLOW}${app_name} (${app_id}) already in $(basename "$BREWFILE")${NC}"
            else
                printf '%s\n' "$mas_line" >> "$BREWFILE"
                printf '%b\n' "${GREEN}Added '${mas_line}' to $(basename "$BREWFILE")${NC}"
                sync_to_git "$BREWFILE" "install" "$app_name"
            fi
        else
            printf '%b\n' "${YELLOW}Warning: no Brewfile for profile '${MACHINE_PROFILE:-unset}' — skipping manifest sync${NC}"
        fi
        ;;
    uninstall)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify an app ID${NC}" >&2
            exit 1
        fi
        app_id="$1"
        # Get name before uninstall
        app_name="$(mas info "$app_id" 2>/dev/null | head -1 | sed 's/ [0-9].*$//' || echo "Unknown")"

        printf '%b\n' "${BLUE}Running: mas uninstall ${app_id}${NC}"
        mas uninstall "$app_id" 2>/dev/null || sudo mas uninstall "$app_id" 2>/dev/null || {
            printf '%b\n' "${YELLOW}mas uninstall failed — try removing from Applications manually${NC}"
        }

        if [[ -n "$BREWFILE" ]]; then
            if grep -qF "id: ${app_id}" "$BREWFILE" 2>/dev/null; then
                tmp="$(mktemp)"
                grep -vF "id: ${app_id}" "$BREWFILE" > "$tmp"
                mv "$tmp" "$BREWFILE"
                printf '%b\n' "${GREEN}Removed '${app_name}' (${app_id}) from $(basename "$BREWFILE")${NC}"
                sync_to_git "$BREWFILE" "uninstall" "$app_name"
            else
                printf '%b\n' "${YELLOW}${app_id} not found in $(basename "$BREWFILE")${NC}"
            fi
        fi
        ;;
    list|search|info|upgrade|outdated|version|lucky|reset|signin|signout)
        # Passthrough
        mas "$SUBCOMMAND" "$@"
        ;;
    *)
        mas "$SUBCOMMAND" "$@"
        ;;
esac
