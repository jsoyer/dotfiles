#!/usr/bin/env bash
# masw — mas wrapper that keeps per-host Brewfile overlay mas entries in sync
# Usage: masw install <app_id>     → installs + adds to host overlay Brewfile
#        masw uninstall <app_id>   → uninstalls + removes from host overlay Brewfile
#        masw list/search/upgrade  → passthrough
#
# Model:
#   Base Brewfile (Brewfile_<profile>)  = curated shared base — NEVER modified by masw
#   Host overlay  (Brewfile_<hostname>) = machine-specific extras (delta)

set -euo pipefail

# --- Colors ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# --- Config ---
# NOTE: `git status --porcelain` and not `git diff --quiet`:
# diff only reports TRACKED files, so a brand-new per-hostname manifest
# (e.g. Aptfile_<host> on a fresh machine) was never committed. It then
# stayed untracked forever and tripped the A1 guard in chezmoi-autoupdate,
# silently killing the unattended update. status sees untracked too.
CHEZMOI_SOURCE_PATH="${CHEZMOI_SOURCE_PATH:-${HOME}/.local/share/chezmoi}"
MANIFEST_DIR="${CHEZMOI_SOURCE_PATH}/dot_private"

# --- Hostname (short, no domain) ---
HOSTNAME_SHORT="$(uname -n | cut -d. -f1)"

# --- Host overlay Brewfile (per-hostname) ---
get_host_brewfile() {
    printf '%s' "${MANIFEST_DIR}/Brewfile_${HOSTNAME_SHORT}"
}

# --- Base Brewfile (read-only reference, for --help display only) ---
get_base_brewfile() {
    case "${MACHINE_PROFILE:-}" in
        mac-personal) printf '%s' "${MANIFEST_DIR}/Brewfile_personal" ;;
        mac-pro)      printf '%s' "${MANIFEST_DIR}/Brewfile_pro" ;;
        *)            printf '' ;;
    esac
}

# --- Git sync ---
sync_to_git() {
    local brewfile="$1"
    local action="$2"
    local app="$3"
    printf '\n%b\n' "${BLUE}Syncing with Git...${NC}"
    if [[ -n "$(git -C "$CHEZMOI_SOURCE_PATH" status --porcelain -- "$brewfile" 2>/dev/null)" ]]; then
        git -C "$CHEZMOI_SOURCE_PATH" add "$brewfile"
        git -C "$CHEZMOI_SOURCE_PATH" commit --no-gpg-sign -m "feat(masw): ${action} ${app}"
        git -C "$CHEZMOI_SOURCE_PATH" pull --rebase origin main 2>/dev/null || true
        git -C "$CHEZMOI_SOURCE_PATH" push || printf '%b\n' "${YELLOW}Warning: Git push failed (will sync later)${NC}"
        printf '%b\n' "${GREEN}Pushed to remote.${NC}"
    else
        printf '%b\n' "${YELLOW}No changes to sync.${NC}"
    fi
}

# --- Help ---
show_help() {
    local base_file host_file
    base_file="$(get_base_brewfile)"
    host_file="$(get_host_brewfile)"
    cat <<EOF
masw — Mac App Store wrapper with per-host Brewfile overlay sync

Usage:
  masw install <app_id>      Install app and add to host overlay
  masw uninstall <app_id>    Uninstall app and remove from host overlay
  masw upgrade               Upgrade all App Store apps
  masw list                  List installed apps
  masw search <query>        Search App Store
  masw <subcommand>          Passthrough to mas

Base file (read-only): ${base_file:-unknown (check MACHINE_PROFILE)}
Host overlay:          ${host_file}
Hostname:              ${HOSTNAME_SHORT}
MACHINE_PROFILE:       ${MACHINE_PROFILE:-unset}
EOF
}

# --- Main ---
if [[ $# -eq 0 ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

SUBCOMMAND="$1"
shift

HOST_BREWFILE="$(get_host_brewfile)"

case "$SUBCOMMAND" in
    install|purchase)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify an app ID${NC}" >&2
            exit 1
        fi
        app_id="$1"
        printf '%b\n' "${BLUE}Running: mas install ${app_id}${NC}"
        mas install "$app_id"

        # Get app name from mas
        app_name="$(mas info "$app_id" 2>/dev/null | head -1 | sed 's/ [0-9].*$//' || echo "Unknown")"
        mas_line="mas \"${app_name}\", id: ${app_id}"

        # Write to host overlay (not base — base is read-only)
        if grep -qF "id: ${app_id}" "$HOST_BREWFILE" 2>/dev/null; then
            printf '%b\n' "${YELLOW}${app_name} (${app_id}) already in $(basename "$HOST_BREWFILE")${NC}"
        else
            # Ensure host overlay exists with a header if new
            if [[ ! -f "$HOST_BREWFILE" ]]; then
                {
                    printf '# Host overlay for %s — extras beyond the shared base.\n' "$HOSTNAME_SHORT"
                    printf '# Managed by masw/breww. Do not edit manually.\n'
                } > "$HOST_BREWFILE"
            fi
            printf '%s\n' "$mas_line" >> "$HOST_BREWFILE"
            printf '%b\n' "${GREEN}Added '${mas_line}' to $(basename "$HOST_BREWFILE")${NC}"
            sync_to_git "$HOST_BREWFILE" "install" "$app_name"
        fi
        ;;
    uninstall)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify an app ID${NC}" >&2
            exit 1
        fi
        app_id="$1"
        # Get name before uninstall
        app_name="$(mas info "$app_id" 2>/dev/null | head -1 | sed 's/ [0-9].*$//' || echo "Unknown")"

        printf '%b\n' "${BLUE}Running: mas uninstall ${app_id}${NC}"
        mas uninstall "$app_id" 2>/dev/null || sudo mas uninstall "$app_id" 2>/dev/null || {
            printf '%b\n' "${YELLOW}mas uninstall failed — try removing from Applications manually${NC}"
        }

        # Remove from host overlay only
        if [[ -f "$HOST_BREWFILE" ]] && grep -qF "id: ${app_id}" "$HOST_BREWFILE" 2>/dev/null; then
            tmp="$(mktemp)"
            grep -vF "id: ${app_id}" "$HOST_BREWFILE" > "$tmp"
            mv "$tmp" "$HOST_BREWFILE"
            printf '%b\n' "${GREEN}Removed '${app_name}' (${app_id}) from $(basename "$HOST_BREWFILE")${NC}"
            sync_to_git "$HOST_BREWFILE" "uninstall" "$app_name"
        else
            printf '%b\n' "${YELLOW}${app_id} not found in host overlay $(basename "$HOST_BREWFILE")${NC}"
        fi
        ;;
    list|search|info|upgrade|outdated|version|lucky|reset|signin|signout)
        # Passthrough
        mas "$SUBCOMMAND" "$@"
        ;;
    *)
        mas "$SUBCOMMAND" "$@"
        ;;
esac
