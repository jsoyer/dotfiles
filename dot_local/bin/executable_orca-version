#!/usr/bin/env bash
#
# orca-version — Show the installed Orca version against the latest GitHub
# release, and whether an update is available.
# Needs no elevation and never launches the app (reads the embedded .desktop).
#
set -uo pipefail

APPIMAGE="${ORCA_APPIMAGE:-/opt/orca/orca-linux.AppImage}"
REPO="${ORCA_REPO:-stablyai/orca}"

c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_b=$'\033[1;34m'; c_0=$'\033[0m'

# Version of an AppImage without running it (X-AppImage-Version of the embedded
# .desktop file).
appimage_version() {
  local img="$1" tmpd ver
  [[ -f "$img" ]] || { echo "missing"; return 0; }
  tmpd="$(mktemp -d)" || { echo "unknown"; return 0; }
  ( cd "$tmpd" && "$img" --appimage-extract '*.desktop' >/dev/null 2>&1 ) || true
  ver="$(grep -hm1 '^X-AppImage-Version=' "$tmpd"/squashfs-root/*.desktop 2>/dev/null | cut -d= -f2)"
  rm -rf "$tmpd"
  echo "${ver:-unknown}"
}

# Latest published version on GitHub (tag without the "v" prefix).
# We follow the .../releases/latest -> .../releases/tag/vX.Y.Z redirect rather
# than querying the REST API: no authentication, no rate limit (60/h), and it is
# the same host (github.com) we download the update from.
latest_version() {
  local loc tag
  loc="$(curl -sSI --max-time 10 "https://github.com/${REPO}/releases/latest" 2>/dev/null \
        | grep -i '^location:' | tr -d '\r')" || true
  tag="$(printf '%s' "$loc" | grep -oE 'tag/[^ ]+' | cut -d/ -f2)"
  echo "${tag#v}"
}

installed="$(appimage_version "$APPIMAGE")"
latest="$(latest_version)"

printf '%sOrca%s\n' "$c_b" "$c_0"
printf '  Installed : %s%s%s\n' "$c_b" "$installed" "$c_0"

if [[ -z "$latest" ]]; then
  printf '  GitHub    : %s(unreachable)%s\n' "$c_y" "$c_0"
  exit 0
fi
printf '  GitHub    : %s\n' "$latest"

if [[ "$installed" == "missing" || "$installed" == "unknown" ]]; then
  printf '  State     : %s?  local version undeterminable%s\n' "$c_y" "$c_0"
elif [[ "$installed" == "$latest" ]]; then
  printf '  State     : %s✔ up to date%s\n' "$c_g" "$c_0"
else
  printf '  State     : %s⬆ update available (%s → %s)%s\n' "$c_y" "$installed" "$latest" "$c_0"
  printf '              Applied automatically at the next timer run, or: sudo systemctl start orca-update.service\n'
fi
