#!/usr/bin/env bash
#
# orca-version — Affiche la version d'Orca installée vs la dernière release
# GitHub, et indique si une mise à jour est disponible.
# Aucune élévation requise, ne lance pas l'appli (lit le .desktop embarqué).
#
set -uo pipefail

APPIMAGE="${ORCA_APPIMAGE:-/opt/orca/orca-linux.AppImage}"
REPO="${ORCA_REPO:-stablyai/orca}"

c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_b=$'\033[1;34m'; c_0=$'\033[0m'

# Version d'une AppImage, sans la lancer (X-AppImage-Version du .desktop embarqué).
appimage_version() {
  local img="$1" tmpd ver
  [[ -f "$img" ]] || { echo "absente"; return 0; }
  tmpd="$(mktemp -d)" || { echo "inconnue"; return 0; }
  ( cd "$tmpd" && "$img" --appimage-extract '*.desktop' >/dev/null 2>&1 ) || true
  ver="$(grep -hm1 '^X-AppImage-Version=' "$tmpd"/squashfs-root/*.desktop 2>/dev/null | cut -d= -f2)"
  rm -rf "$tmpd"
  echo "${ver:-inconnue}"
}

# Dernière version publiée sur GitHub (tag sans le préfixe "v").
# On suit la redirection de .../releases/latest → .../releases/tag/vX.Y.Z plutôt
# que d'interroger l'API REST : pas d'authentification, pas de rate limit (60/h)
# et c'est le même hôte (github.com) que celui utilisé pour télécharger la MAJ.
latest_version() {
  local loc tag
  loc="$(curl -sSI --max-time 10 "https://github.com/${REPO}/releases/latest" 2>/dev/null \
        | grep -i '^location:' | tr -d '\r')" || true
  tag="$(printf '%s' "$loc" | grep -oE 'tag/[^ ]+' | cut -d/ -f2)"
  echo "${tag#v}"
}

installed="$(appimage_version "$APPIMAGE")"
latest="$(latest_version)"

printf '%sOrca%s\n' "$c_b" "$c_0"
printf '  Installée : %s%s%s\n' "$c_b" "$installed" "$c_0"

if [[ -z "$latest" ]]; then
  printf '  GitHub    : %s(injoignable)%s\n' "$c_y" "$c_0"
  exit 0
fi
printf '  GitHub    : %s\n' "$latest"

if [[ "$installed" == "absente" || "$installed" == "inconnue" ]]; then
  printf '  État      : %s?  version locale indéterminable%s\n' "$c_y" "$c_0"
elif [[ "$installed" == "$latest" ]]; then
  printf '  État      : %s✔ à jour%s\n' "$c_g" "$c_0"
else
  printf '  État      : %s⬆ mise à jour dispo (%s → %s)%s\n' "$c_y" "$installed" "$latest" "$c_0"
  printf '              MAJ auto au prochain passage du timer, ou : sudo systemctl start orca-update.service\n'
fi
