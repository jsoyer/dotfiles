#!/usr/bin/env bash
# sync-mcp-servers — regenerate OpenCode config from chezmoi template
# Usage: sync-mcp-servers [--dry-run]
#
# Wrapper around `chezmoi` so users can re-render ~/.config/opencode/opencode.json
# after tweaking Claude settings without running a full apply.

set -euo pipefail

TARGET="$HOME/.config/opencode/opencode.json"

if [[ "${1:-}" == "--dry-run" ]]; then
  echo "[sync-mcp-servers] Previewing changes to $TARGET"
  chezmoi diff "$TARGET"
else
  echo "[sync-mcp-servers] Applying $TARGET from chezmoi template"
  chezmoi apply "$TARGET"
fi
