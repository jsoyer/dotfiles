#!/usr/bin/env bash
# Native package syntax; package layers and machine-local manifest sync are shared.
set -euo pipefail
_LAYER_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if ! command -v python3 >/dev/null 2>&1; then
    printf 'python3 is required by this wrapper; use the native package manager to install it.\n' >&2
    exit 1
fi
exec python3 "$_LAYER_DIR/package_layers.py" wrapper --manager rpm -- "$@"
