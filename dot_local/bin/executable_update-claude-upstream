#!/usr/bin/env python3
"""Update vendored dot_claude from upstream while preserving local patches."""

from __future__ import annotations

import argparse
import filecmp
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path


MANIFEST = Path("docs/CLAUDE_UPSTREAM.json")
PROVENANCE = Path("docs/PROVENANCE.md")


def root_dir() -> Path:
    configured = Path(os.environ.get("CHEZMOI_SOURCE_PATH", Path.home() / ".local/share/chezmoi"))
    if (configured / MANIFEST).exists():
        return configured
    cwd = Path.cwd()
    if (cwd / MANIFEST).exists():
        return cwd
    raise SystemExit(f"Could not find {MANIFEST}; run from chezmoi source or set CHEZMOI_SOURCE_PATH")


def run(args: list[str], cwd: Path | None = None, capture: bool = False) -> str:
    result = subprocess.run(args, cwd=cwd, text=True, capture_output=capture, check=True)
    return result.stdout.strip() if capture else ""


def load_manifest(root: Path) -> dict:
    return json.loads((root / MANIFEST).read_text())


def save_manifest(root: Path, manifest: dict) -> None:
    path = root / MANIFEST
    path.write_text(json.dumps(manifest, indent=2) + "\n")


def latest_commit(repo: str, branch: str) -> str:
    output = run(["git", "ls-remote", repo, f"refs/heads/{branch}"], capture=True)
    if not output:
        raise SystemExit(f"Could not resolve {repo} {branch}")
    return output.split()[0]


def export_tree(repo_dir: Path, commit: str, destination: Path) -> None:
    destination.mkdir(parents=True, exist_ok=True)
    archive = subprocess.Popen(["git", "archive", commit], cwd=repo_dir, stdout=subprocess.PIPE)
    assert archive.stdout is not None
    with tarfile.open(fileobj=archive.stdout, mode="r|") as tar:
        tar.extractall(destination, filter="fully_trusted")
    if archive.wait() != 0:
        raise SystemExit(f"git archive failed for {commit}")


def rel_files(directory: Path) -> set[Path]:
    if not directory.exists():
        return set()
    return {path.relative_to(directory) for path in directory.rglob("*") if path.is_file()}


def same(a: Path, b: Path) -> bool:
    return a.exists() and b.exists() and filecmp.cmp(a, b, shallow=False)


def is_binary(path: Path) -> bool:
    try:
        return b"\0" in path.read_bytes()[:8192]
    except FileNotFoundError:
        return False


def copy_file(src: Path, dst: Path, dry_run: bool) -> None:
    if dry_run:
        return
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)


def remove_file(path: Path, dry_run: bool) -> None:
    if dry_run:
        return
    path.unlink(missing_ok=True)


def merge_text(local: Path, base: Path, new: Path, dry_run: bool) -> bool:
    result = subprocess.run(["git", "merge-file", "-p", str(local), str(base), str(new)], text=True, capture_output=True)
    if not dry_run:
        local.write_text(result.stdout)
    return result.returncode == 0


def update_provenance(root: Path, old: str, new: str, dry_run: bool) -> None:
    path = root / PROVENANCE
    text = path.read_text()
    updated = text.replace(f"Pinned revision: `{old}`", f"Pinned revision: `{new[:8]}`")
    if updated != text and not dry_run:
        path.write_text(updated)


def apply_update(root: Path, manifest: dict, target: str, dry_run: bool) -> int:
    local_dir = root / manifest["local_path"]
    repo = manifest["upstream"]["repo"]
    pinned = manifest["upstream"]["pinned_commit"]

    with tempfile.TemporaryDirectory() as tmp_s:
        tmp = Path(tmp_s)
        repo_dir = tmp / "upstream"
        base_dir = tmp / "base"
        new_dir = tmp / "new"

        run(["git", "clone", "--quiet", repo, str(repo_dir)])
        run(["git", "rev-parse", "--verify", pinned], cwd=repo_dir, capture=True)
        target_full = run(["git", "rev-parse", "--verify", target], cwd=repo_dir, capture=True)
        export_tree(repo_dir, pinned, base_dir)
        export_tree(repo_dir, target_full, new_dir)

        conflicts: list[str] = []
        operations: list[str] = []
        all_files = rel_files(base_dir) | rel_files(new_dir) | rel_files(local_dir)

        for rel in sorted(all_files):
            base = base_dir / rel
            new = new_dir / rel
            local = local_dir / rel
            base_exists = base.exists()
            new_exists = new.exists()
            local_exists = local.exists()

            if not base_exists and new_exists and not local_exists:
                operations.append(f"add upstream {rel}")
                copy_file(new, local, dry_run)
            elif not base_exists and new_exists and local_exists:
                if not same(new, local):
                    operations.append(f"keep local collision {rel}")
            elif base_exists and not new_exists and local_exists:
                if same(base, local):
                    operations.append(f"remove upstream-deleted {rel}")
                    remove_file(local, dry_run)
                else:
                    operations.append(f"keep locally modified upstream-deleted {rel}")
            elif base_exists and new_exists and local_exists:
                if same(local, new) or same(base, new):
                    continue
                if same(local, base):
                    operations.append(f"update upstream {rel}")
                    copy_file(new, local, dry_run)
                elif is_binary(local) or is_binary(base) or is_binary(new):
                    conflicts.append(str(rel))
                    operations.append(f"binary conflict {rel}")
                else:
                    clean = merge_text(local, base, new, dry_run)
                    operations.append(f"merge {'clean' if clean else 'conflict'} {rel}")
                    if not clean:
                        conflicts.append(str(rel))

        for operation in operations:
            print(operation)

        if conflicts:
            print("\nConflicts require manual resolution:", file=sys.stderr)
            for conflict in conflicts:
                print(f"  {conflict}", file=sys.stderr)
            return 1

        if not dry_run:
            manifest["upstream"]["pinned_commit"] = target_full[:8]
            save_manifest(root, manifest)
            update_provenance(root, pinned, target_full, dry_run)
        print(f"Updated pin {pinned} -> {target_full[:8]}" if not dry_run else f"Dry-run target {target_full[:8]}")
        return 0


def patch_report(root: Path, manifest: dict) -> int:
    local_dir = root / manifest["local_path"]
    repo = manifest["upstream"]["repo"]
    pinned = manifest["upstream"]["pinned_commit"]

    with tempfile.TemporaryDirectory() as tmp_s:
        tmp = Path(tmp_s)
        repo_dir = tmp / "upstream"
        base_dir = tmp / "base"

        run(["git", "clone", "--quiet", repo, str(repo_dir)])
        pinned_full = run(["git", "rev-parse", "--verify", pinned], cwd=repo_dir, capture=True)
        export_tree(repo_dir, pinned_full, base_dir)

        base_files = rel_files(base_dir)
        local_files = rel_files(local_dir)
        local_only = sorted(local_files - base_files)
        upstream_missing = sorted(base_files - local_files)
        locally_modified = sorted(rel for rel in base_files & local_files if not same(base_dir / rel, local_dir / rel))
        identical = sorted(rel for rel in base_files & local_files if same(base_dir / rel, local_dir / rel))

        print(f"dot_claude local patch report against upstream {pinned_full[:8]}")
        print(f"identical_to_upstream: {len(identical)}")
        print(f"locally_modified: {len(locally_modified)}")
        for rel in locally_modified:
            print(f"  M {rel}")
        print(f"local_only: {len(local_only)}")
        for rel in local_only:
            print(f"  A {rel}")
        print(f"upstream_missing_locally: {len(upstream_missing)}")
        for rel in upstream_missing:
            print(f"  D {rel}")

    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="check whether upstream has a newer commit")
    parser.add_argument("--update", action="store_true", help="apply a three-way update into dot_claude")
    parser.add_argument("--patch-report", action="store_true", help="report local dot_claude changes against the pinned upstream snapshot")
    parser.add_argument("--target", help="target upstream commit or branch; defaults to configured branch latest")
    parser.add_argument("--dry-run", action="store_true", help="show update operations without writing files")
    args = parser.parse_args()

    root = root_dir()
    manifest = load_manifest(root)
    repo = manifest["upstream"]["repo"]
    branch = manifest["upstream"]["branch"]
    pinned = manifest["upstream"]["pinned_commit"]

    if args.patch_report:
        return patch_report(root, manifest)

    latest = latest_commit(repo, branch)

    if args.check or not args.update:
        status = "ok" if latest.startswith(pinned) else "update available"
        print(f"dot_claude: pinned {pinned}, upstream {branch} {latest[:8]} ({status})")
        return 0 if status == "ok" else 1

    target = args.target or latest
    return apply_update(root, manifest, target, args.dry_run)


if __name__ == "__main__":
    raise SystemExit(main())
