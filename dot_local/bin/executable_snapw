#!/usr/bin/env bash
# snapw — snap wrapper that keeps Snapfile manifests in sync with chezmoi
# Usage: snapw <snap-subcommand> [args...]
#        snapw install foo    → installs + adds to Snapfile
#        snapw remove foo     → removes + removes from Snapfile
#        snapw list/find      → passthrough

set -euo pipefail

# --- Colors ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# --- Config ---
CHEZMOI_SOURCE_PATH="${CHEZMOI_SOURCE_PATH:-${HOME}/.local/share/chezmoi}"
MANIFEST_DIR="${CHEZMOI_SOURCE_PATH}/dot_private"

# --- Package name validation ---
validate_pkg() {
    local pkg="$1"
    # Skip flags (--classic, --edge, etc.)
    [[ "$pkg" == --* ]] && return 1
    if ! [[ "$pkg" =~ ^[a-zA-Z0-9][a-zA-Z0-9.+\-]{0,127}$ ]]; then
        printf '%b\n' "${RED}Error: invalid package name: '${pkg}'${NC}" >&2
        exit 1
    fi
}

# --- Determine target Snapfile based on MACHINE_PROFILE ---
get_snapfile() {
    case "${MACHINE_PROFILE:-}" in
        ubuntu-desktop)  printf '%s' "${MANIFEST_DIR}/Snapfile_ubuntu_desktop" ;;
        ubuntu-server)   printf '%s' "${MANIFEST_DIR}/Snapfile_ubuntu_server" ;;
        *)               printf '' ;;
    esac
}

# --- Add package to manifest (idempotent) ---
add_to_manifest() {
    local manifest="$1"
    local pkg="$2"
    if grep -qxF "$pkg" "$manifest" 2>/dev/null; then
        printf '%b\n' "${YELLOW}${pkg} already in $(basename "$manifest")${NC}"
        return
    fi
    printf '%s\n' "$pkg" >> "$manifest"
    printf '%b\n' "${GREEN}Added '${pkg}' to $(basename "$manifest")${NC}"
}

# --- Remove package from manifest ---
remove_from_manifest() {
    local manifest="$1"
    local pkg="$2"
    local tmp
    tmp="$(mktemp)"
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "$pkg" ]]; then
            continue
        fi
        printf '%s\n' "$line"
    done < "$manifest" > "$tmp"
    mv "$tmp" "$manifest"
    printf '%b\n' "${GREEN}Removed '${pkg}' from $(basename "$manifest")${NC}"
}

# --- Git sync ---
sync_to_git() {
    local manifest="$1"
    local action="$2"
    local pkg="$3"
    printf '\n%b\n' "${BLUE}Syncing with Git...${NC}"
    if ! git -C "$CHEZMOI_SOURCE_PATH" diff --quiet "$manifest" 2>/dev/null; then
        git -C "$CHEZMOI_SOURCE_PATH" add "$manifest"
        git -C "$CHEZMOI_SOURCE_PATH" commit -m "feat(snapw): ${action} ${pkg}"
        git -C "$CHEZMOI_SOURCE_PATH" pull --rebase origin main 2>/dev/null || true
        git -C "$CHEZMOI_SOURCE_PATH" push
        printf '%b\n' "${GREEN}Pushed to remote.${NC}"
    else
        printf '%b\n' "${YELLOW}No changes to sync.${NC}"
    fi
}

# --- Help ---
show_help() {
    local snapfile
    snapfile="$(get_snapfile)"
    cat <<EOF
snapw — snap wrapper with Snapfile manifest sync

Usage:
  snapw install <pkg>    Install snap and add to Snapfile
  snapw remove <pkg>     Remove snap and remove from Snapfile
  snapw list             List installed snaps (no manifest change)
  snapw find <query>     Search snap store
  snapw <subcommand>     Passthrough to snap

Snapfile location: ${snapfile:-unknown (check MACHINE_PROFILE)}
MACHINE_PROFILE: ${MACHINE_PROFILE:-unset}
EOF
}

# --- Main ---
if [[ $# -eq 0 ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

SUBCOMMAND="$1"
shift

SNAPFILE="$(get_snapfile)"

case "$SUBCOMMAND" in
    install)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify a package name${NC}" >&2
            exit 1
        fi
        # Collect package names (skip flags like --classic)
        local_pkgs=()
        for arg in "$@"; do
            if validate_pkg "$arg"; then
                local_pkgs+=("$arg")
            fi
        done
        printf '%b\n' "${BLUE}Running: sudo snap install $*${NC}"
        sudo snap install "$@"
        if [[ -n "$SNAPFILE" ]]; then
            for pkg in "${local_pkgs[@]}"; do
                add_to_manifest "$SNAPFILE" "$pkg"
            done
            sync_to_git "$SNAPFILE" "install" "${local_pkgs[*]}"
        else
            printf '%b\n' "${YELLOW}Warning: no Snapfile for profile '${MACHINE_PROFILE:-unset}' — skipping manifest sync${NC}"
        fi
        ;;
    remove)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify a package name${NC}" >&2
            exit 1
        fi
        local_pkgs=()
        for arg in "$@"; do
            if validate_pkg "$arg"; then
                local_pkgs+=("$arg")
            fi
        done
        printf '%b\n' "${BLUE}Running: sudo snap remove $*${NC}"
        sudo snap remove "$@"
        if [[ -n "$SNAPFILE" ]]; then
            for pkg in "${local_pkgs[@]}"; do
                remove_from_manifest "$SNAPFILE" "$pkg"
            done
            sync_to_git "$SNAPFILE" "remove" "${local_pkgs[*]}"
        else
            printf '%b\n' "${YELLOW}Warning: no Snapfile for profile '${MACHINE_PROFILE:-unset}' — skipping manifest sync${NC}"
        fi
        ;;
    list|find|info|connections|changes|version|refresh)
        # Passthrough — no manifest change needed
        snap "$SUBCOMMAND" "$@"
        ;;
    *)
        # Unknown subcommand — full passthrough
        snap "$SUBCOMMAND" "$@"
        ;;
esac
