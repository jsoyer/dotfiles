#!/usr/bin/env bash
#
# agentsvc — Single entry point for the self-hosted agent stacks:
#
#   moshi   moshi-hook    (--user)  Moshi mobile terminal
#   orca    orca-serve    (system)  headless Orca runtime
#   cursor  cursor-worker (--user)  private Cursor worker
#   herdr   (timer only)            multiplexer — the server daemonizes itself,
#                                   systemd only manages its update
#
# Installing stays manual and explicit (moshi-setup / orca-setup /
# cursor-setup): agentsvc only observes and drives what is already in place.
# No `enable` here.
#
# Usage:
#   agentsvc status  [target]   service state (default: all)
#   agentsvc update  [target]   run the update scripts
#   agentsvc restart [target]
#   agentsvc logs    <target>   follow the journal (Ctrl-C to quit)
#   agentsvc reload             systemctl --user daemon-reload + reminder
#
# target ∈ moshi | orca | cursor | herdr | all
#
set -uo pipefail

CMD="${1:-status}"
TARGET="${2:-all}"

c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_d=$'\033[2m'; c_0=$'\033[0m'
die() { printf '%s[agentsvc]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

usage() { sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

case "$TARGET" in
  moshi|orca|cursor|herdr|all) : ;;
  *) die "Unknown target: ${TARGET} (moshi|orca|cursor|herdr|all)" ;;
esac

want() { [[ "$TARGET" == "all" || "$TARGET" == "$1" ]]; }

# Coloured state of a unit (--user or system).
unit_state() {
  local scope="$1" unit="$2" active enabled
  # NB: is-active/is-enabled ALREADY print a state ("inactive", "not-found") and
  # then exit non-zero. An `|| echo missing` would add a second line and break
  # the alignment — so we keep stdout only.
  if [[ "$scope" == "user" ]]; then
    active="$(systemctl --user is-active   "$unit" 2>/dev/null)" || true
    enabled="$(systemctl --user is-enabled "$unit" 2>/dev/null)" || true
  else
    active="$(systemctl is-active   "$unit" 2>/dev/null)" || true
    enabled="$(systemctl is-enabled "$unit" 2>/dev/null)" || true
  fi
  active="${active:-missing}"
  enabled="${enabled:--}"
  local color="$c_r"
  [[ "$active" == "active" ]] && color="$c_g"
  [[ "$active" == "activating" || "$active" == "inactive" ]] && color="$c_y"
  printf '%s%-10s%s %s(%s)%s' "$color" "$active" "$c_0" "$c_d" "$enabled" "$c_0"
}

row() { printf '  %-22s %s\n' "$1" "$2"; }

cmd_status() {
  if want moshi; then
    printf '%smoshi%s  — mobile terminal\n' "$c_b" "$c_0"
    row "moshi-hook.service"  "$(unit_state user moshi-hook.service)"
    row "moshi-update.timer"  "$(unit_state user moshi-update.timer)"
    row "binary"              "$(command -v moshi-hook 2>/dev/null || echo missing)"
    echo
  fi
  if want orca; then
    printf '%sorca%s   — headless runtime\n' "$c_b" "$c_0"
    row "orca-serve.service"  "$(unit_state system orca-serve.service)"
    row "orca-update.timer"   "$(unit_state system orca-update.timer)"
    row "AppImage"            "$([[ -f /opt/orca/orca-linux.AppImage ]] && echo /opt/orca/orca-linux.AppImage || echo missing)"
    echo
  fi
  if want cursor; then
    printf '%scursor%s — private worker\n' "$c_b" "$c_0"
    row "cursor-worker.service" "$(unit_state user cursor-worker.service)"
    row "cursor-update.timer"   "$(unit_state user cursor-update.timer)"
    # The restart counter is the only signal of a failure loop: a looping
    # service shows "activating" intermittently.
    local n; n="$(systemctl --user show -p NRestarts --value cursor-worker.service 2>/dev/null || echo 0)"
    if [[ "${n:-0}" -gt 50 ]]; then
      row "restarts" "$(printf '%s%s — likely failure loop%s' "$c_r" "$n" "$c_0")"
    else
      row "restarts" "${n:-0}"
    fi
    row "binary" "$(command -v cursor-agent 2>/dev/null || echo missing)"
    echo
  fi
  if want herdr; then
    printf '%sherdr%s  — multiplexer\n' "$c_b" "$c_0"
    # No long-running service: the server daemonizes outside systemd. Its state
    # therefore comes from the binary, not from systemctl.
    row "herdr-update.timer" "$(unit_state user herdr-update.timer)"
    row "binary"             "$(command -v herdr 2>/dev/null || echo missing)"
    if command -v herdr >/dev/null 2>&1; then
      local st ver compat
      st="$(herdr status server 2>/dev/null | awk -F': *' '$1=="status"{print $2; exit}')"
      ver="$(herdr status server 2>/dev/null | awk -F': *' '$1=="version"{print $2; exit}')"
      compat="$(herdr status server 2>/dev/null | awk -F': *' '$1=="compatible"{print $2; exit}')"
      row "server" "${st:-stopped}${ver:+ ($ver)}"
      # compatible=no means attaching will break: THE symptom of a failed handoff.
      if [[ -n "$compat" && "$compat" != "yes" ]]; then
        row "compatible" "$(printf '%s%s — attach broken, see update-herdr%s' "$c_r" "$compat" "$c_0")"
      fi
    fi
    echo
  fi
}

cmd_update() {
  want moshi  && { printf '%s> moshi%s\n'  "$c_b" "$c_0"; update-moshi         || true; }
  want cursor && { printf '%s> cursor%s\n' "$c_b" "$c_0"; update-cursor-agent  || true; }
  want orca   && { printf '%s> orca%s\n'   "$c_b" "$c_0"; sudo systemctl start orca-update.service || true; }
  want herdr  && { printf '%s> herdr%s\n'  "$c_b" "$c_0"; update-herdr         || true; }
}

cmd_restart() {
  want moshi  && systemctl --user restart moshi-hook.service    && printf 'moshi-hook restarted\n'
  want cursor && systemctl --user restart cursor-worker.service && printf 'cursor-worker restarted\n'
  want orca   && sudo systemctl restart orca-serve.service      && printf 'orca-serve restarted\n'
  # No herdr restart: the server holds your panes and is not managed by systemd.
  # A blunt restart would lose them — update-herdr does the handoff properly.
  if [[ "$TARGET" == "herdr" ]]; then
    printf '%sherdr cannot be restarted here%s: the server holds your panes.\n' "$c_y" "$c_0"
    printf '  Update with handoff : update-herdr\n'
    printf '  Deliberate stop     : herdr server stop\n'
  fi
  return 0
}

cmd_logs() {
  case "$TARGET" in
    moshi)  exec journalctl --user -u moshi-hook.service -f ;;
    cursor) exec journalctl --user -u cursor-worker.service -f ;;
    orca)   exec journalctl -u orca-serve.service -f ;;
    herdr)  exec journalctl --user -u herdr-update.service -f ;;
    all)    die "Pick a target: agentsvc logs moshi|orca|cursor|herdr" ;;
  esac
}

cmd_reload() {
  systemctl --user daemon-reload || die "daemon-reload failed."
  printf '%s[agentsvc]%s systemd --user reloaded.\n' "$c_g" "$c_0"
  printf '%sReminder:%s a unit change only takes effect after a restart —\n' "$c_y" "$c_0"
  printf '          agentsvc restart moshi|cursor, or orca-setup for orca (self-elevating).\n'
}

case "$CMD" in
  status)  cmd_status ;;
  update)  cmd_update ;;
  restart) cmd_restart ;;
  logs)    cmd_logs ;;
  reload)  cmd_reload ;;
  -h|--help|help) usage ;;
  *) die "Unknown command: ${CMD} (see --help)" ;;
esac
