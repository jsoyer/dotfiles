#!/usr/bin/env bash
#
# t3-version — Show the installed T3 Code version, the version the service is
# running, and whether a restart is pending.
# Read-only; tolerates missing fields (the `t3 status --json` schema is
# upstream's and not pinned here).
#
# Update: update-t3 (or `t3 update`).
#
set -uo pipefail

case "${1:-}" in
  -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'; exit 0 ;;
  "") : ;;
  *) echo "t3-version: unknown option: $1" >&2; exit 2 ;;
esac

c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_b=$'\033[1;34m'; c_0=$'\033[0m'

printf '%sT3 Code%s\n' "$c_b" "$c_0"
if ! command -v t3 >/dev/null 2>&1; then
  printf '  Installed : %smissing%s (run t3-setup)\n' "$c_y" "$c_0"
  exit 0
fi

installed="$(t3 --version 2>/dev/null | head -1 | tr -d '\r')"
printf '  Installed : %s%s%s\n' "$c_b" "${installed:-unknown}" "$c_0"

json="$(t3 status --json 2>/dev/null)" || json=""
if [[ -z "$json" ]]; then
  printf '  Service   : %s(t3 status unavailable)%s\n' "$c_y" "$c_0"
  exit 0
fi

# Best-effort field extraction: first "version" string, if any.
running="$(printf '%s' "$json" | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*:[[:space:]]*"\(.*\)"/\1/')"
[[ -n "$running" ]] && printf '  Running   : %s\n' "$running"

if [[ "$json" == *restart-pending* ]]; then
  printf '  State     : %s⬆ restart-pending (service still on the old version)%s\n' "$c_y" "$c_0"
  printf '              t3 service restart   (update-t3 does it for you)\n'
else
  printf '  State     : %s✔ no restart pending%s\n' "$c_g" "$c_0"
fi
printf '  Check for updates: t3 update   (add --yes to apply)\n'
