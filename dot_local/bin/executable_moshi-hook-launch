#!/usr/bin/env bash
#
# moshi-hook-launch — Resolve the moshi-hook binary, then run `serve`.
#
# Why this exists: a launchd plist requires an ABSOLUTE path in
# ProgramArguments, yet moshi-hook can live in three places depending on the
# machine:
#   /opt/homebrew/bin  (Apple Silicon)   /usr/local/bin  (Intel)   ~/.local/bin
# This shim avoids generating a different plist per machine.
#
# On Linux, moshi-hook.service points straight at ~/.local/bin/moshi-hook, so
# this shim is not used there.
#
set -euo pipefail

for candidate in \
  "${HOME}/.local/bin/moshi-hook" \
  /opt/homebrew/bin/moshi-hook \
  /usr/local/bin/moshi-hook
do
  [[ -x "$candidate" ]] && exec "$candidate" serve "$@"
done

# Last resort: the PATH inherited from launchd (often minimal, hence the
# explicit ordering above).
if command -v moshi-hook >/dev/null 2>&1; then
  exec moshi-hook serve "$@"
fi

echo "moshi-hook not found — run: moshi-setup" >&2
exit 127
