#!/usr/bin/env bash
# aptw — apt wrapper that keeps Aptfile manifests in sync with chezmoi
# Usage: aptw <apt-subcommand> [args...]
#        aptw install foo    → installs + adds to Aptfile
#        aptw remove foo     → removes + removes from Aptfile
#        aptw upgrade/search → passthrough

set -euo pipefail

# --- Colors ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# --- Config ---
CHEZMOI_SOURCE_PATH="${CHEZMOI_SOURCE_PATH:-${HOME}/.local/share/chezmoi}"
MANIFEST_DIR="${CHEZMOI_SOURCE_PATH}/dot_private"

# --- Package name validation ---
validate_pkg() {
    local pkg="$1"
    [[ "$pkg" == */* ]] && { printf '%b\n' "${RED}Error: invalid package name: '${pkg}'${NC}" >&2; exit 1; }
    if ! [[ "$pkg" =~ ^[a-zA-Z0-9][a-zA-Z0-9.+\-]{0,127}$ ]]; then
        printf '%b\n' "${RED}Error: invalid package name: '${pkg}'${NC}" >&2
        exit 1
    fi
}

# --- Determine target Aptfile based on MACHINE_PROFILE ---
get_aptfile() {
    case "${MACHINE_PROFILE:-}" in
        rpi)             printf '%s' "${MANIFEST_DIR}/Aptfile_rpi" ;;
        ubuntu-desktop)  printf '%s' "${MANIFEST_DIR}/Aptfile_ubuntu_desktop" ;;
        ubuntu-server)   printf '%s' "${MANIFEST_DIR}/Aptfile_ubuntu_server" ;;
        debian)          printf '%s' "${MANIFEST_DIR}/Aptfile_debian" ;;
        *)               printf '' ;;
    esac
}

# --- Add package to manifest (idempotent) ---
add_to_manifest() {
    local manifest="$1"
    local pkg="$2"
    # Skip if already present (exact line match, ignoring comment lines)
    if grep -qxF "$pkg" "$manifest" 2>/dev/null; then
        printf '%b\n' "${YELLOW}${pkg} already in $(basename "$manifest")${NC}"
        return
    fi
    printf '%s\n' "$pkg" >> "$manifest"
    printf '%b\n' "${GREEN}Added '${pkg}' to $(basename "$manifest")${NC}"
}

# --- Remove package from manifest ---
remove_from_manifest() {
    local manifest="$1"
    local pkg="$2"
    local tmp
    tmp="$(mktemp)"
    # Keep all lines except exact match of package name (preserve comments/blanks)
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "$pkg" ]]; then
            continue
        fi
        printf '%s\n' "$line"
    done < "$manifest" > "$tmp"
    mv "$tmp" "$manifest"
    printf '%b\n' "${GREEN}Removed '${pkg}' from $(basename "$manifest")${NC}"
}

# --- Git sync ---
sync_to_git() {
    local manifest="$1"
    local action="$2"
    local pkg="$3"
    printf '\n%b\n' "${BLUE}Syncing with Git...${NC}"
    if ! git -C "$CHEZMOI_SOURCE_PATH" diff --quiet "$manifest" 2>/dev/null; then
        git -C "$CHEZMOI_SOURCE_PATH" add "$manifest"
        git -C "$CHEZMOI_SOURCE_PATH" commit -m "feat(aptw): ${action} ${pkg}"
        git -C "$CHEZMOI_SOURCE_PATH" push
        printf '%b\n' "${GREEN}Pushed to remote.${NC}"
    else
        printf '%b\n' "${YELLOW}No changes to sync.${NC}"
    fi
}

# --- Brew duplicate hint ---
check_brew_duplicate() {
    local pkg="$1"
    if command -v brew &>/dev/null && brew list "$pkg" &>/dev/null 2>&1; then
        printf '%b\n' "${YELLOW}Note: '${pkg}' is also installed via brew. Consider: brew uninstall ${pkg}${NC}"
    fi
}

# --- Help ---
show_help() {
    local aptfile
    aptfile="$(get_aptfile)"
    cat <<EOF
aptw — apt wrapper with Aptfile manifest sync

Usage:
  aptw install <pkg>    Install package and add to Aptfile
  aptw remove <pkg>     Remove package and remove from Aptfile
  aptw upgrade          Upgrade all packages (no manifest change)
  aptw <subcommand>     Passthrough to apt

Aptfile location: ${aptfile:-unknown (check MACHINE_PROFILE)}
MACHINE_PROFILE: ${MACHINE_PROFILE:-unset}
EOF
}

# --- Main ---
if [[ $# -eq 0 ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

SUBCOMMAND="$1"
shift

APTFILE="$(get_aptfile)"

case "$SUBCOMMAND" in
    install)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify a package name${NC}" >&2
            exit 1
        fi
        # Validate all package names before installing anything
        for pkg in "$@"; do
            validate_pkg "$pkg"
        done
        printf '%b\n' "${BLUE}Running: sudo apt-get install -y $*${NC}"
        sudo apt-get install -y "$@"
        for pkg in "$@"; do
            check_brew_duplicate "$pkg"
        done
        if [[ -n "$APTFILE" ]]; then
            for pkg in "$@"; do
                add_to_manifest "$APTFILE" "$pkg"
            done
            sync_to_git "$APTFILE" "install" "$*"
        else
            printf '%b\n' "${YELLOW}Warning: no Aptfile for profile '${MACHINE_PROFILE:-unset}' — skipping manifest sync${NC}"
        fi
        ;;
    remove|purge)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify a package name${NC}" >&2
            exit 1
        fi
        for pkg in "$@"; do
            validate_pkg "$pkg"
        done
        printf '%b\n' "${BLUE}Running: sudo apt-get ${SUBCOMMAND} -y $*${NC}"
        sudo apt-get "$SUBCOMMAND" -y "$@"
        if [[ -n "$APTFILE" ]]; then
            for pkg in "$@"; do
                remove_from_manifest "$APTFILE" "$pkg"
            done
            sync_to_git "$APTFILE" "remove" "$*"
        else
            printf '%b\n' "${YELLOW}Warning: no Aptfile for profile '${MACHINE_PROFILE:-unset}' — skipping manifest sync${NC}"
        fi
        ;;
    upgrade|update|autoremove|autoclean|clean|search|show|list|depends|rdepends)
        # Passthrough — no manifest change needed
        printf '%b\n' "${BLUE}Running: apt-get ${SUBCOMMAND} $*${NC}"
        case "$SUBCOMMAND" in
            search|show|list|depends|rdepends)
                apt "$SUBCOMMAND" "$@"
                ;;
            *)
                sudo apt-get "$SUBCOMMAND" "$@"
                ;;
        esac
        ;;
    *)
        # Unknown subcommand — full passthrough
        printf '%b\n' "${BLUE}Running: apt ${SUBCOMMAND} $*${NC}"
        apt "$SUBCOMMAND" "$@"
        ;;
esac
