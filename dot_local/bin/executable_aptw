#!/usr/bin/env bash
# aptw — apt wrapper that keeps Aptfile manifests in sync with chezmoi
# Usage: aptw <apt-subcommand> [args...]
#        aptw install foo    → installs + adds to host overlay Aptfile
#        aptw remove foo     → removes + removes from host overlay Aptfile
#        aptw dump           → recompute host overlay from installed − base − blacklist
#        aptw upgrade/search → passthrough
#
# Model:
#   Base file   (Aptfile_<profile>)  = curated shared base — NEVER modified by aptw
#   Host overlay (Aptfile_<hostname>) = machine-specific extras (delta)

set -euo pipefail

# --- Colors ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# --- Config ---
CHEZMOI_SOURCE_PATH="${CHEZMOI_SOURCE_PATH:-${HOME}/.local/share/chezmoi}"
MANIFEST_DIR="${CHEZMOI_SOURCE_PATH}/dot_private"

# --- Hostname (short, no domain) ---
HOSTNAME_SHORT="$(uname -n | cut -d. -f1)"

# --- Package name validation ---
validate_pkg() {
    local pkg="$1"
    [[ "$pkg" == */* ]] && { printf '%b\n' "${RED}Error: invalid package name: '${pkg}'${NC}" >&2; exit 1; }
    if ! [[ "$pkg" =~ ^[a-zA-Z0-9][a-zA-Z0-9.+\-]{0,127}$ ]]; then
        printf '%b\n' "${RED}Error: invalid package name: '${pkg}'${NC}" >&2
        exit 1
    fi
}

# --- Determine base Aptfile (read-only reference) ---
get_base_aptfile() {
    case "${MACHINE_PROFILE:-}" in
        rpi)             printf '%s' "${MANIFEST_DIR}/Aptfile_rpi" ;;
        ubuntu-desktop)  printf '%s' "${MANIFEST_DIR}/Aptfile_ubuntu_desktop" ;;
        ubuntu-server)   printf '%s' "${MANIFEST_DIR}/Aptfile_ubuntu_server" ;;
        debian)          printf '%s' "${MANIFEST_DIR}/Aptfile_debian" ;;
        *)               printf '' ;;
    esac
}

# --- Host overlay file ---
get_host_aptfile() {
    printf '%s' "${MANIFEST_DIR}/Aptfile_${HOSTNAME_SHORT}"
}

# --- Load base packages into a temp file for comm/grep ---
load_base_pkgs() {
    local base="$1"
    if [[ -f "$base" ]]; then
        grep -v '^\s*#' "$base" | grep -v '^\s*$' | sort
    fi
}

# --- Add package to manifest (idempotent) ---
add_to_manifest() {
    local manifest="$1"
    local pkg="$2"
    # Skip if already present (exact line match, ignoring comment lines)
    if grep -qxF "$pkg" "$manifest" 2>/dev/null; then
        printf '%b\n' "${YELLOW}${pkg} already in $(basename "$manifest")${NC}"
        return
    fi
    printf '%s\n' "$pkg" >> "$manifest"
    printf '%b\n' "${GREEN}Added '${pkg}' to $(basename "$manifest")${NC}"
}

# --- Remove package from manifest ---
remove_from_manifest() {
    local manifest="$1"
    local pkg="$2"
    local tmp
    tmp="$(mktemp)"
    # Keep all lines except exact match of package name (preserve comments/blanks)
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "$pkg" ]]; then
            continue
        fi
        printf '%s\n' "$line"
    done < "$manifest" > "$tmp"
    mv "$tmp" "$manifest"
    printf '%b\n' "${GREEN}Removed '${pkg}' from $(basename "$manifest")${NC}"
}

# --- Dump host overlay: installed − base ---
dump_host_overlay() {
    local base_file host_file
    base_file="$(get_base_aptfile)"
    host_file="$(get_host_aptfile)"

    printf '\n%b\n' "${YELLOW}Dumping host overlay: $(basename "$host_file")${NC}"

    # Collect manually-installed packages
    local installed_tmp base_tmp
    installed_tmp="$(mktemp)"
    base_tmp="$(mktemp)"

    apt-mark showmanual 2>/dev/null | sort > "$installed_tmp"

    if [[ -n "$base_file" && -f "$base_file" ]]; then
        load_base_pkgs "$base_file" > "$base_tmp"
    else
        : > "$base_tmp"
    fi

    # Delta: installed − base (comm -23 requires both inputs sorted)
    local delta_pkgs
    delta_pkgs="$(comm -23 "$installed_tmp" "$base_tmp")"

    rm -f "$installed_tmp" "$base_tmp"

    {
        printf '# Host overlay for %s — extras beyond the shared base.\n' "$HOSTNAME_SHORT"
        printf '# Managed by aptw. Do not edit manually.\n'
        printf '%s\n' "$delta_pkgs"
    } > "$host_file"

    local count
    count="$(printf '%s\n' "$delta_pkgs" | grep -c '\S' || true)"
    printf '%b\n' "${GREEN}Host overlay written: ${count} entries${NC}"
}

# --- Git sync ---
sync_to_git() {
    local manifest="$1"
    local action="$2"
    local pkg="$3"
    printf '\n%b\n' "${BLUE}Syncing with Git...${NC}"
    if ! git -C "$CHEZMOI_SOURCE_PATH" diff --quiet "$manifest" 2>/dev/null; then
        git -C "$CHEZMOI_SOURCE_PATH" add "$manifest"
        git -C "$CHEZMOI_SOURCE_PATH" commit -m "feat(aptw): ${action} ${pkg}"
        git -C "$CHEZMOI_SOURCE_PATH" pull --rebase origin main 2>/dev/null || true
        git -C "$CHEZMOI_SOURCE_PATH" push
        printf '%b\n' "${GREEN}Pushed to remote.${NC}"
    else
        printf '%b\n' "${YELLOW}No changes to sync.${NC}"
    fi
}

# --- Brew duplicate hint ---
check_brew_duplicate() {
    local pkg="$1"
    if command -v brew &>/dev/null && brew list "$pkg" &>/dev/null 2>&1; then
        printf '%b\n' "${YELLOW}Note: '${pkg}' is also installed via brew. Consider: brew uninstall ${pkg}${NC}"
    fi
}

# --- Help ---
show_help() {
    local base_file host_file
    base_file="$(get_base_aptfile)"
    host_file="$(get_host_aptfile)"
    cat <<EOF
aptw — apt wrapper with per-host overlay Aptfile sync

Usage:
  aptw install <pkg>    Install package and add to host overlay
  aptw remove <pkg>     Remove package and remove from host overlay
  aptw dump             Recompute host overlay from: installed − base
  aptw upgrade          Upgrade all packages (no manifest change)
  aptw <subcommand>     Passthrough to apt

Base file (read-only): ${base_file:-unknown (check MACHINE_PROFILE)}
Host overlay:          ${host_file}
Hostname:              ${HOSTNAME_SHORT}
MACHINE_PROFILE:       ${MACHINE_PROFILE:-unset}
EOF
}

# --- Main ---
if [[ $# -eq 0 ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
    show_help
    exit 0
fi

SUBCOMMAND="$1"
shift

HOST_APTFILE="$(get_host_aptfile)"

case "$SUBCOMMAND" in
    install)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify a package name${NC}" >&2
            exit 1
        fi
        # Validate all package names before installing anything
        for pkg in "$@"; do
            validate_pkg "$pkg"
        done
        printf '%b\n' "${BLUE}Running: sudo apt-get install -y $*${NC}"
        sudo apt-get install -y "$@"
        for pkg in "$@"; do
            check_brew_duplicate "$pkg"
        done
        # Add to host overlay (not base — base is read-only)
        for pkg in "$@"; do
            add_to_manifest "$HOST_APTFILE" "$pkg"
        done
        sync_to_git "$HOST_APTFILE" "install" "$*"
        ;;
    remove|purge)
        if [[ $# -eq 0 ]]; then
            printf '%b\n' "${RED}Error: specify a package name${NC}" >&2
            exit 1
        fi
        for pkg in "$@"; do
            validate_pkg "$pkg"
        done
        printf '%b\n' "${BLUE}Running: sudo apt-get ${SUBCOMMAND} -y $*${NC}"
        sudo apt-get "$SUBCOMMAND" -y "$@"
        # Remove from host overlay
        for pkg in "$@"; do
            remove_from_manifest "$HOST_APTFILE" "$pkg"
        done
        sync_to_git "$HOST_APTFILE" "remove" "$*"
        ;;
    dump)
        dump_host_overlay
        sync_to_git "$HOST_APTFILE" "dump" "host-overlay"
        ;;
    upgrade|update|autoremove|autoclean|clean|search|show|list|depends|rdepends)
        # Passthrough — no manifest change needed
        printf '%b\n' "${BLUE}Running: apt-get ${SUBCOMMAND} $*${NC}"
        case "$SUBCOMMAND" in
            search|show|list|depends|rdepends)
                apt "$SUBCOMMAND" "$@"
                ;;
            *)
                sudo apt-get "$SUBCOMMAND" "$@"
                ;;
        esac
        ;;
    *)
        # Unknown subcommand — full passthrough
        printf '%b\n' "${BLUE}Running: apt ${SUBCOMMAND} $*${NC}"
        apt "$SUBCOMMAND" "$@"
        ;;
esac
