#!/usr/bin/env bash
#
# install-ai — Install the mandatory AI CLIs, one official one-liner each.
#
# Mandatory set: claude, copilot-cli, codex, grok, cursor-agent, pi (pi.dev).
# Idempotent: anything already present is left alone (update-ai handles
# upgrades). Deliberately NOT in the Brewfiles: each of these ships its own
# installer/self-updater, and a brew/npm copy fights it (pi ended up installed
# twice, once per channel, before this script existed).
#
# Usage:
#   install-ai               install whatever is missing
#   install-ai --status      presence + version of each CLI
#   install-ai --only <cli>  install a single one (claude|copilot|codex|grok|cursor|pi)
#   install-ai --dry-run     print without executing
#
set -uo pipefail

DRY_RUN=0
ONLY=""
ACTION="install"

c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[install-ai]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[install-ai]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[install-ai]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[install-ai]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

usage() { sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status)  ACTION="status" ;;
    --only)    ONLY="${2:?cli missing}"; shift ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *)         die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

run_installer() {
  # $1 label, $2 shell command (one-liner, shown verbatim in --dry-run)
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s %s\n' "$c_y" "$c_0" "$2"
    return 0
  fi
  bash -c "$2" || { warn "$1: installer failed"; return 1; }
}

# --- Per-CLI presence probes ---------------------------------------------------
# grok: NEVER probe `agent` on PATH — that name is owned by cursor-agent (and
# has flip-flopped between the two; it caused the cursor-worker crash-loop).
# The Grok CLI home is authoritative.
has_claude()  { command -v claude       >/dev/null 2>&1; }
has_copilot() { command -v copilot-cli  >/dev/null 2>&1 || command -v copilot >/dev/null 2>&1; }
has_codex()   { command -v codex        >/dev/null 2>&1; }
has_grok()    { [[ -x "$HOME/.grok/bin/agent" ]]; }
has_cursor()  { command -v cursor-agent >/dev/null 2>&1 && cursor-agent worker --help >/dev/null 2>&1; }
has_pi()      { command -v pi           >/dev/null 2>&1; }

ver() { "$@" 2>/dev/null | head -1 | tr -d '\r'; }

do_status() {
  printf '%sMandatory AI CLIs%s\n' "$c_b" "$c_0"
  printf '  %-13s %s\n' "claude"       "$(has_claude  && ver claude --version            || echo missing)"
  printf '  %-13s %s\n' "copilot-cli"  "$(has_copilot && echo present                    || echo missing)"
  printf '  %-13s %s\n' "codex"        "$(has_codex   && ver codex --version             || echo missing)"
  printf '  %-13s %s\n' "grok"         "$(has_grok    && ver "$HOME/.grok/bin/agent" --version || echo missing)"
  printf '  %-13s %s\n' "cursor-agent" "$(has_cursor  && ver cursor-agent --version      || echo missing)"
  printf '  %-13s %s\n' "pi"           "$(has_pi      && ver pi --version                || echo missing)"
}

[[ "$ACTION" == "status" ]] && { do_status; exit 0; }

want() { [[ -z "$ONLY" || "$ONLY" == "$1" ]]; }
missing=0; installed=0

step() {
  # $1 key, $2 label, $3 has_fn, $4 one-liner
  want "$1" || return 0
  if "$3"; then
    log "$2: already installed — skipping (update-ai upgrades it)"
    return 0
  fi
  log "$2: installing…"
  if run_installer "$2" "$4"; then
    hash -r
    if "$3" || [[ "$DRY_RUN" -eq 1 ]]; then ok "$2 installed."; installed=$((installed+1)); return 0; fi
    warn "$2: installer succeeded but the binary is still not found (PATH?)"
  fi
  missing=$((missing+1))
}

step claude  "Claude Code"  has_claude  'curl -fsSL https://claude.ai/install.sh | bash'
step copilot "Copilot CLI"  has_copilot 'curl -fsSL https://gh.io/copilot-install | bash'
step codex   "Codex"        has_codex   'npm install -g @openai/codex'
step grok    "Grok CLI"     has_grok    'curl -fsSL https://x.ai/cli/install.sh | bash'
step cursor  "cursor-agent" has_cursor  'curl -fsS https://cursor.com/install | bash'
step pi      "pi (pi.dev)"  has_pi      'curl -fsSL https://pi.dev/install.sh | bash'

echo
if [[ "$missing" -gt 0 ]]; then
  warn "Done with $missing failure(s) — see above."
  exit 1
fi
ok "Done ($installed newly installed)."
[[ "$DRY_RUN" -eq 1 ]] || { echo; do_status; }
