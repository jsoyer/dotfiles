#!/usr/bin/env bash
#
# install-ai — Install the mandatory AI CLIs, one official one-liner each.
#
# Mandatory set: claude, copilot-cli, codex, grok, cursor-agent, pi (pi.dev),
# omp (omp.sh). Idempotent: anything already present is left alone (update-ai
# handles upgrades). Deliberately NOT in the Brewfiles: each of these ships
# its own installer/self-updater, and a brew/npm copy fights it (pi ended up
# installed twice, once per channel, before this script existed). omp is a
# seventh CLI, not a replacement for pi — different binary, different product.
#
# Usage:
#   install-ai               install whatever is missing
#   install-ai --status      presence + version of each CLI
#   install-ai --only <cli>  install a single one (claude|copilot|codex|grok|cursor|pi|omp)
#   install-ai --dry-run     print without executing
#
set -uo pipefail

DRY_RUN=0
ONLY=""
ACTION="install"

c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[install-ai]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[install-ai]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[install-ai]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[install-ai]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

usage() { sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status)  ACTION="status" ;;
    --only)    ONLY="${2:?cli missing}"; shift ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *)         die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

run_installer() {
  # $1 label, $2 shell command (one-liner, shown verbatim in --dry-run)
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s %s\n' "$c_y" "$c_0" "$2"
    return 0
  fi
  bash -c "$2" || { warn "$1: installer failed"; return 1; }
}

# --- Per-CLI presence probes ---------------------------------------------------
# grok: NEVER probe `agent` on PATH — that name is owned by cursor-agent (and
# has flip-flopped between the two; it caused the cursor-worker crash-loop).
# The Grok CLI home is authoritative.
has_claude()  { command -v claude       >/dev/null 2>&1; }
has_copilot() { command -v copilot-cli  >/dev/null 2>&1 || command -v copilot >/dev/null 2>&1; }
# codex must be the official standalone (installer drops it in ~/.local/bin).
# An npm copy (the old Brewfile channel) counts as "missing" so the install
# step runs after migrate_codex clears it.
has_codex() {
  local tgt
  command -v codex >/dev/null 2>&1 || return 1
  tgt="$(readlink -f "$(command -v codex)" 2>/dev/null || true)"
  [[ "$tgt" != *"node_modules/@openai/codex"* ]]
}

migrate_codex() {
  if npm ls -g @openai/codex >/dev/null 2>&1; then
    log "codex: npm copy (old Brewfile channel) found — uninstalling before migrating…"
    [[ "$DRY_RUN" -eq 1 ]] || npm uninstall -g @openai/codex >/dev/null 2>&1 || true
  fi
}
has_grok()    { [[ -x "$HOME/.grok/bin/agent" ]]; }
has_cursor()  { command -v cursor-agent >/dev/null 2>&1 && cursor-agent worker --help >/dev/null 2>&1; }
# pi must be the CURRENT npm scope (@earendil-works). The Brewfiles used to
# install the old @mariozechner scope; its bin link occupies ~/.npm-global/bin/pi
# and makes the official installer fail with EEXIST. An old-scope pi counts as
# "missing" so the install step runs (after migrate_pi clears the way).
has_pi() {
  local tgt bp
  command -v pi >/dev/null 2>&1 || return 1
  tgt="$(readlink -f "$(command -v pi)" 2>/dev/null || true)"
  [[ "$tgt" == *"@mariozechner/pi-coding-agent"* ]] && return 1
  # A pi living under the brew prefix is a Brewfile leftover, not the official
  # install — it shadows or blocks the pi.dev installer. Field-verified on
  # diabolo: `rm -f /home/linuxbrew/.linuxbrew/bin/pi` was the actual fix.
  bp="$(brew --prefix 2>/dev/null || true)"
  [[ -n "$bp" && "$tgt" == "$bp"/* ]] && return 1
  return 0
}

# Clear the old scope and any orphaned bin link before the pi.dev installer runs.
migrate_pi() {
  if npm ls -g @mariozechner/pi-coding-agent >/dev/null 2>&1; then
    log "pi: old npm scope (@mariozechner) found — uninstalling before migrating…"
    [[ "$DRY_RUN" -eq 1 ]] || npm uninstall -g @mariozechner/pi-coding-agent >/dev/null 2>&1 || true
  fi
  local bin="${HOME}/.npm-global/bin/pi"
  if [[ -e "$bin" || -L "$bin" ]]; then
    local tgt; tgt="$(readlink -f "$bin" 2>/dev/null || true)"
    if [[ -z "$tgt" || ! -e "$tgt" || "$tgt" == *"@mariozechner"* ]]; then
      log "pi: removing stale bin link ${bin} (would EEXIST the installer)"
      [[ "$DRY_RUN" -eq 1 ]] || rm -f "$bin"
    fi
  fi
  # Brewfile-era copy under the brew prefix (installed by brew's npm): its bin
  # link blocks or shadows the official install. Field fix from diabolo.
  local bp; bp="$(brew --prefix 2>/dev/null || true)"
  if [[ -n "$bp" && ( -e "$bp/bin/pi" || -L "$bp/bin/pi" ) ]]; then
    log "pi: removing Brewfile-era copy ${bp}/bin/pi"
    [[ "$DRY_RUN" -eq 1 ]] || rm -f "$bp/bin/pi"
  fi
}

# omp (omp.sh / can1357/oh-my-pi). Binary is `omp`, never `pi` — the npm
# package is @oh-my-pi/pi-coding-agent for historical reasons only.
# A Homebrew copy (can1357/tap/omp) counts as missing so the official
# installer runs after migrate_omp clears the brew prefix.
has_omp() {
  local tgt bp
  command -v omp >/dev/null 2>&1 || return 1
  tgt="$(readlink -f "$(command -v omp)" 2>/dev/null || true)"
  bp="$(brew --prefix 2>/dev/null || true)"
  [[ -n "$bp" && "$tgt" == "$bp"/* ]] && return 1
  return 0
}

migrate_omp() {
  if ! command -v brew >/dev/null 2>&1; then
    return 0
  fi
  if brew list omp >/dev/null 2>&1 || brew list can1357/tap/omp >/dev/null 2>&1; then
    log "omp: Homebrew copy found — uninstalling before the official installer…"
    if [[ "$DRY_RUN" -ne 1 ]]; then
      brew uninstall --force omp >/dev/null 2>&1 \
        || brew uninstall --force can1357/tap/omp >/dev/null 2>&1 \
        || true
    fi
  fi
  local bp; bp="$(brew --prefix 2>/dev/null || true)"
  if [[ -n "$bp" && ( -e "$bp/bin/omp" || -L "$bp/bin/omp" ) ]]; then
    log "omp: removing Brewfile-era copy ${bp}/bin/omp"
    [[ "$DRY_RUN" -eq 1 ]] || rm -f "$bp/bin/omp"
  fi
}

ver() { "$@" 2>/dev/null | head -1 | tr -d '\r'; }

do_status() {
  printf '%sMandatory AI CLIs%s\n' "$c_b" "$c_0"
  printf '  %-13s %s\n' "claude"       "$(has_claude  && ver claude --version            || echo missing)"
  printf '  %-13s %s\n' "copilot-cli"  "$(has_copilot && echo present                    || echo missing)"
  printf '  %-13s %s\n' "codex"        "$(has_codex   && ver codex --version             || echo missing)"
  printf '  %-13s %s\n' "grok"         "$(has_grok    && ver "$HOME/.grok/bin/agent" --version || echo missing)"
  printf '  %-13s %s\n' "cursor-agent" "$(has_cursor  && ver cursor-agent --version      || echo missing)"
  printf '  %-13s %s\n' "pi"           "$(has_pi      && ver pi --version                || echo missing)"
  printf '  %-13s %s\n' "omp"          "$(has_omp     && ver omp --version               || echo missing)"
}

[[ "$ACTION" == "status" ]] && { do_status; exit 0; }

want() { [[ -z "$ONLY" || "$ONLY" == "$1" ]]; }
missing=0; installed=0

step() {
  # $1 key, $2 label, $3 has_fn, $4 one-liner
  want "$1" || return 0
  if "$3"; then
    log "$2: already installed — skipping (update-ai upgrades it)"
    return 0
  fi
  log "$2: installing…"
  if run_installer "$2" "$4"; then
    hash -r
    if "$3" || [[ "$DRY_RUN" -eq 1 ]]; then ok "$2 installed."; installed=$((installed+1)); return 0; fi
    warn "$2: installer succeeded but the binary is still not found (PATH?)"
  fi
  missing=$((missing+1))
}

step claude  "Claude Code"  has_claude  'curl -fsSL https://claude.ai/install.sh | bash'
step copilot "Copilot CLI"  has_copilot 'curl -fsSL https://gh.io/copilot-install | bash'
want codex && ! has_codex && migrate_codex
step codex   "Codex"        has_codex   'curl -fsSL https://chatgpt.com/codex/install.sh | sh'
step grok    "Grok CLI"     has_grok    'curl -fsSL https://x.ai/cli/install.sh | bash'
step cursor  "cursor-agent" has_cursor  'curl -fsS https://cursor.com/install | bash'
want pi && ! has_pi && migrate_pi
step pi      "pi (pi.dev)"  has_pi      'curl -fsSL https://pi.dev/install.sh | bash'
want omp && ! has_omp && migrate_omp
step omp     "omp (omp.sh)" has_omp     'curl -fsSL https://omp.sh/install | sh'

echo
if [[ "$missing" -gt 0 ]]; then
  warn "Done with $missing failure(s) — see above."
  exit 1
fi
ok "Done ($installed newly installed)."

# A freshly installed CLI has no Moshi agent hooks yet: refresh them so the
# mobile app sees the new agent without waiting for the next moshi update.
if [[ "$installed" -gt 0 && "$DRY_RUN" -eq 0 ]] && command -v moshi-hook >/dev/null 2>&1; then
  log "Refreshing Moshi agent hooks for the new CLI(s)…"
  moshi-hook install 2>/dev/null || warn "moshi-hook install failed — run it by hand."
fi
[[ "$DRY_RUN" -eq 1 ]] || { echo; do_status; }
