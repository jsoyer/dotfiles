#!/usr/bin/env bash
#
# update-paseo — Update the Paseo CLI, restart the daemon when the version moved,
# smoke-test it with paseo-health, and ROLL BACK to the previous version when the
# smoke test fails (same contract as agents-update).
#
# Paseo has no `update` command: the CLI is the npm package @getpaseo/cli,
# installed with --prefix ~/.local by paseo-setup.
#
# Run by paseo-update.timer (user scope, see paseo-setup --update-at), or by hand.
#
# Usage:
#   update-paseo               update to latest, restart if changed, smoke test
#   update-paseo --no-restart  install only, leave the running daemon alone
#   update-paseo --no-smoke    skip paseo-health (and therefore the rollback)
#
set -euo pipefail

PKG="@getpaseo/cli"
PREFIX="${PASEO_NPM_PREFIX:-$HOME/.local}"
SERVICE="paseo.service"
RESTART=1
SMOKE=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-restart) RESTART=0 ;;
    --no-smoke)   SMOKE=0 ;;
    -h|--help)    sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; exit 0 ;;
    *)            echo "update-paseo: unknown option: $1 (see --help)" >&2; exit 2 ;;
  esac
  shift
done

log()  { printf '\033[1;34m[update-paseo]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[update-paseo]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[update-paseo]\033[0m %s\n' "$*" >&2; exit 1; }

# systemctl --user needs XDG_RUNTIME_DIR (absent outside a login session).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

[[ "$(id -u)" -ne 0 ]] || die "Run as your user, not root."
command -v npm >/dev/null 2>&1 || die "npm not found — run: paseo-setup"
command -v paseo >/dev/null 2>&1 || die "paseo not found — run: paseo-setup"

version() { paseo --version 2>/dev/null | head -1 | tr -d '\r' | sed 's/^v//' || true; }

have_service=0
systemctl --user cat "$SERVICE" >/dev/null 2>&1 && have_service=1

restart_daemon() {
  [[ "$RESTART" -eq 1 && "$have_service" -eq 1 ]] || return 0
  log "Restarting ${SERVICE}..."
  systemctl --user restart "$SERVICE" || warn "Unclean restart (the smoke test decides)."
}

before="$(version)"
log "Installed version: ${before:-unknown}"

# Network outage: not fatal (binary untouched), the next timer run catches up.
if ! npm install -g --prefix "$PREFIX" "${PKG}@latest"; then
  warn "npm install failed — version unchanged (${before:-unknown})."
  exit 0
fi

hash -r
after="$(version)"
[[ -n "$after" ]] || die "The updated paseo no longer answers --version."
log "Version: ${before:-unknown} -> ${after}"

if [[ "$after" == "$before" ]]; then
  log "Already up to date — daemon left alone."
  exit 0
fi

restart_daemon

if [[ "$SMOKE" -eq 1 && "$RESTART" -eq 1 && "$have_service" -eq 1 ]]; then
  sleep 5
  if command -v paseo-health >/dev/null 2>&1 && paseo-health; then
    log "Smoke test OK."
  else
    warn "Smoke test FAILED on ${after}."
    if [[ -n "$before" ]]; then
      warn "Rolling back to ${before}..."
      npm install -g --prefix "$PREFIX" "${PKG}@${before}" || die "Rollback install failed — fix by hand: npm install -g --prefix ${PREFIX} ${PKG}@${before}"
      hash -r
      restart_daemon
      die "Rolled back ${after} -> ${before}. See: journalctl --user -u ${SERVICE} -e"
    fi
    die "No previous version known — nothing to roll back to."
  fi
fi
log "Paseo is up to date (${after})."
