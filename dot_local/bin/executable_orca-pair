#!/usr/bin/env bash
#
# orca-pair — Pair a new client (phone, tablet, desktop Orca) with the headless
# Orca server running on this machine, WITHOUT restarting it.
#
# orca-serve runs with --no-pairing (orca-setup), so it never writes a pairing
# link to the journal. This wrapper asks the running server for an offer through
# `orca-ide pair`, the same call the desktop app makes: nothing restarts and the
# clients already paired stay connected.
#
# It must run as the user that owns the service (its ~/.config/orca profile is
# where the offer is registered). Run as root, it re-executes itself as that
# user, read from orca-serve.service.
#
# Usage:
#   orca-pair                  QR code + link for Orca Mobile (iOS / Android)
#   orca-pair --desktop        access link for Orca desktop (Win/macOS/Linux):
#                              Settings → Remote Orca Servers → Add Server
#   orca-pair --rotate         retire the unused offer and print a new one
#                              (do it if a link leaked or went to the wrong device)
#   orca-pair --address <ip>   address the client dials (default: Tailscale IPv4)
#   orca-pair --status         server state + how to revoke a client
#
# A link grants access to this server: treat it like a password, send it over a
# private channel, and pair over the tailnet (mobile pairing is LAN/tailnet
# only). Revoking a client is done from a paired app: Settings → Remote Orca
# Servers → Shared Server Access.
#
set -euo pipefail

SERVICE="orca-serve.service"
APPIMAGE="${ORCA_APPIMAGE:-/opt/orca/orca-linux.AppImage}"
PORT="${ORCA_PORT:-6768}"

c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[orca-pair]%s %s\n' "$c_b" "$c_0" "$*" >&2; }
ok()   { printf '%s[orca-pair]%s %s\n' "$c_g" "$c_0" "$*" >&2; }
warn() { printf '%s[orca-pair]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[orca-pair]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

MODE="mobile"
ADDRESS=""
ROTATE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --desktop) MODE="desktop" ;;
    --mobile)  MODE="mobile" ;;
    --status)  MODE="status" ;;
    --rotate)  ROTATE=1 ;;
    --address) ADDRESS="${2:?address missing}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *)         die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

[[ -x "$APPIMAGE" ]] || die "Orca not installed ($APPIMAGE) — run orca-setup first."

# --- Run as the service user --------------------------------------------------
SVC_USER="$(systemctl show -p User --value "$SERVICE" 2>/dev/null || true)"
[[ -n "$SVC_USER" ]] || die "${SERVICE} not found — run orca-setup first."
if [[ "$(id -un)" != "$SVC_USER" ]]; then
  [[ "$(id -u)" -eq 0 ]] || die "Run as ${SVC_USER} (the owner of ${SERVICE}), not $(id -un)."
  self="$(readlink -f -- "$0")"
  log "Re-running as ${SVC_USER} (owner of the Orca profile)…"
  exec runuser -u "$SVC_USER" -- "$self" "$@"
fi

# `orca-ide` is Electron: it needs an X display even for CLI calls. Reuse
# xvfb-run when there is no display (SSH session, root shell, cron).
orca() {
  if [[ -n "${DISPLAY:-}" ]]; then
    "$APPIMAGE" "$@"
  else
    xvfb-run --auto-servernum "$APPIMAGE" "$@"
  fi
}

# Chromium noise on a headless host, never useful here.
quiet() { grep -vE 'Gtk-|dbus|libva|vaInitialize|Fontconfig|GPU|gpu_|ALSA' || true; }

server_up() {
  systemctl is-active --quiet "$SERVICE" \
    && ss -ltn "sport = :${PORT}" 2>/dev/null | grep -q LISTEN
}

if [[ "$MODE" == "status" ]]; then
  printf '%sOrca server%s\n' "$c_b" "$c_0"
  printf '  Service : %s\n' "$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
  if server_up; then printf '  Port %s : listening\n' "$PORT"; else printf '  Port %s : %snot listening%s\n' "$PORT" "$c_y" "$c_0"; fi
  orca status 2>&1 | quiet | sed 's/^/  /'
  cat <<EOF

  Revoke a client: in a paired Orca app, Settings → Remote Orca Servers →
  Shared Server Access → revoke. Revoking also invalidates links made from
  terminals that client opened.
EOF
  exit 0
fi

server_up || die "Orca is not serving on ${PORT} — check: systemctl status ${SERVICE}"

# --- Address the client dials -------------------------------------------------
if [[ -z "$ADDRESS" ]]; then
  if command -v tailscale >/dev/null 2>&1; then
    ADDRESS="$(tailscale ip -4 2>/dev/null | head -1 || true)"
  fi
  [[ -n "$ADDRESS" ]] || die "No Tailscale address — pass --address <ip> (the client must reach it)."
fi

args=(pair --address "$ADDRESS")
[[ "$MODE" == "mobile" ]] && args+=(--mobile)
[[ "$ROTATE" -eq 1 ]] && args+=(--rotate)

log "Asking the running server for a ${MODE} offer (dial address ${ADDRESS})…"
out="$(orca "${args[@]}" --json 2>/dev/null | quiet)" || die "orca-ide pair failed: $(orca "${args[@]}" 2>&1 | quiet | tail -3)"

# Pull the link out of the JSON whatever the exact key is called.
link="$(printf '%s' "$out" | grep -oE 'orca://pair\?code=[A-Za-z0-9._~%=-]+' | head -1 || true)"
weburl="$(printf '%s' "$out" | grep -oE 'https?://[^"]+web-index\.html#pairing=[^"]+' | head -1 || true)"
[[ -n "$link" ]] || { printf '%s\n' "$out"; die "No pairing link in the server's answer."; }

echo
if [[ "$MODE" == "mobile" ]]; then
  printf '%s1.%s Phone on the same tailnet (Tailscale app connected).\n' "$c_b" "$c_0"
  printf '%s2.%s Orca Mobile → Pair → scan this code:\n\n' "$c_b" "$c_0"
else
  printf '%s1.%s Orca desktop → Settings → Remote Orca Servers → Add Server.\n' "$c_b" "$c_0"
  printf '%s2.%s Paste the link below (or scan it from a phone to copy it):\n\n' "$c_b" "$c_0"
fi
if command -v qrencode >/dev/null 2>&1; then
  qrencode -t ansiutf8 -m 1 "$link"
else
  warn "qrencode not installed — link only (apt install qrencode)."
fi
printf '\n%sLink%s (treat it like a password):\n%s\n' "$c_b" "$c_0" "$link"
if [[ -n "$weburl" && "$MODE" == "desktop" ]]; then
  printf '\n%sBrowser client%s:\n%s\n' "$c_b" "$c_0" "$weburl"
fi
echo
ok "Offer ready. An unused offer stays valid until --rotate; already paired clients are unaffected."
