#!/usr/bin/env bash
#
# update-orca — Update Orca (AppImage) in /opt/orca (headless server)
#
# Flow: download the latest GitHub release → validate → stop the systemd service
# → replace the AppImage atomically → restart the service. Keeps a backup for
# rollback and touches nothing if already up to date.
#
# Installed by orca-setup into /usr/local/bin/update-orca (SELinux bin_t
# context: systemd refuses to execute a script under /home, labelled home_t).
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
REPO="${ORCA_REPO:-stablyai/orca}"
DEST_DIR="${ORCA_DEST_DIR:-/opt/orca}"
APP_NAME="orca-linux.AppImage"          # local name, independent of the asset
DEST="${DEST_DIR}/${APP_NAME}"
BACKUP="${DEST}.bak"
SERVICE="orca-serve.service"

# Expected port of the headless websocket runtime. WARNING: recent Orca versions
# IGNORE `serve --port`: the real port is read from and persisted to
# mobile-ws-fallback-port.json in the userData profile. After an update a new
# version may rewrite an ephemeral port there (e.g. 37579) and the headless
# server silently moves to the wrong port. So we force that file to EXPECTED_PORT.
EXPECTED_PORT="${ORCA_PORT:-6768}"

# --- Asset selection by architecture ------------------------------------------
# WARNING: the release publishes two AppImages. Without this check an arm64 RPi
# silently received the x86_64 binary on the first timer run.
case "$(uname -m)" in
  x86_64|amd64)  ASSET="orca-linux.AppImage" ;;
  aarch64|arm64) ASSET="orca-linux-arm64.AppImage" ;;
  *)             echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac
URL="https://github.com/${REPO}/releases/latest/download/${ASSET}"

# --- Helpers ------------------------------------------------------------------
log()  { printf '\033[1;34m[orca-update]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[orca-update]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[orca-update]\033[0m %s\n' "$*" >&2; exit 1; }

# User/HOME of the service (the userData profile is theirs, not root's).
SVC_USER="$(systemctl show -p User --value "$SERVICE" 2>/dev/null || true)"
[[ -n "$SVC_USER" ]] || SVC_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
SVC_HOME="$(getent passwd "$SVC_USER" 2>/dev/null | cut -d: -f6)"
FALLBACK_PORT_FILE="${SVC_HOME:-/home/$SVC_USER}/.config/orca/mobile-ws-fallback-port.json"

# Force the profile's port file to EXPECTED_PORT (preserving ownership — the
# script runs as root but the file belongs to the user).
enforce_port_file() {
  local dir; dir="$(dirname "$FALLBACK_PORT_FILE")"
  [[ -d "$dir" ]] || { warn "Orca profile not found ($dir) — port not forced."; return 0; }
  printf '{"port":%s}' "$EXPECTED_PORT" > "$FALLBACK_PORT_FILE"
  chown "$SVC_USER":"$SVC_USER" "$FALLBACK_PORT_FILE" 2>/dev/null || true
  chmod 644 "$FALLBACK_PORT_FILE" 2>/dev/null || true
  log "Port forced to ${EXPECTED_PORT} in $(basename "$FALLBACK_PORT_FILE")."
}

# True if something is listening on EXPECTED_PORT.
port_listening() { ss -ltn 2>/dev/null | grep -qE ":${EXPECTED_PORT}\b"; }

# Extract an Orca AppImage version WITHOUT running it: read `X-AppImage-Version`
# from the embedded .desktop (internal extraction, no FUSE required). Returns
# "missing" if the file does not exist, "unknown" if the version is unreadable.
appimage_version() {
  local img="$1" tmpd ver
  [[ -f "$img" ]] || { echo "missing"; return 0; }
  tmpd="$(mktemp -d)" || { echo "unknown"; return 0; }
  ( cd "$tmpd" && "$img" --appimage-extract '*.desktop' >/dev/null 2>&1 ) || true
  ver="$(grep -hm1 '^X-AppImage-Version=' "$tmpd"/squashfs-root/*.desktop 2>/dev/null | cut -d= -f2)"
  rm -rf "$tmpd"
  echo "${ver:-unknown}"
}

# Do NOT call `sudo update-orca`: sudo's secure_path does not include
# ~/.local/bin. We elevate ourselves with the resolved absolute path.
if [[ "$(id -u)" -ne 0 ]]; then
  self="$(readlink -f -- "$0" 2>/dev/null || true)"
  [[ -n "$self" && -r "$self" ]] || die "Cannot resolve the script path ($0) for elevation."
  log "Root required (writing /opt + systemd) — elevating through sudo…"
  exec sudo -- "$self" "$@"
fi

command -v curl >/dev/null 2>&1 || die "curl is required but not found."

have_systemd=0
if command -v systemctl >/dev/null 2>&1 && systemctl cat "$SERVICE" >/dev/null 2>&1; then
  have_systemd=1
fi

# --- Download -----------------------------------------------------------------
mkdir -p "$DEST_DIR"

TMP="$(mktemp "${DEST_DIR}/.${APP_NAME}.XXXXXX")"
trap 'rm -f "$TMP"' EXIT   # clean up the temporary file on failure

log "Downloading the latest Orca AppImage (${ASSET})…"
curl -fL --retry 3 --retry-delay 2 --progress-bar -o "$TMP" "$URL" \
  || die "Download failed from $URL"

# --- Validation ---------------------------------------------------------------
# A valid AppImage starts with an ELF header (0x7F 'E' 'L' 'F').
if [[ "$(head -c 4 "$TMP" | od -An -tx1 | tr -d ' ')" != "7f454c46" ]]; then
  die "The downloaded file is not a valid ELF executable (broken release?)."
fi
SIZE="$(stat -c%s "$TMP")"
[[ "$SIZE" -gt 1000000 ]] || die "Suspiciously small file (${SIZE} bytes)."
log "Download OK ($(numfmt --to=iec "$SIZE" 2>/dev/null || echo "${SIZE}B"))."

# --- Versions (read without launching the app) --------------------------------
CUR_VER="$(appimage_version "$DEST")"   # currently installed version
NEW_VER="$(appimage_version "$TMP")"    # version just downloaded
log "Installed version: ${CUR_VER}  →  downloaded version: ${NEW_VER}"

# Already up to date → do not disturb the running service.
if [[ -f "$DEST" ]] && cmp -s "$TMP" "$DEST"; then
  log "Already up to date (${CUR_VER}) — service left alone, nothing changed."
  exit 0
fi

# --- Stop the service ---------------------------------------------------------
was_active=0
if [[ "$have_systemd" -eq 1 ]]; then
  if systemctl is-active --quiet "$SERVICE"; then
    was_active=1
    log "Stopping ${SERVICE}…"
    # The stop can be slow (Electron handles SIGINT poorly); systemd applies its
    # TimeoutStopSec then force-kills — we do not fail on that.
    systemctl stop "$SERVICE" || warn "Unclean stop of ${SERVICE} (continuing)."
  else
    log "${SERVICE} is not active (state: $(systemctl is-active "$SERVICE" 2>/dev/null || echo unknown))."
  fi
fi

# --- Atomic install -----------------------------------------------------------
chmod 755 "$TMP"
if [[ -f "$DEST" ]]; then
  cp -f "$DEST" "$BACKUP"
  log "Previous version backed up → ${BACKUP}"
fi
mv -f "$TMP" "$DEST"      # atomic replacement (same filesystem)
trap - EXIT
log "AppImage replaced (${CUR_VER} → ${NEW_VER}): ${DEST}"

# --- Restart the service ------------------------------------------------------
if [[ "$have_systemd" -eq 1 ]]; then
  # (Re)start if the service was running before, or if it is enabled at boot.
  if [[ "$was_active" -eq 1 ]] || systemctl is-enabled --quiet "$SERVICE"; then
    # Set the port BEFORE the start: the new version reads that file on boot.
    enforce_port_file
    log "Starting ${SERVICE}…"
    systemctl start "$SERVICE" || die "Start failed — check: journalctl -u ${SERVICE} -e"
    sleep 2
    if systemctl is-active --quiet "$SERVICE"; then
      log "Service active ✔"
    else
      warn "Service not active after start. Rollback is possible:"
      warn "  sudo systemctl stop ${SERVICE}; sudo mv -f '${BACKUP}' '${DEST}'; sudo systemctl start ${SERVICE}"
      die  "See: journalctl -u ${SERVICE} -e"
    fi

    # --- Port check (self-correcting) -----------------------------------------
    # The server takes a few seconds to listen. We wait, and if the expected port
    # never shows up we re-force the file plus a restart, then check again.
    # Non-fatal: the update succeeded, we just complain loudly.
    log "Checking that the headless server listens on ${EXPECTED_PORT}…"
    ok_port=0
    for _ in $(seq 1 20); do port_listening && { ok_port=1; break; }; sleep 2; done
    if [[ "$ok_port" -eq 0 ]]; then
      warn "Port ${EXPECTED_PORT} missing — re-forcing the file + restart…"
      enforce_port_file
      systemctl restart "$SERVICE" || warn "restart failed."
      for _ in $(seq 1 20); do port_listening && { ok_port=1; break; }; sleep 2; done
    fi
    if [[ "$ok_port" -eq 1 ]]; then
      log "Headless server listening on ${EXPECTED_PORT} ✔"
    else
      warn "⚠ The headless server is NOT listening on ${EXPECTED_PORT} after correction."
      warn "  Actual port: $(ss -ltnp 2>/dev/null | grep -i orca | grep -oE ':[0-9]+' | sort -u | tr '\n' ' ')"
      warn "  Fix by hand: echo '{\"port\":${EXPECTED_PORT}}' > '${FALLBACK_PORT_FILE}' then restart."
    fi
  fi
fi

log "Orca updated successfully (${CUR_VER} → ${NEW_VER})."
