#!/usr/bin/env bash
#
# update-orca — Met à jour Orca (AppImage) dans /opt/orca (serveur headless)
#
# Flux : télécharge la dernière release GitHub → valide → arrête le service
# systemd → remplace l'AppImage de façon atomique → redémarre le service.
# Conserve une sauvegarde pour rollback et ne touche à rien si déjà à jour.
#
# Installé par orca-setup dans /usr/local/bin/update-orca (contexte SELinux
# bin_t : systemd refuse d'exécuter un script sous /home, étiqueté home_t).
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
REPO="${ORCA_REPO:-stablyai/orca}"
DEST_DIR="${ORCA_DEST_DIR:-/opt/orca}"
APP_NAME="orca-linux.AppImage"          # nom local, indépendant de l'asset
DEST="${DEST_DIR}/${APP_NAME}"
BACKUP="${DEST}.bak"
SERVICE="orca-serve.service"

# Port attendu du runtime websocket headless. ⚠️ Les versions récentes d'Orca
# IGNORENT `serve --port` : le port réel est lu/persisté dans le fichier
# mobile-ws-fallback-port.json du profil userData. Après une MAJ, une nouvelle
# version peut y réécrire un port éphémère (ex. 37579) → le headless bascule
# silencieusement sur le mauvais port. On force donc ce fichier à EXPECTED_PORT.
EXPECTED_PORT="${ORCA_PORT:-6768}"

# --- Asset selon l'architecture -----------------------------------------------
# ⚠️ La release publie deux AppImages. Sans ce test, un RPi arm64 recevait
# silencieusement le binaire x86_64 au premier passage du timer.
case "$(uname -m)" in
  x86_64|amd64)  ASSET="orca-linux.AppImage" ;;
  aarch64|arm64) ASSET="orca-linux-arm64.AppImage" ;;
  *)             echo "Architecture non supportée : $(uname -m)" >&2; exit 1 ;;
esac
URL="https://github.com/${REPO}/releases/latest/download/${ASSET}"

# --- Helpers ------------------------------------------------------------------
log()  { printf '\033[1;34m[orca-update]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[orca-update]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[orca-update]\033[0m %s\n' "$*" >&2; exit 1; }

# Utilisateur/HOME du service (le profil userData est chez lui, pas chez root).
SVC_USER="$(systemctl show -p User --value "$SERVICE" 2>/dev/null || true)"
[[ -n "$SVC_USER" ]] || SVC_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
SVC_HOME="$(getent passwd "$SVC_USER" 2>/dev/null | cut -d: -f6)"
FALLBACK_PORT_FILE="${SVC_HOME:-/home/$SVC_USER}/.config/orca/mobile-ws-fallback-port.json"

# Force le fichier de port du profil à EXPECTED_PORT (en préservant le
# propriétaire — le script tourne en root mais le fichier appartient au user).
enforce_port_file() {
  local dir; dir="$(dirname "$FALLBACK_PORT_FILE")"
  [[ -d "$dir" ]] || { warn "Profil Orca introuvable ($dir) — port non forcé."; return 0; }
  printf '{"port":%s}' "$EXPECTED_PORT" > "$FALLBACK_PORT_FILE"
  chown "$SVC_USER":"$SVC_USER" "$FALLBACK_PORT_FILE" 2>/dev/null || true
  chmod 644 "$FALLBACK_PORT_FILE" 2>/dev/null || true
  log "Port forcé à ${EXPECTED_PORT} dans $(basename "$FALLBACK_PORT_FILE")."
}

# Vrai si un serveur écoute sur EXPECTED_PORT.
port_listening() { ss -ltn 2>/dev/null | grep -qE ":${EXPECTED_PORT}\b"; }

# Extrait la version d'une AppImage Orca SANS la lancer : lit `X-AppImage-Version`
# du .desktop embarqué (extraction interne, pas de FUSE requis). Renvoie
# "absente" si le fichier n'existe pas, "inconnue" si la version est illisible.
appimage_version() {
  local img="$1" tmpd ver
  [[ -f "$img" ]] || { echo "absente"; return 0; }
  tmpd="$(mktemp -d)" || { echo "inconnue"; return 0; }
  ( cd "$tmpd" && "$img" --appimage-extract '*.desktop' >/dev/null 2>&1 ) || true
  ver="$(grep -hm1 '^X-AppImage-Version=' "$tmpd"/squashfs-root/*.desktop 2>/dev/null | cut -d= -f2)"
  rm -rf "$tmpd"
  echo "${ver:-inconnue}"
}

# Réexécute le script via sudo si on n'a pas les droits root (écriture /opt +
# contrôle du service system).
# NE PAS appeler `sudo update-orca` : le secure_path de sudo n'inclut pas
# ~/.local/bin. On s'élève soi-même avec le chemin absolu résolu.
if [[ "$(id -u)" -ne 0 ]]; then
  self="$(readlink -f -- "$0" 2>/dev/null || true)"
  [[ -n "$self" && -r "$self" ]] || die "Impossible de résoudre le chemin du script ($0) pour l'élévation."
  log "Droits root requis (écriture /opt + systemd) — élévation via sudo…"
  exec sudo -- "$self" "$@"
fi

command -v curl >/dev/null 2>&1 || die "curl est requis mais introuvable."

have_systemd=0
if command -v systemctl >/dev/null 2>&1 && systemctl cat "$SERVICE" >/dev/null 2>&1; then
  have_systemd=1
fi

# --- Téléchargement -----------------------------------------------------------
mkdir -p "$DEST_DIR"

TMP="$(mktemp "${DEST_DIR}/.${APP_NAME}.XXXXXX")"
trap 'rm -f "$TMP"' EXIT   # nettoyage du temporaire en cas d'échec

log "Téléchargement de la dernière AppImage Orca (${ASSET})…"
curl -fL --retry 3 --retry-delay 2 --progress-bar -o "$TMP" "$URL" \
  || die "Échec du téléchargement depuis $URL"

# --- Validation ---------------------------------------------------------------
# Une AppImage valide démarre par un en-tête ELF (0x7F 'E' 'L' 'F').
if [[ "$(head -c 4 "$TMP" | od -An -tx1 | tr -d ' ')" != "7f454c46" ]]; then
  die "Le fichier téléchargé n'est pas un exécutable ELF valide (release cassée ?)."
fi
SIZE="$(stat -c%s "$TMP")"
[[ "$SIZE" -gt 1000000 ]] || die "Fichier suspicieusement petit (${SIZE} octets)."
log "Téléchargement OK ($(numfmt --to=iec "$SIZE" 2>/dev/null || echo "${SIZE}o"))."

# --- Versions (lues sans lancer l'appli) --------------------------------------
CUR_VER="$(appimage_version "$DEST")"   # version actuellement installée
NEW_VER="$(appimage_version "$TMP")"    # version qui vient d'être téléchargée
log "Version installée : ${CUR_VER}  →  version téléchargée : ${NEW_VER}"

# Déjà à jour → on ne perturbe pas le service en cours.
if [[ -f "$DEST" ]] && cmp -s "$TMP" "$DEST"; then
  log "Déjà à jour (${CUR_VER}) — service laissé intact, aucune modification."
  exit 0
fi

# --- Arrêt du service ---------------------------------------------------------
was_active=0
if [[ "$have_systemd" -eq 1 ]]; then
  if systemctl is-active --quiet "$SERVICE"; then
    was_active=1
    log "Arrêt de ${SERVICE}…"
    # L'arrêt peut être lent (Electron réagit mal à SIGINT) ; systemd applique
    # son TimeoutStopSec puis force le kill — on n'échoue pas là-dessus.
    systemctl stop "$SERVICE" || warn "Arrêt non-propre de ${SERVICE} (poursuite)."
  else
    log "${SERVICE} n'est pas actif (état: $(systemctl is-active "$SERVICE" 2>/dev/null || echo inconnu))."
  fi
fi

# --- Installation atomique ----------------------------------------------------
chmod 755 "$TMP"
if [[ -f "$DEST" ]]; then
  cp -f "$DEST" "$BACKUP"
  log "Sauvegarde de l'ancienne version → ${BACKUP}"
fi
mv -f "$TMP" "$DEST"      # remplacement atomique (même système de fichiers)
trap - EXIT
log "AppImage remplacée (${CUR_VER} → ${NEW_VER}) : ${DEST}"

# --- Redémarrage du service ---------------------------------------------------
if [[ "$have_systemd" -eq 1 ]]; then
  # On (re)démarre si le service tournait avant, ou s'il est activé au boot.
  if [[ "$was_active" -eq 1 ]] || systemctl is-enabled --quiet "$SERVICE"; then
    # Fixe le port AVANT le start : la nouvelle version lit ce fichier au boot.
    enforce_port_file
    log "Démarrage de ${SERVICE}…"
    systemctl start "$SERVICE" || die "Échec du démarrage — vérifie: journalctl -u ${SERVICE} -e"
    sleep 2
    if systemctl is-active --quiet "$SERVICE"; then
      log "Service actif ✔"
    else
      warn "Service non actif après démarrage. Rollback possible :"
      warn "  sudo systemctl stop ${SERVICE}; sudo mv -f '${BACKUP}' '${DEST}'; sudo systemctl start ${SERVICE}"
      die  "Voir: journalctl -u ${SERVICE} -e"
    fi

    # --- Vérification du port (auto-correction) -------------------------------
    # Le serveur met quelques secondes à écouter. On attend, et si le port
    # attendu n'apparaît pas, on re-force le fichier + un restart, puis on
    # revérifie. Non-fatal : la MAJ a réussi, on signale juste fort.
    log "Vérification que le headless écoute sur ${EXPECTED_PORT}…"
    ok_port=0
    for _ in $(seq 1 20); do port_listening && { ok_port=1; break; }; sleep 2; done
    if [[ "$ok_port" -eq 0 ]]; then
      warn "Port ${EXPECTED_PORT} absent — re-force du fichier + restart…"
      enforce_port_file
      systemctl restart "$SERVICE" || warn "restart échoué."
      for _ in $(seq 1 20); do port_listening && { ok_port=1; break; }; sleep 2; done
    fi
    if [[ "$ok_port" -eq 1 ]]; then
      log "Headless en écoute sur ${EXPECTED_PORT} ✔"
    else
      warn "⚠ Le headless N'ÉCOUTE PAS sur ${EXPECTED_PORT} après correction."
      warn "  Port réel : $(ss -ltnp 2>/dev/null | grep -i orca | grep -oE ':[0-9]+' | sort -u | tr '\n' ' ')"
      warn "  Corrige à la main : echo '{\"port\":${EXPECTED_PORT}}' > '${FALLBACK_PORT_FILE}' puis restart."
    fi
  fi
fi

log "Orca mis à jour avec succès (${CUR_VER} → ${NEW_VER})."
