#!/usr/bin/env bash
# nuke — Kill switch: factory reset dotfiles, brew, caches, homedir
# Usage: nuke
# Requires typing "NUKE" to confirm + 5 second delay

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${RED}"
echo "  ███╗   ██╗██╗   ██╗██╗  ██╗███████╗"
echo "  ████╗  ██║██║   ██║██║ ██╔╝██╔════╝"
echo "  ██╔██╗ ██║██║   ██║█████╔╝ █████╗  "
echo "  ██║╚██╗██║██║   ██║██╔═██╗ ██╔══╝  "
echo "  ██║ ╚████║╚██████╔╝██║  ██╗███████╗"
echo "  ╚═╝  ╚═══╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝"
echo -e "${NC}"

echo -e "${RED}This will PERMANENTLY DELETE:${NC}"
echo "  - All chezmoi configs and managed files"
echo "  - Homebrew and ALL installed packages"
echo "  - Oh-My-Zsh"
echo "  - All AI tools configs (.claude, .codex, .qwen, .vibe, etc.)"
echo "  - All shell caches"
echo "  - ALL dotfiles and configs in your home directory"
echo ""
echo -e "${YELLOW}Preserved: ~/Desktop, ~/Documents, ~/Downloads, ~/Pictures,"
echo -e "           ~/Music, ~/Videos, ~/Public, ~/Templates, ~/Library, ~/Applications${NC}"
echo ""
echo -e "${RED}Type 'NUKE' to confirm:${NC}"
read -r confirm
if [[ "$confirm" != "NUKE" ]]; then
    echo "Aborted."
    exit 1
fi

echo ""
echo -e "${RED}Starting in 5 seconds... (Ctrl+C to abort)${NC}"
for i in 5 4 3 2 1; do
    echo -ne "\r  ${i}..."
    sleep 1
done
echo ""
echo ""

# =============================================================================
# 1. Chezmoi
# =============================================================================
echo -e "${RED}[1/7] Destroying chezmoi...${NC}"
if command -v chezmoi &>/dev/null; then
    chezmoi destroy --force 2>/dev/null || true
fi
rm -rf "${HOME}/.local/share/chezmoi" "${HOME}/.config/chezmoi"

# =============================================================================
# 2. Homebrew
# =============================================================================
echo -e "${RED}[2/7] Uninstalling Homebrew...${NC}"
if command -v brew &>/dev/null; then
    eval "$(brew shellenv 2>/dev/null)" || true
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh)" 2>/dev/null || true
fi
sudo rm -rf /opt/homebrew /home/linuxbrew 2>/dev/null || true

# =============================================================================
# 3. Snap packages (Ubuntu)
# =============================================================================
echo -e "${RED}[3/7] Removing snap packages...${NC}"
if command -v snap &>/dev/null; then
    snap list 2>/dev/null | awk 'NR>1 && !/^(bare|core|snapd|gnome-)/{print $1}' | while read -r pkg; do
        sudo snap remove "$pkg" 2>/dev/null || true
    done
fi

# =============================================================================
# 4. Oh-My-Zsh
# =============================================================================
echo -e "${RED}[4/7] Removing Oh-My-Zsh...${NC}"
rm -rf "${HOME}/.oh-my-zsh"

# =============================================================================
# 5. AI tools
# =============================================================================
echo -e "${RED}[5/7] Removing AI tools configs...${NC}"
rm -rf "${HOME}/.claude" "${HOME}/.codex" "${HOME}/.config/opencode" \
       "${HOME}/.agents" "${HOME}/.qwen" "${HOME}/.vibe" "${HOME}/.mistralcode" \
       "${HOME}/.kiro"

# =============================================================================
# 6. Caches
# =============================================================================
echo -e "${RED}[6/7] Clearing all caches...${NC}"
rm -rf "${HOME}/.cache"

# =============================================================================
# 7. Clean homedir (keep system dirs only)
# =============================================================================
echo -e "${RED}[7/7] Cleaning home directory...${NC}"

# Dirs to preserve (macOS + Linux system dirs)
KEEP_DIRS="Desktop|Documents|Downloads|Pictures|Music|Videos|Public|Templates|Library|Applications"

# Remove all dotfiles and dirs except preserved ones
find "${HOME}" -maxdepth 1 -mindepth 1 \
    -not -regex ".*/\(${KEEP_DIRS}\)" \
    -exec rm -rf {} + 2>/dev/null || true

echo ""
echo -e "${GREEN}NUKE complete. Machine is clean.${NC}"
echo "To start fresh: curl -fsSL https://raw.githubusercontent.com/jsoyer/dotfiles/main/scripts/bootstrap.sh | bash"
