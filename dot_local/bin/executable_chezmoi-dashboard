    for rec in "${MACHINE_RECORDS[@]}"; do
        local hostname reachable status timestamp age_secs duration profile errors_count
        IFS='|' read -r hostname reachable status timestamp age_secs duration profile errors_count <<< "${rec}"
        _html_row "${hostname}" "${reachable}" "${status}" "${timestamp}" "${age_secs}" "${duration}" "${profile}" "${errors_count}"
    done

    cat <<'HTML'
      </tbody>
    </table>
  </div>

  <div class="footer">
    chezmoi-dashboard &mdash; auto-refreshes every 5 minutes &mdash;
    data from <code>~/.cache/chezmoi-autoupdate/status.json</code>
  </div>

</body>
</html>
HTML
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    # Collect local machine data
    _collect_local

    if [[ "${LOCAL_ONLY}" == false ]]; then
        # Try to use deadman-state.json if it exists and is recent (< 30 min)
        local use_deadman_state=false
        if [[ -f "${DEADMAN_STATE}" ]]; then
            local state_mtime
            state_mtime="$(stat -c %Y "${DEADMAN_STATE}" 2>/dev/null || stat -f %m "${DEADMAN_STATE}" 2>/dev/null || echo 0)"
            if (( NOW - state_mtime < 1800 )); then
                use_deadman_state=true
            fi
        fi

        if [[ "${use_deadman_state}" == true ]]; then
            # Parse machines from deadman-state.json
            # Extract each machine object — iterate by host field
            local hosts_json
            if command -v jq >/dev/null 2>&1; then
                hosts_json="$(jq -r '.machines[] | [.host, .status, .last_update, .age_secs, .age_human, .profile] | @tsv' \
                    "${DEADMAN_STATE}" 2>/dev/null)" || hosts_json=""
                while IFS=$'\t' read -r dhost dstatus dlast_update dage_secs _ dprofile; do
                    [[ -z "${dhost}" ]] && continue
                    # Skip if this is the local machine (already collected)
                    local local_hostname
                    local_hostname="$(hostname -s 2>/dev/null || hostname)"
                    [[ "${dhost}" == "${local_hostname}" ]] && continue
                    local reachable="true"
                    [[ "${dstatus}" == "unreachable" ]] && reachable="false"
                    MACHINE_RECORDS+=("${dhost}|${reachable}|${dstatus}|${dlast_update}|${dage_secs}|0|${dprofile}|0")
                done <<< "${hosts_json}"
            fi
        else
            # Discover and SSH into remote machines
            local machines=()
            local ts_machines
            if ts_machines="$(_discover_tailscale_fleet 2>/dev/null)" && [[ -n "${ts_machines}" ]]; then
                while IFS= read -r m; do
                    [[ -n "${m}" ]] && machines+=("${m}")
                done <<< "${ts_machines}"
            fi

            if [[ ${#machines[@]} -eq 0 ]] && [[ -n "${CHEZMOI_FLEET_MACHINES:-}" ]]; then
                IFS=',' read -ra machines <<< "${CHEZMOI_FLEET_MACHINES}"
            fi

            local local_hostname
            local_hostname="$(hostname -s 2>/dev/null || hostname)"
            for machine in "${machines[@]}"; do
                [[ -z "${machine}" ]] && continue
                [[ "${machine}" == "${local_hostname}" ]] && continue
                _collect_remote "${machine}"
            done
        fi
    fi

    # Generate HTML
    _generate_html > "${OUTPUT_FILE}"

    printf '%s\n' "${OUTPUT_FILE}"

    if [[ "${OPEN_BROWSER}" == true ]]; then
        if command -v xdg-open >/dev/null 2>&1; then
            xdg-open "${OUTPUT_FILE}" &
        elif command -v open >/dev/null 2>&1; then
            open "${OUTPUT_FILE}"
        else
            printf '%s: --open: no browser opener found (tried xdg-open, open)\n' "${SCRIPT_NAME}" >&2
        fi
    fi
}

main "$@"
