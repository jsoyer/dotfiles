    .generated-at {
      color: var(--subtext0);
      font-size: 0.8rem;
    }

    /* Health pill */
    .health-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .health-ok {
      background: color-mix(in srgb, var(--green) 20%, transparent);
      color: var(--green);
      border: 1px solid color-mix(in srgb, var(--green) 40%, transparent);
    }

    .health-degraded {
      background: color-mix(in srgb, var(--red) 20%, transparent);
      color: var(--red);
      border: 1px solid color-mix(in srgb, var(--red) 40%, transparent);
    }

    /* Summary cards */
    .summary {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }

    .summary-card {
      background: var(--mantle);
      border: 1px solid var(--surface0);
      border-radius: 0.5rem;
      padding: 0.75rem 1.25rem;
      min-width: 110px;
      text-align: center;
    }

    .summary-card .count {
      font-size: 1.8rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .summary-card .label {
      font-size: 0.75rem;
      color: var(--subtext0);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .card-ok    .count { color: var(--green); }
    .card-stale .count { color: var(--yellow); }
    .card-error .count { color: var(--red); }
    .card-unreachable .count { color: var(--overlay1); }
    .card-total .count { color: var(--lavender); }

    /* Table */
    .table-wrap {
      background: var(--mantle);
      border: 1px solid var(--surface0);
      border-radius: 0.5rem;
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead tr {
      background: var(--crust);
      border-bottom: 2px solid var(--surface0);
