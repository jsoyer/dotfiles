    }

    .badge-ok           { background: color-mix(in srgb, var(--green) 20%, transparent);   color: var(--green);   }
    .badge-error        { background: color-mix(in srgb, var(--red) 20%, transparent);     color: var(--red);     }
    .badge-stale        { background: color-mix(in srgb, var(--yellow) 20%, transparent);  color: var(--yellow);  }
