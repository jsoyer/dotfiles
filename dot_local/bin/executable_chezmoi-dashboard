      .col-timestamp, .col-duration { display: none; }
    }
  </style>
</head>
<body>

  <div class="header">
    <div>
      <h1>chezmoi <span>fleet dashboard</span></h1>
      <div class="generated-at">Generated: ${generated_ts}</div>
    </div>
    <span class="health-pill ${health_class}">${health_text}</span>
  </div>

  <div class="summary">
    <div class="summary-card card-ok">
      <div class="count">${ok_count}</div>
      <div class="label">Healthy</div>
    </div>
    <div class="summary-card card-stale">
      <div class="count">${stale_count}</div>
      <div class="label">Stale</div>
    </div>
    <div class="summary-card card-error">
