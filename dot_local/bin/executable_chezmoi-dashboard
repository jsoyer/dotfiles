#!/usr/bin/env bash
# =============================================================================
# chezmoi-dashboard — Generate a static HTML fleet status page
#
# Reads status from:
#   - Local ~/.cache/chezmoi-autoupdate/status.json
#   - Remote machines via SSH over Tailscale (same method as chezmoi-deadman)
#   - deadman-state.json if chezmoi-deadman has already run
#
# Output: ~/.cache/chezmoi-autoupdate/dashboard.html
#         Also printed to stdout as the path (for scripting)
#
# Usage:
#   chezmoi-dashboard              # Generate dashboard
#   chezmoi-dashboard --open       # Generate and open in browser
#   chezmoi-dashboard --local-only # Only include this machine (no SSH)
#   chezmoi-dashboard --output FILE # Write to a custom path
#
# Env vars (same as chezmoi-deadman):
#   CHEZMOI_FLEET_MACHINES — comma-separated fallback hostnames
#   CHEZMOI_SSH_USER       — SSH user (default: current user)
#   CHEZMOI_SSH_KEY        — path to SSH key
#   CHEZMOI_SSH_TIMEOUT    — SSH connect timeout in seconds (default: 10)
#   CHEZMOI_DEADMAN_DAYS   — stale threshold in days (default: 7)
# =============================================================================

set -uo pipefail

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
readonly SCRIPT_NAME="${0##*/}"
readonly CACHE_DIR="${HOME}/.cache/chezmoi-autoupdate"
readonly LOCAL_STATUS="${CACHE_DIR}/status.json"
readonly DEADMAN_STATE="${CACHE_DIR}/deadman-state.json"
readonly REMOTE_STATUS_PATH=".cache/chezmoi-autoupdate/status.json"

THRESHOLD_DAYS="${CHEZMOI_DEADMAN_DAYS:-7}"
readonly THRESHOLD_SECS=$(( THRESHOLD_DAYS * 86400 ))
readonly NOW="$(date +%s)"

SSH_USER="${CHEZMOI_SSH_USER:-${USER}}"
SSH_KEY="${CHEZMOI_SSH_KEY:-${HOME}/.ssh/id_ed25519}"
SSH_TIMEOUT="${CHEZMOI_SSH_TIMEOUT:-10}"

OUTPUT_FILE="${CACHE_DIR}/dashboard.html"
OPEN_BROWSER=false
LOCAL_ONLY=false

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --open)        OPEN_BROWSER=true; shift ;;
        --local-only)  LOCAL_ONLY=true; shift ;;
        --output)      OUTPUT_FILE="${2:?--output requires a path}"; shift 2 ;;
        -h|--help)
            printf 'Usage: %s [--open] [--local-only] [--output FILE]\n' "${SCRIPT_NAME}"
            exit 0
            ;;
        *) printf '%s: unknown option: %s\n' "${SCRIPT_NAME}" "$1" >&2; exit 2 ;;
    esac
done

mkdir -p "${CACHE_DIR}"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
_parse_timestamp() {
    local ts="$1"
    [[ "${ts}" =~ ^[0-9]+$ ]] && { printf '%s' "${ts}"; return 0; }
    date -d "${ts}" +%s 2>/dev/null \
        || date -j -f "%Y-%m-%dT%H:%M:%SZ" "${ts}" +%s 2>/dev/null \
        || return 1
}

_human_duration() {
    local secs="$1"
    (( secs < 0 )) && { printf 'unknown'; return; }
    local days=$(( secs / 86400 ))
    local hours=$(( (secs % 86400) / 3600 ))
    local mins=$(( (secs % 3600) / 60 ))
    if (( days > 0 )); then
        printf '%dd %dh' "${days}" "${hours}"
    elif (( hours > 0 )); then
        printf '%dh %dm' "${hours}" "${mins}"
    else
        printf '%dm' "${mins}"
    fi
}

_ssh_read_status() {
    local host="$1"
    local ssh_key_args=()
    [[ -f "${SSH_KEY}" ]] && ssh_key_args=(-i "${SSH_KEY}")
    ssh \
        -o StrictHostKeyChecking=no \
        -o BatchMode=yes \
        -o ConnectTimeout="${SSH_TIMEOUT}" \
        -o ServerAliveInterval=5 \
        -o ServerAliveCountMax=1 \
        "${ssh_key_args[@]}" \
        "${SSH_USER}@${host}" \
        "cat ~/${REMOTE_STATUS_PATH} 2>/dev/null" \
        2>/dev/null
}

_discover_tailscale_fleet() {
    command -v tailscale >/dev/null 2>&1 || return 1
    local ts_json
    ts_json="$(tailscale status --json 2>/dev/null)" || return 1
    if command -v jq >/dev/null 2>&1; then
        printf '%s' "${ts_json}" \
            | jq -r '.Peer[] | select(.Online == true) | .DNSName' 2>/dev/null \
            | sed 's/\.$//; s/\..*//' | sort -u
    else
        printf '%s' "${ts_json}" \
            | grep -o '"DNSName":"[^"]*"' \
            | sed 's/"DNSName":"//; s/\.$//; s/\..*//' | sort -u
    fi
}

# ---------------------------------------------------------------------------
# Parse a status.json blob into fields
# Outputs: hostname|status|timestamp|duration|profile|errors_count
# ---------------------------------------------------------------------------
_parse_status_json() {
    local json="$1"
    local hostname status timestamp duration profile errors_count

    hostname="$(printf '%s' "${json}"   | grep -o '"hostname":"[^"]*"'         | head -1 | sed 's/"hostname":"//;s/"//')"
    status="$(printf '%s' "${json}"     | grep -o '"status":"[^"]*"'           | head -1 | sed 's/"status":"//;s/"//')"
    timestamp="$(printf '%s' "${json}"  | grep -o '"timestamp":"[^"]*"'        | head -1 | sed 's/"timestamp":"//;s/"//')"
    duration="$(printf '%s' "${json}"   | grep -o '"duration_seconds":[0-9]*'  | head -1 | sed 's/"duration_seconds"://')"
    profile="$(printf '%s' "${json}"    | grep -o '"machine_profile":"[^"]*"'  | head -1 | sed 's/"machine_profile":"//;s/"//')"

    # Count errors array entries (count commas + 1 if non-empty)
    local errors_raw
    errors_raw="$(printf '%s' "${json}" | grep -o '"errors":\[[^]]*\]' | head -1 | sed 's/"errors":\[//;s/\]//')"
    if [[ -z "${errors_raw}" || "${errors_raw}" == "" ]]; then
        errors_count=0
    else
        errors_count=$(( $(printf '%s' "${errors_raw}" | tr -cd ',' | wc -c) + 1 ))
    fi

    hostname="${hostname:-unknown}"
    status="${status:-unknown}"
    timestamp="${timestamp:-}"
    duration="${duration:-0}"
    profile="${profile:-unknown}"

    printf '%s|%s|%s|%s|%s|%s' \
        "${hostname}" "${status}" "${timestamp}" "${duration}" "${profile}" "${errors_count}"
}

# ---------------------------------------------------------------------------
# Collect data from all machines
# Returns array of pipe-separated record strings
# Format: hostname|reachable|status|timestamp|age_secs|duration|profile|errors_count
# ---------------------------------------------------------------------------
declare -a MACHINE_RECORDS=()

_collect_local() {
    if [[ ! -f "${LOCAL_STATUS}" ]]; then
        local hn
        hn="$(hostname -s 2>/dev/null || hostname)"
        MACHINE_RECORDS+=("${hn}|true|unknown||−1|0|unknown|0")
        return
    fi
    local json
    json="$(cat "${LOCAL_STATUS}")"
    local fields
    fields="$(_parse_status_json "${json}")"
    local hostname status timestamp duration profile errors_count
    IFS='|' read -r hostname status timestamp duration profile errors_count <<< "${fields}"

    local age_secs=-1
    if [[ -n "${timestamp}" ]]; then
        local ts_epoch
        ts_epoch="$(_parse_timestamp "${timestamp}")" && age_secs=$(( NOW - ts_epoch )) || true
    fi

    MACHINE_RECORDS+=("${hostname}|true|${status}|${timestamp}|${age_secs}|${duration}|${profile}|${errors_count}")
}

_collect_remote() {
    local host="$1"
    local raw
    raw="$(_ssh_read_status "${host}")" || true

    if [[ -z "${raw}" ]]; then
        MACHINE_RECORDS+=("${host}|false|unreachable||-1|0|unknown|0")
        return
    fi

    local fields
    fields="$(_parse_status_json "${raw}")"
    local hostname status timestamp duration profile errors_count
    IFS='|' read -r hostname status timestamp duration profile errors_count <<< "${fields}"

    # Use the SSH target name if hostname couldn't be parsed
    [[ "${hostname}" == "unknown" ]] && hostname="${host}"

    local age_secs=-1
    if [[ -n "${timestamp}" ]]; then
        local ts_epoch
        ts_epoch="$(_parse_timestamp "${timestamp}")" && age_secs=$(( NOW - ts_epoch )) || true
    fi

    MACHINE_RECORDS+=("${hostname}|true|${status}|${timestamp}|${age_secs}|${duration}|${profile}|${errors_count}")
}

# ---------------------------------------------------------------------------
# Build the HTML for a single table row
# ---------------------------------------------------------------------------
_html_row() {
    local hostname="$1"
    local reachable="$2"
    local status="$3"
    local timestamp="$4"
    local age_secs="$5"
    local duration="$6"
    local profile="$7"
    local errors_count="$8"

    local row_class status_badge age_display duration_display

    # Determine row class and status badge
    if [[ "${reachable}" == "false" ]]; then
        row_class="row-unreachable"
        status_badge='<span class="badge badge-unreachable">unreachable</span>'
    elif [[ "${status}" == "ok" ]]; then
        if (( age_secs >= 0 && age_secs > THRESHOLD_SECS )); then
            row_class="row-stale"
            status_badge='<span class="badge badge-stale">stale</span>'
        else
            row_class="row-ok"
            status_badge='<span class="badge badge-ok">ok</span>'
        fi
    elif [[ "${status}" == "error" ]]; then
        row_class="row-error"
        status_badge='<span class="badge badge-error">error</span>'
    else
        row_class="row-unknown"
        status_badge="<span class=\"badge badge-unknown\">${status}</span>"
    fi

    # Age display
    if (( age_secs < 0 )); then
        age_display='<span class="muted">—</span>'
    else
        local age_human
        age_human="$(_human_duration "${age_secs}")"
        if (( age_secs > THRESHOLD_SECS )); then
            age_display="<span class=\"age-stale\">${age_human} ago</span>"
        elif (( age_secs > 86400 )); then
            age_display="<span class=\"age-warn\">${age_human} ago</span>"
        else
            age_display="${age_human} ago"
        fi
    fi

    # Duration display
    if [[ -z "${duration}" || "${duration}" == "0" ]]; then
        duration_display='<span class="muted">—</span>'
    else
        duration_display="${duration}s"
    fi

    # Timestamp display
    local ts_display
    if [[ -z "${timestamp}" ]]; then
        ts_display='<span class="muted">never</span>'
    else
        ts_display="${timestamp}"
    fi

    # Errors badge
    local errors_display
    if (( errors_count == 0 )); then
        errors_display='<span class="muted">0</span>'
    else
        errors_display="<span class=\"errors-count\">${errors_count}</span>"
    fi

    printf '    <tr class="%s">\n' "${row_class}"
    printf '      <td class="col-machine"><span class="hostname">%s</span></td>\n' "${hostname}"
    printf '      <td class="col-profile"><span class="profile-tag">%s</span></td>\n' "${profile}"
    printf '      <td class="col-status">%s</td>\n' "${status_badge}"
    printf '      <td class="col-timestamp">%s</td>\n' "${ts_display}"
    printf '      <td class="col-age">%s</td>\n' "${age_display}"
    printf '      <td class="col-duration">%s</td>\n' "${duration_display}"
    printf '      <td class="col-errors">%s</td>\n' "${errors_display}"
    printf '    </tr>\n'
}

# ---------------------------------------------------------------------------
# Generate the full HTML document
# ---------------------------------------------------------------------------
_generate_html() {
    local generated_ts
    generated_ts="$(date -u '+%Y-%m-%d %H:%M:%S UTC')"

    local total_machines=${#MACHINE_RECORDS[@]}
    local ok_count=0 stale_count=0 error_count=0 unreachable_count=0

    for rec in "${MACHINE_RECORDS[@]}"; do
        local reachable status age_secs
        IFS='|' read -r _ reachable status _ age_secs _ _ _ <<< "${rec}"
        if [[ "${reachable}" == "false" ]]; then
            (( unreachable_count++ )) || true
        elif [[ "${status}" == "error" ]]; then
            (( error_count++ )) || true
        elif (( age_secs >= 0 && age_secs > THRESHOLD_SECS )); then
            (( stale_count++ )) || true
        else
            (( ok_count++ )) || true
        fi
    done

    # Overall health indicator
    local health_class health_text
    if (( error_count > 0 || stale_count > 0 || unreachable_count > 0 )); then
        health_class="health-degraded"
        health_text="Degraded"
    else
        health_class="health-ok"
        health_text="Healthy"
    fi

    cat <<HTML
