#!/usr/bin/env bash
# yayw — yay AUR helper wrapper that keeps Pacfile_aur_desktop in sync
# IMPORTANT: yay must NEVER be called with sudo (AUR helper best practice)
# Usage: yayw -S foo   → installs AUR pkg + adds to Pacfile_aur_desktop
#        yayw -R foo   → removes AUR pkg + removes from Pacfile_aur_desktop

set -euo pipefail

BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

CHEZMOI_SOURCE_PATH="${CHEZMOI_SOURCE_PATH:-${HOME}/.local/share/chezmoi}"
MANIFEST="${CHEZMOI_SOURCE_PATH}/dot_private/Pacfile_aur_desktop"

if [[ "${EUID}" -eq 0 ]]; then
    printf '%b\n' "${RED}Error: yayw must not be run as root. yay builds AUR packages as a regular user.${NC}" >&2
    exit 1
fi

validate_pkg() {
    local pkg="$1"
    if ! [[ "$pkg" =~ ^[a-zA-Z0-9][a-zA-Z0-9.+\-_]{0,127}$ ]]; then
        printf '%b\n' "${RED}Error: invalid package name: '${pkg}'${NC}" >&2
        exit 1
    fi
}

add_to_manifest() {
    local pkg="$1"
    if grep -qxF "$pkg" "$MANIFEST" 2>/dev/null; then
        printf '%b\n' "${YELLOW}${pkg} already in Pacfile_aur_desktop${NC}"
        return
    fi
    printf '%s\n' "$pkg" >> "$MANIFEST"
    printf '%b\n' "${GREEN}Added ${pkg} to Pacfile_aur_desktop${NC}"
}

remove_from_manifest() {
    local pkg="$1"
    if ! grep -qxF "$pkg" "$MANIFEST" 2>/dev/null; then
        printf '%b\n' "${YELLOW}${pkg} not in Pacfile_aur_desktop${NC}"
        return
    fi
    local tmp
    tmp="$(mktemp)"
    grep -vxF "$pkg" "$MANIFEST" > "$tmp"
    mv "$tmp" "$MANIFEST"
    printf '%b\n' "${GREEN}Removed ${pkg} from Pacfile_aur_desktop${NC}"
}

sync_to_git() {
    if command -v chezmoi &>/dev/null; then
        chezmoi re-add "$MANIFEST" 2>/dev/null || true
    fi
}

if [[ $# -eq 0 ]]; then
    exec yay
fi

SUBCMD="$1"
shift

case "$SUBCMD" in
    -S|--sync)
        PKGS=()
        FLAGS=()
        for arg in "$@"; do
            if [[ "$arg" == -* ]]; then
                FLAGS+=("$arg")
            else
                PKGS+=("$arg")
            fi
        done
        if [[ ${#PKGS[@]} -eq 0 ]]; then
            exec yay "$SUBCMD" "${FLAGS[@]}"
        fi
        for pkg in "${PKGS[@]}"; do
            validate_pkg "$pkg"
        done
        printf '%b\n' "${BLUE}Installing from AUR: ${PKGS[*]}${NC}"
        yay "$SUBCMD" "${FLAGS[@]}" "${PKGS[@]}"
        if [[ "${MACHINE_PROFILE:-}" == "arch-desktop" ]]; then
            for pkg in "${PKGS[@]}"; do
                add_to_manifest "$pkg"
            done
            sync_to_git
        fi
        ;;
    -R|--remove|-Rs|-Rns)
        PKGS=()
        FLAGS=()
        for arg in "$@"; do
            if [[ "$arg" == -* ]]; then
                FLAGS+=("$arg")
            else
                PKGS+=("$arg")
            fi
        done
        if [[ ${#PKGS[@]} -eq 0 ]]; then
            exec yay "$SUBCMD" "${FLAGS[@]}"
        fi
        printf '%b\n' "${BLUE}Removing from AUR: ${PKGS[*]}${NC}"
        yay "$SUBCMD" "${FLAGS[@]}" "${PKGS[@]}"
        for pkg in "${PKGS[@]}"; do
            remove_from_manifest "$pkg"
        done
        sync_to_git
        ;;
    *)
        exec yay "$SUBCMD" "$@"
        ;;
esac
