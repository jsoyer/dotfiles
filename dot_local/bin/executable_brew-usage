<script>
const DATA = __DATA__;
const bucketDefs = [
  {k:"≤7j",  test:d=>d!=null&&d<=7,   c:"var(--fresh)"},
  {k:"≤30j", test:d=>d!=null&&d>7&&d<=30,  c:"#5A8E5A"},
  {k:"≤90j", test:d=>d!=null&&d>30&&d<=90, c:"#8C8F3C"},
  {k:"≤180j",test:d=>d!=null&&d>90&&d<=180,c:"var(--aging)"},
  {k:"≤1an", test:d=>d!=null&&d>180&&d<=365,c:"#B5622A"},
  {k:">1an",  test:d=>d!=null&&d>365, c:"var(--stale)"},
  {k:"inconnu",test:d=>d==null,       c:"var(--unk)"},
];
const counts = bucketDefs.map(b=>DATA.filter(r=>b.test(r.d)).length);
const maxc = Math.max(...counts, 1);
const barsEl = document.getElementById("bars");
bucketDefs.forEach((b,i)=>{
  const col=document.createElement("div");col.className="bar-col";
  col.innerHTML='<div class="bar-n">'+counts[i]+'</div><div class="bar" style="background:'+b.c+';height:0"></div><div class="bar-l">'+b.k+'</div>';
  barsEl.appendChild(col);
  requestAnimationFrame(()=>{col.querySelector(".bar").style.height=(counts[i]/maxc*100)+"%";});
});
function cls(d){ if(d==null)return"unk"; if(d<=30)return"fresh"; if(d<=180)return"aging"; return"stale"; }
function label(d){ if(d==null)return"jamais / ?"; return d+" j"; }
function stripeColor(d){ if(d==null)return"var(--unk)"; if(d<=30)return"var(--fresh)"; if(d<=180)return"var(--aging)"; return"var(--stale)"; }
let filter="all", q="", sortKey="d", sortDir=-1;
const tb=document.getElementById("tb"), countEl=document.getElementById("count");
function pass(r){
  if(filter==="form"&&r.t!=="form")return false;
  if(filter==="cask"&&r.t!=="cask")return false;
  if(filter==="stale"&&!(r.d==null||r.d>180))return false;
  if(q&&!r.n.toLowerCase().includes(q))return false;
  return true;
}
function sortVal(r){
  let v=r[sortKey];
  if(sortKey==="d"||sortKey==="a"){ return v==null?(sortDir===1?Infinity:-1):v; }
  return (v||"").toString().toLowerCase();
}
function render(){
  let rows=DATA.filter(pass).sort((a,b)=>{
    const x=sortVal(a),y=sortVal(b);
    if(x<y)return -sortDir; if(x>y)return sortDir; return a.n<b.n?-1:1;
  });
  tb.innerHTML=rows.map(r=>'<tr><td class="stripe" style="background:'+stripeColor(r.d)+'"></td>'
    +'<td class="name">'+r.n+'</td>'
    +'<td><span class="badge '+r.t+'">'+(r.t==="cask"?"cask":"formula")+'</span></td>'
    +'<td class="num"><span class="pill '+cls(r.d)+'">'+label(r.d)+'</span></td>'
    +'<td class="num col-hide dt">'+(r.lu||"—")+'</td>'
    +'<td class="num col-hide dt">'+(r.a!=null?r.a+" j":"—")+'</td></tr>').join("");
  countEl.textContent=rows.length+" / "+DATA.length+" affichés";
}
document.getElementById("segs").addEventListener("click",e=>{
  const b=e.target.closest(".seg"); if(!b)return;
  document.querySelectorAll(".seg").forEach(s=>s.classList.remove("on"));
  b.classList.add("on"); filter=b.dataset.f; render();
});
document.getElementById("q").addEventListener("input",e=>{q=e.target.value.toLowerCase().trim();render();});
document.querySelectorAll("th[data-s]").forEach(th=>th.addEventListener("click",()=>{
  const k=th.dataset.s;
  if(sortKey===k)sortDir*=-1; else{sortKey=k;sortDir=(k==="n"||k==="t")?1:-1;}
  render();
}));
render();
</script>
</body></html>"""


def render_html(rows: list[dict], n_form: int, n_cask: int, n_deps: int) -> str:
    payload = [{
        "n": r["name"],
        "t": "cask" if r["type"] == "cask" else "form",
        "d": r["days"],
        "a": r["age"],
        "lu": fmt_date(r["last_used"]) if r["last_used"] else None,
        "in": fmt_date(r["installed"]) if r["installed"] else None,
    } for r in rows]
    n_stale = sum(1 for r in rows if r["days"] is None or r["days"] > 180)
    return (HTML_TEMPLATE
            .replace("__DATA__", json.dumps(payload, ensure_ascii=False))
            .replace("__DATE__", time.strftime("%Y-%m-%d"))
            .replace("__NFORM__", str(n_form))
            .replace("__NCASK__", str(n_cask))
            .replace("__NDEPS__", str(n_deps))
            .replace("__NSTALE__", str(n_stale)))


def main() -> int:
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--stale", nargs="?", const=180, type=int, metavar="DAYS")
    ap.add_argument("--formulae", action="store_true")
    ap.add_argument("--casks", action="store_true")
    ap.add_argument("--all-formulae", action="store_true")
    ap.add_argument("--sort", choices=["name", "used", "age", "type"], default="used")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--uninstall-script", action="store_true")
    ap.add_argument("--html", nargs="?", const="~/brew-usage.html", metavar="FILE")
    ap.add_argument("--open", action="store_true")
    ap.add_argument("--no-color", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args()
    if args.help:
        print(__doc__)
        return 0

    if not run(["brew", "--version"]).strip():
        sys.stderr.write("brew introuvable dans le PATH.\n")
        return 1

    prefix = brew_prefix()
    rows: list[dict] = []
    want_form = args.formulae or not args.casks
    want_cask = args.casks or not args.formulae
    if want_form:
        rows += collect_formulae(prefix, args.all_formulae)
    if want_cask:
        rows += collect_casks(prefix)

    for r in rows:
        r["days"] = days(r["last_used"])
        r["age"] = days(r["installed"])

    full = rows  # keep the complete set for the summary histogram
    if args.stale is not None:
        rows = [r for r in rows if r["days"] is None or r["days"] > args.stale]

    keymap = {
        "name": lambda r: (r["name"].lower(),),
        "type": lambda r: (r["type"], r["name"].lower()),
        "age": lambda r: (r["age"] is None, r["age"] or 0),
        "used": lambda r: (r["days"] is not None, -(r["days"] or 0)),
    }
    # newest-idle first for "used": unknown then largest days
    if args.sort == "used":
        rows.sort(key=lambda r: (r["days"] is not None, -(r["days"] or 0)))
    else:
        rows.sort(key=keymap[args.sort])

    if args.html is not None:
        n_form = sum(1 for r in full if r["type"] == "formula")
        n_cask = sum(1 for r in full if r["type"] == "cask")
        n_deps = max(0, len(run(["brew", "list", "--formula"]).split())
                     - len(run(["brew", "leaves"]).split()))
        html = render_html(full, n_form, n_cask, n_deps)
        path = os.path.abspath(os.path.expanduser(args.html))
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(html)
        except OSError as e:
            sys.stderr.write(f"Écriture impossible ({path}): {e}\n")
            return 1
        print(f"Rapport écrit : {path}")
        if args.open:
            opener = "open" if sys.platform == "darwin" else "xdg-open"
            subprocess.run([opener, path], check=False)
        return 0

    if args.json:
        out = [{k: r[k] for k in ("name", "type", "leaf", "days", "age")}
               | {"last_used": fmt_date(r["last_used"]),
                  "installed": fmt_date(r["installed"])} for r in rows]
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0

    if args.uninstall_script:
        leaves = [r for r in rows if r["leaf"]
                  and (r["days"] is None or r["days"] > (args.stale or 180))]
        print("#!/usr/bin/env bash")
        print("# Generated by brew-usage — REVIEW before running.")
        print("# Each package is checked with `brew uses` so nothing depended-on is removed.")
        print("set -euo pipefail\n")
        for r in leaves:
            d = "jamais/inconnu" if r["days"] is None else f"{r['days']}j idle"
            kind = "--cask " if r["type"] == "cask" else ""
            print(f'# {r["name"]} ({d})')
            if r["type"] == "formula":
                print(f'if [ -z "$(brew uses --installed {r["name"]})" ]; then '
                      f'brew uninstall {r["name"]}; '
                      f'else echo "SKIP {r["name"]}: required by $(brew uses --installed {r["name"]} | tr "\\n" " ")"; fi')
            else:
                print(f'brew uninstall --cask {r["name"]}')
            print()
        sys.stderr.write(f"# {len(leaves)} paquets candidats.\n")
        return 0

    color = C(on=sys.stdout.isatty() and not args.no_color)
    summary(color, full)
    print_table(color, rows, show_dates=True)
    if args.stale is not None:
        print()
        print(color.dim(f"  → {len(rows)} candidats (idle > {args.stale}j). "
                        f"Génère un script : brew-usage --uninstall-script --stale {args.stale}"))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
