#!/usr/bin/env python3
"""brew-usage — estimate real usage of installed Homebrew formulae & casks.

Homebrew keeps no usage counter. This tool approximates "last used" from:
  * formulae : newest atime among the package's binaries in the Cellar
  * casks    : Spotlight's kMDItemLastUsedDate of the installed .app (fallback atime)

Old timestamps are reliable (the package is idle); recent ones less so, since a
background scan (Spotlight, antivirus, a `brew` command) can touch a file.

Usage:
  brew-usage                     summary + full table (leaves + casks), newest-idle first
  brew-usage --stale [DAYS]      only packages idle > DAYS (default 180) or never seen
  brew-usage --formulae          formulae only
  brew-usage --casks             casks only
  brew-usage --all-formulae      include auto-pulled dependencies too
  brew-usage --sort name|used|age|type
  brew-usage --json              machine-readable output
  brew-usage --uninstall-script  emit a guarded `brew uninstall` script for stale leaves
  brew-usage --html [FILE]       write an interactive HTML report (default ~/brew-usage.html)
  brew-usage --html --open       write the report and open it in the browser (macOS)
  brew-usage --no-color
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time

NOW = time.time()


def brew_prefix() -> str:
    env = os.environ.get("HOMEBREW_PREFIX")
    if env and os.path.isdir(env):
        return env
    for p in ("/opt/homebrew", "/usr/local", "/home/linuxbrew/.linuxbrew"):
        if os.path.isdir(os.path.join(p, "Cellar")):
            return p
    out = run(["brew", "--prefix"])
    return out.strip() or "/opt/homebrew"


def run(args: list[str]) -> str:
    try:
        r = subprocess.run(args, capture_output=True, text=True, check=False)
        return r.stdout
    except FileNotFoundError:
        return ""


def max_atime(path: str) -> float:
    """Newest atime among regular files under path; prefer bin/sbin executables."""
    best = best_exec = 0.0
    for root, _dirs, files in os.walk(path):
        exe = "/bin/" in root or "/sbin/" in root or root.endswith(("bin", "sbin"))
        for fn in files:
            fp = os.path.join(root, fn)
            try:
                st = os.stat(fp)  # follow symlinks; skip broken ones
            except OSError:
                continue
            a = st.st_atime
            if a > best:
                best = a
            if exe and a > best_exec:
                best_exec = a
    return best_exec or best


def birthtime(path: str) -> float:
    try:
        st = os.stat(path)
    except OSError:
        return 0.0
    return getattr(st, "st_birthtime", st.st_mtime)


def install_time(version_dir: str) -> float:
    """Actual install time = mtime of Homebrew's INSTALL_RECEIPT.json, written at
    install. Falls back to birthtime (which Homebrew may set from the source)."""
    receipt = os.path.join(version_dir, "INSTALL_RECEIPT.json")
    try:
        return os.stat(receipt).st_mtime
    except OSError:
        return birthtime(version_dir)


def days(t: float | None) -> int | None:
    if not t:
        return None
    return int((NOW - t) / 86400)


def collect_formulae(prefix: str, include_deps: bool) -> list[dict]:
    cellar = os.path.join(prefix, "Cellar")
    if not os.path.isdir(cellar):
        return []
    leaves = set(run(["brew", "leaves"]).split())
    names = run(["brew", "list", "--formula"]).split()
    rows = []
    for name in names:
        is_leaf = name in leaves
        if not include_deps and not is_leaf:
            continue
        d = os.path.join(cellar, name)
        if not os.path.isdir(d):
            continue
        try:
            versions = [os.path.join(d, v) for v in os.listdir(d)
                        if os.path.isdir(os.path.join(d, v))]
        except OSError:
            versions = []
        used = max((max_atime(v) for v in versions), default=0.0)
        inst = max((install_time(v) for v in versions), default=0.0)
        rows.append({"name": name, "type": "formula", "leaf": is_leaf,
                     "last_used": used, "installed": inst})
    return rows


def collect_casks(prefix: str) -> list[dict]:
    tokens = run(["brew", "list", "--cask"]).split()
    if not tokens:
        return []
    apps: dict[str, list[str]] = {}
    bins: dict[str, list[str]] = {}
    try:
        data = json.loads(run(["brew", "info", "--json=v2", "--cask", *tokens]))
        for c in data.get("casks", []):
            names, binaries = [], []
            for art in c.get("artifacts", []):
                if not isinstance(art, dict):
                    continue
                for a in art.get("app", []) or []:
                    if isinstance(a, str):
                        names.append(a)
                for b in art.get("binary", []) or []:
                    if isinstance(b, str):
                        binaries.append(os.path.basename(b))
                    elif isinstance(b, dict) and isinstance(b.get("target"), str):
                        binaries.append(os.path.basename(b["target"]))
            apps[c["token"]] = names
            bins[c["token"]] = binaries
    except (ValueError, KeyError):
        pass

    app_dirs = ("/Applications", os.path.expanduser("~/Applications"))

    def last_used(app: str) -> float:
        for base in app_dirs:
            p = os.path.join(base, app)
            if not os.path.exists(p):
                continue
            raw = run(["mdls", "-name", "kMDItemLastUsedDate", "-raw", p]).strip()
            if raw and raw != "(null)":
                try:
                    return time.mktime(time.strptime(raw.split(" +")[0],
                                                     "%Y-%m-%d %H:%M:%S"))
                except ValueError:
                    pass
            try:
                return os.stat(p).st_atime
            except OSError:
                pass
        return 0.0

    bindirs = (os.path.join(prefix, "bin"), os.path.expanduser("~/.local/bin"))

    def bin_used(names: list[str], tok: str) -> float:
        best = 0.0
        for cand in list(names) + [tok]:  # heuristic: token often matches binary
            for d in bindirs:
                p = os.path.join(d, cand)
                if os.path.exists(p):
                    try:
                        best = max(best, os.stat(p).st_atime)
                    except OSError:
                        pass
        return best

    rows = []
    for tok in tokens:
        used = max((last_used(a) for a in apps.get(tok, [])), default=0.0)
        if not used:  # CLI-only cask: fall back to the installed binary's atime
            used = bin_used(bins.get(tok, []), tok)
        inst = birthtime(os.path.join(prefix, "Caskroom", tok))
        rows.append({"name": tok, "type": "cask", "leaf": True,
                     "last_used": used, "installed": inst})
    return rows


# ---- rendering ----
class C:
    def __init__(self, on: bool):
        self.on = on

    def _w(self, code: str, s: str) -> str:
        return f"\033[{code}m{s}\033[0m" if self.on else s

    dim = lambda self, s: self._w("2", s)
    bold = lambda self, s: self._w("1", s)
    green = lambda self, s: self._w("32", s)
    yellow = lambda self, s: self._w("33", s)
    red = lambda self, s: self._w("31", s)
    grey = lambda self, s: self._w("90", s)
    cyan = lambda self, s: self._w("36", s)


def color_days(c: C, d: int | None) -> str:
    if d is None:
        return c.grey("jamais/?")
    label = f"{d}j"
    if d <= 30:
        return c.green(label)
    if d <= 180:
        return c.yellow(label)
    return c.red(label)


def fmt_date(t: float | None) -> str:
    return time.strftime("%Y-%m-%d", time.localtime(t)) if t else "—"


def summary(c: C, rows: list[dict]) -> None:
    buckets = [("≤7j", 0, 7), ("≤30j", 8, 30), ("≤90j", 31, 90),
               ("≤180j", 91, 180), ("≤1an", 181, 365), (">1an", 366, 10**9)]
    counts = []
    for _lbl, lo, hi in buckets:
        counts.append(sum(1 for r in rows
                          if r["days"] is not None and lo <= r["days"] <= hi))
    unknown = sum(1 for r in rows if r["days"] is None)
    n_form = sum(1 for r in rows if r["type"] == "formula")
    n_cask = sum(1 for r in rows if r["type"] == "cask")
    stale = sum(1 for r in rows if r["days"] is None or r["days"] > 180)
    print(c.bold(f"  {len(rows)} paquets analysés  ")
          + c.dim(f"· {n_form} formulae · {n_cask} casks · "
                  f"{stale} dorment >180j/inconnu"))
    print()
    mx = max(counts + [unknown, 1])
    allb = list(zip([b[0] for b in buckets], counts)) + [("inconnu", unknown)]
    tint = [c.green, c.green, c.yellow, c.yellow, c.red, c.red, c.grey]
    for (lbl, n), paint in zip(allb, tint):
        bar = paint("█" * int(n / mx * 34)) if n else ""
        print(f"  {lbl:>7} {bar} {c.dim(str(n))}")
    print()


def print_table(c: C, rows: list[dict], show_dates: bool) -> None:
    w = min(max((len(r["name"]) for r in rows), default=10), 34)
    head = f"  {'PAQUET':<{w}}  {'TYPE':<4}  {'DERNIER':>10}"
    if show_dates:
        head += f"  {'LE':<10}  {'INSTALLÉ':>9}"
    print(c.dim(head))
    for r in rows:
        name = r["name"] if len(r["name"]) <= w else r["name"][:w - 1] + "…"
        typ = c.cyan("cask") if r["type"] == "cask" else c.dim("form")
        # color codes have zero visible width, so pad the plain label first
        d_plain = "jamais/?" if r["days"] is None else f"{r['days']}j"
        used_cell = color_days(c, r["days"]) + " " * max(0, 10 - len(d_plain))
        line = f"  {c.bold(name)}{' ' * max(0, w - len(name))}  {typ}{' ' * (4 - 4)}  {used_cell}"
        if show_dates:
            line += f"  {c.dim(fmt_date(r['last_used'])):<10}"
            age = f"{r['age']}j" if r["age"] is not None else "—"
            line += f"  {c.dim(age):>9}"
        print(line)


