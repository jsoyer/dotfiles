#!/usr/bin/env bash
#
# cursor-setup — Install cursor-agent and configure the private Cursor worker.
#
# `cursor-agent worker start` connects this machine to Cursor so cloud agents
# run in YOUR environment. The service runs in --user scope: the binary, the
# auth (~/.local/share/cursor-agent) and the worktrees belong to the user.
#
# HISTORICAL TRAP: the old cursor-worker.service pointed at ~/.local/bin/agent,
# which is a symlink to the Grok CLI (no `worker` subcommand) → 262,000 failed
# restarts before anyone noticed. This script explicitly checks that the binary
# answers `worker --help` before enabling anything, and refuses to enable an
# unauthenticated worker.
#
# Linux only for now (the worker targets servers/RPis).
#
# SECOND TRAP: worker mode requires an API KEY (CURSOR_API_KEY). The session
# token from `cursor-agent login` is not accepted, even when `cursor-agent
# status` prints "Login successful". The key is stored 0600 in
# ~/.config/cursor/worker.env, read by the unit through EnvironmentFile=.
#
# Usage:
#   cursor-setup                        install + enable the worker
#   cursor-setup --api-key              masked prompt for the API key
#   cursor-setup --api-key-file <path>  read the key from a file
#   cursor-setup --worker-dir <path>    root exposed to agents (repeatable;
#                                       rewrites the override, never appends)
#   cursor-setup --clear-overrides      remove the local override
#   cursor-setup --name <name>          display name (default <hostname>-worker)
#   cursor-setup --no-service           binary only
#   cursor-setup --status
#   cursor-setup --update
#   cursor-setup --uninstall
#   cursor-setup --dry-run
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
INSTALL_URL="https://cursor.com/install"
BIN_DIR="${HOME}/.local/bin"
BIN="${BIN_DIR}/cursor-agent"
SERVICE="cursor-worker.service"
UPDATE_TIMER="cursor-update.timer"
# Worker API key. Read by the unit through EnvironmentFile=; never in the repo.
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/cursor/worker.env"

WORKER_DIRS=()
WORKER_NAME=""
CLEAR_OVERRIDES=0
API_KEY_PROMPT=0
API_KEY_FILE=""
DO_SERVICE=1
DRY_RUN=0
ASSUME_YES=0
ACTION="install"

# --- Helpers ------------------------------------------------------------------
c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[cursor-setup]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[cursor-setup]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[cursor-setup]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[cursor-setup]%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then printf '  %s+%s %s\n' "$c_y" "$c_0" "$*"; return 0; fi
  "$@"
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

# --- Option parsing -----------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --worker-dir)
      _d="${2:?path missing}"; shift
      # A mistyped path would slip through silently and the worker would expose
      # something other than intended: refuse right away, and normalise (~,
      # relative path, trailing slash) so the drop-in is comparable across runs.
      _d="${_d/#\~/$HOME}"
      [[ -d "$_d" ]] || die "Directory does not exist: ${_d} (typo?)"
      _d="$(cd "$_d" && pwd -P)"
      WORKER_DIRS+=("$_d")
      ;;
    --name)             WORKER_NAME="${2:?name missing}"; shift ;;
    --clear-overrides)  CLEAR_OVERRIDES=1 ;;
    --api-key)          API_KEY_PROMPT=1 ;;
    --api-key-file)     API_KEY_FILE="${2:?path missing}"; shift ;;
    --no-service)       DO_SERVICE=0 ;;
    --status)           ACTION="status" ;;
    --update)           ACTION="update" ;;
    --uninstall)        ACTION="uninstall" ;;
    --dry-run)          DRY_RUN=1 ;;
    -y|--yes)           ASSUME_YES=1 ;;
    -h|--help)          usage; exit 0 ;;
    *)                  die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

[[ "$(uname -s)" == "Linux" ]] || die "cursor-setup targets Linux (platform: $(uname -s))."

have_systemd_user() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

agent_path() { [[ -x "$BIN" ]] && echo "$BIN" || command -v cursor-agent 2>/dev/null || true; }

agent_version() { "$1" --version 2>/dev/null | head -1 || echo unknown; }

# Check the binary really is the Cursor CLI and not a namesake (the Grok CLI
# installs as `agent` in the same directory).
is_real_cursor_agent() {
  local p="$1"
  [[ -n "$p" && -x "$p" ]] || return 1
  "$p" worker --help >/dev/null 2>&1
}

# WARNING: `cursor-agent status` is NOT enough: it answers "Login successful"
# with the plain session token, while worker mode requires an API key and exits
# with "Authentication required for worker mode". `worker debug` is the only
# preflight that actually tests worker auth, so it is the source of truth.
worker_auth_ok() {
  local p="$1"
  # shellcheck disable=SC1090
  [[ -r "$ENV_FILE" ]] && set -a && . "$ENV_FILE" && set +a
  timeout 45 "$p" worker debug >/dev/null 2>&1
}

# Write the API key into a 0600 file read by the unit through EnvironmentFile=.
# Never a plaintext argument by default: the prompt is masked, otherwise the key
# would end up in the shell history.
write_api_key() {
  local key=""
  if [[ -n "$API_KEY_FILE" ]]; then
    [[ -r "$API_KEY_FILE" ]] || die "Key file unreadable: ${API_KEY_FILE}"
    key="$(tr -d '[:space:]' < "$API_KEY_FILE")"
  else
    printf 'Cursor API key (masked input, https://cursor.com/dashboard -> Integrations): '
    read -rs key
    echo
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
  fi
  [[ -n "$key" ]] || die "Empty key — nothing written."

  local dir; dir="$(dirname "$ENV_FILE")"
  run mkdir -p "$dir"
  run chmod 700 "$dir"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    ( umask 077; printf 'CURSOR_API_KEY=%s\n' "$key" > "$ENV_FILE" )
    chmod 600 "$ENV_FILE"
  fi
  ok "Key written to ${ENV_FILE} (0600, outside the chezmoi source)."
}

# --- Status -------------------------------------------------------------------
# systemctl is-active/is-enabled ALREADY print a state ("inactive", "not-found")
# and then exit non-zero: an `|| echo unknown` would add a SECOND line.
# So keep stdout only, with a default when it is empty.
sstate() { local out; out="$("$@" 2>/dev/null)" || true; echo "${out:-unknown}"; }

do_status() {
  local p; p="$(agent_path)"
  printf '%sCursor worker%s\n' "$c_b" "$c_0"
  if [[ -n "$p" ]]; then
    printf '  Binary   : %s (%s)\n' "$p" "$(agent_version "$p")"
    if is_real_cursor_agent "$p"; then
      printf '  CLI      : %svalid cursor-agent%s\n' "$c_g" "$c_0"
    else
      printf '  CLI      : %sdoes not answer `worker --help` — wrong binary?%s\n' "$c_r" "$c_0"
    fi
    printf '  Session  : %s\n' "$("$p" status >/dev/null 2>&1 && echo 'logged in' || echo 'not logged in')"
    printf '  API key  : %s\n' "$([[ -r "$ENV_FILE" ]] && echo "$ENV_FILE" || echo missing)"
    printf '  Wrk auth : %s\n' "$(worker_auth_ok "$p" && echo OK || echo 'FAILED — worker start will refuse to run')"
  else
    printf '  Binary   : %smissing%s\n' "$c_r" "$c_0"
  fi
  if have_systemd_user; then
    printf '  Service  : %s / %s\n' \
      "$(sstate systemctl --user is-active "$SERVICE")" \
      "$(sstate systemctl --user is-enabled "$SERVICE")"
    # The restart counter is THE signal of a silent failure loop.
    printf '  Restarts : %s\n' "$(sstate systemctl --user show -p NRestarts --value "$SERVICE")"
    printf '  Timer    : %s\n' "$(sstate systemctl --user is-active "$UPDATE_TIMER")"

    # Scope exposed to cloud agents. We print TWO things because they can
    # diverge: the config systemd loaded, and what the running process actually
    # exposes (when a restart was forgotten after writing a drop-in).
    local exec_line dirs_cfg dir_live
    exec_line="$(systemctl --user show -p ExecStart --value "$SERVICE" 2>/dev/null | grep -oP 'argv\[\]=\K[^;]*' || true)"
    dirs_cfg="$(printf '%s' "$exec_line" | grep -oP -- '--worker-dir \K[^ ]+' | paste -sd' ' - || true)"
    printf '  Config   : %s\n' "${dirs_cfg:-\$HOME (no --worker-dir)}"
    dir_live="$(journalctl --user -u "$SERVICE" -n 200 --no-pager 2>/dev/null | grep -oP 'Directory: \K.*' | tail -1 || true)"
    if [[ -n "$dir_live" ]]; then
      if [[ -n "$dirs_cfg" && " $dirs_cfg " != *" $dir_live "* ]]; then
        printf '  Exposed  : %s%s — DIVERGES from config: restart required%s\n' "$c_r" "$dir_live" "$c_0"
      else
        printf '  Exposed  : %s\n' "$dir_live"
      fi
    fi
    [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE}.d/override.conf" ]] \
      && printf '  Override : local drop-in present (cursor-setup --clear-overrides to remove it)\n'
  fi
}

[[ "$ACTION" == "status" ]] && { do_status; exit 0; }
[[ "$ACTION" == "update" ]] && exec "${BIN_DIR}/update-cursor-agent"

# --- Uninstall ----------------------------------------------------------------
if [[ "$ACTION" == "uninstall" ]]; then
  if [[ "$ASSUME_YES" -eq 0 ]]; then
    printf 'Disable the Cursor worker? (the binary is kept) [y/N] '
    read -r reply
    [[ "$reply" =~ ^[yY]$ ]] || { log "Cancelled."; exit 0; }
  fi
  if have_systemd_user; then
    run systemctl --user disable --now "$SERVICE" 2>/dev/null || true
    run systemctl --user disable --now "$UPDATE_TIMER" 2>/dev/null || true
    run systemctl --user reset-failed "$SERVICE" 2>/dev/null || true
    run systemctl --user daemon-reload
  fi
  ok "Worker disabled."
  exit 0
fi

# --- Step 1: binary -----------------------------------------------------------
P="$(agent_path)"
if [[ -n "$P" ]] && is_real_cursor_agent "$P"; then
  ok "cursor-agent already installed: ${P} ($(agent_version "$P"))"
else
  [[ -n "$P" ]] && warn "Binary present but without a 'worker' subcommand — reinstalling."
  log "Installing cursor-agent…"
  command -v curl >/dev/null 2>&1 || die "curl is required."
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  %s+%s curl -fsS %s | bash\n' "$c_y" "$c_0" "$INSTALL_URL"
  else
    curl -fsS "$INSTALL_URL" | bash || die "The cursor-agent installer failed."
    hash -r
    P="$(agent_path)"
    is_real_cursor_agent "$P" || die "cursor-agent installed but 'worker --help' fails — broken install."
    ok "cursor-agent installed: ${P} ($(agent_version "$P"))"
  fi
fi

if [[ "$DO_SERVICE" -eq 0 ]]; then
  ok "Done (--no-service)."
  exit 0
fi

[[ "$DRY_RUN" -eq 1 ]] || P="$(agent_path)"

# --- Step 2: worker authentication --------------------------------------------
# Without auth, `worker start` exits immediately: combined with Restart=always
# that is a guaranteed crash loop. We refuse to enable the service in that case.
[[ "$API_KEY_PROMPT" -eq 1 || -n "$API_KEY_FILE" ]] && write_api_key

if [[ "$DRY_RUN" -eq 0 ]] && ! worker_auth_ok "$P"; then
  warn "Worker mode is not authenticated."
  warn "The token from 'cursor-agent login' is not enough: the worker needs an API KEY."
  warn "Get it from https://cursor.com/dashboard -> Integrations."
  if [[ "$ASSUME_YES" -eq 1 || ! -t 0 ]]; then
    die "Re-run: cursor-setup --api-key  (or --api-key-file <path>). Service NOT enabled."
  fi
  printf 'Enter the API key now? [Y/n] '
  read -r reply
  if [[ "$reply" =~ ^[nN]$ ]]; then
    die "Service not enabled (an unauthenticated worker loops on failure)."
  fi
  write_api_key
  worker_auth_ok "$P" || die "Key rejected by 'worker debug' — service NOT enabled."
fi
ok "Worker authentication OK."

# --- Step 3: service ----------------------------------------------------------
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
[[ -f "${UNIT_DIR}/${SERVICE}" ]] \
  || die "Unit missing: ${UNIT_DIR}/${SERVICE} — run 'chezmoi apply' first."

# Local overrides (worker name, exposed directories): a drop-in rather than an
# edit of the unit, so chezmoi stays the owner of the base file.
DROPIN="${UNIT_DIR}/${SERVICE}.d"
DROPIN_CONF="${DROPIN}/override.conf"
DROPIN_CHANGED=0

if [[ "$CLEAR_OVERRIDES" -eq 1 ]]; then
  if [[ -f "$DROPIN_CONF" ]]; then
    run rm -f "$DROPIN_CONF"
    run rmdir "$DROPIN" 2>/dev/null || true
    DROPIN_CHANGED=1
    ok "Local overrides removed — back to the base unit."
  else
    log "No local override to remove."
  fi
elif [[ ${#WORKER_DIRS[@]} -gt 0 || -n "$WORKER_NAME" ]]; then
  # WARNING: an empty `ExecStart=` clears the line from the base unit: anything
  # we do not rewrite here is LOST, `--name` included. So we re-emit the base
  # name (<hostname>-worker) when --name is not given, otherwise the worker
  # would silently reappear in Cursor under a different name.
  eff_name="${WORKER_NAME:-$(hostname)-worker}"

  new_exec="ExecStart=%h/.local/bin/cursor-agent worker start --name ${eff_name}"
  for d in "${WORKER_DIRS[@]}"; do
    new_exec+=" --worker-dir ${d}"
  done

  run mkdir -p "$DROPIN"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    new_content="$(printf '# Generated by cursor-setup — local overrides for this machine.\n# Edit: cursor-setup --worker-dir <path>  |  remove: --clear-overrides\n[Service]\nExecStart=\n%s\n' "$new_exec")"
    if [[ ! -f "$DROPIN_CONF" ]] || [[ "$(cat "$DROPIN_CONF")" != "$new_content" ]]; then
      printf '%s' "$new_content" > "$DROPIN_CONF"
      DROPIN_CHANGED=1
      log "Drop-in updated: ${DROPIN_CONF}"
    else
      log "Drop-in already up to date — unchanged."
    fi
  else
    printf '  %s+%s write %s:\n      %s\n' "$c_y" "$c_0" "$DROPIN_CONF" "$new_exec"
  fi
fi

if ! have_systemd_user; then
  warn "systemd --user unavailable — start the worker by hand: cursor-agent worker start"
  exit 0
fi

# Linger keeps the --user manager alive after an SSH logout.
if ! loginctl show-user "$(id -un)" -p Linger 2>/dev/null | grep -q 'Linger=yes'; then
  log "Enabling linger…"
  run sudo loginctl enable-linger "$(id -un)" || warn "Could not enable linger."
fi

run systemctl --user daemon-reload
run systemctl --user reset-failed "$SERVICE" 2>/dev/null || true
run systemctl --user enable --now "$SERVICE"

# WARNING: `enable --now` does NOTHING to an already-running service: without
# this restart, a freshly written drop-in is loaded by systemd while the running
# process keeps the old command line — the change silently vanishes (and
# `systemctl show` reports the NEW value, which hides the problem).
if [[ "$DROPIN_CHANGED" -eq 1 ]] && systemctl --user is-active --quiet "$SERVICE"; then
  log "Overrides changed — restarting to apply them…"
  run systemctl --user restart "$SERVICE"
fi

if [[ "$DRY_RUN" -eq 1 ]]; then exit 0; fi

# --- Anti crash-loop check ----------------------------------------------------
# Read the restart counter AFTER a few seconds: it is the only signal that tells
# "started" apart from "failure loop".
log "Checking worker stability (15s)…"
sleep 5
n1="$(systemctl --user show -p NRestarts --value "$SERVICE" 2>/dev/null || echo 0)"
sleep 10
n2="$(systemctl --user show -p NRestarts --value "$SERVICE" 2>/dev/null || echo 0)"

if ! systemctl --user is-active --quiet "$SERVICE"; then
  # DISABLE it: leaving Restart=always on a failing service is exactly what
  # produced 262,000 invisible restarts.
  systemctl --user disable --now "$SERVICE" || true
  journalctl --user -u "$SERVICE" -n 15 --no-pager >&2 || true
  die "The worker did not start — service disabled. See: journalctl --user -u ${SERVICE} -e"
elif [[ "$n2" -gt "$n1" ]]; then
  systemctl --user disable --now "$SERVICE" || true
  journalctl --user -u "$SERVICE" -n 15 --no-pager >&2 || true
  die "The worker is restarting in a loop (${n1} → ${n2}) — service disabled to avoid a silent loop."
fi

ok "Cursor worker active and stable ✔"

# The update timer is only enabled AFTER the worker is confirmed running: a
# failed setup must not leave anything enabled behind it.
[[ -f "${UNIT_DIR}/cursor-update.timer" ]] && systemctl --user enable --now "$UPDATE_TIMER"

echo
do_status
