#!/usr/bin/env bash
# sysup — update everything on this machine (OS packages, flatpak, brew, omz,
# AI CLIs, mise, herdr). Extracted from the former `sysup()` shell function in
# dot_shell_common/aliases.sh so that bash, zsh, fish, nushell and the fleet
# agent all run the exact same code.
#
# Usage: sysup [--reboot]
#   --reboot  (Fedora desktop/server) stage the dnf upgrade offline and reboot
#             into it. Manual use only: fleet-agent never passes it (reboots go
#             through the agent's own `reboot` verb).
#
# Non-interactive by construction: nothing here may wait for a keypress, so it
# is safe to run detached (systemd-run --user, nohup) with no tty.
# Must run on stock macOS bash 3.2.

set -u

# Detached runs (systemd --user, nohup from sshd) start with a minimal PATH.
for _d in "$HOME/.local/bin" /home/linuxbrew/.linuxbrew/bin /opt/homebrew/bin /usr/local/bin; do
  case ":$PATH:" in
    *":$_d:"*) ;;
    *) [ -d "$_d" ] && PATH="$PATH:$_d" ;;
  esac
done
export PATH
unset _d

# apt/needrestart must never prompt. The sudoers rule keeps these two variables
# (env_keep) and matches the exact apt-get command lines used below.
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=l
# Homebrew: no confirmation prompt, even when the shell env files were not loaded
# (HOMEBREW_NO_ASK is normally exported by dot_zsh/00-env.zsh.tmpl).
export HOMEBREW_NO_ASK=1
export NONINTERACTIVE=1

# MACHINE_PROFILE is exported by the interactive shell config; detached runs do
# not have it, so derive it from /etc/os-release when unset.
_sysup_detect_profile() {
  [[ -n "${MACHINE_PROFILE:-}" ]] && return 0
  [[ "$OSTYPE" == linux* ]] || return 0
  local id="" like=""
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    id="$(. /etc/os-release; printf '%s' "${ID:-}")"
    # shellcheck disable=SC1091
    like="$(. /etc/os-release; printf '%s' "${ID_LIKE:-}")"
  fi
  case "$id $like" in
    *fedora*|*rhel*)   MACHINE_PROFILE=fedora-server ;;
    *arch*)            MACHINE_PROFILE=arch-server ;;
    *debian*|*ubuntu*) MACHINE_PROFILE=debian ;;
  esac
  export MACHINE_PROFILE
}

# dnf systems: warn when updated packages (kernel, glibc, systemd...) only take
# effect after a reboot. --disablerepo: only the rpm database is needed, so it
# runs as the user, offline, in under a second. Exit code 1 = reboot needed.
_sysup_reboot_hint() {
  command -v dnf &>/dev/null || return 0
  if ! dnf needs-restarting --disablerepo='*' &>/dev/null; then
    echo "⚠️  Reboot needed to load the updates (running kernel $(uname -r)) — run: sysup --reboot"
  fi
}

# A CLI whose binary resolves under the brew prefix is brew-managed (macOS
# casks: claude-code, copilot-cli, cursor-cli, grok-build…): bup/bcu already
# updates it, and running its own updater would install a second copy that
# fights the cask — the pi/qwen duplicate disease.
_ai_brew_owned() {
  local t bp
  t="$(readlink -f "$(command -v "$1" 2>/dev/null)" 2>/dev/null)" || return 1
  bp="$(brew --prefix 2>/dev/null)" || return 1
  [[ -n "$bp" && "$t" == "$bp"/* ]]
}

# oh-my-zsh and its custom plugins are chezmoi git-repo externals refreshed
# only every 168h — pull them now so sysup means "everything is current".
update-omz() {
  local d
  for d in "$HOME/.oh-my-zsh" \
           "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions" \
           "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"; do
    [[ -d "$d/.git" ]] || continue
    git -C "$d" pull --ff-only -q 2>/dev/null || true
  done
}

# Update CLI AI tools (claude-code, copilot-cli, codex, ...). Kept in sync with
# the interactive `update-ai` helper in dot_shell_common/aliases.sh.
update-ai() {
  echo "🤖 Updating CLI AI tools..."
  if command -v claude &>/dev/null; then
    if _ai_brew_owned claude; then
      echo "  🤖 Claude Code: brew-managed — bup handles it"
    else
      echo "  🤖 Updating Claude Code..."
      claude update 2>/dev/null || true
    fi
  fi
  # The binary is `copilot` since the standalone CLI; older installs shipped
  # `copilot-cli`. Probing only the old name silently skipped it everywhere.
  if command -v copilot &>/dev/null || command -v copilot-cli &>/dev/null; then
    if _ai_brew_owned copilot || _ai_brew_owned copilot-cli; then
      echo "  🤖 Copilot CLI: brew-managed — bup handles it"
    else
      echo "  🤖 Updating Copilot CLI..."
      curl -fsSL https://gh.io/copilot-install | bash 2>/dev/null || true
    fi
  fi
  if command -v codex &>/dev/null; then
    if _ai_brew_owned codex; then
      echo "  🤖 Codex CLI: brew-managed — bup handles it"
    else
      echo "  🤖 Updating Codex CLI..."
      codex update 2>/dev/null || true
    fi
  fi
  # Grok: NEVER probe `agent` on PATH — that name is owned by cursor-agent
  # (it has flip-flopped between the two; it caused the cursor-worker
  # crash-loop). The Grok CLI home is authoritative.
  if [[ -x "$HOME/.grok/bin/agent" ]]; then
    echo "  🤖 Updating Grok CLI..."
    "$HOME/.grok/bin/agent" update 2>/dev/null || true
  fi
  # cursor-agent: through our updater, which restarts the worker, watches for
  # a crash loop and prunes old versions — not the raw `cursor-agent update`.
  # Probe the BINARY too: chezmoi deploys the update-cursor-agent script on
  # every machine, including ones (Pis, Macs) where cursor-agent itself is not
  # installed — without this, every sysup there printed a confusing error.
  if command -v cursor-agent &>/dev/null && command -v update-cursor-agent &>/dev/null; then
    if _ai_brew_owned cursor-agent; then
      echo "  🤖 cursor-agent: brew-managed — bup handles it"
    else
      echo "  🤖 Updating cursor-agent..."
      update-cursor-agent || true
    fi
  fi
  if command -v pi &>/dev/null && ! _ai_brew_owned pi; then
    echo "  🤖 Updating pi (pi.dev) + extensions..."
    pi update --all 2>/dev/null || true
  fi
  # omp: macOS Homebrew is the channel (bup). Elsewhere the official
  # one-liner / `omp update`.
  if command -v omp &>/dev/null; then
    if _ai_brew_owned omp; then
      echo "  🤖 omp: brew-managed — bup handles it"
    else
      echo "  🤖 Updating omp..."
      omp update 2>/dev/null || curl -fsSL https://omp.sh/install | sh 2>/dev/null || true
    fi
  fi
  # agy (Antigravity CLI): macOS Homebrew cask is the channel (bup). Linux:
  # official installer, updated in place by `agy update`.
  if command -v agy &>/dev/null; then
    if _ai_brew_owned agy; then
      if [[ "$(uname -s)" == "Darwin" ]]; then
        echo "  🤖 Antigravity CLI: brew-managed — bup handles it"
      else
        echo "  ⚠️  Antigravity CLI: Linuxbrew copy — run 'install-ai --only agy' to migrate to the official install"
      fi
    else
      echo "  🤖 Updating Antigravity CLI..."
      agy update 2>/dev/null || true
    fi
  fi
}

# mise owns toolchains Homebrew cannot pour on this host (rust on Intel macOS is
# Tier 3: no bottle, an hour of source build per bump). brew upgrade used to keep
# those current — once a tool moves to mise, nothing does unless sysup asks.
_update_mise_if_present() {
  if ! command -v mise &>/dev/null; then
    return 0
  fi
  echo "🔧 Updating mise tools..."
  mise upgrade || true
}

_update_herdr_if_present() {
  if ! command -v herdr &>/dev/null; then
    return 0
  fi
  if _ai_brew_owned herdr; then
    echo "📺 herdr: brew-managed — bup handles it"
    return 0
  fi
  if command -v update-herdr &>/dev/null; then
    echo "📺 Updating herdr..."
    update-herdr || true
  fi
}

# `sysup --reboot` (Fedora desktop/server): stage the dnf upgrade offline and
# reboot into it, so nothing is replaced under the running session.
# Exit status: non-zero when the OS package manager step failed (the fleet agent
# turns that into `failed`). Best-effort extras (flatpak, AI CLIs...) never
# change it, as before.
_sysup_rc=0

sysup() {
  local os reboot=0 arg
  for arg in "$@"; do
    [[ "$arg" == "--reboot" ]] && reboot=1
  done
  case "$OSTYPE" in
    darwin*) os="darwin" ;;
    linux*)  os="linux" ;;
    cygwin*|msys*|mingw*) os="windows" ;;
    *) return ;;
  esac
  _sysup_detect_profile

  case "$os" in
    darwin)
      breww upgrade       # was alias bup
      breww cu -a         # was alias bcu (brew-cask-upgrade)
      if command -v mas &>/dev/null; then
        echo "📱 Updating App Store apps..."
        mas upgrade
      fi
      # bup/bcu upgrade but never reclaim: do it explicitly. See the Linux
      # branch below for what --prune=all -s actually removes.
      if command -v brew &>/dev/null; then
        echo "🍺 Cleaning up Homebrew cache..."
        brew cleanup --prune=all -s
      fi
      echo "🐚 Updating oh-my-zsh..."
      update-omz
      # The AI CLIs update on macOS too — this call only existed in the
      # Linux branch, so Macs never updated any of them through sysup.
      update-ai
      _update_mise_if_present
      _update_herdr_if_present
      ;;
    linux)
      case "${MACHINE_PROFILE:-}" in
        rpi|ubuntu-desktop|ubuntu-server|debian)
          echo "📦 Updating apt packages..."
          # --force-confdef/--force-confold: never ask about a modified conffile
          # (the new one is kept next to it as .dpkg-dist and reported).
          sudo apt-get update \
            && sudo apt-get dist-upgrade -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
            && sudo apt-get autoremove -y || _sysup_rc=1
          ;;
        arch-desktop|arch-server|omarchy)
          echo "📦 Updating pacman packages..."
          sudo pacman -Syu --noconfirm || _sysup_rc=1
          if command -v yay &>/dev/null; then
            echo "📦 Updating AUR packages..."
            yay -Sua --noconfirm
          fi
          ;;
        fedora-desktop|fedora-server|toolbox)
          if [[ "$reboot" == 1 && "${MACHINE_PROFILE}" != toolbox ]]; then
            echo "📦 Staging dnf offline upgrade..."
            # A stale stored transaction (e.g. left by GNOME Software) makes
            # `--offline` refuse to queue a new one.
            sudo dnf offline clean
            sudo dnf upgrade --refresh --offline -y || _sysup_rc=1
          else
            echo "📦 Updating dnf packages..."
            sudo dnf upgrade --refresh -y || _sysup_rc=1
          fi
          ;;
        fedora-atomic)
          echo "🔒 Updating Fedora Atomic..."
          rpm-ostree upgrade || _sysup_rc=1
          ;;
      esac

      if command -v flatpak &>/dev/null; then
        echo "📦 Updating Flatpak apps..."
        # Split by scope. A bare `flatpak update` also targets system-scope
        # installs, and polkit refuses a non-interactive deploy for a normal
        # user: "Flatpak system operation Deploy not allowed for user", which
        # then makes the whole command exit non-zero.
        flatpak update --user -y || true
        if flatpak list --system --columns=application 2>/dev/null | grep -q .; then
          sudo flatpak update --system -y || true
        fi
      fi

      if command -v brew &>/dev/null; then
        eval "$(brew shellenv)"
        echo "🍺 Updating Linuxbrew packages..."
        brew update && brew upgrade
        # --prune=all removes ALL cached downloads (not just those older than 120
        # days), -s also clears the download cache itself. On a Pi with a small
        # SD card this is the difference between a few hundred MB and a few GB.
        brew cleanup --prune=all -s
      fi

      echo "🐚 Updating oh-my-zsh..."
      update-omz
      update-ai
      _update_mise_if_present
      _update_herdr_if_present

      if [[ "$reboot" == 1 && ( "${MACHINE_PROFILE:-}" == fedora-desktop || "${MACHINE_PROFILE:-}" == fedora-server ) ]]; then
        echo "🔄 Rebooting to apply the offline upgrade..."
        # Fails when nothing was staged (already up to date): fall back to the hint.
        sudo dnf offline reboot -y || _sysup_reboot_hint
      else
        _sysup_reboot_hint
      fi
      ;;
    windows)
      echo "🪣 Updating Scoop packages..."
      scoop update --all
      ;;
  esac
}

sysup "$@"
exit "$_sysup_rc"
