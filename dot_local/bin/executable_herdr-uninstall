#!/usr/bin/env bash
# herdr-uninstall — take herdr off this machine.
#
# `herdr-setup --uninstall` only disables the update timer and says the rest is
# manual. This does the rest: stops the auto-daemonised server, removes the
# binary and, on macOS, the brew formula.

set -euo pipefail

ASSUME_YES=0
PURGE=0

usage() {
    cat <<'EOF'
Usage: herdr-uninstall [-y] [--purge]

  -y, --yes    do not ask for confirmation
  --purge      also drop ~/.config/herdr

Stops the herdr server (live sessions and panes are lost), disables the update
timer, removes the binary, and uninstalls the brew formula on macOS.
EOF
}

for arg in "$@"; do
    case "$arg" in
        -y|--yes) ASSUME_YES=1 ;;
        --purge) PURGE=1 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "herdr-uninstall: unknown option: $arg" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ "$ASSUME_YES" -eq 0 ]]; then
    echo "This stops the herdr server — running sessions and panes are lost."
    printf 'Remove herdr from this machine? [y/N] '
    read -r reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
fi

OS="$(uname -s)"

# The server reparents to PID 1, so systemd does not own it: ask it to stop.
if command -v herdr &>/dev/null; then
    echo "🛑 Stopping the herdr server..."
    herdr server stop 2>/dev/null || true
fi

if command -v herdr-setup &>/dev/null; then
    echo "⏱️  Disabling the update timer (herdr-setup --uninstall)..."
    herdr-setup --uninstall -y || true
fi

if [[ "$OS" == "Linux" ]]; then
    units_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
    removed_units=0
    for unit in herdr-update.service herdr-update.timer; do
        if [[ -f "${units_dir}/${unit}" ]]; then
            rm -f "${units_dir}/${unit}"
            removed_units=1
        fi
    done
    if [[ "$removed_units" -eq 1 ]]; then
        systemctl --user daemon-reload 2>/dev/null || true
        echo "⚠️  The unit files are chezmoi-managed: the next \`chezmoi apply\` puts"
        echo "    them back. Run \`chezmoi forget\` on them to make this stick."
    fi
elif command -v brew &>/dev/null; then
    eval "$(brew shellenv)"
    brew list --formula herdr &>/dev/null && brew uninstall herdr || true
fi

rm -f "${HOME}/.local/bin/herdr" "${HOME}/.local/bin/herdr.bak" 2>/dev/null || true

[[ "$PURGE" -eq 1 ]] && rm -rf "${XDG_CONFIG_HOME:-${HOME}/.config}/herdr"

echo "✅ herdr removed."
echo "   Still declared in the Brewfiles — drop \"herdr\" there (and blacklist it)"
echo "   or the next bundle run reinstalls it."
