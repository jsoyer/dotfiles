#!/usr/bin/env bash
# secret-age — Check age of secrets/tokens and warn if stale
# Usage: secret-age [--days N]

set -uo pipefail

# --- Colors ---
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

THRESHOLD_DAYS="${1:-90}"
[[ "$1" == "--days" ]] && THRESHOLD_DAYS="${2:-90}"

echo -e "${BOLD}Secret Age Audit (threshold: ${THRESHOLD_DAYS} days)${NC}"
echo ""

NOW=$(date +%s)
WARN=0

_check_file_age() {
    local label="$1" filepath="$2"
    if [[ ! -f "${filepath}" ]]; then
        printf "  ${YELLOW}%-35s MISSING${NC}\n" "${label}"
        WARN=$((WARN + 1))
        return
    fi

    local mtime
    if [[ "$(uname)" == "Darwin" ]]; then
        mtime=$(stat -f %m "${filepath}" 2>/dev/null || echo 0)
    else
        mtime=$(stat -c %Y "${filepath}" 2>/dev/null || echo 0)
    fi

    local age_days=$(( (NOW - mtime) / 86400 ))

    if (( age_days > THRESHOLD_DAYS )); then
        printf "  ${RED}%-35s %4d days old${NC}\n" "${label}" "${age_days}"
        WARN=$((WARN + 1))
    elif (( age_days > THRESHOLD_DAYS / 2 )); then
        printf "  ${YELLOW}%-35s %4d days old${NC}\n" "${label}" "${age_days}"
    else
        printf "  ${GREEN}%-35s %4d days old${NC}\n" "${label}" "${age_days}"
    fi
}

# SSH keys
echo -e "${BOLD}SSH Keys:${NC}"
for key in "${HOME}"/.ssh/id_*; do
    [[ -f "${key}" ]] || continue
    [[ "${key}" == *.pub ]] && continue
    _check_file_age "$(basename "${key}")" "${key}"
done

# Age encryption key
echo ""
echo -e "${BOLD}Encryption Keys:${NC}"
_check_file_age "chezmoi age key" "${HOME}/.config/chezmoi/key.txt"

# Secrets file
echo ""
echo -e "${BOLD}Secret Files:${NC}"
_check_file_age "secrets.zsh" "${HOME}/.zsh/secrets.zsh"
_check_file_age "secrets.bash" "${HOME}/.bash/secrets.bash"

# GitHub CLI token
echo ""
echo -e "${BOLD}CLI Auth:${NC}"
if command -v gh &>/dev/null; then
    GH_CONFIG="${HOME}/.config/gh/hosts.yml"
    _check_file_age "gh auth" "${GH_CONFIG}"
fi

echo ""
if (( WARN > 0 )); then
    echo -e "${RED}${WARN} secret(s) need attention${NC}"
    echo "Consider rotating secrets older than ${THRESHOLD_DAYS} days."
else
    echo -e "${GREEN}All secrets within ${THRESHOLD_DAYS} day threshold${NC}"
fi
