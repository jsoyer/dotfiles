#!/usr/bin/env bash
# t3-uninstall — take T3 Code off this machine (Linux, user scope).
#
# Stops the monitoring and updater units, runs `t3 service uninstall` then
# `t3 uninstall` (upstream), and removes the units t3-setup generated.
# Data in ~/.t3 is KEPT unless --purge. Linger is left as is (other user
# services may need it). On macOS T3 Code is just the cask.

set -euo pipefail

ASSUME_YES=0
PURGE=0

usage() {
    cat <<'EOF'
Usage: t3-uninstall [-y] [--purge]

  -y, --yes    do not ask for confirmation
  --purge      also drop ~/.t3 (data, service.env, auth)

Linux: t3-health/t3-update timers and units, t3 service uninstall, t3 uninstall.
macOS: uninstalls the t3-code cask.
EOF
}

for arg in "$@"; do
    case "$arg" in
        -y|--yes) ASSUME_YES=1 ;;
        --purge) PURGE=1 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "t3-uninstall: unknown option: $arg" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ "$ASSUME_YES" -eq 0 ]]; then
    printf 'Remove T3 Code from this machine? [y/N] '
    read -r reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
fi

if [[ "$(uname -s)" == "Darwin" ]]; then
    if command -v brew &>/dev/null; then
        eval "$(brew shellenv)"
        brew list --cask t3-code &>/dev/null && brew uninstall --cask --zap t3-code || true
    fi
    [[ "$PURGE" -eq 1 ]] && rm -rf "${HOME}/.t3"
    echo "T3 Code removed (cask)."
    exit 0
fi

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

echo "Stopping monitoring and updater..."
if command -v systemctl &>/dev/null; then
    systemctl --user disable --now t3-health.timer t3-update.timer 2>/dev/null || true
fi
rm -rf "${UNIT_DIR}/t3code.service.d"
rm -f "${UNIT_DIR}"/t3-{health,update}.{service,timer} "${UNIT_DIR}/t3-alert@.service"
systemctl --user daemon-reload 2>/dev/null || true

if command -v t3 &>/dev/null; then
    echo "Removing the service and the CLI (upstream)..."
    t3 service uninstall || true
    t3 uninstall || true
fi

rm -rf "${XDG_STATE_HOME:-$HOME/.local/state}/t3-health"
[[ "$PURGE" -eq 1 ]] && rm -rf "${HOME}/.t3"

echo "T3 Code removed."
