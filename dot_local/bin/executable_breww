#!/usr/bin/env python3
"""
Smart Homebrew wrapper that automatically keeps the profile-specific
Brewfile up to date and syncs changes to Git.

The shared base Brewfile (selected by MACHINE_PROFILE) is NEVER overwritten
by a dump. Instead, a per-hostname overlay (Brewfile_<hostname>) receives
only the delta: installed − base − blacklist.
"""

import argparse
import os
import subprocess
import sys
import tempfile
from pathlib import Path

# --- Configuration ---
CHEZMOI_SOURCE_PATH = Path(
    os.environ.get("CHEZMOI_SOURCE_PATH", Path.home() / ".local" / "share" / "chezmoi")
)
BREWFILE_DIR = CHEZMOI_SOURCE_PATH / "dot_private"

# --- Colors ---
BLUE = "\033[0;34m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
NC = "\033[0m"


NATIVE_PACKAGES = {
    "bat", "chezmoi", "curl", "eza", "fd", "fontconfig", "fzf", "git",
    "jq", "neovim", "ripgrep", "starship", "tmux", "unzip", "vivid",
    "wget", "zoxide", "zsh", "atuin", "htop", "tree",
}

NATIVE_WRAPPER = {
    "ubuntu-desktop": "aptw",
    "ubuntu-server": "aptw",
    "debian": "aptw",
    "rpi": "aptw",
    "fedora-desktop": "dnfw",
    "fedora-server": "dnfw",
    "arch-desktop": "pacmanw",
    "arch-server": "pacmanw",
}


def get_hostname() -> str:
    """Return the short hostname (no domain)."""
    return os.uname().nodename.split(".")[0]


def get_target_brewfile():
    """Return the shared base Brewfile path for the current profile (read-only reference)."""
    profile = os.environ.get("MACHINE_PROFILE")
    if profile == "mac-pro":
        return BREWFILE_DIR / "Brewfile_pro"
    elif profile == "mac-personal":
        return BREWFILE_DIR / "Brewfile_personal"
    elif profile == "rpi":
        return BREWFILE_DIR / "Brewfile_rpi"
    elif profile == "fedora-atomic":
        return BREWFILE_DIR / "Brewfile_fedora_atomic"
    elif profile in ("ubuntu-desktop", "fedora-desktop", "arch-desktop", "toolbox"):
        return BREWFILE_DIR / "Brewfile_brew_only"
    else:
        return None


def get_host_brewfile() -> Path:
    """Return the per-hostname overlay Brewfile path."""
    return BREWFILE_DIR / f"Brewfile_{get_hostname()}"


def check_native_available(args):
    """Warn if a package is available natively on Linux."""
    profile = os.environ.get("MACHINE_PROFILE", "")
    wrapper = NATIVE_WRAPPER.get(profile)
    if not wrapper:
        return

    for arg in args:
        if not arg.startswith("-") and arg in NATIVE_PACKAGES:
            print(
                f"{YELLOW}Warning: '{arg}' is available natively via {wrapper}. "
                f"Consider using {wrapper} instead.{NC}"
            )


def run_brew_command(args):
    """Execute the brew command."""
    cmd = ["brew"] + args
    print(f"{BLUE}Running: {' '.join(cmd)}{NC}")
    result = subprocess.run(cmd)
    return result.returncode


def load_package_list(path: Path) -> list[str]:
    """Load a one-token-per-line package list. Comments and blanks are ignored."""
    if not path.exists():
        return []
    packages: list[str] = []
    seen: set[str] = set()
    with path.open() as f:
        for raw in f:
            line = raw.split("#", 1)[0].strip()
            if not line or line in seen:
                continue
            seen.add(line)
            packages.append(line)
    return packages


def load_blacklist() -> set:
    """Load the set of blacklisted package identity strings from Brewfile_blacklist."""
    return set(load_package_list(BREWFILE_DIR / "Brewfile_blacklist"))


def get_cu_skip_file() -> Path:
    """Per-hostname cask skip list (bulk `cu` / `upgrade` only)."""
    return BREWFILE_DIR / f"Brewfile_cu_skip_{get_hostname()}"


def iter_cu_skip_files() -> list[Path]:
    """Skip files for this host and MACHINE_PROFILE (hostname match is case-insensitive)."""
    keys = {get_hostname().lower()}
    profile = os.environ.get("MACHINE_PROFILE", "")
    if profile:
        keys.add(profile.lower())
    found: list[Path] = []
    seen: set[Path] = set()
    if not BREWFILE_DIR.is_dir():
        return found
    for path in sorted(BREWFILE_DIR.glob("Brewfile_cu_skip_*")):
        suffix = path.name[len("Brewfile_cu_skip_") :]
        if suffix.lower() in keys and path not in seen:
            seen.add(path)
            found.append(path)
    return found


def load_cu_skip() -> list[str]:
    """Merge hostname + profile skip lists, preserving first-seen order."""
    packages: list[str] = []
    seen: set[str] = set()
    for path in iter_cu_skip_files():
        for pkg in load_package_list(path):
            if pkg not in seen:
                seen.add(pkg)
                packages.append(pkg)
    return packages


def _split_brew_args(args: list[str]) -> tuple[str, list[str], list[str]]:
    """Split `brew` argv into (command, flags, positionals)."""
    if not args:
        return "", [], []
    flags: list[str] = []
    positionals: list[str] = []
    for arg in args[1:]:
        if arg == "--":
            continue
        if arg.startswith("-"):
            flags.append(arg)
        else:
            positionals.append(arg)
    return args[0], flags, positionals


def plan_brew_commands(
    args: list[str],
    skip: list[str],
    *,
    installed_casks: list[str] | None = None,
    outdated_casks: list[str] | None = None,
) -> list[list[str]]:
    """
    Rewrite bulk `cu` / `upgrade` so host-local skip casks are not touched.

    Explicit package names (e.g. `breww cu -a obs`) are honored as-is.
    A bare `brew cu -a` must never be emitted when a skip list is active:
    that would upgrade the skipped casks too.
    """
    if not args:
        return []
    if not skip:
        return [args]

    cmd, flags, positionals = _split_brew_args(args)
    skip_set = set(skip)

    if cmd == "cu":
        if positionals:
            return [args]
        remaining = [c for c in (installed_casks or []) if c not in skip_set]
        if not remaining:
            return []
        return [[cmd, *flags, *remaining]]

    if cmd == "upgrade":
        if positionals:
            return [args]
        if "--formula" in flags and "--cask" not in flags:
            return [args]
        remaining = [c for c in (outdated_casks or []) if c not in skip_set]
        other_flags = [f for f in flags if f not in ("--formula", "--cask")]
        plans: list[list[str]] = []
        if "--cask" not in flags:
            plans.append(["upgrade", "--formula", *other_flags])
        if remaining:
            plans.append(["upgrade", "--cask", *other_flags, *remaining])
        return plans

    return [args]


def brew_list_casks() -> list[str]:
    """Installed cask tokens, or empty if the query fails (fail closed)."""
    result = subprocess.run(
        ["brew", "list", "--cask", "-1"],
        capture_output=True,
        text=True,
    )
    names = [ln.strip() for ln in result.stdout.splitlines() if ln.strip()]
    if result.returncode != 0 and not names:
        print(
            f"{RED}Warning: brew list --cask failed; "
            f"skipping bulk cask upgrade to honor the skip list{NC}"
        )
        return []
    return names


def brew_outdated_casks(*, greedy: bool = False) -> list[str]:
    """Outdated cask tokens, or empty if the query fails (fail closed)."""
    cmd = ["brew", "outdated", "--cask", "--quiet"]
    if greedy:
        cmd.append("--greedy")
    result = subprocess.run(cmd, capture_output=True, text=True)
    names = [ln.strip() for ln in result.stdout.splitlines() if ln.strip()]
    if result.returncode not in (0, 1) and not names:
        print(
            f"{RED}Warning: brew outdated --cask failed; "
            f"skipping cask upgrades to honor the skip list{NC}"
        )
        return []
    return names


def _extract_identity(line: str) -> str | None:
    """
    Extract the canonical identity string from a Brewfile line.

    Returns the quoted name for brew/cask/tap/mas lines, e.g.:
      brew "git"        → git
      cask "1password"  → 1password
      tap "homebrew/core" → homebrew/core
      mas "Amphetamine", id: 937984704 → Amphetamine
    Returns None for comments or blank lines.
    """
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return None
    for keyword in ("brew", "cask", "tap", "mas"):
        if stripped.startswith(keyword + " "):
            # Extract the first quoted token
            for q in ('"', "'"):
                start = stripped.find(q)
                if start != -1:
                    end = stripped.find(q, start + 1)
                    if end != -1:
                        return stripped[start + 1:end]
    return None


def parse_brewfile_entries(path: Path) -> dict[str, str]:
    """
    Parse a Brewfile and return a mapping of identity → full original line.
    Only brew/cask/tap/mas lines are included.
    """
    if not path.exists():
        return {}
    entries: dict[str, str] = {}
    for line in path.read_text().splitlines():
        identity = _extract_identity(line)
        if identity is not None:
            entries[identity] = line
    return entries


def _is_blacklisted(line: str, blacklist: set) -> bool:
    """Return True if the line matches any blacklist entry."""
    stripped = line.strip()
    for pkg in blacklist:
        if f'"{pkg}"' in stripped or f"'{pkg}'" in stripped:
            return True
    return False


def dump_host_overlay(base_brewfile: Path | None):
    """
    Full delta-dump flow:
    1. brew bundle dump → tmp file (full installed state)
    2. Parse tmp, base, and blacklist
    3. host_entries = tmp − base − blacklist
    4. Write host overlay file
    """
    hostname = get_hostname()
    host_file = get_host_brewfile()

    print(f"\n{YELLOW}Dumping host overlay: {host_file.name}{NC}")

    with tempfile.NamedTemporaryFile(suffix=".Brewfile", delete=False, mode="w") as tf:
        tmp_path = Path(tf.name)

    try:
        result = subprocess.run(
            ["brew", "bundle", "dump", "--file", str(tmp_path), "--force"],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            print(f"{RED}Warning: brew bundle dump failed: {result.stderr}{NC}")
            return

        tmp_entries = parse_brewfile_entries(tmp_path)
        base_entries = parse_brewfile_entries(base_brewfile) if base_brewfile else {}
        blacklist = load_blacklist()

        host_lines = []
        for identity, line in tmp_entries.items():
            if identity in base_entries:
                continue
            if _is_blacklisted(line, blacklist):
                continue
            host_lines.append(line)

        host_file.parent.mkdir(parents=True, exist_ok=True)
        header = (
            f"# Host overlay for {hostname} — extras beyond the shared base.\n"
            f"# Managed by breww. Do not edit manually.\n"
        )
        host_file.write_text(header + "\n".join(host_lines) + ("\n" if host_lines else ""))
        print(
            f"{GREEN}Host overlay written: {len(host_lines)} entries "
            f"({len(tmp_entries) - len(host_lines)} in base/blacklist){NC}"
        )
    finally:
        tmp_path.unlink(missing_ok=True)


def promote_entry(name: str, base_brewfile: Path | None):
    """
    Move a single entry identified by <name> from the host overlay into the base file.
    """
    if base_brewfile is None:
        print(f"{RED}Error: no base Brewfile for current profile — cannot promote{NC}")
        sys.exit(1)

    host_file = get_host_brewfile()
    if not host_file.exists():
        print(f"{RED}Error: host overlay {host_file.name} does not exist{NC}")
        sys.exit(1)

    host_entries = parse_brewfile_entries(host_file)
    if name not in host_entries:
        print(f"{RED}Error: '{name}' not found in {host_file.name}{NC}")
        sys.exit(1)

    line_to_promote = host_entries[name]

    # Remove from host overlay
    host_lines = [
        l for l in host_file.read_text().splitlines()
        if _extract_identity(l) != name
    ]
    host_file.write_text("\n".join(host_lines) + "\n")
    print(f"{GREEN}Removed '{name}' from {host_file.name}{NC}")

    # Append to base
    base_content = base_brewfile.read_text()
    if not base_content.endswith("\n"):
        base_content += "\n"
    base_brewfile.write_text(base_content + line_to_promote + "\n")
    print(f"{GREEN}Added '{name}' to {base_brewfile.name}{NC}")

    sync_to_git()


def sync_to_git():
    """Commit and push changes in the chezmoi repository."""
    print(f"\n{BLUE}Syncing with Git...{NC}")
    try:
        subprocess.run(["git", "add", "."], cwd=CHEZMOI_SOURCE_PATH, check=True)
        result = subprocess.run(
            ["git", "commit", "--no-gpg-sign", "-m", "style(brew): update brewfiles via breww"],
            cwd=CHEZMOI_SOURCE_PATH,
        )
        if result.returncode not in (0, 1):
            raise subprocess.CalledProcessError(result.returncode, "git commit")
        # Pull --rebase before push to avoid "rejected: fetch first" errors
        subprocess.run(
            ["git", "pull", "--rebase", "origin", "main"],
            cwd=CHEZMOI_SOURCE_PATH,
        )
        subprocess.run(["git", "push"], cwd=CHEZMOI_SOURCE_PATH, check=True)
        print(f"{GREEN}Pushed to remote.{NC}")
    except subprocess.CalledProcessError as e:
        print(f"Warning: Git sync failed: {e}")


def main():
    import shutil

    # Handle --promote before the brew-binary check (it's a pure-manifest operation)
    if "--promote" in sys.argv:
        idx = sys.argv.index("--promote")
        if idx + 1 >= len(sys.argv):
            print(f"{RED}Error: --promote requires a package name argument{NC}")
            sys.exit(1)
        entry_name = sys.argv[idx + 1]
        base_brewfile = get_target_brewfile()
        promote_entry(entry_name, base_brewfile)
        sync_to_git()
        return

    if not shutil.which("brew"):
        print(f"{RED}brew not found. Install Homebrew first: https://brew.sh{NC}")
        sys.exit(1)

    args = sys.argv[1:]

    if not args or args[0] in ("--help", "-h"):
        hostname = get_hostname()
        base_brewfile = get_target_brewfile()
        print(
            f"breww — Homebrew wrapper with per-host overlay manifest sync\n\n"
            f"Usage:\n"
            f"  breww install <pkg>         Install + update host overlay\n"
            f"  breww uninstall <pkg>       Uninstall + update host overlay\n"
            f"  breww tap <repo>            Tap + update host overlay\n"
            f"  breww untap <repo>          Untap + update host overlay\n"
            f"  breww --promote <name>      Move entry from host overlay to base\n"
            f"  breww <command>             Passthrough to brew\n\n"
            f"Base file (read-only): {base_brewfile or 'unknown (check MACHINE_PROFILE)'}\n"
            f"Host overlay:          {get_host_brewfile()}\n"
            f"Cask skip files:       {', '.join(p.name for p in iter_cu_skip_files()) or get_cu_skip_file().name}\n"
            f"Hostname:              {hostname}\n"
            f"MACHINE_PROFILE:       {os.environ.get('MACHINE_PROFILE', 'unset')}\n"
        )
        return

    # Determine the base Brewfile (read-only reference; never dumped onto)
    base_brewfile = get_target_brewfile()
    if not base_brewfile:
        print(
            "Warning: unrecognized machine profile. Running brew without Brewfile sync."
        )
        run_brew_command(args)
        return

    # Warn about native packages on Linux
    if "install" in args:
        check_native_available(args)

    skip = load_cu_skip()
    cmd, flags, positionals = _split_brew_args(args)
    skip_bulk = bool(skip) and (
        (cmd == "cu" and not positionals)
        or (cmd == "upgrade" and not positionals and "--formula" not in flags)
    )
    if skip_bulk:
        print(
            f"{YELLOW}Skipping casks (no admin on this host): {', '.join(skip)}{NC}"
        )
        print(f"{YELLOW}Override with an explicit name: breww {cmd} <cask>{NC}")
        # Pin so unwrapped `brew upgrade` (cmupgrade, other scripts) skips them too.
        subprocess.run(["brew", "pin", *skip], capture_output=True)
        plans = plan_brew_commands(
            args,
            skip,
            installed_casks=brew_list_casks() if cmd == "cu" else None,
            outdated_casks=(
                brew_outdated_casks(greedy="--greedy" in flags)
                if cmd == "upgrade"
                else None
            ),
        )
        if not plans:
            print(f"{YELLOW}Nothing to upgrade after applying the cask skip list.{NC}")
            sys.exit(0)
        returncode = 0
        for plan in plans:
            rc = run_brew_command(plan)
            if rc != 0:
                returncode = rc
        sys.exit(returncode)

    # Run the brew command
    returncode = run_brew_command(args)

    # If command succeeded and modified packages, dump the host overlay delta
    if returncode == 0 and any(
        cmd in args for cmd in ["install", "uninstall", "tap", "untap"]
    ):
        dump_host_overlay(base_brewfile)
        sync_to_git()

    sys.exit(returncode)


if __name__ == "__main__":
    main()
