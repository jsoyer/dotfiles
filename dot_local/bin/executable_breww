#!/usr/bin/env python3
"""
Smart Homebrew wrapper that automatically keeps the profile-specific
Brewfile up to date and syncs changes to Git.

The shared base Brewfile (selected by MACHINE_PROFILE) is NEVER overwritten
by a dump. Instead, a per-hostname overlay (Brewfile_<hostname>) receives
only the delta: installed − base − blacklist.
"""

from __future__ import annotations

import os
import json
import subprocess
import sys
import tempfile
from pathlib import Path

# The same module is deployed next to breww and is importable from source tests.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from package_layers import (
    Context,
    LayerError,
    context_from_environment,
    clear_exclusions,
    dump_overlay,
    parse_entries,
    promote,
    record,
)

# --- Configuration ---
_context_path = Path(
    os.environ.get(
        "PACKAGE_CONTEXT_FILE", Path.home() / ".config/dotfiles/package-context.json"
    )
)
_saved_context = (
    json.loads(_context_path.read_text(encoding="utf-8-sig"))
    if _context_path.exists()
    else {}
)
CHEZMOI_SOURCE_PATH = Path(
    os.environ.get("CHEZMOI_SOURCE_PATH")
    or _saved_context.get("source_dir")
    or Path.home() / ".local/share/chezmoi"
)
BREWFILE_DIR = CHEZMOI_SOURCE_PATH / "dot_private"

# --- Colors ---
BLUE = "\033[0;34m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
NC = "\033[0m"


NATIVE_PACKAGES = {
    "bat",
    "chezmoi",
    "curl",
    "eza",
    "fd",
    "fontconfig",
    "fzf",
    "git",
    "jq",
    "neovim",
    "ripgrep",
    "starship",
    "tmux",
    "unzip",
    "vivid",
    "wget",
    "zoxide",
    "zsh",
    "atuin",
    "htop",
    "tree",
}

NATIVE_WRAPPER = {
    "ubuntu-desktop": "aptw",
    "ubuntu-server": "aptw",
    "debian": "aptw",
    "rpi": "aptw",
    "fedora-desktop": "dnfw",
    "fedora-server": "dnfw",
    "arch-desktop": "pacmanw",
    "arch-server": "pacmanw",
}


def get_hostname() -> str:
    """Return the short hostname (no domain)."""
    return os.uname().nodename.split(".")[0]


def get_layer_context():
    if not (BREWFILE_DIR / "package-layers.json").is_file():
        return None  # isolated pre-catalog test fixtures
    context = context_from_environment()
    return Context(
        BREWFILE_DIR.parent,
        context.machine_profile,
        context.package_profile,
        get_hostname(),
        context.install_mas,
    )


def get_target_brewfile():
    """Reference file for display; dumps subtract ALL active shared layers."""
    context = get_layer_context()
    if context is not None:
        files = context.selection("brew")["shared"]
        return BREWFILE_DIR / files[-1] if files else None
    profile = os.environ.get("MACHINE_PROFILE")
    names = {
        "mac-pro": "Brewfile_pro",
        "mac-personal": "Brewfile_personal",
        "rpi": "Brewfile_rpi",
        "fedora-atomic": "Brewfile_fedora_atomic",
        "ubuntu-desktop": "Brewfile_brew_only",
        "fedora-desktop": "Brewfile_brew_only",
        "arch-desktop": "Brewfile_brew_only",
        "toolbox": "Brewfile_brew_only",
    }
    return BREWFILE_DIR / names[profile] if profile in names else None


def get_host_brewfile() -> Path:
    """Return the per-hostname overlay Brewfile path."""
    return BREWFILE_DIR / f"Brewfile_{get_hostname()}"


def check_native_available(args):
    """Warn if a package is available natively on Linux."""
    profile = os.environ.get("MACHINE_PROFILE", "")
    wrapper = NATIVE_WRAPPER.get(profile)
    if not wrapper:
        return

    for arg in args:
        if not arg.startswith("-") and arg in NATIVE_PACKAGES:
            print(
                f"{YELLOW}Warning: '{arg}' is available natively via {wrapper}. "
                f"Consider using {wrapper} instead.{NC}"
            )


def run_brew_command(args):
    """Execute the brew command."""
    cmd = ["brew"] + args
    print(f"{BLUE}Running: {' '.join(cmd)}{NC}")
    result = subprocess.run(cmd)
    return result.returncode


def load_package_list(path: Path) -> list[str]:
    """Load a one-token-per-line package list. Comments and blanks are ignored."""
    if not path.exists():
        return []
    packages: list[str] = []
    seen: set[str] = set()
    with path.open() as f:
        for raw in f:
            line = raw.split("#", 1)[0].strip()
            if not line or line in seen:
                continue
            seen.add(line)
            packages.append(line)
    return packages


def load_blacklist() -> set:
    """Load the set of blacklisted package identity strings from Brewfile_blacklist."""
    return set(load_package_list(BREWFILE_DIR / "Brewfile_blacklist"))


def get_cu_skip_file() -> Path:
    """Per-hostname cask skip list (bulk `cu` / `upgrade` only)."""
    return BREWFILE_DIR / f"Brewfile_cu_skip_{get_hostname()}"


def iter_cu_skip_files() -> list[Path]:
    """Skip files for this host and MACHINE_PROFILE (hostname match is case-insensitive)."""
    keys = {get_hostname().lower()}
    profile = os.environ.get("MACHINE_PROFILE", "")
    if profile:
        keys.add(profile.lower())
    found: list[Path] = []
    seen: set[Path] = set()
    if not BREWFILE_DIR.is_dir():
        return found
    for path in sorted(BREWFILE_DIR.glob("Brewfile_cu_skip_*")):
        suffix = path.name[len("Brewfile_cu_skip_") :]
        if suffix.lower() in keys and path not in seen:
            seen.add(path)
            found.append(path)
    return found


def load_cu_skip() -> list[str]:
    """Merge hostname + profile skip lists, preserving first-seen order."""
    packages: list[str] = []
    seen: set[str] = set()
    for path in iter_cu_skip_files():
        for pkg in load_package_list(path):
            if pkg not in seen:
                seen.add(pkg)
                packages.append(pkg)
    return packages


def _split_brew_args(args: list[str]) -> tuple[str, list[str], list[str]]:
    """Split `brew` argv into (command, flags, positionals)."""
    if not args:
        return "", [], []
    flags: list[str] = []
    positionals: list[str] = []
    for arg in args[1:]:
        if arg == "--":
            continue
        if arg.startswith("-"):
            flags.append(arg)
        else:
            positionals.append(arg)
    return args[0], flags, positionals


def plan_brew_commands(
    args: list[str],
    skip: list[str],
    *,
    installed_casks: list[str] | None = None,
    outdated_casks: list[str] | None = None,
    upgradeable_formulae: list[str] | None = None,
    compile_formulae: list[str] | None = None,
) -> list[list[str]]:
    """
    Rewrite bulk `cu` / `upgrade` so host-local skip casks are not touched
    and split formula upgrades into bottles and source builds.

    Explicit package names (e.g. `breww cu -a obs`) are honored as-is.
    A bare `brew cu -a` must never be emitted when a skip list is active:
    that would upgrade the skipped casks too.

    `upgradeable_formulae` is the bottle-filtered list (None = filter
    unavailable, keep the unfiltered `brew upgrade --formula`; [] = nothing
    can be poured, so no formula upgrade is planned).

    `compile_formulae` contains ALL remaining outdated formulae; they get a
    `--build-from-source` upgrade after the bottled one. Ignored unless the
    bottle filter is active. No installed formula is deliberately left stale.
    """
    if not args:
        return []

    cmd, flags, positionals = _split_brew_args(args)
    if cmd in ("install", "uninstall", "tap", "untap"):
        context = get_layer_context()
        if context is not None:
            context.entries(
                "brew"
            )  # reject conflicts before changing installed packages
    skip_set = set(skip)

    if cmd == "cu":
        if positionals or not skip:
            return [args]
        remaining = [c for c in (installed_casks or []) if c not in skip_set]
        if not remaining:
            return []
        return [[cmd, *flags, *remaining]]

    if cmd == "upgrade":
        if positionals:
            return [args]
        formula_wanted = "--cask" not in flags
        cask_wanted = "--formula" not in flags
        use_filter = formula_wanted and upgradeable_formulae is not None
        if not use_filter and (not skip or not cask_wanted):
            return [args]
        other_flags = [f for f in flags if f not in ("--formula", "--cask")]
        plans: list[list[str]] = []
        if formula_wanted:
            if use_filter:
                if upgradeable_formulae:
                    plans.append(
                        ["upgrade", "--formula", *other_flags, *upgradeable_formulae]
                    )
                if compile_formulae:
                    plans.append(
                        [
                            "upgrade",
                            "--formula",
                            "--build-from-source",
                            *other_flags,
                            *compile_formulae,
                        ]
                    )
            else:
                plans.append(["upgrade", "--formula", *other_flags])
        if cask_wanted:
            if skip:
                remaining = [c for c in (outdated_casks or []) if c not in skip_set]
                if remaining:
                    plans.append(["upgrade", "--cask", *other_flags, *remaining])
            else:
                plans.append(["upgrade", "--cask", *other_flags])
        return plans

    return [args]


def _find_bottle_filter() -> Path | None:
    """Locate brewfile-filter-bottled next to breww (source or deployed name)."""
    here = Path(__file__).resolve().parent
    for name in ("executable_brewfile-filter-bottled", "brewfile-filter-bottled"):
        candidate = here / name
        if candidate.is_file():
            return candidate
    return None


def brew_upgradeable_formulae() -> list[str] | None:
    """
    Outdated formulae that can be poured from a bottle on this machine.

    Reuses brewfile-filter-bottled --mode=upgradeable (the same filter the
    chezmoi update script uses). Returns None when the filter is missing or
    fails, so the caller falls back to an unfiltered upgrade.
    """
    script = _find_bottle_filter()
    if script is None:
        print(
            f"{YELLOW}Warning: brewfile-filter-bottled not found; "
            f"upgrading formulae without bottle filtering{NC}"
        )
        return None
    try:
        result = subprocess.run(
            [sys.executable, str(script), "--mode=upgradeable"],
            stdout=subprocess.PIPE,
            universal_newlines=True,
        )
    except OSError as exc:
        print(
            f"{YELLOW}Warning: bottle filter failed to run ({exc}); "
            f"upgrading formulae without bottle filtering{NC}"
        )
        return None
    if result.returncode != 0:
        print(
            f"{YELLOW}Warning: bottle filter exited {result.returncode}; "
            f"upgrading formulae without bottle filtering{NC}"
        )
        return None
    return [ln.strip() for ln in result.stdout.splitlines() if ln.strip()]


def select_compile_formulae(outdated: list[str], upgradeable: list[str]) -> list[str]:
    """All outdated formulae that cannot be upgraded from a bottle."""
    poured = set(upgradeable)
    return [name for name in outdated if name not in poured]


def brew_outdated_formulae() -> list[str]:
    """Outdated formula names. Query failures must never mean 'up to date'."""
    result = subprocess.run(
        ["brew", "outdated", "--formula", "--quiet"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        universal_newlines=True,
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"brew outdated --formula failed: {(result.stderr or '').strip()}"
        )
    return [ln.strip() for ln in result.stdout.splitlines() if ln.strip()]


def brew_compile_formulae(upgradeable: list[str] | None) -> list[str]:
    """Build every outdated formula left outside the bottle upgrade plan."""
    if upgradeable is None:
        return []
    names = select_compile_formulae(brew_outdated_formulae(), upgradeable)
    if names:
        print(
            f"{YELLOW}Upgrading from source (no usable bottle): "
            f"{', '.join(names)}{NC}"
        )
    return names


def brew_list_casks() -> list[str]:
    """Installed cask tokens, or empty if the query fails (fail closed)."""
    result = subprocess.run(
        ["brew", "list", "--cask", "-1"],
        capture_output=True,
        text=True,
    )
    names = [ln.strip() for ln in result.stdout.splitlines() if ln.strip()]
    if result.returncode != 0 and not names:
        print(
            f"{RED}Warning: brew list --cask failed; "
            f"skipping bulk cask upgrade to honor the skip list{NC}"
        )
        return []
    return names


def brew_outdated_casks(*, greedy: bool = False) -> list[str]:
    """Outdated cask tokens, including pinned casks. Raise on query failure."""
    cmd = ["brew", "outdated", "--cask", "--quiet"]
    if greedy:
        cmd.append("--greedy")
    result = subprocess.run(cmd, capture_output=True, text=True)
    names = [ln.strip() for ln in result.stdout.splitlines() if ln.strip()]
    if result.returncode != 0:
        raise RuntimeError(f"brew outdated --cask failed: {result.stderr.strip()}")
    return names


def brew_git_latest_receipts(names: list[str]) -> dict[str, tuple[str, str, int]]:
    """Read installation receipts for unpinned, enabled Git `latest` casks.

    Homebrew cannot checksum Git downloads, so its greedy outdated check always
    returns true for these casks. Only a successful upgrade AND a newer installed
    receipt can prove they were refreshed; `version == latest` alone cannot.
    """
    if not names:
        return {}
    result = subprocess.run(
        ["brew", "info", "--cask", "--json=v2", *names],
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise RuntimeError(
            f"brew info --cask failed for {', '.join(names)}: {result.stderr.strip()}"
        )
    try:
        casks = json.loads(result.stdout)["casks"]
        if not isinstance(casks, list) or any(not isinstance(c, dict) for c in casks):
            raise ValueError("expected a list of cask objects")
    except (ValueError, KeyError, TypeError) as exc:
        raise RuntimeError(
            f"Invalid brew info --cask JSON for {', '.join(names)}: {exc}"
        ) from exc
    receipts = {}
    for cask in casks:
        url, specs = cask.get("url"), cask.get("url_specs", {})
        installed_time = cask.get("installed_time")
        if (
            cask.get("version") != "latest"
            or cask.get("installed") != "latest"
            or cask.get("pinned") is not False
            or cask.get("disabled") is not False
            or not isinstance(installed_time, int)
            or isinstance(installed_time, bool)
            or installed_time <= 0
            or not isinstance(url, str)
            or not isinstance(specs, dict)
        ):
            continue
        using = specs.get("using")
        if using != "git" and not (using is None and url.endswith(".git")):
            continue
        for name in names:
            if name in (cask.get("token"), cask.get("full_token")):
                receipts[name] = (
                    url,
                    json.dumps(specs, sort_keys=True),
                    installed_time,
                )
    return receipts


def run_bulk_upgrade(args: list[str], skip: list[str]) -> int:
    """Attempt every update, then check for stale/pinned/deferred packages."""
    cmd, flags, _ = _split_brew_args(args)
    dry_run = "--dry-run" in flags or "-n" in flags
    formula_wanted = cmd == "upgrade" and "--cask" not in flags
    cask_wanted = cmd == "cu" or "--formula" not in flags
    greedy = "--greedy" in flags or (
        cmd == "cu" and ("-a" in flags or "--all" in flags)
    )
    returncode = 0
    try:
        returncode = run_brew_command(["update"])
        if skip and cask_wanted:
            print(f"{YELLOW}Deferred casks (admin required): {', '.join(skip)}{NC}")
            print(
                f"{YELLOW}Update explicitly with an admin account: breww {cmd} <cask>{NC}"
            )
        outdated_casks = brew_outdated_casks(greedy=greedy) if cask_wanted else []
        before_git = {}
        if outdated_casks and not dry_run:
            try:
                before_git = brew_git_latest_receipts(outdated_casks)
            except (OSError, RuntimeError) as exc:
                # Still attempt updates. Without receipts, the final outdated
                # check remains authoritative and cannot claim a Git refresh.
                print(f"{YELLOW}Cannot record cask refresh receipts: {exc}{NC}")
        completed_casks = set()
        upgradeable = brew_upgradeable_formulae() if formula_wanted else None
        plans = plan_brew_commands(
            args,
            skip,
            installed_casks=brew_list_casks() if cmd == "cu" else None,
            outdated_casks=outdated_casks,
            upgradeable_formulae=upgradeable,
            compile_formulae=brew_compile_formulae(upgradeable)
            if formula_wanted
            else None,
        )
        for plan in plans:
            rc = run_brew_command(plan)
            if rc:
                returncode = rc
            else:
                plan_cmd, plan_flags, targets = _split_brew_args(plan)
                if plan_cmd == "cu" or (
                    plan_cmd == "upgrade" and "--formula" not in plan_flags
                ):
                    completed_casks.update(targets or outdated_casks)
        if not dry_run:
            remaining = []
            if formula_wanted:
                remaining.extend(brew_outdated_formulae())
            if cask_wanted:
                casks = brew_outdated_casks(greedy=greedy)
                candidates = [
                    name
                    for name in casks
                    if name in before_git
                    and name in completed_casks
                    and name not in skip
                ]
                after_git = brew_git_latest_receipts(candidates)
                refreshed = {
                    name
                    for name, receipt in after_git.items()
                    if receipt[:2] == before_git[name][:2]
                    and receipt[2] > before_git[name][2]
                }
                if refreshed:
                    print(
                        f"{GREEN}Refreshed Git-based latest casks "
                        f"(installation receipts changed): {', '.join(sorted(refreshed))}{NC}"
                    )
                remaining.extend(name for name in casks if name not in refreshed)
            if remaining:
                print(
                    f"{RED}Updates incomplete; packages still outdated (including pins/deferred casks): "
                    f"{', '.join(remaining)}{NC}",
                    file=sys.stderr,
                )
                returncode = returncode or 1
    except (OSError, RuntimeError) as exc:
        print(f"{RED}Cannot complete/verify upgrades: {exc}{NC}", file=sys.stderr)
        returncode = returncode or 1
    return returncode


def _extract_identity(line: str) -> str | None:
    """
    Extract the canonical identity string from a Brewfile line.

    Returns the quoted name for brew/cask/tap/mas lines, e.g.:
      brew "git"        → git
      cask "1password"  → 1password
      tap "homebrew/core" → homebrew/core
      mas "Amphetamine", id: 937984704 → Amphetamine
    Returns None for comments or blank lines.
    """
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return None
    for keyword in ("brew", "cask", "tap", "mas"):
        if stripped.startswith(keyword + " "):
            # Extract the first quoted token
            for q in ('"', "'"):
                start = stripped.find(q)
                if start != -1:
                    end = stripped.find(q, start + 1)
                    if end != -1:
                        return stripped[start + 1 : end]
    return None


def parse_brewfile_entries(path: Path) -> dict[str, str]:
    """
    Parse a Brewfile and return a mapping of identity → full original line.
    Only brew/cask/tap/mas lines are included.
    """
    if not path.exists():
        return {}
    entries: dict[str, str] = {}
    for line in path.read_text().splitlines():
        identity = _extract_identity(line)
        if identity is not None:
            entries[identity] = line
    return entries


def _is_blacklisted(line: str, blacklist: set) -> bool:
    """Return True if the line matches any blacklist entry."""
    stripped = line.strip()
    for pkg in blacklist:
        if f'"{pkg}"' in stripped or f"'{pkg}'" in stripped:
            return True
    return False


# Extra dumpers of recent `brew bundle dump` that breww does not use (it keeps
# brew/cask/tap/mas lines only). A broken one (e.g. krew with no index) would
# fail the whole dump. Env vars, not flags: older brew ignores unknown env.
DUMP_DISABLE_ENV = tuple(
    f"HOMEBREW_BUNDLE_DUMP_NO_{kind}"
    for kind in ("VSCODE", "GO", "CARGO", "UV", "KREW", "NPM", "FLATPAK", "WINGET")
)


def dump_env() -> dict[str, str]:
    """Process env with the unneeded bundle dumpers disabled."""
    env = dict(os.environ)
    for name in DUMP_DISABLE_ENV:
        env[name] = "1"
    return env


def dump_host_overlay(base_brewfile: Path | None):
    """
    Full delta-dump flow:
    1. brew bundle dump → tmp file (full installed state)
    2. Parse tmp, base, and blacklist
    3. host_entries = tmp − base − blacklist
    4. Write host overlay file
    """
    hostname = get_hostname()
    host_file = get_host_brewfile()

    print(f"\n{YELLOW}Dumping host overlay: {host_file.name}{NC}")

    with tempfile.NamedTemporaryFile(suffix=".Brewfile", delete=False, mode="w") as tf:
        tmp_path = Path(tf.name)

    try:
        result = subprocess.run(
            ["brew", "bundle", "dump", "--file", str(tmp_path), "--force"],
            capture_output=True,
            text=True,
            env=dump_env(),
        )
        if result.returncode != 0:
            print(f"{RED}Warning: brew bundle dump failed: {result.stderr}{NC}")
            raise LayerError("brew bundle dump failed; host manifest left unchanged")

        context = get_layer_context()
        if context is not None:
            entries = parse_entries(tmp_path, "brew")
            blacklist = load_blacklist()
            entries = {
                key: line
                for key, line in entries.items()
                if not _is_blacklisted(line, blacklist)
            }
            dump_overlay(context, "brew", entries)
            return

        tmp_entries = parse_brewfile_entries(tmp_path)
        base_entries = parse_brewfile_entries(base_brewfile) if base_brewfile else {}
        blacklist = load_blacklist()

        host_lines = []
        for identity, line in tmp_entries.items():
            if identity in base_entries:
                continue
            if _is_blacklisted(line, blacklist):
                continue
            host_lines.append(line)

        host_file.parent.mkdir(parents=True, exist_ok=True)
        header = (
            f"# Host overlay for {hostname} — extras beyond the shared base.\n"
            f"# Managed by breww. Do not edit manually.\n"
        )
        host_file.write_text(
            header + "\n".join(host_lines) + ("\n" if host_lines else "")
        )
        print(
            f"{GREEN}Host overlay written: {len(host_lines)} entries "
            f"({len(tmp_entries) - len(host_lines)} in base/blacklist){NC}"
        )
    finally:
        tmp_path.unlink(missing_ok=True)


def record_uninstall(names: list[str], flags: list[str]) -> list[Path]:
    """A local uninstall excludes inherited packages without editing other machines."""
    context = get_layer_context()
    if context is None:
        raise LayerError(
            "Package layer catalog missing; refusing to edit a shared Brewfile"
        )
    qualified = []
    for name in names:
        kind = "cask" if "--cask" in flags else "brew" if "--formula" in flags else None
        qualified.append(f"{kind}:{name}" if kind else name)
    return record(context, "brew", "remove", qualified)


def sync_to_git(paths):
    """
    Commit and push the manifests breww just rewrote.

    Only <paths> are staged. Staging the whole source tree swept anything else
    pending there into a commit labelled "update brewfiles via breww" and pushed
    it unreviewed — one such commit carried 224 files, exactly one of which was
    a Brewfile.
    """
    existing = [p for p in paths if Path(p).exists()]
    if not existing:
        return
    print(f"\n{BLUE}Syncing with Git...{NC}")
    try:
        status = subprocess.run(
            ["git", "status", "--porcelain", "--", *[str(p) for p in existing]],
            cwd=CHEZMOI_SOURCE_PATH,
            check=True,
            capture_output=True,
            text=True,
        )
        if not status.stdout.strip():
            return
        subprocess.run(
            ["git", "add", "--", *[str(p) for p in existing]],
            cwd=CHEZMOI_SOURCE_PATH,
            check=True,
        )
        subprocess.run(
            [
                "git",
                "commit",
                "--only",
                "-m",
                "style(brew): update brewfiles via breww",
                "--",
                *[str(p) for p in existing],
            ],
            cwd=CHEZMOI_SOURCE_PATH,
            check=True,
        )
        # Pull --rebase before push to avoid "rejected: fetch first" errors
        subprocess.run(
            ["git", "pull", "--rebase", "origin", "main"],
            cwd=CHEZMOI_SOURCE_PATH,
            check=True,
        )
        subprocess.run(["git", "push"], cwd=CHEZMOI_SOURCE_PATH, check=True)
        print(f"{GREEN}Pushed to remote.{NC}")
    except subprocess.CalledProcessError as e:
        raise LayerError(f"Git manifest sync failed: {e}") from e


def main():
    import shutil

    # Promotion always names its shared scope; legacy lists stay read-only.
    if "--promote" in sys.argv:
        args = sys.argv[1:]
        if (
            len(args) != 4
            or args[0] != "--promote"
            or args[2] != "--to"
            or args[3] not in ("base", "usage")
        ):
            raise LayerError("Usage: breww --promote NAME --to base|usage")
        context = get_layer_context()
        if context is None:
            raise LayerError("Package layer catalog missing")
        sync_to_git(promote(context, "brew", args[1], args[3]))
        return

    if not shutil.which("brew"):
        print(f"{RED}brew not found. Install Homebrew first: https://brew.sh{NC}")
        sys.exit(1)

    args = sys.argv[1:]

    if not args or args[0] in ("--help", "-h"):
        hostname = get_hostname()
        base_brewfile = get_target_brewfile()
        print(
            f"breww — Homebrew wrapper with per-host overlay manifest sync\n\n"
            f"Usage:\n"
            f"  breww install <pkg>         Install + update host overlay\n"
            f"  breww uninstall <pkg>       Uninstall + exclude locally + update host overlay\n"
            f"  breww tap <repo>            Tap + update host overlay\n"
            f"  breww untap <repo>          Untap + update host overlay\n"
            f"  breww --promote NAME --to base|usage  Promote explicitly\n"
            f"  breww <command>             Passthrough to brew\n\n"
            f"Base file (read-only): {base_brewfile or 'unknown (check MACHINE_PROFILE)'}\n"
            f"Host overlay:          {get_host_brewfile()}\n"
            f"Cask skip files:       {', '.join(p.name for p in iter_cu_skip_files()) or get_cu_skip_file().name}\n"
            f"Hostname:              {hostname}\n"
            f"MACHINE_PROFILE:       {os.environ.get('MACHINE_PROFILE', 'unset')}\n"
        )
        return

    # Determine the base Brewfile (read-only reference; never dumped onto)
    base_brewfile = get_target_brewfile()
    if not base_brewfile:
        print(
            "Warning: unrecognized machine profile. Running brew without Brewfile sync."
        )

    # Warn about native packages on Linux
    if "install" in args:
        check_native_available(args)

    skip = load_cu_skip()
    cmd, flags, positionals = _split_brew_args(args)
    if cmd in ("upgrade", "cu") and not positionals:
        sys.exit(run_bulk_upgrade(args, skip))

    # Run the brew command
    returncode = run_brew_command(args)

    # If command succeeded and modified packages, dump the host overlay delta
    if (
        base_brewfile
        and returncode == 0
        and any(cmd in args for cmd in ["install", "uninstall", "tap", "untap"])
    ):
        changed = [get_host_brewfile()]
        if cmd in ("uninstall", "untap") and positionals:
            if cmd == "untap":
                positionals = [f"tap:{name}" for name in positionals]
            changed.extend(record_uninstall(positionals, flags))
        elif cmd == "install" and positionals:
            context = get_layer_context()
            if context is not None:
                kind = (
                    "cask"
                    if "--cask" in flags
                    else "brew"
                    if "--formula" in flags
                    else None
                )
                names = [f"{kind}:{name}" if kind else name for name in positionals]
                changed.extend(clear_exclusions(context, names))
        dump_host_overlay(base_brewfile)
        sync_to_git(changed)

    sys.exit(returncode)


if __name__ == "__main__":
    try:
        main()
    except (LayerError, OSError) as error:
        print(f"breww: {error}", file=sys.stderr)
        sys.exit(1)
