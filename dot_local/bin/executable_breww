#!/usr/bin/env python3
"""
Wrapper intelligent pour Homebrew qui maintient automatiquement le Brewfile
spécifique au profil à jour et le synchronise avec Git.
"""

import os
import subprocess
import sys
from pathlib import Path

# --- Configuration ---
# Le chemin vers le dossier source de chezmoi
CHEZMOI_SOURCE_PATH = Path(
    os.environ.get("CHEZMOI_SOURCE_PATH", Path.home() / ".local" / "share" / "chezmoi")
)
BREWFILE_DIR = CHEZMOI_SOURCE_PATH / "dot_private"

# --- Couleurs ---
BLUE = "\033[0;34m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
NC = "\033[0m"


def get_target_brewfile():
    """Détermine le Brewfile cible en fonction du profil de la machine."""
    profile = os.environ.get("MACHINE_PROFILE")
    if profile == "mac-pro":
        return BREWFILE_DIR / "Brewfile_pro"
    elif profile == "mac-personal":
        return BREWFILE_DIR / "Brewfile_personal"
    else:
        # Comportement par défaut ou erreur si non macOS
        return None


def run_brew_command(args):
    """Exécute la commande brew."""
    cmd = ["brew"] + args
    print(f"{BLUE}🍺 Exécution: {' '.join(cmd)}{NC}")
    result = subprocess.run(cmd)
    return result.returncode


def update_brewfile(target_brewfile):
    """Met à jour le Brewfile spécifié avec 'brew bundle dump'."""
    print(f"\n{YELLOW}📝 Mise à jour du Brewfile: {target_brewfile.name}{NC}")
    cmd = ["brew", "bundle", "dump", "--file", str(target_brewfile), "--force"]
    result = subprocess.run(cmd, capture_output=True, text=True)

    if result.returncode == 0:
        print(f"{GREEN}✅ Brewfile mis à jour avec succès.{NC}")
    else:
        print(f"⚠️  Erreur lors de la mise à jour du Brewfile: {result.stderr}")


def sync_to_git():
    """Commite et pousse les changements dans le dépôt chezmoi."""
    print(f"\n{BLUE}🔄 Synchronisation avec Git...{NC}")
    try:
        # 'cwd' est l'équivalent de 'cd'
        subprocess.run(["git", "add", "."], cwd=CHEZMOI_SOURCE_PATH, check=True)
        # Le '|| true' du shell est géré par le 'check=False' ici
        subprocess.run(
            ["git", "commit", "-m", "style(brew): update brewfiles via breww"],
            cwd=CHEZMOI_SOURCE_PATH,
        )
        subprocess.run(["git", "push"], cwd=CHEZMOI_SOURCE_PATH, check=True)
        print(f"{GREEN}✅ Poussé sur le dépôt distant !{NC}")
    except subprocess.CalledProcessError as e:
        print(f"⚠️  Erreur lors de la synchronisation Git: {e}")


def main():
    args = sys.argv[1:]

    if not args:
        subprocess.run(["brew", "--help"])
        return

    # Détermine le Brewfile cible avant toute chose
    target_brewfile = get_target_brewfile()
    if not target_brewfile:
        print(
            "⚠️  Profil de machine non reconnu ou non-macOS. Exécution de brew sans mise à jour du Brewfile."
        )
        run_brew_command(args)
        return

    # Exécute la commande brew
    returncode = run_brew_command(args)

    # Si la commande a réussi et que c'est une commande d'installation/modification
    if returncode == 0 and any(
        cmd in args for cmd in ["install", "uninstall", "tap", "untap"]
    ):
        update_brewfile(target_brewfile)
        sync_to_git()

    sys.exit(returncode)


if __name__ == "__main__":
    main()
