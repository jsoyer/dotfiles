#!/usr/bin/env bash
#
# update-herdr — Update the herdr binary (~/.local/bin) through its self-update.
#
# What sets it apart from update-moshi: herdr is a MULTIPLEXER, not a daemon.
# The server (`herdr server`) daemonizes itself (reparented to PID 1) and holds
# the live panes/agents. So we do not blindly restart it: we use
# `herdr update --handoff`, which installs the new version and then transfers
# the live sessions to the new server, without losing any pane.
#
# The handoff is not a convenience, it is a SAFETY measure: without it the
# binary (client) moves to N+1 while the server stays at N → protocol mismatch
# on the next attach (`compatible: no`) = broken terminal.
#
# It is also why herdr has no long-running systemd service like moshi-hook or
# cursor-worker: only the update timer is managed here.
#
set -euo pipefail

# --- Configuration ------------------------------------------------------------
BIN="${HERDR_BIN:-$HOME/.local/bin/herdr}"
BACKUP="${BIN}.bak"

# --- Helpers ------------------------------------------------------------------
log()  { printf '\033[1;34m[herdr-update]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[herdr-update]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[herdr-update]\033[0m %s\n' "$*" >&2; exit 1; }

# `herdr --version` prints "herdr X.Y.Z"; "unknown" if the binary stays silent.
bin_version() {
  local v
  v="$("$1" --version 2>/dev/null | awk 'NF{print $NF; exit}')" || true
  echo "${v:-unknown}"
}

# One "key: value" field of `herdr status server`.
server_field() { "$BIN" status server 2>/dev/null | awk -F': *' -v k="$1" '$1==k{print $2; exit}'; }

# --- Guards -------------------------------------------------------------------
[[ "$(id -u)" -ne 0 ]] || die "Run as your user, not root (binary and sessions live in \$HOME)."
[[ -x "$BIN" ]] || BIN="$(command -v herdr 2>/dev/null || true)"
[[ -n "$BIN" && -x "$BIN" ]] || die "herdr binary not found or not executable."
BACKUP="${BIN}.bak"

CUR_VER="$(bin_version "$BIN")"
SRV_STATUS="$(server_field status || true)"
log "Installed version: ${CUR_VER} — server: ${SRV_STATUS:-absent} (channel: $("$BIN" channel show 2>/dev/null | awk 'NF{print $NF; exit}' || echo unknown))"

cp -f "$BIN" "$BACKUP"   # rollback stays possible if the release is broken

# --- Self-update --------------------------------------------------------------
# --handoff only when a server is running: otherwise herdr has nothing to move.
UPDATE_ARGS=()
[[ "$SRV_STATUS" == "running" ]] && UPDATE_ARGS+=(--handoff)

set +e
OUT="$("$BIN" update "${UPDATE_ARGS[@]}" 2>&1)"; RC=$?
set -e
printf '%s\n' "$OUT" | sed 's/^/    /'

if [[ "$RC" -ne 0 ]]; then
  # Network/release unreachable: the binary did not move, nothing is broken.
  warn "herdr update failed (code ${RC}) — binary unchanged (${CUR_VER}), will retry on the next run."
  exit 0
fi

# --- Validation ---------------------------------------------------------------
NEW_VER="$(bin_version "$BIN")"
if [[ "$NEW_VER" == "unknown" ]]; then
  warn "The updated binary no longer answers --version — rolling back."
  mv -f "$BACKUP" "$BIN"; chmod 755 "$BIN"
  die "Rolled back to ${CUR_VER}. Broken release?"
fi

log "Installed version: ${CUR_VER}  →  version after update: ${NEW_VER}"

if [[ "$NEW_VER" == "$CUR_VER" ]]; then
  log "Already up to date (${CUR_VER}) — sessions untouched, no handoff."
  exit 0
fi

# --- Client / server coherence after the handoff ------------------------------
# The real post-update risk is a server left on the old version. Check that it
# answers, runs the new version, and stays compatible.
if [[ "$SRV_STATUS" == "running" ]]; then
  sleep 3
  NEW_SRV_STATUS="$(server_field status || true)"
  NEW_SRV_VER="$(server_field version || true)"
  NEW_SRV_COMPAT="$(server_field compatible || true)"

  if [[ "$NEW_SRV_STATUS" != "running" ]]; then
    warn "⚠ The herdr server stopped answering after the update (status: ${NEW_SRV_STATUS:-none})."
    warn "  Live panes are probably lost. Restart with: herdr"
  elif [[ "$NEW_SRV_VER" != "$NEW_VER" ]]; then
    warn "⚠ Incomplete handoff: client ${NEW_VER} but server still ${NEW_SRV_VER} (compatible: ${NEW_SRV_COMPAT})."
    warn "  If compatible=no, attaching will break. Fix: detach your clients, then 'herdr server stop' and run 'herdr'."
  else
    log "Handoff OK — server ${NEW_SRV_VER}, compatible: ${NEW_SRV_COMPAT} ✔"
  fi
fi

log "herdr updated successfully (${CUR_VER} → ${NEW_VER})."
