#!/usr/bin/env bash
#
# agent-host-setup — Install the shared agent CLI set on a headless agent host
# (Orca, T3 Code, Paseo or Happy Agent server), as the agents' user. Idempotent.
#
# One template for every host: ~/.local/share/agent-host/mise-agents.toml
# (claude, codex, copilot, opencode v1 + opencode2, pi, omp, cline, gemini,
# vibe, rtk + node/bun/uv, exact versions). Then the server-specific script
# (orca-setup / t3-setup / paseo-setup / happy-setup) runs on top.
#
# Steps:
#   1. prerequisites   libatomic1 (mise's node), jq (agents-update), curl, git
#                      installed with `sudo -n apt-get` when missing
#   2. mise            installed to ~/.local/bin/mise when missing
#   3. mise config     ~/.config/mise/config.toml from the template when absent;
#                      otherwise only the template's MISSING tools are merged in
#                      (backup first, existing versions never changed)
#   4. ~/.bashrc       managed block: mise shims, ~/.local/bin, ~/.grok/bin on
#                      PATH + pinned MISE_*_DIR (agent tools isolate XDG_*)
#   5. mise install    every tool of the config
#   6. vendor CLIs     grok, agy, cursor-agent: reported when missing;
#                      --vendor runs their official installers
#   7. rtk             `rtk init -g` for every installed agent it supports
#                      (grok and devin have no rtk integration)
#   8. Obsidian skills `npx skills add obsidianmd/obsidian-skills -g -y` when
#                      missing (`ob` itself comes from the mise template);
#                      kept up to date by obsidian-update after agents-update
#
# Usage (as the agents' user, never root):
#   agent-host-setup [--paseo] [--vendor] [--no-rtk] [--dry-run]
#   agent-host-setup --check          state only (no changes)
#
#   --paseo    also add npm:@getpaseo/cli (the Paseo server host)
#   --vendor   run the grok / agy / cursor-agent installers when missing
#
# Next: orca-setup | t3-setup | paseo-setup | happy-setup, then (full path: sudo's secure_path
# skips ~/.local/bin)
#   sudo ~/.local/bin/agents-update --install-timer --at 05:00 --user "$USER"
#
set -euo pipefail

TEMPLATE="${AGENT_HOST_TEMPLATE:-$HOME/.local/share/agent-host/mise-agents.toml}"
MISE_CONFIG="${MISE_GLOBAL_CONFIG_FILE:-$HOME/.config/mise/config.toml}"
BASHRC="${AGENT_HOST_BASHRC:-$HOME/.bashrc}"
MISE_BIN="$HOME/.local/bin/mise"
PASEO_LINE='"npm:@getpaseo/cli" = { version = "0.17.4", npm_args = "--ignore-scripts=false" }'
BLOCK_BEGIN="# >>> agent-host (managed by agent-host-setup) >>>"
BLOCK_END="# <<< agent-host <<<"
# name : official installer (same as the vendor docs; run only with --vendor)
VENDOR=(
  "grok:curl -fsSL https://x.ai/cli/install.sh | bash"
  "agy:curl -fsSL https://antigravity.google/cli/install.sh | bash"
  "cursor-agent:curl -fsS https://cursor.com/install | bash"
)

MODE="install"; DRY_RUN=0; WITH_PASEO=0; WITH_VENDOR=0; WITH_RTK=1
c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_0=$'\033[0m'
log()  { printf '%s[agent-host]%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s[agent-host]%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s[agent-host]%s %s\n' "$c_y" "$c_0" "$*" >&2; }
die()  { printf '%s[agent-host] ERROR:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }
run() {
  if (( DRY_RUN )); then printf '  %s+%s %s\n' "$c_y" "$c_0" "$*"; return 0; fi
  "$@"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --paseo)   WITH_PASEO=1 ;;
    --vendor)  WITH_VENDOR=1 ;;
    --no-rtk)  WITH_RTK=0 ;;
    --dry-run) DRY_RUN=1 ;;
    --check)   MODE="check" ;;
    -h|--help) usage; exit 0 ;;
    *)         die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

[[ "$(id -u)" -ne 0 ]] || die "Run as the agents' user, not root (mise installs are per user)."
[[ -r "$TEMPLATE" ]] || die "Template not found: $TEMPLATE (chezmoi apply first)."

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$HOME/.grok/bin:$PATH"
export MISE_DATA_DIR="$HOME/.local/share/mise" MISE_CONFIG_DIR="$HOME/.config/mise" \
  MISE_STATE_DIR="$HOME/.local/state/mise" MISE_CACHE_DIR="$HOME/.cache/mise"
have() { command -v "$1" >/dev/null 2>&1; }

# Print the template's [tools] entries missing from $1 (with their comments),
# plus the Paseo line with --paseo. Keys are compared as written ("npm:x", node).
missing_tools() {
  local extra=""
  (( WITH_PASEO )) && extra="$PASEO_LINE"
  python3 - "$TEMPLATE" "$1" "$extra" <<'PY'
import re, sys
tpl, cfg, extra = sys.argv[1], sys.argv[2], sys.argv[3]
key = re.compile(r'^\s*("[^"]+"|[A-Za-z0-9_.:@/-]+)\s*=')
def tools(lines):
    out, sect, pending = [], None, []
    for l in lines:
        s = l.strip()
        if s.startswith("["):
            sect = s; pending = []; continue
        if sect != "[tools]":
            continue
        if s.startswith("#"):
            pending.append(l); continue
        m = key.match(l)
        if m:
            out.append((m.group(1).strip('"'), pending + [l])); pending = []
    return out
try:
    have = {k for k, _ in tools(open(cfg).read().splitlines())}
except FileNotFoundError:
    have = set()
want = tools(open(tpl).read().splitlines())
if extra:
    want += tools(["[tools]", extra])
for k, block in want:
    if k not in have:
        print("\n".join(block))
PY
}

# Insert the lines read on stdin at the end of the [tools] section of $1.
# (stdin carries the python program, so the lines travel in AGENT_HOST_ADD.)
merge_into_config() {
  AGENT_HOST_ADD="$(cat)" python3 - "$1" <<'PY'
import os, sys
p = sys.argv[1]; add = os.environ["AGENT_HOST_ADD"].rstrip("\n").splitlines()
if not add:
    sys.exit(0)
lines = open(p).read().splitlines()
start = next((i for i, l in enumerate(lines) if l.strip() == "[tools]"), None)
if start is None:
    lines = ["[tools]"] + add + [""] + lines
else:
    end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith("[")), len(lines))
    while end > start + 1 and not lines[end - 1].strip():
        end -= 1
    lines[end:end] = add
tmp = p + ".tmp"
with open(tmp, "w") as f:
    f.write("\n".join(lines) + "\n")
os.replace(tmp, p)
PY
}

bashrc_block() {
  cat <<EOF
${BLOCK_BEGIN}
# Agent host: mise shims + vendor CLIs on PATH (same as the server units)
export PATH="\$HOME/.local/share/mise/shims:\$HOME/.local/bin:\$HOME/.grok/bin:\$PATH"
# Agent tools isolate XDG_* for logins: pin mise to its real dirs.
export MISE_DATA_DIR="\$HOME/.local/share/mise" MISE_CONFIG_DIR="\$HOME/.config/mise" \\
  MISE_STATE_DIR="\$HOME/.local/state/mise" MISE_CACHE_DIR="\$HOME/.cache/mise"
${BLOCK_END}
EOF
}

# rtk integrations: "<agent binary>:<rtk init args>"
RTK_TARGETS=(
  "codex:--codex"
  "gemini:--gemini --auto-patch --no-trust-filters"
  "copilot:--copilot --auto-patch --no-trust-filters"
  "cursor-agent:--agent cursor --auto-patch --no-trust-filters"
  "agy:--agent antigravity --auto-patch --no-trust-filters"
  "pi:--agent pi --auto-patch --no-trust-filters"
  "omp:--agent omp --auto-patch --no-trust-filters"
  "vibe:--agent vibe --auto-patch --no-trust-filters"
)

# --- check --------------------------------------------------------------------
if [[ "$MODE" == check ]]; then
  printf '  %-14s %s\n' mise "$(have mise && mise --version 2>/dev/null | head -1 || echo MISSING)"
  printf '  %-14s %s\n' config "$([[ -f "$MISE_CONFIG" ]] && echo "$MISE_CONFIG" || echo MISSING)"
  miss="$(missing_tools "$MISE_CONFIG" | { grep -v '^\s*#' || true; } | sed -E 's/\s*=.*//' | tr '\n' ' ')"
  printf '  %-14s %s\n' "missing tools" "${miss:-none}"
  if grep -qF "$BLOCK_BEGIN" "$BASHRC" 2>/dev/null; then b="block present"
  elif grep -q 'mise/shims' "$BASHRC" 2>/dev/null && grep -q 'MISE_DATA_DIR=' "$BASHRC" 2>/dev/null; then b="set by hand"
  else b="MISSING"; fi
  printf '  %-14s %s\n' bashrc "$b"
  for v in "${VENDOR[@]}"; do
    n="${v%%:*}"; printf '  %-14s %s\n' "$n" "$(have "$n" && echo installed || echo MISSING)"
  done
  have rtk && rtk init --show 2>/dev/null | grep '^\[' | sed 's/^/  rtk: /'
  have agents-update && { agents-update --check | sed 's/^/  smoke: /'; } || true
  exit 0
fi

# --- 1. prerequisites -----------------------------------------------------------
need_pkgs=()
# AGENT_HOST_NO_PREREQS=1 skips this step (tests, non-apt hosts set up by hand).
if [[ "${AGENT_HOST_NO_PREREQS:-0}" != 1 ]]; then
# ldconfig lives in /sbin, which a regular user's PATH may not list.
"$(command -v ldconfig || echo /sbin/ldconfig)" -p 2>/dev/null | grep -q 'libatomic\.so\.1' \
  || need_pkgs+=(libatomic1)
for b in jq curl git; do have "$b" || need_pkgs+=("$b"); done
if (( ${#need_pkgs[@]} > 0 )); then
  have apt-get || die "Missing: ${need_pkgs[*]} (install them, then re-run)."
  log "Installing ${need_pkgs[*]} (sudo -n apt-get)..."
  run sudo -n apt-get install -y -q "${need_pkgs[@]}" >/dev/null \
    || die "sudo -n apt-get failed: install ${need_pkgs[*]} by hand (pct-bootstrap sets up sudo)."
fi
fi

# --- 2. mise --------------------------------------------------------------------
if ! have mise; then
  log "Installing mise to ${MISE_BIN}..."
  if (( DRY_RUN )); then
    printf '  %s+%s curl -fsSL https://mise.run | MISE_INSTALL_PATH=%s sh\n' "$c_y" "$c_0" "$MISE_BIN"
  else
    curl -fsSL https://mise.run | MISE_INSTALL_PATH="$MISE_BIN" sh >/dev/null || die "mise install failed."
  fi
fi

# --- 3. mise config ------------------------------------------------------------
if [[ ! -f "$MISE_CONFIG" ]]; then
  log "Writing ${MISE_CONFIG} from the template..."
  if (( ! DRY_RUN )); then
    mkdir -p "$(dirname "$MISE_CONFIG")"
    cp "$TEMPLATE" "$MISE_CONFIG"
    (( WITH_PASEO )) && printf '%s\n' "$PASEO_LINE" | merge_into_config "$MISE_CONFIG"
  fi
else
  add="$(missing_tools "$MISE_CONFIG")"
  if [[ -n "$add" ]]; then
    log "Adding the template's missing tools to ${MISE_CONFIG}:"
    printf '%s\n' "$add" | grep -v '^\s*#' | sed 's/^/    /'
    if (( ! DRY_RUN )); then
      cp -p "$MISE_CONFIG" "${MISE_CONFIG}.bak-agent-host"
      printf '%s\n' "$add" | merge_into_config "$MISE_CONFIG"
    fi
  else
    ok "mise config already has every template tool (versions left as they are)."
  fi
fi

# --- 4. ~/.bashrc ----------------------------------------------------------------
if grep -qF "$BLOCK_BEGIN" "$BASHRC" 2>/dev/null; then
  ok "${BASHRC}: agent-host block present."
elif grep -q 'mise/shims' "$BASHRC" 2>/dev/null && grep -q 'MISE_DATA_DIR=' "$BASHRC" 2>/dev/null; then
  ok "${BASHRC}: shims + MISE_*_DIR already set by hand (left as is)."
else
  log "Adding the agent-host block to ${BASHRC}..."
  (( DRY_RUN )) || { printf '\n'; bashrc_block; } >> "$BASHRC"
fi

# --- 5. mise install ------------------------------------------------------------
if (( ! DRY_RUN )); then
  mise trust -q "$MISE_CONFIG" >/dev/null 2>&1 || true
fi
log "mise install (can take a few minutes)..."
run mise install -y

# --- 6. vendor CLIs ------------------------------------------------------------
for v in "${VENDOR[@]}"; do
  n="${v%%:*}"; cmd="${v#*:}"
  have "$n" && continue
  if (( WITH_VENDOR )); then
    log "Installing ${n}: ${cmd}"
    if (( DRY_RUN )); then printf '  %s+%s %s\n' "$c_y" "$c_0" "$cmd"
    else bash -c "$cmd" </dev/null || warn "${n}: installer failed."; fi
  else
    warn "${n} missing — install it: ${cmd}   (or re-run with --vendor)"
  fi
done

# --- 7. rtk ---------------------------------------------------------------------
if (( WITH_RTK )) && have rtk; then
  log "rtk: global hooks for the installed agents..."
  rtk_init() {
    if (( DRY_RUN )); then printf '  %s+%s rtk init -g %s\n' "$c_y" "$c_0" "$*"; return 0; fi
    (cd "$HOME" && rtk init -g "$@" </dev/null >/dev/null 2>&1) || warn "rtk init -g $* failed."
  }
  if have claude; then
    if have opencode; then rtk_init --opencode --auto-patch --no-trust-filters
    else rtk_init --auto-patch --no-trust-filters; fi
  fi
  for t in "${RTK_TARGETS[@]}"; do
    have "${t%%:*}" || continue
    # shellcheck disable=SC2086  # the args are a fixed word list
    rtk_init ${t#*:}
  done
  ok "rtk hooks done (restart the server so the agents reload them)."
fi

# --- 8. Obsidian skills ---------------------------------------------------------
if [[ -d "$HOME/.agents/skills/obsidian-cli" ]]; then
  ok "Obsidian skills present (~/.agents/skills)."
elif have npx; then
  if (( DRY_RUN )); then printf '  %s+%s npx skills add obsidianmd/obsidian-skills -g -y\n' "$c_y" "$c_0"
  else
    log "Obsidian skills (obsidianmd/obsidian-skills)..."
    (cd "$HOME" && npx --yes skills add obsidianmd/obsidian-skills -g -y </dev/null >/dev/null 2>&1) \
      && ok "Obsidian skills installed." || warn "npx skills add obsidianmd/obsidian-skills failed."
  fi
fi

(( DRY_RUN )) && exit 0
echo
ok "Agent CLIs ready. Next:"
cat <<EOF
  - the server: orca-setup | t3-setup --host 127.0.0.1 | paseo-setup --user ${USER:-$(id -un)} | happy-setup --user ${USER:-$(id -un)}
  - updates:    sudo ~/.local/bin/agents-update --install-timer --at 05:00 --user ${USER:-$(id -un)}
  - snapshots:  on the Proxmox host, pct-snapshot --install-timer <ctid>
  - logins:     run each agent once (or copy the credential dirs from the old host)
  - check:      agent-host-setup --check
EOF
