#!/usr/bin/env bash
# chezmoi-validate — post-apply validation for chezmoi-autoupdate
# Exits 0 if all checks pass, non-zero with details on failure.
# Called by chezmoi-autoupdate after applying changes.

set -euo pipefail

CHEZMOI_DIR="${CHEZMOI_SOURCE_DIR:-${HOME}/.local/share/chezmoi}"
CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/chezmoi-autoupdate"

# --- Colors ---
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

_log() { printf '[chezmoi-validate] %s\n' "$*" >&2; }
_warn() { printf '%b\n' "${YELLOW}[chezmoi-validate] WARN: $*${NC}" >&2; }
_fail() { printf '%b\n' "${RED}[chezmoi-validate] FAIL: $*${NC}" >&2; }
_ok()   { printf '%b\n' "${GREEN}[chezmoi-validate] OK: $*${NC}" >&2; }

# --- Validation checks ---

_check_zsh() {
    if ! command -v zsh &>/dev/null; then
        return 0  # zsh not installed on this machine — skip
    fi
    if timeout 10 zsh -i -c 'exit 0' 2>/dev/null; then
        _ok "zsh starts cleanly"
        return 0
    else
        _fail "zsh fails to start interactively"
        return 1
    fi
}

_check_starship() {
    if ! command -v starship &>/dev/null; then
        return 0  # not installed — skip
    fi
    if starship --version &>/dev/null; then
        _ok "starship responds"
        return 0
    else
        _fail "starship --version failed"
        return 1
    fi
}

_check_tmux() {
    if ! command -v tmux &>/dev/null; then
        return 0  # not installed — skip
    fi
    if timeout 5 tmux new-session -d -s _validate_$$ 'exit 0' 2>/dev/null; then
        tmux kill-session -t _validate_$$ 2>/dev/null || true
        _ok "tmux launches a session"
        return 0
    else
        _fail "tmux failed to launch a session"
        return 1
    fi
}

_check_chezmoi_verify() {
    if ! command -v chezmoi &>/dev/null; then
        _warn "chezmoi not found — skipping verify check"
        return 0
    fi
    if chezmoi verify 2>/dev/null; then
        _ok "chezmoi verify passed"
        return 0
    else
        _fail "chezmoi verify: drift detected"
        return 1
    fi
}

# --- Rollback helper ---

_rollback() {
    local reason="$1"
    _fail "Validation failed: ${reason}"
    _log "Attempting rollback: git reset --hard HEAD~1 + chezmoi apply"

    if git -C "$CHEZMOI_DIR" reset --hard HEAD~1 2>/dev/null; then
        chezmoi apply --no-tty --keep-going 2>/dev/null || true
        _warn "Rolled back to previous commit. Investigate before re-applying."
    else
        _fail "Rollback failed — manual intervention required"
    fi

    # Notify (desktop)
    local msg="chezmoi-validate: rollback triggered — ${reason}"
    if command -v osascript &>/dev/null; then
        osascript -e "display notification \"${msg}\" with title \"chezmoi\" sound name \"Basso\"" 2>/dev/null || true
    elif command -v notify-send &>/dev/null; then
        notify-send --urgency=critical "chezmoi validation failed" "${msg}" 2>/dev/null || true
    fi

    # Write failure to cache
    mkdir -p "$CACHE_DIR"
    printf '{"status":"validation-failed","reason":"%s","ts":"%s"}\n' \
        "${reason}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        > "${CACHE_DIR}/last-validation.json"

    return 1
}

# --- Main ---

_validate() {
    local failed=0
    local failures=()

    _check_zsh       || { ((failed++)); failures+=("zsh startup"); }
    _check_starship  || { ((failed++)); failures+=("starship"); }
    _check_tmux      || { ((failed++)); failures+=("tmux"); }
    _check_chezmoi_verify || { ((failed++)); failures+=("chezmoi verify"); }

    if [[ "$failed" -gt 0 ]]; then
        local reason
        reason="$(IFS=', '; printf '%s' "${failures[*]}")"
        _rollback "$reason"
        return 1
    fi

    # All passed — record success
    mkdir -p "$CACHE_DIR"
    printf '{"status":"ok","ts":"%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        > "${CACHE_DIR}/last-validation.json"

    _ok "All validation checks passed"
    return 0
}

_validate
