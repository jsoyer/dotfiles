#!/usr/bin/env bash
#
# paseo-version — Show the Paseo CLI version (installed through mise), the version
# pinned in the mise config, and the latest published @getpaseo/cli.
# Read-only; needs no elevation.
#
# Update: agents-update (mise upgrade --bump --pin, restart via --restart-on),
# or its thin wrapper update-paseo.
#
set -uo pipefail

case "${1:-}" in
  -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'; exit 0 ;;
  "") : ;;
  *) echo "paseo-version: unknown option: $1" >&2; exit 2 ;;
esac

c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_b=$'\033[1;34m'; c_0=$'\033[0m'
SHIM="${HOME}/.local/share/mise/shims/paseo"
MISE_CONF="${MISE_GLOBAL_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml}"

printf '%sPaseo%s\n' "$c_b" "$c_0"
PASEO=""
if command -v paseo >/dev/null 2>&1; then PASEO=paseo
elif [[ -x "$SHIM" ]]; then PASEO="$SHIM"; fi
if [[ -z "$PASEO" ]]; then
  printf '  Installed : %smissing%s (mise: "npm:@getpaseo/cli", then paseo-setup)\n' "$c_y" "$c_0"
  exit 0
fi

installed="$("$PASEO" --version 2>/dev/null | head -1 | tr -d '\r' | sed 's/^v//')"
printf '  Installed : %s%s%s\n' "$c_b" "${installed:-unknown}" "$c_0"

pinned="$(grep -E '^"npm:@getpaseo/cli"' "$MISE_CONF" 2>/dev/null | grep -oE 'version *= *"[^"]+"' | head -1 | sed 's/.*"\(.*\)"/\1/')"
[[ -z "$pinned" ]] || printf '  Pinned    : %s (%s)\n' "$pinned" "$MISE_CONF"

latest=""
if command -v mise >/dev/null 2>&1; then latest="$(mise latest "npm:@getpaseo/cli" 2>/dev/null | head -1)"; fi
if [[ -z "$latest" ]] && command -v npm >/dev/null 2>&1; then
  latest="$(npm view @getpaseo/cli version 2>/dev/null | head -1)"
fi
if [[ -z "$latest" ]]; then
  printf '  Latest    : %s(unreachable)%s\n' "$c_y" "$c_0"
  exit 0
fi
printf '  Latest    : %s\n' "$latest"

if [[ -z "$installed" ]]; then
  printf '  State     : %s?  local version undeterminable%s\n' "$c_y" "$c_0"
elif [[ "$installed" == "$latest" ]]; then
  printf '  State     : %s✔ up to date%s\n' "$c_g" "$c_0"
else
  printf '  State     : %s⬆ update available (%s → %s)%s\n' "$c_y" "$installed" "$latest" "$c_0"
  printf '              update-paseo (agents-update bumps the pin and restarts paseo.service)\n'
fi
