#!/usr/bin/env bash
#
# paseo-version — Show the installed Paseo CLI version against the latest
# @getpaseo/cli on npm, and whether an update is available.
# Read-only; needs no elevation.
#
# Update: update-paseo.
#
set -uo pipefail

case "${1:-}" in
  -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'; exit 0 ;;
  "") : ;;
  *) echo "paseo-version: unknown option: $1" >&2; exit 2 ;;
esac

c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_b=$'\033[1;34m'; c_0=$'\033[0m'

printf '%sPaseo%s\n' "$c_b" "$c_0"
if ! command -v paseo >/dev/null 2>&1; then
  printf '  Installed : %smissing%s (run paseo-setup)\n' "$c_y" "$c_0"
  exit 0
fi

installed="$(paseo --version 2>/dev/null | head -1 | tr -d '\r' | sed 's/^v//')"
printf '  Installed : %s%s%s\n' "$c_b" "${installed:-unknown}" "$c_0"

latest=""
command -v npm >/dev/null 2>&1 && latest="$(npm view @getpaseo/cli version 2>/dev/null | head -1)"
if [[ -z "$latest" ]]; then
  printf '  npm       : %s(unreachable)%s\n' "$c_y" "$c_0"
  exit 0
fi
printf '  npm       : %s\n' "$latest"

if [[ -z "$installed" ]]; then
  printf '  State     : %s?  local version undeterminable%s\n' "$c_y" "$c_0"
elif [[ "$installed" == "$latest" ]]; then
  printf '  State     : %s✔ up to date%s\n' "$c_g" "$c_0"
else
  printf '  State     : %s⬆ update available (%s → %s)%s\n' "$c_y" "$installed" "$latest" "$c_0"
  printf '              Applied by the next timer run, or now: update-paseo\n'
fi
