.DS_Store
README.md
CLAUDE.md
.private/Brewfile
.zsh/secrets.zsh

{{/* Ignore full bash configuration on Fedora Atomic host, but allow minimal .bashrc */}}
{{- if lookPath "rpm-ostree" }}
.bash_profile
.bash/
{{- end }}

{{/* In toolbox, only ignore .bashrc and .bash/ but allow .bash_profile for env vars */}}
{{- if env "TOOLBOX_PATH" }}
.bashrc
.bash/
{{- end }}

{{/* Ignore 1Password-dependent files when op CLI is not available */}}
{{- if not (lookPath "op") }}
.ssh/config
{{- end }}

{{/* Scripts and CI directories - never apply to $HOME */}}
scripts/
.github/

{{/* Ignore COSMIC DE config on non-Fedora systems */}}
{{- if not (and (eq .chezmoi.os "linux") (or (lookPath "dnf") (lookPath "rpm-ostree"))) }}
.config/cosmic/
{{- end }}

{{/* Ignore Windows-only configs on non-Windows */}}
{{- if ne .chezmoi.os "windows" }}
.config/komorebi/
{{- end }}

{{/* Ignore Unix-only configs on Windows */}}
{{- if eq .chezmoi.os "windows" }}
.zsh/
.zshrc
.zshenv
.p10k.zsh
.config/alacritty/
.config/atuin/
.config/bat/
.config/btop/
.config/fish/
.config/flashspace/
.config/ghostty/
.config/kitty/
.config/lazygit/
.config/nushell/
.config/sketchybar/
.config/skhd/
.config/thefuck/
.config/zellij/
{{- end }}
