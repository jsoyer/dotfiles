# Single chezmoi ignore file (target paths, relative to $HOME).
# Both .chezmoiignore and .chezmoiignore.tmpl used to exist; chezmoi merged
# them, but docs only mentioned the .tmpl and rules landed in the wrong file.
{{- $mp := index . "machine_profile" -}}

.DS_Store
README.md
CLAUDE.md
docs/
.private/Brewfile
.zsh/secrets.zsh
.bash/secrets.bash
# Never track secret files even if accidentally added
.env
.envrc
.netrc
.pypirc
.docker/config.json
.kube/config
.aws/credentials
.aws/config
*.key
*.pem
*.p12

{{/* Build artifacts, development-only, and non-deployable directories */}}
tools/
.omc/
.serena/
.rtk/

{{/* Ignore full bash configuration on Fedora Atomic host, but allow minimal .bashrc */}}
{{- if lookPath "rpm-ostree" }}
.bash_profile
.bash/
{{- end }}

{{/* In toolbox, only ignore .bashrc and .bash/ but allow .bash_profile for env vars */}}
{{- if env "TOOLBOX_PATH" }}
.bashrc
.bash/
{{- end }}

{{/* Ignore SSH config on macOS when 1Password app is not installed */}}
{{- if and (eq .chezmoi.os "darwin") (not (stat "/Applications/1Password.app")) }}
.ssh/config
{{- end }}

{{/* Scripts, CI, and project-local directories - never apply to $HOME */}}
scripts/
.github/
tasks/
memory/

{{/* Ignore COSMIC DE config on non-Fedora systems */}}
{{- if not (and (eq .chezmoi.os "linux") (or (lookPath "dnf") (lookPath "rpm-ostree"))) }}
.config/cosmic/
{{- end }}

{{/* Ignore macOS-only configs on non-macOS */}}
{{- if ne .chezmoi.os "darwin" }}
Library/
{{- end }}

{{/* Ignore Windows-only configs on non-Windows */}}
{{- if ne .chezmoi.os "windows" }}
.config/komorebi/
{{- end }}

{{/* AI CLI tools — runtime/cache/secrets exclusions */}}
{{/* .codex runtime */}}
.codex/auth.json
.codex/history.jsonl
.codex/models_cache.json
.codex/state_5.sqlite
.codex/.codex-global-state.json
.codex/.personality_migration
.codex/version.json
.codex/log/**
.codex/sessions/**
.codex/shell_snapshots/**
.codex/sqlite/**
.codex/tmp/**
.codex/vendor_imports/**
.codex/skills/**

{{/* Other CLI skills — managed by aictx, not chezmoi */}}
.qwen/skills/
.kimi/skills/

{{/* OmArchy — selective overrides (respect OmArchy defaults for nvim, WM).
     Patterns are TARGET paths (.zsh/), not source names (dot_zsh/). */}}
{{- if eq $mp "omarchy" }}
{{-   if not (index . "omarchy" | default dict | dig "override_shell" true) }}
.zsh/
.zshrc
.zprofile
.config/starship/
{{-   end }}
{{-   if not (index . "omarchy" | default dict | dig "override_nvim" false) }}
.config/nvim/
{{-   end }}
{{-   if not (index . "omarchy" | default dict | dig "override_tmux" true) }}
.config/tmux/
{{-   end }}
{{-   if not (index . "omarchy" | default dict | dig "override_wm" false) }}
.config/hypr/
.config/waybar/
{{-   end }}
{{- end }}

{{/* .config/opencode — skip entirely on platforms without ocx */}}
{{- $ocxProfiles := list "mac-personal" "fedora-desktop" "toolbox" "ubuntu-desktop" "arch-desktop" "omarchy" -}}
{{- if not (has $mp $ocxProfiles) }}
.config/opencode/
{{- else }}
{{/* opencode runtime + generated files */}}
.config/opencode/node_modules/
.config/opencode/package.json
.config/opencode/bun.lock
.config/opencode/.opencode/
.config/opencode/.ocx/
.config/opencode/tui.json
.config/opencode/*.bak*
.config/opencode/.gitignore
.config/opencode/oh-my-opencode.json*
.config/opencode/profiles/default/opencode.jsonc
{{- end }}

{{/* .kiro — ignore entirely (UUID-specific, trivial config) */}}
.kiro/**

{{/* Ignore Unix-only configs on Windows */}}
{{- if eq .chezmoi.os "windows" }}
.zsh/
.zshrc
.zshenv
.zprofile
.p10k.zsh
.profile
.bash/
.bash_profile
.bashrc
.config/alacritty/
.config/atuin/
.config/bat/
.config/btop/
.config/fish/
.config/flashspace/
.config/ghostty/
.config/isync/
.config/kitty/
.config/lazygit/
.config/msmtp/
.config/neomutt/
.config/nushell/
.config/nvim/
.config/sketchybar/
.config/skhd/
.config/starship/
.config/thefuck/
.config/tmux/
.config/zellij/
.ssh/
.codex/**
.qwen/**
.vibe/**
.mistralcode/**
{{- end }}

