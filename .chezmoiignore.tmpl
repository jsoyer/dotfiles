.DS_Store
README.md
CLAUDE.md
.private/Brewfile
.zsh/secrets.zsh
# Never track secret files even if accidentally added
.env
.envrc
*.key
*.pem
*.p12

{{/* Ignore full bash configuration on Fedora Atomic host, but allow minimal .bashrc */}}
{{- if lookPath "rpm-ostree" }}
.bash_profile
.bash/
{{- end }}

{{/* In toolbox, only ignore .bashrc and .bash/ but allow .bash_profile for env vars */}}
{{- if env "TOOLBOX_PATH" }}
.bashrc
.bash/
{{- end }}

{{/* Ignore SSH config on macOS when 1Password app is not installed */}}
{{- if and (eq .chezmoi.os "darwin") (not (stat "/Applications/1Password.app")) }}
.ssh/config
{{- end }}

{{/* Scripts and CI directories - never apply to $HOME */}}
scripts/
.github/

{{/* Ignore COSMIC DE config on non-Fedora systems */}}
{{- if not (and (eq .chezmoi.os "linux") (or (lookPath "dnf") (lookPath "rpm-ostree"))) }}
.config/cosmic/
{{- end }}

{{/* Ignore Windows-only configs on non-Windows */}}
{{- if ne .chezmoi.os "windows" }}
.config/komorebi/
{{- end }}

{{/* Ignore Unix-only configs on Windows */}}
{{- if eq .chezmoi.os "windows" }}
.zsh/
.zshrc
.zshenv
.zprofile
.p10k.zsh
.profile
.bash/
.bash_profile
.bashrc
.config/alacritty/
.config/atuin/
.config/bat/
.config/btop/
.config/fish/
.config/flashspace/
.config/ghostty/
.config/isync/
.config/kitty/
.config/lazygit/
.config/msmtp/
.config/neomutt/
.config/nushell/
.config/nvim/
.config/sketchybar/
.config/skhd/
.config/starship/
.config/thefuck/
.config/tmux/
.config/zellij/
.ssh/
{{- end }}
