# ============================================================================
# Cache helper: regenerate if cache is missing or older than 24h
# ============================================================================
function _fish_cache_eval -a name cmd
    set -l cache $HOME/.cache/fish/$name.fish
    if not test -f $cache; or test (math (date +%s) - (stat -c %Y $cache 2>/dev/null; or stat -f %m $cache 2>/dev/null; or echo 0)) -gt 86400
        mkdir -p $HOME/.cache/fish
        eval $cmd >$cache 2>/dev/null
    end
    source $cache
end

# LS_COLORS with vivid -- cache output to avoid forking vivid on every startup
if command -q vivid
    set -l _vivid_theme catppuccin-mocha
    test "$_use_snazzy" = true; and set _vivid_theme snazzy
    set -l _vivid_cache $HOME/.cache/vivid/ls-colors-$_vivid_theme.txt
    if not test -f $_vivid_cache; or test (math (date +%s) - (stat -c %Y $_vivid_cache 2>/dev/null; or stat -f %m $_vivid_cache 2>/dev/null; or echo 0)) -gt 86400
        mkdir -p $HOME/.cache/vivid
        vivid generate $_vivid_theme >$_vivid_cache 2>/dev/null
    end
    set -gx LS_COLORS (cat $_vivid_cache)
end

