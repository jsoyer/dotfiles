# Chezmoi update + package updates
function sysup
    set os (uname -s | tr '[:upper:]' '[:lower:]')

    # sysup doit tourner sans surveillance (appelee par `cup`). Chaque
    # gestionnaire se tait a sa facon : NONINTERACTIVE pour Homebrew,
    # HOMEBREW_NO_ENV_HINTS pour les hints, DEBIAN_FRONTEND pour dpkg.
    # -f limite la portee a la fonction, le shell n'est pas pollue.
    # HOMEBREW_NO_ASK : le mode "ask" de brew est actif par defaut et demande
    # "Do you want to proceed? [y/n]" ; NONINTERACTIVE ne le couvre pas.
    set -f -x NONINTERACTIVE 1
    set -f -x HOMEBREW_NO_ASK 1
    set -f -x HOMEBREW_NO_ENV_HINTS 1
    set -f -x DEBIAN_FRONTEND noninteractive

    # oh-my-zsh : upgrade.sh appele directement (la fonction `omz` n'existe
    # que dans zsh). Non interactif par defaut, -v minimal limite le bruit.
    set -l omz_dir (test -n "$ZSH"; and echo $ZSH; or echo "$HOME/.oh-my-zsh")
    if test -x "$omz_dir/tools/upgrade.sh"
        echo "💤 Updating oh-my-zsh..."
        "$omz_dir/tools/upgrade.sh" -v minimal; or true
    end

    switch $os
        case darwin
            bup
            # brew-cask-upgrade demande une confirmation par cask sans -y ;
            # on appelle la commande complete pour ne pas rendre `bcu` muet
            # quand tu l'utilises a la main.
            breww cu -a -y
            if command -q mas
                echo "📱 Updating App Store apps..."
                mas upgrade
            end
            # Condition positive sur mac-personal : une variable vide doit
            # exclure la machine de travail, pas l'inclure.
            if test "$MACHINE_PROFILE" = "mac-personal"
                update-ai
            end
        case linux
            set -l _mp "$MACHINE_PROFILE"
            switch $_mp
                case rpi ubuntu-desktop ubuntu-server debian
                    echo "📦 Updating apt packages..."
                    sudo apt-get update; and sudo apt-get dist-upgrade -y; and sudo apt-get autoremove -y
                case arch-desktop arch-server omarchy
                    echo "📦 Updating pacman packages..."
                    sudo pacman -Syu --noconfirm
                    if command -q yay
                        echo "📦 Updating AUR packages..."
                        yay -Sua --noconfirm
                    end
                case fedora-desktop fedora-server toolbox
                    echo "📦 Updating dnf packages..."
                    sudo dnf upgrade --refresh -y
                case fedora-atomic
                    echo "🔒 Updating Fedora Atomic..."
                    rpm-ostree upgrade
            end

            if command -q flatpak
                echo "📦 Updating Flatpak apps..."
                # -y ne couvre pas les questions de choix (remote/version) :
                # --noninteractive est le mode prevu pour l'automatisation.
                flatpak update --noninteractive -y
            end

            if command -q brew
                eval (brew shellenv)
                echo "🍺 Updating Linuxbrew packages..."
                brew update; and brew upgrade; and brew cleanup
            end

            update-ai
        case windows
            echo "🪣 Updating Scoop packages..."
            scoop update --all
    end
end

# Format : "commande|update integre|repli"   (champ vide = non applicable)
# Deux couches : BINAIRE, puis EXTENSIONS que l'updater du binaire ne touche pas.
# Un updater integre passe devant Homebrew, meme quand l'outil vient de brew :
# brew livrait cline 3.0.3 quand l'editeur en etait a 3.0.56.
set -g _AI_TOOLS \
    "claude|claude update|" \
    "codex|codex update|npm update -g @openai/codex" \
    "cursor-agent|cursor-agent update|" \
    "grok|grok update|" \
    "copilot|copilot update|" \
    "kilo|kilo upgrade|" \
    "qwen|qwen update|" \
    "opencode|opencode upgrade|" \
    "kimi|kimi upgrade|" \
    "pi|pi update --all --no-approve|"

# gemini : binaire sans updater (reste sur brew), mais extensions couvertes.
set -g _AI_EXTENSIONS \
    "gemini|gemini extensions update --all"

# update-ai [--dry-run]
function update-ai
    set -l dry 0
    test "$argv[1]" = "--dry-run"; and set dry 1

    set -l updated 0
    set -l absent 0
    set -l failed 0

    echo "🤖 Updating CLI AI tools..."

    for entry in $_AI_TOOLS
        set -l parts (string split '|' $entry)
        set -l cmd $parts[1]
        set -l self $parts[2]
        set -l fallback $parts[3]

        if not command -q $cmd
            set absent (math $absent + 1)
            test $dry -eq 1; and printf "  %-13s %s\n" $cmd "absent"
            continue
        end

        set -l action ""
        if test -n "$self"
            set action $self
        else if test -n "$fallback"
            set action $fallback
        else
            set absent (math $absent + 1)
            continue
        end

        if test $dry -eq 1
            printf "  %-13s %s\n" $cmd "$action"
            continue
        end

        echo "  🤖 $cmd"
        # Un updater casse ne doit jamais interrompre les suivants.
        if eval $action
            set updated (math $updated + 1)
        else
            set failed (math $failed + 1)
            echo "     ⚠ $cmd : echec de la mise a jour, on continue" >&2
        end
    end

    for entry in $_AI_EXTENSIONS
        set -l parts (string split -m1 '|' $entry)
        set -l cmd $parts[1]
        set -l action $parts[2]
        command -q $cmd; or continue

        if test $dry -eq 1
            printf "  %-13s %s\n" "$cmd ext" "$action"
            continue
        end

        echo "  🧩 $cmd (extensions)"
        if eval $action
            set updated (math $updated + 1)
        else
            set failed (math $failed + 1)
            echo "     ⚠ $cmd extensions : echec, on continue" >&2
        end
    end

    test $dry -eq 1; and return 0
    echo "  → $updated mis a jour, $absent absents, $failed en echec"
end

function cup
    chezmoi update -v $argv
    sysup
    dcua $HOME
    echo "✅ Update complete!"
end

