function dcua
    set -l base (if test (count $argv) -gt 0; echo $argv[1]; else; echo .; end)
    set -l runtime ""

    if command -q docker; and docker info >/dev/null 2>&1
        set runtime "docker"
    else if command -q podman; and podman info >/dev/null 2>&1
        set runtime "podman"
    else
        echo "⚠️ No container runtime found."
        return 1
    end

    set -l updated 0

    for dir in $base/*/
        set -l compose_file ""
        if test -f "$dir/docker-compose.yml"
            set compose_file "$dir/docker-compose.yml"
        else if test -f "$dir/compose.yml"
            set compose_file "$dir/compose.yml"
        else
            continue
        end

        set -l name (basename $dir)
        echo "📥 $name"

        set -l before ($runtime compose -f $compose_file images -q 2>/dev/null | sort)
        $runtime compose -f $compose_file pull --quiet 2>/dev/null
        set -l after ($runtime compose -f $compose_file images -q 2>/dev/null | sort)

        if test "$before" != "$after"
            echo "  🔄 Updated, restarting..."
            $runtime compose -f $compose_file up -d --quiet-pull
            set updated (math $updated + 1)
        else
            echo "  ✅ Up to date"
        end
    end

    echo "🧹 Pruning dangling images..."
    $runtime image prune -f --filter "dangling=true" 2>/dev/null
    echo "✨ Done. $updated project(s) updated."
end

