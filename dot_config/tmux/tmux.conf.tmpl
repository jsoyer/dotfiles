{{- $isRpi := and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "raspbian") (stat "/proc/device-tree/model")) -}}
{{- $sshIcon := "" -}}
{{- $sshIconColor := "#eff0eb" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $sshIcon = "" -}}
{{-   $sshIconColor = "#ffffff" -}}
{{- else if eq .chezmoi.os "windows" -}}
{{-   $sshIcon = "" -}}
{{-   $sshIconColor = "#00a4ef" -}}
{{- else if $isRpi -}}
{{-   $sshIcon = "🍓" -}}
{{-   $sshIconColor = "#ff5c57" -}}
{{-   if hasPrefix "bbh-network" .chezmoi.hostname -}}{{- $sshIcon = "🌐" -}}
{{-   else if hasPrefix "omv-" .chezmoi.hostname -}}{{- $sshIcon = "🐟" -}}
{{-   end -}}
{{- else if eq .chezmoi.osRelease.id "arch" -}}
{{-   $sshIcon = "" -}}
{{-   $sshIconColor = "#1793d1" -}}
{{- else if eq .chezmoi.osRelease.id "omarchy" -}}
{{-   $sshIcon = "" -}}
{{-   $sshIconColor = "#9b59b6" -}}
{{- else if eq .chezmoi.osRelease.id "fedora" -}}
{{-   $sshIcon = "" -}}
{{-   $sshIconColor = "#51a2da" -}}
{{- else if eq .chezmoi.osRelease.id "ubuntu" -}}
{{-   $sshIcon = "" -}}
{{-   $sshIconColor = "#e95420" -}}
{{- else if eq .chezmoi.osRelease.id "debian" -}}
{{-   $sshIcon = "" -}}
{{-   $sshIconColor = "#a80030" -}}
{{- end -}}
source-file ~/.config/tmux/tmux.reset.conf
set-option -g default-terminal 'tmux-256color'
set-option -g allow-passthrough on
set-option -g terminal-features 'xterm*:clipboard'
set-option -g terminal-overrides ',xterm-256color:RGB'
{{ if eq .chezmoi.os "darwin" -}}
set-option -g default-shell {{ env "HOMEBREW_PREFIX" | default "/opt/homebrew" }}/bin/zsh
{{ else -}}
set-option -g default-shell /usr/bin/zsh
{{ end -}}

# ============================================================================
# Common settings
# ============================================================================
set -g base-index 1
set -g detach-on-destroy off
set -g escape-time 0
set -g extended-keys on
set -g extended-keys-format csi-u
set -g history-limit 1000000
set -g renumber-windows on
set-option -g set-clipboard external
set -g default-terminal "${TERM}"
setw -g mode-keys vi
set -g popup-border-lines rounded
set -g set-titles on
set -g set-titles-string '#{pane_title}'

# ============================================================================
# Local vs SSH: prefix and status position
# ============================================================================
if-shell '[ -z "$SSH_TTY" ]' 'set -g prefix ^A; bind ^A last-window; set -g status-position top; set -g pane-active-border-style "fg=magenta,bg=default"; set -g pane-border-style "fg=brightblack,bg=default"'
if-shell '[ -n "$SSH_TTY" ]' 'set -g prefix ^B; bind ^B last-window; set -g status-position bottom'

# Catppuccin config (catppuccin plugin overrides status in local mode)
set -g @catppuccin_flavour 'mocha'
set -g @catppuccin_window_left_separator "\ue0b6"
set -g @catppuccin_window_right_separator "\ue0b4\u00a0"
set -g @catppuccin_window_middle_separator " \u2588"
set -g @catppuccin_window_number_position "right"
set -g @catppuccin_window_default_fill "number"
set -g @catppuccin_window_default_text "#W"
set -g @catppuccin_window_current_fill "number"
set -g @catppuccin_window_current_text "#W#{?window_zoomed_flag,(),}"
set -g @catppuccin_status_modules_right "directory date_time"
set -g @catppuccin_status_modules_left "session"
set -g @catppuccin_status_left_separator  " \ue0b6"
set -g @catppuccin_status_right_separator "\ue0b4 "
set -g @catppuccin_status_right_separator_inverse "no"
set -g @catppuccin_status_fill "icon"
set -g @catppuccin_status_connect_separator "no"
set -g @catppuccin_directory_text "#{b:pane_current_path}"
set -g @catppuccin_meetings_text "#($HOME/.config/tmux/scripts/cal.sh)"
set -g @catppuccin_date_time_text "%H:%M"

# ============================================================================
# Plugins
# ============================================================================
set -g @fzf-url-fzf-options '-p 60%,30% --prompt="   " --border-label=" Open URL "'
set -g @fzf-url-history-limit '2000'

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'fcsonline/tmux-thumbs'
set -g @plugin 'sainnhe/tmux-fzf'
set -g @plugin 'wfxr/tmux-fzf-url'
set -g @plugin 'omerxx/catppuccin-tmux'
set -g @plugin 'omerxx/tmux-sessionx'
set -g @plugin 'omerxx/tmux-floax'
set -g @floax-width '80%'
set -g @floax-height '80%'
set -g @floax-border-color 'magenta'
set -g @floax-text-color 'blue'
set -g @floax-bind 'b'
set -g @floax-change-path 'true'
set -g @sessionx-bind-zo-new-window 'ctrl-y'
set -g @sessionx-auto-accept 'off'
set -g @sessionx-custom-paths '{{ .chezmoi.homeDir }}/dotfiles'
set -g @sessionx-bind 'o'
set -g @sessionx-x-path '~/dotfiles'
set -g @sessionx-window-height '85%'
set -g @sessionx-window-width '75%'
set -g @sessionx-zoxide-mode 'on'
set -g @sessionx-custom-paths-subdirectories 'false'
set -g @sessionx-filter-current 'false'
set -g @continuum-restore 'on'
set -g @resurrect-strategy-nvim 'session'

set-environment -g TMUX_PLUGIN_MANAGER_PATH '~/.config/tmux/plugins'
run '~/.config/tmux/plugins/tpm/tpm'

# ============================================================================
# Snazzy override AFTER tpm (catppuccin sets status, we override in SSH)
# ============================================================================
if-shell '[ -n "$SSH_TTY" ]' "set -g status-style 'bg=#282a36 fg=#eff0eb'; set -g status-left-length 50; set -g status-right-length 100; set -g status-left '#[fg={{ $sshIconColor }},bold]{{ $sshIcon }} #[fg=#f3f99d,bold]#S #[fg=#5af78e]│ '; set -g status-right '#[fg=#5af78e]│ #[fg=#57c7ff]#H #[fg=#5af78e]│ #[fg=#ff6ac1]%d/%m #[fg=#f3f99d]%H:%M '; set -g window-status-format '#[fg=#9aedfe] #I:#W '; set -g window-status-current-format '#[fg=#282a36,bg=#57c7ff,bold] #I:#W#{?window_zoomed_flag, 󰊓,} '; set -g window-status-separator ''; set -g pane-border-style 'fg=#3a3d4d'; set -g pane-active-border-style 'fg=#57c7ff'; set -g message-style 'bg=#57c7ff fg=#282a36'; set -g message-command-style 'bg=#ff6ac1 fg=#282a36'; set -g mode-style 'bg=#3a3d4d fg=#eff0eb'"

# ============================================================================
# Keybindings
# ============================================================================
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind v split-window -h -c "#{pane_current_path}"
bind s split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"
