#!/usr/bin/env bash

source "$CONFIG_DIR/colors.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar Appearance #####
sketchybar --bar         \
  position=top           \
  height=35              \
  blur_radius=50         \
  color=$BAR_COLOR       \
  padding_left=8         \
  padding_right=8

##### Defaults #####
sketchybar --default                                \
  padding_left=4                                    \
  padding_right=4                                   \
  icon.font="Hack Nerd Font:Bold:14.0"              \
  icon.color=$ICON_COLOR                            \
  icon.padding_left=6                               \
  icon.padding_right=4                              \
  label.font="SF Pro:Semibold:13.0"                 \
  label.color=$LABEL_COLOR                          \
  label.padding_left=4                              \
  label.padding_right=8                             \
  background.color=$ITEM_BG_COLOR                   \
  background.corner_radius=6                        \
  background.height=26                              \
  popup.background.color=$POPUP_BACKGROUND_COLOR    \
  popup.background.border_color=$POPUP_BORDER_COLOR \
  popup.background.border_width=2                   \
  popup.background.corner_radius=8                  \
  updates=on

##### Left — Aerospace workspaces #####

sketchybar --add event aerospace_workspace_change

for monitor in $(aerospace list-monitors --format "%{monitor-appkit-nsscreen-screens-id}"); do
  for sid in $(aerospace list-workspaces --monitor "$monitor"); do
    display_id="1"
    if [ "$sid" -ge 6 ] && [ "$sid" -le 7 ]; then
      display_id="2"
    fi

    sketchybar --add item space.$sid left           \
      --set space.$sid display="$display_id"        \
      --subscribe space.$sid aerospace_workspace_change \
      --set space.$sid                              \
        background.color=$WS_INACTIVE_BG            \
        background.corner_radius=5                  \
        background.border_color=$TRANSPARENT        \
        background.border_width=0                   \
        background.height=26                        \
        background.drawing=on                       \
        icon="$sid"                                 \
        icon.color=$WS_INACTIVE_ICON                \
        icon.font="SF Pro:Bold:13.0"                \
        icon.padding_left=8                         \
        icon.padding_right=2                        \
        icon.shadow.drawing=off                     \
        label.font="sketchybar-app-font:Regular:14.0" \
        label.color=$LABEL_COLOR                    \
        label.padding_left=2                        \
        label.padding_right=8                       \
        label.y_offset=-1                           \
        label.shadow.drawing=off                    \
        drawing=on                                  \
        click_script="aerospace workspace $sid"     \
        script="$PLUGIN_DIR/aerospace.sh $sid"
  done
done

# Load app icons for non-empty workspaces on startup
for monitor in $(aerospace list-monitors); do
  for sid in $(aerospace list-workspaces --monitor "$monitor" --empty no); do
    apps=$(aerospace list-windows --workspace "$sid" | awk -F'|' '{gsub(/^ *| *$/, "", $2); print $2}')
    sketchybar --set space.$sid drawing=on
    icon_strip=" "
    if [ "${apps}" != "" ]; then
      while read -r app; do
        icon_strip+=" $($PLUGIN_DIR/icon_map_fn.sh "$app")"
      done <<<"${apps}"
    else
      icon_strip=""
    fi
    sketchybar --set space.$sid label="$icon_strip"
  done
done

##### Left — Separator › front app › timer #####
sketchybar --add item separator left                \
           --set separator                          \
             icon="›"                              \
             icon.font="SF Pro:Bold:16.0"           \
             icon.color=$ACCENT_COLOR               \
             icon.padding_left=6                    \
             icon.padding_right=6                   \
             label.drawing=off                      \
             background.drawing=off                 \
             click_script=false

source "$ITEM_DIR/front_app.sh"
source "$ITEM_DIR/timer.sh"

##### Center — Media (hidden when nothing plays) #####
source "$ITEM_DIR/media.sh"

##### Right — System stats #####
# Order added = rightmost first
# Result (left→right): mic | github | cpu | ram | wifi | volume | battery | calendar

source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/ram.sh"
source "$ITEM_DIR/cpu.sh"
source "$ITEM_DIR/github.sh"
source "$ITEM_DIR/mic.sh"

##### Force all scripts to run the first time #####
sketchybar --update
