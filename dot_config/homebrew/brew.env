# Homebrew user environment file — read by EVERY brew invocation, including
# non-interactive ones (systemd timers, chezmoi scripts, cron), unlike the
# shell exports in dot_zsh/00-env.zsh which only cover interactive shells.
# No shell expansion allowed here (KEY=value only). See `man brew`, section
# "ENVIRONMENT" -> environment files.

# Homebrew 6 made "ask before install/reinstall/upgrade" the default in a TTY.
# That broke every scripted flow that suddenly hung on "[y/n]": sysup, breww,
# run_onchange_03-brew-bundle, chezmoi-autoupdate. Restore the historical
# non-interactive behaviour.
HOMEBREW_NO_ASK=1
