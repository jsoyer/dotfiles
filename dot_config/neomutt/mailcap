# mailcap — NeoMutt MIME handlers

# HTML: inline rendering via w3m (copiousoutput = displayed in NeoMutt pager)
text/html; w3m -dump -I %{charset} -T text/html %s; copiousoutput; nametemplate=%s.html
# HTML: open in browser (key V)
text/html; open %s; test=test "$(uname)" = "Darwin"; needsterminal
text/html; xdg-open %s; needsterminal

# Images: inline display via chafa (Kitty/Sixel — WezTerm + Ghostty)
image/*; chafa --format auto --size 80x24 %s; copiousoutput
