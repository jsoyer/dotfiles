[Unit]
Description=Update cursor-agent to the latest version
Documentation=file:%h/.local/bin/update-cursor-agent
# --user scope: the binary, the auth and the versions all live in $HOME.

[Service]
Type=oneshot
ExecStart=%h/.local/bin/update-cursor-agent
# The script handles the worker restart, the crash-loop detection and the
# pruning of old versions itself. It exits 0 on a plain network outage.
SuccessExitStatus=0
TimeoutStartSec=10min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
