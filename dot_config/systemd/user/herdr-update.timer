[Unit]
Description=Daily check for herdr updates

[Timer]
Unit=herdr-update.service
# Deliberately an off-hour, not "daily" (= midnight sharp): the update hands
# over the server that holds your panes. Better when you are not typing in them.
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30min
# Catch up if the machine was off at 04:00.
Persistent=true

[Install]
WantedBy=timers.target
