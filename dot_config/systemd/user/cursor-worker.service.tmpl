[Unit]
Description=Cursor private worker (cloud agents running on this machine)
Documentation=https://docs.cursor.com/en/cli/overview
# No network-online.target in --user scope (it does not exist there): network
# resilience comes from Restart=always plus the backoff below.
# No start limit, but a REAL backoff — see the note below.
StartLimitIntervalSec=0

[Service]
Type=simple
# WARNING: `cursor-agent`, NOT `agent`: ~/.local/bin/agent is the Grok CLI,
# which has no `worker` subcommand at all. The previous version of this unit
# pointed at it and failed 262,957 times without anything flagging it.
#
# Cloud-agent parity (all three are explicit opt-ins, never enabled server-side):
#   --connect-workspace   open the agent's live workspace (files, changes,
#                         terminal, ports) from Cursor; starts cursor-server on
#                         127.0.0.1 on demand. Agents run as trusted workspaces.
#   --computer-use        agents drive a desktop (screenshot, click, type) on a
#                         Cursor-managed TigerVNC + Xfce display.
#   --share-desktop view_and_control
#                         "Show desktop" in Cursor: watch AND take the mouse and
#                         keyboard. Pixels leave through the outbound worker
#                         connection — no inbound port is opened.
# The desktop flags are only emitted when the packages are present (install-ai
# --cursor-desktop): otherwise the worker would advertise a desktop it cannot
# start. Installed them later? `chezmoi apply` again, then restart the worker.
# Preflight: `cursor-agent worker debug` (sections "Computer use" and
# "Desktop share" must say yes).
{{- $desktop := and (lookPath "Xtigervnc") (lookPath "startxfce4") (lookPath "xdotool") (lookPath "ffmpeg") }}
ExecStart=%h/.local/bin/cursor-agent worker start --name {{ .chezmoi.hostname }}-worker --connect-workspace{{ if $desktop }} --computer-use --share-desktop view_and_control{{ end }}
WorkingDirectory=%h

# --- Always up ---
Restart=always
RestartSec=10
# Exponential backoff 10s -> 5min (systemd >= 254). Without it, an invalid
# command or an expired token restarts the binary every 10s forever.
RestartSteps=5
RestartMaxDelaySec=300
# --- Clean shutdown ---
KillSignal=SIGTERM
TimeoutStopSec=30

# --- Environment ---
# cursor-agent shells out to git / node / project tooling: full PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=HOME=%h

# --- Worker authentication ---
# WARNING: the session token from `cursor-agent login` is NOT accepted in worker
# mode: `worker start` answers "Authentication required for worker mode".
# It needs an API key (CURSOR_API_KEY), kept in a 0600 file outside the repo.
# The leading `-` makes the file optional so the unit still loads on a machine
# where the worker is not configured.
# Written by: cursor-setup --api-key
EnvironmentFile=-%h/.config/cursor/worker.env

[Install]
WantedBy=default.target
