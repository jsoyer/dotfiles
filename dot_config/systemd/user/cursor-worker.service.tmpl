[Unit]
Description=Cursor private worker (cloud agents running on this machine)
Documentation=https://docs.cursor.com/en/cli/overview
# No network-online.target in --user scope (it does not exist there): network
# resilience comes from Restart=always plus the backoff below.
# No start limit, but a REAL backoff — see the note below.
StartLimitIntervalSec=0

[Service]
Type=simple
# WARNING: `cursor-agent`, NOT `agent`: ~/.local/bin/agent is the Grok CLI,
# which has no `worker` subcommand at all. The previous version of this unit
# pointed at it and failed 262,957 times without anything flagging it.
ExecStart=%h/.local/bin/cursor-agent worker start --name {{ .chezmoi.hostname }}-worker
WorkingDirectory=%h

# --- Always up ---
Restart=always
RestartSec=10
# Exponential backoff 10s -> 5min (systemd >= 254). Without it, an invalid
# command or an expired token restarts the binary every 10s forever.
RestartSteps=5
RestartMaxDelaySec=300
# --- Clean shutdown ---
KillSignal=SIGTERM
TimeoutStopSec=30

# --- Environment ---
# cursor-agent shells out to git / node / project tooling: full PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=HOME=%h

# --- Worker authentication ---
# WARNING: the session token from `cursor-agent login` is NOT accepted in worker
# mode: `worker start` answers "Authentication required for worker mode".
# It needs an API key (CURSOR_API_KEY), kept in a 0600 file outside the repo.
# The leading `-` makes the file optional so the unit still loads on a machine
# where the worker is not configured.
# Written by: cursor-setup --api-key
EnvironmentFile=-%h/.config/cursor/worker.env

[Install]
WantedBy=default.target
