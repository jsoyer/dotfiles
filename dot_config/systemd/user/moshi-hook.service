[Unit]
Description=Moshi hook daemon (local socket + Moshi WebSocket bridge)
Documentation=https://github.com/rjyo/moshi
# NB: no network-online.target in --user scope (it does not exist there).
# Network resilience comes from Restart=always plus the backoff below.
# No start limit: this service must never end up in "failed"
# ([Unit] key, not [Service] — systemd silently ignores it otherwise).
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/moshi-hook serve
WorkingDirectory=%h

# --- Always up ---
# always (not on-failure): the daemon can exit 0 (e.g. after a self-update or a
# dropped bridge) and we still want it back.
Restart=always
RestartSec=2
# Exponential backoff 2s -> 60s (systemd >= 254): no crash loop spamming the
# journal when the network or the pairing stays broken.
RestartSteps=5
RestartMaxDelaySec=60
# --- Clean shutdown ---
KillSignal=SIGTERM
TimeoutStopSec=20

# --- Environment ---
# moshi-hook shells out to tmux / git / ssh: full PATH, including ~/.local/bin
# (where it lives itself, which matters for its re-execs).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=HOME=%h

[Install]
WantedBy=default.target
