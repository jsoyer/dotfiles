[Unit]
Description=Update herdr to the latest version
Documentation=file:%h/.local/bin/update-herdr
# --user scope: the binary (~/.local/bin/herdr), the config (~/.config/herdr)
# and above all the live sessions belong to the user.

[Service]
Type=oneshot
ExecStart=%h/.local/bin/update-herdr
# The script hands the live sessions over and checks client/server coherence;
# it exits 0 on a plain network outage.
SuccessExitStatus=0
TimeoutStartSec=10min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
