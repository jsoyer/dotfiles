[Unit]
Description=fleet reminder (ntfy if no fleet up for 14 days; history only, opens no connection)
ConditionPathExists=%h/.local/bin/fleet

[Service]
Type=oneshot
ExecStart=%h/.local/bin/fleet reminder
TimeoutStartSec=60
Environment="PATH=%h/.local/bin:%h/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
# Optional, outside the repo (no secret is stored in this unit): FLEET_NTFY_TOKEN=... or the
# 1Password session for `op read`. The leading "-" makes a missing file harmless.
EnvironmentFile=-%h/.config/fleet/env
NoNewPrivileges=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleet-reminder
