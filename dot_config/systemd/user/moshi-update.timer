[Unit]
Description=Daily check for moshi-hook updates

[Timer]
Unit=moshi-update.service
OnCalendar=daily
# Catch up if the machine was off at the scheduled time.
Persistent=true
# Spread the load (avoid hitting the release at the same instant as every other
# update on the fleet).
RandomizedDelaySec=1h
# Let the daemon come up before attempting an update right after boot.
OnBootSec=15min

[Install]
WantedBy=timers.target
