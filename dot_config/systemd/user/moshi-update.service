[Unit]
Description=Update moshi-hook to the latest release
Documentation=file:%h/.local/bin/update-moshi
# --user scope: the binary (~/.local/bin/moshi-hook) and the state
# (~/.config/moshi, ~/.local/state/moshi) belong to the user.

[Service]
Type=oneshot
ExecStart=%h/.local/bin/update-moshi
# The script handles the daemon restart itself, and rolls back if the new
# version fails to come up. It exits 0 on a plain network outage (no alert for
# nothing — the next run catches up).
SuccessExitStatus=0
TimeoutStartSec=10min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
