add_newline = false
format = """$env_var$directory$character"""
palette = "catppuccin_mocha"
right_format = """$all"""
command_timeout = 1000
scan_timeout = 30

# Platform icon — color set per machine_profile via chezmoi template
{{- $mp := index . "machine_profile" -}}
{{- $iconColor := "white" -}}
{{- if or (eq $mp "mac-personal") (eq $mp "mac-pro") }}{{ $iconColor = "mauve" }}
{{- else if eq $mp "rpi" }}{{ $iconColor = "red" }}
{{- else if or (eq $mp "ubuntu-desktop") (eq $mp "ubuntu-server") }}{{ $iconColor = "peach" }}
{{- else if eq $mp "debian" }}{{ $iconColor = "red" }}
{{- else if eq $mp "omarchy" }}{{ $iconColor = "purple" }}
{{- else if or (eq $mp "arch-desktop") (eq $mp "arch-server") }}{{ $iconColor = "blue" }}
{{- else if or (eq $mp "fedora-desktop") (eq $mp "fedora-server") (eq $mp "fedora-atomic") }}{{ $iconColor = "blue" }}
{{- else if eq $mp "toolbox" }}{{ $iconColor = "blue" }}
{{- else if eq $mp "windows" }}{{ $iconColor = "cyan" }}
{{- end }}
[env_var.STARSHIP_ICON]
variable = "STARSHIP_ICON"
style = "bold {{ $iconColor }}"
format = "[$env_value]($style) "
disabled = false

[character]
vicmd_symbol = "[N] >>>"
success_symbol = '[➜](bold green)'
error_symbol = '[➜](bold red)'

[cmd_duration]
min_time = 2000
style = "bold yellow"

[directory]
truncation_length = 3
truncate_to_repo = true

[directory.substitutions]
'~/Documents' = '📄 Docs'
'~/Downloads' = '📥 Downloads'

[hostname]
style = "bold purple"

[username]
format = "[$user]($style) on "
style_user = "bold cyan"

[git_branch]
format = '[$symbol$branch(:$remote_branch)]($style) '
style = "bold pink"
symbol = " "

[git_status]
format = '([\[$all_status$ahead_behind\]]($style) )'
style = "bold red"
conflicted = "🏳"
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = "?${count}"
stashed = '$${count}'
modified = "!${count}"
staged = "+${count}"
renamed = "»${count}"
deleted = "✘${count}"

[aws]
format = '[$symbol(profile: "$profile" )(\(region: $region\) )]($style)'
disabled = false
style = 'bold orange'
symbol = "☁️ "

[golang]
format = 'via [ $version](bold cyan) '

[nodejs]
format = "via [⬢ $version](bold green) "
disabled = false

[python]
format = 'via [🐍 $version](bold yellow) '
disabled = false

[rust]
format = 'via [🦀 $version](bold red) '
disabled = false

[kubernetes]
symbol = '☸ '
disabled = true
detect_files = ['Dockerfile']
format = '[$symbol$context( \($namespace\))]($style) '
contexts = [
]

[docker_context]
disabled = false

[package]
disabled = false

