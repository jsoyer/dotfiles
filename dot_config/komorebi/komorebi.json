{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 8,
  "default_container_padding": 8,
  "border": true,
  "border_width": 4,
  "border_offset": -1,
  "border_colours": {
    "single": {
      "r": 203,
      "g": 166,
      "b": 247
    },
    "stack": {
      "r": 166,
      "g": 227,
      "b": 161
    },
    "monocle": {
      "r": 245,
      "g": 224,
      "b": 220
    },
    "unfocused": {
      "r": 88,
      "g": 91,
      "b": 112
    }
  },
  "monitors": [
    {
      "workspaces": [
        { "name": "I",   "layout": "BSP" },
        { "name": "II",  "layout": "BSP" },
        { "name": "III", "layout": "BSP" },
        { "name": "IV",  "layout": "VerticalStack" },
        { "name": "V",   "layout": "BSP" }
      ]
    },
    {
      "workspaces": [
        { "name": "VI",  "layout": "BSP" },
        { "name": "VII", "layout": "BSP" }
      ]
    }
  ],
  "float_rules": [
    { "kind": "exe", "id": "Calculator.exe", "matching_strategy": "Equals" },
    { "kind": "exe", "id": "SystemSettings.exe", "matching_strategy": "Equals" },
    { "kind": "exe", "id": "1Password.exe", "matching_strategy": "Equals" },
    { "kind": "title", "id": "Picture-in-Picture", "matching_strategy": "Contains" }
  ]
}
