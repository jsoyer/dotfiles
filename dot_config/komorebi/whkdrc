# Komorebi hotkey configuration (whkd)
# Mirrors Aerospace keybindings for cross-platform consistency
# Catppuccin Mocha theme — border colors set in komorebi.json

.shell pwsh

# Focus (vim-style, matches Aerospace alt-hjkl)
alt + h : komorebic focus left
alt + j : komorebic focus down
alt + k : komorebic focus up
alt + l : komorebic focus right

# Move windows (matches Aerospace alt-shift-hjkl)
alt + shift + h : komorebic move left
alt + shift + j : komorebic move down
alt + shift + k : komorebic move up
alt + shift + l : komorebic move right

# Resize (matches Aerospace alt-shift-minus/equal)
alt + shift + oem_minus : komorebic resize-axis horizontal decrease
alt + shift + oem_plus  : komorebic resize-axis horizontal increase

# Workspaces (matches Aerospace alt-1..7)
alt + 1 : komorebic focus-workspace 0
alt + 2 : komorebic focus-workspace 1
alt + 3 : komorebic focus-workspace 2
alt + 4 : komorebic focus-workspace 3
alt + 5 : komorebic focus-workspace 4
alt + 6 : komorebic focus-workspace 5
alt + 7 : komorebic focus-workspace 6

# Move to workspace (matches Aerospace alt-shift-1..7)
alt + shift + 1 : komorebic move-to-workspace 0
alt + shift + 2 : komorebic move-to-workspace 1
alt + shift + 3 : komorebic move-to-workspace 2
alt + shift + 4 : komorebic move-to-workspace 3
alt + shift + 5 : komorebic move-to-workspace 4
alt + shift + 6 : komorebic move-to-workspace 5
alt + shift + 7 : komorebic move-to-workspace 6

# Layout toggles (matches Aerospace alt-e, alt-f)
alt + e : komorebic cycle-layout
alt + f : komorebic toggle-monocle

# Floating toggle (matches Aerospace service mode f)
alt + shift + f : komorebic toggle-float

# Stack operations
alt + shift + semicolon : komorebic toggle-pause

# Workspace back-and-forth (matches Aerospace alt-tab)
alt + tab : komorebic focus-last-workspace

# Move workspace to monitor (matches Aerospace alt-shift-tab)
alt + shift + tab : komorebic cycle-move-to-monitor next

# Close window
alt + q : komorebic close

# Reload config
alt + shift + r : komorebic reload-configuration
