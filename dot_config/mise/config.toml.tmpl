{{- /* Global mise config: language toolchains, plus (Intel macOS) CLI tools.
       Not deployed on servers / Windows; Debian / RPi get it with an empty [tools] (see .chezmoiignore.tmpl).
       Global languages only where mise is the toolchain source: the work Mac
       (mac-pro) and Intel Macs (no Homebrew bottles). Personal Apple Silicon
       Macs get them from Homebrew, Linux desktops from the native package
       manager; there mise only runs per-project versions. */ -}}
{{- $mp := includeTemplate "machine-profile" . -}}
{{- $intel := and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") -}}
{{- $pp := index . "package_profile" | default "legacy" -}}
{{- $base := eq $pp "base" -}}
{{- $globalLangs := and (not $base) (or (eq $mp "mac-pro") $intel) -}}
# ~/.config/mise/config.toml -- managed by chezmoi.
# Per-project versions go in a project-local mise.toml (then `mise trust`).

# Global languages: mac-pro + Intel Macs only (see the header comment in the
# template). Other machines keep an empty [tools] and use project mise.toml.
[tools]
{{- if and $base $intel }}
# Python is the runtime used by package-plan and package wrappers.
python = "latest"
{{- end }}
{{- if $globalLangs }}
node = "latest"
python = "latest"
go = "latest"
# "stable" = latest stable Rust release (rustup-style channel; the mise core
# rust backend lists it in `mise ls-remote rust`).
rust = "stable"
# Ruby: mise uses jdx/ruby precompiled builds, which exist for Linux and macOS
# arm64 only. Intel Macs get a prebuilt ruby from conda-forge instead (see the
# Intel block below), since nothing may compile there.
{{- if not $intel }}
ruby = "latest"
{{- end }}
# Java (Temurin, java.shorthand_vendor default): first entry is the default.
# "lts" is a mise alias for the newest LTS, so it never goes stale. The second
# entry is the newest feature release that has macOS builds: plain "latest"
# (27.x) has no macOS metadata yet and would fail, so bump "temurin-26" when
# a newer series ships for macOS (check `mise lock --platform macos-x64`).
java = ["lts", "temurin-26"]
{{- end }}
{{ if $intel }}
# Intel macOS is Homebrew Tier 3: no bottles, brew would compile from source
# (see dot_local/bin/executable_brewfile-filter-bottled). These CLI tools are
# taken from prebuilt upstream release binaries through the aqua backend
# instead (verified with `mise lock --platform macos-x64`).
# atuin, git-delta and eza ship no darwin/amd64 release asset (aqua would map
# eza to a cargo build), and ruby has no jdx/ruby Intel build: these four come
# from conda-forge's prebuilt osx-64 packages through the conda backend.
# Note: a project .ruby-version still asks the core ruby backend (source build).
"conda:eza" = "latest"
{{- if not $base }}
"conda:ruby" = "latest"
"conda:atuin" = "latest"
"conda:git-delta" = "latest"
{{- end }}
# Keep the dotfiles entrypoint selected globally: an installed mise shim
# otherwise shadows chezmoi without an active version after this file is applied.
"aqua:twpayne/chezmoi" = "latest"
# Zsh/Nushell call Carapace during startup, including outside project folders.
"aqua:carapace-sh/carapace-bin" = "latest"
"aqua:BurntSushi/ripgrep" = "latest"
"aqua:sharkdp/fd" = "latest"
"aqua:sharkdp/bat" = "latest"
"aqua:junegunn/fzf" = "latest"
"aqua:jqlang/jq" = "latest"
{{- if not $base }}
"aqua:mikefarah/yq" = "latest"
{{- end }}
{{- if not $base }}
"aqua:cli/cli" = "latest"
{{- end }}
"aqua:ajeetdsouza/zoxide" = "latest"
"aqua:starship/starship" = "latest"
{{- if not $base }}
"aqua:jesseduffield/lazygit" = "latest"
{{- end }}
{{- if not $base }}
"aqua:astral-sh/uv" = "latest"
{{- end }}
{{- if not $base }}
"aqua:casey/just" = "latest"
{{- end }}
{{- if not $base }}
"aqua:derailed/k9s" = "latest"
{{- end }}
{{- if not $base }}
"aqua:helm/helm" = "latest"
{{- end }}
{{- if not $base }}
"aqua:jesseduffield/lazydocker" = "latest"
{{- end }}
{{- if not $base }}
"aqua:getsops/sops" = "latest"
{{- end }}
{{- if not $base }}
"aqua:watchexec/watchexec" = "latest"
{{- end }}
{{- if not $base }}
"aqua:ducaale/xh" = "latest"
{{- end }}
{{- if not $base }}
"aqua:sxyazi/yazi" = "latest"
{{- end }}
{{- if not $base }}
"aqua:zellij-org/zellij" = "latest"
{{- end }}
{{- if not $base }}
"aqua:astral-sh/ruff" = "latest"
{{- end }}
{{- if not $base }}
"aqua:direnv/direnv" = "latest"
{{- end }}
{{- if not $base }}
"aqua:tealdeer-rs/tealdeer" = "latest"
{{- end }}
"aqua:neovim/neovim" = "latest"
{{- if not $base }}
"aqua:jj-vcs/jj" = "latest"
{{- end }}
{{ end }}
[settings]
# Never force source builds: python/node/go/java come precompiled (python via
# python-build-standalone; ruby on Intel macOS via conda-forge).
all_compile = false
