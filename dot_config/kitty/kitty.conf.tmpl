# ============================================================================
# Kitty Configuration
# ============================================================================
# Based on Ghostty, WezTerm and Alacritty
# Theme: Catppuccin Mocha
# Font: JetBrains Mono Nerd Font
# ============================================================================

# ============================================================================
# Font Configuration
# ============================================================================

font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        12.0

# Disable ligatures
disable_ligatures never

# ============================================================================
# Cursor Configuration
# ============================================================================

cursor_shape block
cursor_blink_interval 0
cursor_stop_blinking_after 15.0

# ============================================================================
# Scrollback
# ============================================================================

scrollback_lines 10000
wheel_scroll_multiplier 5.0
touch_scroll_multiplier 1.0

# ============================================================================
# Mouse
# ============================================================================

mouse_hide_wait 0
url_style curly
open_url_with default
copy_on_select yes
strip_trailing_spaces smart

# ============================================================================
# Terminal Bell
# ============================================================================

enable_audio_bell no
visual_bell_duration 0.0
window_alert_on_bell no

# ============================================================================
# Window Layout
# ============================================================================

enabled_layouts splits:split_axis=horizontal,tall,fat,grid,horizontal,vertical,stack
remember_window_size  yes
initial_window_width  800
initial_window_height 600

window_padding_width 12
window_margin_width 0
single_window_margin_width -1

# Hide window decorations
hide_window_decorations titlebar-only
macos_titlebar_color background
macos_show_window_title_in none

# ============================================================================
# Tab Bar
# ============================================================================

tab_bar_edge top
tab_bar_style powerline
tab_powerline_style slanted
tab_bar_min_tabs 1
tab_title_template "{index}: {title}"
active_tab_font_style bold

# ============================================================================
# Color Scheme - Catppuccin Mocha
# ============================================================================

# The basic colors
foreground              #cdd6f4
background              #1e1e2e
selection_foreground    #1e1e2e
selection_background    #f5e0dc

# Cursor colors
cursor                  #f5e0dc
cursor_text_color       #1e1e2e

# URL underline color when hovering with mouse
url_color               #89b4fa

# Kitty window border colors
active_border_color     #89b4fa
inactive_border_color   #45475a
bell_border_color       #f9e2af

# Tab bar colors
active_tab_foreground   #1e1e2e
active_tab_background   #89b4fa
inactive_tab_foreground #cdd6f4
inactive_tab_background #313244
tab_bar_background      #1e1e2e

# Colors for marks (marked text in the terminal)
mark1_foreground #1e1e2e
mark1_background #89b4fa
mark2_foreground #1e1e2e
mark2_background #f5c2e7
mark3_foreground #1e1e2e
mark3_background #74c7ec

# The 16 terminal colors

# black
color0 #45475a
color8 #585b70

# red
color1 #f38ba8
color9 #f38ba8

# green
color2  #a6e3a1
color10 #a6e3a1

# yellow
color3  #f9e2af
color11 #f9e2af

# blue
color4  #89b4fa
color12 #89b4fa

# magenta
color5  #f5c2e7
color13 #f5c2e7

# cyan
color6  #94e2d5
color14 #94e2d5

# white
color7  #bac2de
color15 #a6adc8

# ============================================================================
# Background Opacity
# ============================================================================

background_opacity 0.9
background_blur 30

# ============================================================================
# Advanced
# ============================================================================

{{ if eq .chezmoi.os "darwin" -}}
shell /opt/homebrew/bin/nu
{{ else -}}
shell /usr/bin/nu
{{ end -}}
editor .
close_on_child_death no
allow_remote_control socket-only
listen_on unix:/tmp/kitty-socket
update_check_interval 0
term xterm-256color

enable_legacy_keyboard true

# ============================================================================
# Keyboard Shortcuts
# ============================================================================

# Clipboard
map cmd+c copy_to_clipboard
map cmd+v paste_from_clipboard
map ctrl+shift+c copy_to_clipboard
map ctrl+shift+v paste_from_clipboard

# Internal copy/paste buffers
map ctrl+alt+f1 copy_to_buffer a
map ctrl+alt+f2 paste_from_buffer a
map ctrl+alt+f3 copy_to_buffer b
map ctrl+alt+f4 paste_from_buffer b
map ctrl+alt+f5 copy_to_buffer c
map ctrl+alt+f6 paste_from_buffer c

# Window management
map cmd+n new_os_window
map ctrl+shift+n new_os_window
map cmd+w close_window
map ctrl+shift+w close_window

# Splits layout
# F4-F7, Shift+arrows, Ctrl+arrows and Ctrl+Shift+arrows follow kitty's
# documented Splits Layout examples for a consistent macOS/Linux workflow.
map f4 launch --location=split
map f5 launch --location=hsplit
map f6 launch --location=vsplit
map f7 layout_action rotate

map shift+up move_window up
map shift+left move_window left
map shift+right move_window right
map shift+down move_window down

map ctrl+up neighboring_window up
map ctrl+left neighboring_window left
map ctrl+right neighboring_window right
map ctrl+down neighboring_window down

map ctrl+shift+up layout_action move_to_screen_edge top
map ctrl+shift+left layout_action move_to_screen_edge left
map ctrl+shift+right layout_action move_to_screen_edge right
map ctrl+shift+down layout_action move_to_screen_edge bottom

map ctrl+. layout_action bias 80
map ctrl+, layout_action bias 50

# The kitty docs also show Ctrl+Shift+Right/Up for axis maximization, but those
# keys are already used above for move_to_screen_edge to stay close to Splits.
map ctrl+alt+h layout_action maximize horizontal
map ctrl+alt+v layout_action maximize vertical

# Window resizing uses the same directions as kitty's docs, with Alt added to
# avoid conflicting with Ctrl+arrows focus navigation.
map ctrl+alt+left resize_window narrower
map ctrl+alt+right resize_window wider
map ctrl+alt+up resize_window taller
map ctrl+alt+down resize_window shorter 3
map ctrl+alt+home resize_window reset

# Tab management
map cmd+t new_tab
map ctrl+shift+t new_tab
map cmd+w close_tab
map ctrl+shift+x close_tab
map cmd+] next_tab
map ctrl+shift+] next_tab
map cmd+[ previous_tab
map ctrl+shift+[ previous_tab
map cmd+shift+] move_tab_forward
map cmd+shift+[ move_tab_backward

# Quick tab switching (cmd+1 through cmd+9)
map cmd+1 goto_tab 1
map cmd+2 goto_tab 2
map cmd+3 goto_tab 3
map cmd+4 goto_tab 4
map cmd+5 goto_tab 5
map cmd+6 goto_tab 6
map cmd+7 goto_tab 7
map cmd+8 goto_tab 8
map cmd+9 goto_tab 9

# Font size
map cmd+equal increase_font_size
map cmd+plus increase_font_size
map cmd+minus decrease_font_size
map cmd+0 restore_font_size
map ctrl+equal increase_font_size
map ctrl+plus increase_font_size
map ctrl+minus decrease_font_size
map ctrl+0 restore_font_size

# Scrolling
map shift+page_up scroll_page_up
map shift+page_down scroll_page_down
map cmd+home scroll_home
map cmd+end scroll_end

# Search
map cmd+f launch --type=overlay --stdin-source=@screen_scrollback /opt/homebrew/bin/fzf --no-sort --no-mouse --exact -i
map ctrl+shift+f launch --type=overlay --stdin-source=@screen_scrollback /opt/homebrew/bin/fzf --no-sort --no-mouse --exact -i

# Reload config
map cmd+shift+r load_config_file
map ctrl+shift+r load_config_file

# ============================================================================
# OS Specific
# ============================================================================

macos_option_as_alt right
macos_quit_when_last_window_closed yes
macos_traditional_fullscreen no
