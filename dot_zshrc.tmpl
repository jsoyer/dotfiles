# Oh-My-Zsh configuration
export ZSH=$HOME/.oh-my-zsh
export UPDATE_ZSH_DAYS=7
ZSH_THEME=""  # Theme disabled, using Starship instead

# ============================================================================
# Oh-My-Zsh Plugins
# ============================================================================
# Platform-specific plugins are conditionally loaded

# Defer ssh-agent to avoid ~100ms fork on startup
zstyle :omz:plugins:ssh-agent quiet yes
zstyle :omz:plugins:ssh-agent lazy yes

plugins=(
  colored-man-pages    # Colorful man pages
  copybuffer           # Copy command line to clipboard (Ctrl+O)
  copyfile             # Copy file contents to clipboard
  extract              # Universal archive extraction
  encode64             # Base64 encoding/decoding helpers
  sudo                 # ESC ESC to add sudo
  ssh-agent            # SSH agent management (lazy-loaded)

{{- if eq .chezmoi.os "darwin" }}
  macos                # macOS-specific utilities
  # kubectl/helm completions handled via _cache_eval in 99-integrations.zsh
{{- end }}
)


# ============================================================================
# Load Oh-My-Zsh (not available on Fedora Atomic host — externals excluded)
# ============================================================================
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ============================================================================
# Cache helper for eval-based tool init (avoids fork on every shell start)
# Defined before modular config files since 99-integrations.zsh uses it
# ============================================================================
_cache_eval() {
  local name="$1" cmd="$2"
  local cache="${HOME}/.cache/${name}/init.zsh"
  local meta="${HOME}/.cache/${name}/meta"
  # Track binary path to invalidate cache when binary moves (e.g., brew -> pacman)
  local bin_name="${cmd%% *}"
  # Use zsh $commands hash table — zero fork (no subshell needed)
  local cur_path="${commands[$bin_name]:-$bin_name}"
  local prev_path=""
  [[ -f "$meta" ]] && prev_path="$(<"$meta")"
  if [[ ! -f "$cache" ]] || [[ ! -s "$cache" ]] || \
     [[ "$cur_path" != "$prev_path" ]] || \
     [[ -n "$(find "$cache" -mtime +1 2>/dev/null)" ]]; then
    mkdir -p "${cache:h}"
    eval "$cmd" > "$cache" 2>/dev/null || { rm -f "$cache" "$meta"; eval "$cmd"; return; }
    echo "$cur_path" > "$meta"
  fi
  source "$cache" 2>/dev/null || eval "$cmd"
}

# ============================================================================
# Load modular configuration files
# ============================================================================
for config_file ($HOME/.zsh/*.zsh(N)); do
  source $config_file
done

# ============================================================================
# Starship prompt (must be last to override oh-my-zsh theme)
# ============================================================================
if (( $+commands[starship] )); then
  _cache_eval starship 'starship init zsh'
fi

# ===============================================================
# Machine-specific configuration (Work vs Personal)
# ===============================================================
{{ if eq .chezmoi.hostname "jsoyer-macOS" -}}
# Work machine
export GIT_AUTHOR_EMAIL="{{ .work_email }}"
alias k="kubectl"

{{ else -}}
# Personal machines
export GIT_AUTHOR_EMAIL="{{ .email }}"

{{ end -}}
