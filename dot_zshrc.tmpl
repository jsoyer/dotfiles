# Oh-My-Zsh configuration
export ZSH=$HOME/.oh-my-zsh
export UPDATE_ZSH_DAYS=7
ZSH_THEME=""  # Theme disabled, using Starship instead

# ============================================================================
# Oh-My-Zsh Plugins
# ============================================================================
# Platform-specific plugins are conditionally loaded

plugins=(
  colored-man-pages    # Colorful man pages
  copybuffer           # Copy command line to clipboard (Ctrl+O)
  copyfile             # Copy file contents to clipboard
  extract              # Universal archive extraction
  encode64             # Base64 encoding/decoding helpers
  sudo                 # ESC ESC to add sudo
  ssh-agent            # SSH agent management

{{- if eq .chezmoi.os "darwin" }}
  macos                # macOS-specific utilities
  kubectl              # Kubernetes completion
  helm                 # Helm completion
{{- end }}
)


# ============================================================================
# Load Oh-My-Zsh
# ============================================================================
source $ZSH/oh-my-zsh.sh

# ============================================================================
# Cache helper for eval-based tool init (avoids fork on every shell start)
# Defined before modular config files since 99-integrations.zsh uses it
# ============================================================================
_cache_eval() {
  local name="$1" cmd="$2"
  local cache="${HOME}/.cache/${name}/init.zsh"
  if [[ ! -f "$cache" ]] || [[ ! -s "$cache" ]]; then
    mkdir -p "${cache:h}"
    eval "$cmd" > "$cache" 2>/dev/null
  fi
  source "$cache"
}

# ============================================================================
# Load modular configuration files
# ============================================================================
for config_file ($HOME/.zsh/*.zsh(N)); do
  source $config_file
done

# ============================================================================
# Starship prompt (must be last to override oh-my-zsh theme)
# ============================================================================
if (( $+commands[starship] )); then
  _cache_eval starship 'starship init zsh'
fi

# ===============================================================
# Machine-specific configuration (Work vs Personal)
# ===============================================================
{{ if eq .chezmoi.hostname "jsoyer-macOS" -}}
# Work machine
export GIT_AUTHOR_EMAIL="{{ .work_email }}"
alias k="kubectl"

{{ else -}}
# Personal machines
export GIT_AUTHOR_EMAIL="{{ .email }}"

{{ end -}}
